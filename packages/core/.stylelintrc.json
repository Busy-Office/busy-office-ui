{
  "rules": {
    "selector-class-pattern": [
      "^bo-[a-z0-9]+(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Class names must follow .bo-block, .bo-block__part, .bo-block--variant (also allows htmx-* via ignore)",
        "severity": "error"
      }
    ],
    "custom-property-pattern": [
      "^bo-[a-z0-9]+(-[a-z0-9]+)*$",
      { "message": "Custom properties must be --bo-*" }
    ]
  },
  "overrides": [
    {
      "files": ["src/css/integrations/htmx.css"],
      "rules": { "selector-class-pattern": null }
    },
    {
      "files": ["src/css/reset/**/*.css"],
      "rules": { "selector-class-pattern": null }
    }
  ]
}
