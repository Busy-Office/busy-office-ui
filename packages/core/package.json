{
  "name": "@busy-office/ui",
  "version": "0.2.0",
  "description": "CSS-first ERP UI framework: semantic components, density-aware tokens, modern CSS, zero runtime dependencies.",
  "keywords": [
    "css",
    "ui",
    "framework",
    "erp",
    "design-system",
    "dark-mode",
    "density",
    "container-queries",
    "htmx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Busy-Office/busy-office-ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./css": "./dist/css/index.css",
    "./css/min": "./dist/css/index.min.css",
    "./css/tokens": "./dist/css/tokens.css",
    "./css/reset": "./dist/css/reset.css",
    "./css/primitives": "./dist/css/primitives.css",
    "./css/components/*": "./dist/css/components/*.css",
    "./css/htmx": "./dist/css/htmx.css",
    "./css/motion": "./dist/css/motion.css",
    "./css/*": "./dist/css/*.css",
    "./api": "./dist/api.json",
    "./contrast": "./dist/contrast.json",
    "./behaviors-manifest": "./dist/behaviors.json",
    "./events": "./dist/events.json",
    "./keymap": "./dist/keymap.json",
    "./acr": "./dist/acr.json",
    "./js": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js"
    },
    "./js/behaviors/*": "./dist/js/behaviors/*.js",
    "./scales": "./dist/scales.json"
  },
  "scripts": {
    "build:css": "node scripts/build-component-css.mjs",
    "build:api": "node scripts/extract-api.mjs",
    "build:behaviors": "node scripts/extract-behaviors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "build:js": "tsc -p tsconfig.json",
    "build": "node scripts/generate-scales.mjs --check && npm run lint:css && npm run build:css && npm run build:js && npm run build:api && npm run build:behaviors && npm run build:events && npm run build:keymap && npm run check:contrast && npm run check:rtl && npm run check:motion && npm run build:acr && node scripts/stamp-readme.mjs --check",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "new:component": "node scripts/new-component.mjs",
    "pretest": "npm run build:js",
    "test": "vitest run",
    "build:events": "node scripts/extract-events.mjs",
    "build:keymap": "node scripts/extract-keymap.mjs",
    "build:acr": "node scripts/extract-acr.mjs",
    "gen:scales": "node scripts/generate-scales.mjs"
  },
  "browserslist": [
    "chrome >= 119",
    "edge >= 119",
    "firefox >= 128",
    "safari >= 17.4"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "postcss": "^8.4.47",
    "postcss-custom-media": "^11.0.5",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "stylelint": "^16.10.0",
    "typescript": "^5.6.3",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
