node_modules/
dist/
# po-app's local Dockerfile-mirroring workflow (npm pack + npm install) always
# produces these locally when testing outside the container — found
# uncommitted and unignored during the role-home dogfood spike, 2026-08-22.
examples/*/busy-office-ui.tgz
examples/*/package-lock.json
.astro/
graphify-out/
.DS_Store

# Derived loop-telemetry mirror — rebuild with scripts/loops/rebuild_from_log.py
.roundtable/loops.db

# Claude Code session-lock state (session id/PID/timestamp) — ephemeral
# runtime state, not project content; was accidentally tracked once and
# has shown a perpetual uncommitted diff on every autonomous-loop wake
# since (a new session claims the lock each time).
.claude/scheduled_tasks.lock
visual-diffs/
apps/docs/public/assets/

# serena MCP workspace cache (derived, per-machine)
.serena/

# Throwaway probe scripts. They must live in scripts/ (they import
# ./browser-harness.mjs and ./serve-dist.mjs by relative path), so they cannot
# be kept in a scratch directory elsewhere — and hand-deleting them is exactly
# what failed: _repro.mjs was committed in the 0.2.0 release commit because the
# cleanup `rm` ran from the wrong directory. Ignored rather than gated: the file
# existing locally is the point, only committing it is the defect.
apps/docs/scripts/_*.mjs
packages/core/scripts/_*.mjs
