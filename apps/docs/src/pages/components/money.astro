---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const basic = `<div class="bo-money">
  <select class="bo-select bo-money__currency" aria-label="Currency">
    <option>USD</option>
    <option>EUR</option>
    <option>JPY</option>
    <option>BHD</option>
  </select>
  <input class="bo-input bo-input--numeric bo-money__amount" type="number"
      step="0.01" value="1250.00" aria-label="Amount">
</div>`;

const trailing = `<!-- Currency AFTER the amount: de-DE writes 1.234,56 € where
     en-US writes $1,234.56. Same two elements, same classes — the order you
     write them in is the order they render. No modifier to remember. -->
<div class="bo-money">
  <input class="bo-input bo-input--numeric bo-money__amount" type="number"
      step="0.01" value="1250.00" aria-label="Amount">
  <select class="bo-select bo-money__currency" aria-label="Currency">
    <option>EUR</option>
    <option>USD</option>
    <option>JPY</option>
  </select>
</div>`;

const rejected = `<!-- The mechanism already ships: aria-invalid is the
     programmatic channel, .bo-form-field__message the visible one. What counts
     as a valid code is the server's call, not CSS's. -->
<div class="bo-form-field">
  <label class="bo-form-field__label" for="cur-bad">Order value</label>
  <div class="bo-money">
    <input class="bo-input bo-money__amount" type="text" inputmode="decimal"
           value="1250.00" aria-label="Amount">
    <div class="bo-combobox bo-money__currency" data-name="currency">
      <input class="bo-input" id="cur-bad" type="text" role="combobox"
             aria-expanded="false" aria-autocomplete="list" aria-label="Currency"
             aria-invalid="true" aria-describedby="cur-bad-msg" value="EURO">
    </div>
  </div>
  <p class="bo-form-field__message" id="cur-bad-msg">EURO is not a currency code. Did you mean EUR?</p>
</div>`;

const readOnly = `<!-- an amount, read-only: Amount with a currency -->
<span class="bo-amount">
  <span class="bo-amount__currency">$</span>
  <span class="bo-amount__value">1,250.00</span>
</span>`;

const grouped = `<!-- data-grouped: thousands separators, formatted ON BLUR.
     The name moves to a generated hidden input that always submits the RAW
     number — the server never parses "1,234,567.50". -->
<div class="bo-money">
  <select class="bo-select bo-money__currency" aria-label="Currency">
    <option>USD</option>
    <option>JPY</option>
  </select>
  <input class="bo-input bo-input--numeric bo-money__amount" type="number"
      step="0.01" value="1234567.5" name="net-total" data-grouped
      data-locale="en-US" aria-label="Amount">
</div>
<!-- + initGroupedNumber() once, alongside initMoneyField() -->`;

const tableColumn = `<!-- In a line table the currency is its own COLUMN, fixed per row —
     so each amount cell is a plain numeric input (the family rule: fixed
     currency needs no widget), with step server-rendered per that row's
     currency. -->
<table class="bo-data-table">
  <thead><tr>
    <th>Line item</th>
    <th class="bo-data-table__col--numeric">Amount</th>
    <th>Currency</th>
  </tr></thead>
  <tbody>
    <tr>
      <td>Standing desk</td>
      <td class="bo-data-table__col--numeric">
        <input class="bo-input bo-input--numeric" type="number" step="0.01"
            value="1208.00" aria-label="Amount, standing desk" />
      </td>
      <td class="bo-data-table__col--code">USD</td>
    </tr>
    <tr>
      <td>Import duty</td>
      <td class="bo-data-table__col--numeric">
        <input class="bo-input bo-input--numeric" type="number" step="1"
            value="56000" aria-label="Amount, import duty" />
      </td>
      <td class="bo-data-table__col--code">JPY</td>
    </tr>
  </tbody>
</table>`;

const spacious = `<div data-density="spacious">
  <div class="bo-money">
    <select class="bo-select bo-money__currency" aria-label="Currency">
      <option>USD</option>
      <option>EUR</option>
    </select>
    <input class="bo-input bo-input--numeric bo-money__amount" type="number"
        step="0.01" value="1250.00" aria-label="Amount">
  </div>
</div>`;

const override = `<div class="bo-money">
  <select class="bo-select bo-money__currency" aria-label="Currency">
    <option>USD</option>
    <option data-decimals="4">USD — FX rate</option>
  </select>
  <input class="bo-input bo-input--numeric bo-money__amount" type="number"
      step="0.01" value="1.0842" aria-label="Rate">
</div>`;

const inField = `<div class="bo-form-field" style="max-inline-size: 20rem">
  <label class="bo-form-field__label" for="po-total-amount">Order total</label>
  <div class="bo-money">
    <select class="bo-select bo-money__currency" aria-label="Currency">
      <option>SGD</option>
      <option>THB</option>
      <option>JPY</option>
      <option>KWD</option>
    </select>
    <input class="bo-input bo-input--numeric bo-money__amount" id="po-total-amount"
        type="number" step="0.01" value="18940.50" aria-label="Amount">
  </div>
  <p class="bo-form-field__hint">Precision follows the currency — try JPY (0) or KWD (3).</p>
</div>`;

const canonical = `<!-- Two real form controls working as one field: the select picks the
     currency, the behavior re-derives the input's step/decimals from it.
     Decimal source, in priority order:
       1. data-decimals on the selected <option>   (your override)
       2. data-decimals on the .bo-money container (your override)
       3. the built-in ISO 4217 minor-units table  (default 2) -->
<div class="bo-money">
  <select class="bo-select bo-money__currency" aria-label="Currency">
    <option>USD</option>
    <option>JPY</option>
  </select>
  <input class="bo-input bo-input--numeric bo-money__amount" type="number"
      step="0.01" value="0.00" aria-label="Amount">
</div>
<script type="module">
  import { initMoneyField } from "@busy-office/ui/js";
  initMoneyField();
</script>`;
const searchable = `<!-- A searchable currency, for the list that is 180 long.
     Same slot as the select; the combobox is the framework's value-help
     control, so nothing new is introduced. No data-open-on-focus, so the
     list stays shut until the first character is typed. -->
<div class="bo-money">
  <input class="bo-input bo-money__amount" type="text" inputmode="decimal"
         value="1250.00" aria-label="Amount">
  <div class="bo-combobox bo-money__currency" data-name="currency">
    <input class="bo-input" type="text" role="combobox" aria-expanded="false"
           aria-controls="cur-list" aria-autocomplete="list" aria-label="Currency"
           value="EUR">
    <ul class="bo-combobox__listbox" id="cur-list" role="listbox" popover>
      <li class="bo-combobox__option" role="option" id="cur-eur" data-value="EUR">EUR — Euro</li>
      <li class="bo-combobox__option" role="option" id="cur-usd" data-value="USD">USD — US dollar</li>
      <li class="bo-combobox__option" role="option" id="cur-gbp" data-value="GBP">GBP — Pound sterling</li>
      <li class="bo-combobox__option" role="option" id="cur-nok" data-value="NOK">NOK — Norwegian krone</li>
      <li class="bo-combobox__option" role="option" id="cur-jpy" data-value="JPY">JPY — Japanese yen</li>
    </ul>
  </div>
</div>`;
---
<Gallery title="Money" description="An editable money field where a currency select and an amount input work as one, with decimal precision updating live from a built-in ISO 4217 table.">
  <p class="demo-note">
    Editable money: a currency select and amount input working as one
    field. Changing currency updates the input's decimal precision live
    (USD 1250.00 → JPY 1250 → BHD 1250.000) from a built-in ISO 4217
    table — overridable when your app supplies its own. The read-only
    counterpart is <a href={base + '/components/amount'}>Amount</a>.
    <strong>Not for a fixed-currency value</strong> — a rate, a fee percentage, a
    price your app always quotes in one currency: the select adds a decision the
    field never needs, and a plain <code>.bo-input--numeric</code> is the whole
    answer.
  </p>

  {/* Kept byte-identical across amount.astro / money.astro / quantity.astro — the numeric-family routing rule. Update all three together. */}
  <p class="demo-note"><strong>The rule for this family:</strong> displaying a value is <a href={base + '/components/amount'}>Amount</a>'s job; capturing one is <a href={base + '/components/money'}>Money</a>'s (currency) or <a href={base + '/components/quantity'}>Quantity</a>'s (count). One display component for every numeric value; two entry components, split by what the value <em>is</em> — and when it is neither a selectable currency nor a steppable count (a rate, a fixed-currency price, a percentage), a plain <code>.bo-input--numeric</code> is the whole answer: no fourth component, just the input modifier.</p>

  <section class="demo">
    <h2>Basic — precision follows the currency</h2>
    <Demo code={basic} />
    <p class="bo-u-text-muted">Switch to JPY: <code>step</code> becomes 1
    and 1250.00 trims to 1250 — a <em>lossless</em> reformat. Values that
    don't fit the new precision keep their digits (nothing is ever
    rounded away); switch to BHD and it pads to 3 decimals. Everything
    not in the built-in exception table uses 2.</p>
  </section>

  <section class="demo">
    <h2>Currency after the amount</h2>
    <Demo code={trailing} />
    <p class="bo-u-text-muted">Currency placement is a locale convention, not
    a preference: <code>de-DE</code> writes 1.234,56 € where <code>en-US</code>
    writes $1,234.56. Put the <code>select</code> after the <code>input</code>
    and it renders that way — the joint follows DOM order, so there is no
    modifier to remember and no way for a class to disagree with your markup.
    Tab order follows too, because nothing is visually reordered. The
    behaviour is unchanged: precision still tracks the currency from either
    position.</p>
  </section>

  <section class="demo">
    <h2>Long currency lists — use a combobox in the same slot</h2>
    <Demo code={searchable} />
    <p class="bo-u-text-muted">A <code>select</code> is right for five
    currencies and wrong for a hundred and eighty; unit-of-measure lists in a
    real ERP run to hundreds.
    <strong>Put a <a href={base + '/components/combobox'}>combobox</a> where
    the select goes</strong> — the joint reaches the input inside it, so the
    field still reads as one control. Nothing new is introduced: the combobox
    is already this framework's value-help surface, with its keyboard
    contract in the <a href={base + '/concepts/js-behaviors'}>generated
    keymap</a>.
    <strong>The list stays shut until you type.</strong> That is the default,
    not a setting: <code>data-open-on-focus</code> is opt-IN, so a combobox
    without it opens on the first character rather than dropping two hundred
    options the moment the field is focused. Add the attribute for the short
    lists where seeing every option immediately is the point.</p>
  </section>

  <section class="demo">
    <h2>A currency that is not on the list</h2>
    <Demo code={rejected} />
    <p class="bo-u-text-muted">A combobox lets people TYPE, so people type
    <code>EURO</code>, <code>US$</code> and yesterday's currency code. Nothing
    new is needed to say no: <code>aria-invalid="true"</code> on the input is
    the programmatic channel, <code>.bo-form-field</code> reacts to it with
    <code>:has()</code>, and <code>.bo-form-field__message</code> is the
    visible one — the same two channels every other field in this framework
    uses. <strong>Whether a code is valid is your server's call</strong>, not a
    CSS one: ISO 4217 has 180 entries, it changes, and half of ERP money
    fields are additionally restricted to the currencies a company is
    configured for.</p>
    <p class="bo-u-text-muted"><strong>Say what is wrong, not that something
    is.</strong> "Not a currency" leaves the reader to guess whether they
    mistyped or the currency is genuinely unavailable here — and those have
    different fixes. Naming the nearest match turns a rejection into a
    correction.</p>
  </section>

  <section class="demo">
    <h2>Read-only display — use Amount</h2>
    <Demo code={readOnly} />
    <p class="bo-u-text-muted">There is no <code>.bo-money--display</code> —
    same shape as <a href={base + '/components/quantity'}>Quantity</a>'s
    own "use Amount" rule. Once a value stops being edited, it's a display
    concern, and <a href={base + '/components/amount'}>Amount</a> already
    handles currency symbols, grouping, minor units, and negative/credit
    formatting — building a second read-only variant here would just be
    <code>.bo-amount</code> again under a different name. The visual
    difference is the affordance: a bordered box says "you can type here",
    plain text says "this is a fact" — the two are meant to look unrelated.</p>
  </section>

  <section class="demo">
    <h2>Your data wins — <code>data-decimals</code> override</h2>
    <Demo code={override} />
    <p class="bo-u-text-muted">An option (or the container) carrying
    <code>data-decimals</code> beats the built-in table — here an FX-rate
    field forces 4 decimals on USD. Supply it wherever your currency
    master data disagrees with ISO 4217.</p>
  </section>

  <section class="demo">
    <h2>Grouped display — <code>data-grouped</code></h2>
    <Demo code={grouped} />
    <p class="bo-u-text-muted">Formats <strong>on blur, never while you
    type</strong> — the pattern real accounting software ships (live
    reformatting is where caret jumps and locale bugs live; the evidence
    is linked from the API notes). Focus shows the raw value for editing;
    leaving the field renders <code>1,234,567.50</code>. Grouping is
    <code>Intl</code>-driven via <code>data-locale</code> — under
    <code>en-IN</code> the same value reads <code>12,34,567.50</code> —
    and the submitted value is always the raw number via a generated
    hidden input. Works the same on
    <a href={base + '/components/quantity'}>Quantity</a> and any plain
    numeric input. Without JS the field stays a native number input:
    correct, just ungrouped.</p>
  </section>

  <section class="demo">
    <h2>Inside a form field</h2>
    <Demo code={inField} />
    <p class="bo-u-text-muted">Composes <code>.bo-form-field</code>
    normally — label, hint, and validation states all apply. The two
    controls keep their own focus rings and accessible names.</p>
  </section>

  <section class="demo">
    <h2>Currency decimals reference</h2>
    <p>The built-in table stores only the ISO 4217 exceptions —
    <strong>every currency not listed here uses 2 decimals</strong>
    (USD, EUR, GBP, SGD, THB, …).</p>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 40rem">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Decimals</th><th scope="col">Currencies</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--numeric">0</td>
            <td class="bo-data-table__col--code">BIF CLP DJF GNF ISK JPY KMF KRW PYG RWF UGX UYI VND VUV XAF XOF XPF</td></tr>
          <tr><td class="bo-data-table__col--numeric">3</td>
            <td class="bo-data-table__col--code">BHD IQD JOD KWD LYD OMR TND</td></tr>
          <tr><td class="bo-data-table__col--numeric">4</td>
            <td class="bo-data-table__col--code">CLF UYW</td></tr>
          <tr><td class="bo-data-table__col--numeric">2</td>
            <td>All other ISO 4217 currencies (the default)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Programmatic access:
    <code>currencyDecimals('JPY') → 0</code>, exported next to
    <code>initMoneyField</code>. The authoritative source is the
    <a href="https://www.iso.org/iso-4217-currency-codes.html">ISO 4217
    amendment list</a> — if an amendment moves a currency, your
    <code>data-decimals</code> override covers the gap until the table
    catches up.</p>
  </section>

  <section class="demo">
    <h2>In a table column</h2>
    <div class="bo-data-table-container" tabindex="0">
      <Demo code={tableColumn} />
    </div>
    <p class="bo-u-text-muted">In a line table, split the pair: the
    currency is its own <strong>column</strong>, fixed per row, and each
    amount cell is a plain <code>.bo-input--numeric</code> — the family
    rule's fixed-currency case, no widget needed. Precision is the
    <code>step</code> the server renders per that row's currency (0.01 for
    the USD line, 1 for JPY). The joined <code>.bo-money</code> control is
    the <em>form</em> shape — it belongs in a cell only in the rare case
    the user must change a row's currency inline.</p>
  </section>

  <section class="demo">
    <h2>Large-target (warehouse-floor) variant</h2>
    <Demo code={spacious} />
    <p class="bo-u-text-muted">There's no separate "large" modifier —
    density IS the size variant, same as
    <a href={base + '/components/quantity'}>Quantity</a>.
    <code>data-density="spacious"</code> (44px controls) already meets the
    WCAG 2.5.8 minimum target size; scope it to a receiving-floor or
    kiosk screen the same way you'd scope <code>compact</code> to a dense
    table.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{canonical}</code></pre>
  </section>

  <script>
    import { initMoneyField, initGroupedNumber } from '@busy-office/ui/js';
    initMoneyField();
    initGroupedNumber();
  </script>

  <ClassRef component="money" />
  <ApiTable
    component="money"
    js="initMoneyField() — on currency change, re-derives the amount input's step/decimals (option data-decimals ▸ container data-decimals ▸ built-in ISO 4217 table ▸ 2) and reformats the current value LOSSLESSLY only: pads or trims zeros, never rounds — a value that doesn't fit the new precision (a JPY-priced 12.40) keeps its digits and surfaces through the native step-mismatch channel instead. A lossless reformat dispatches a real input event so dirty-tracking (row-edit) sees the change."
    notes={[
      'The built-in currency table is a deliberate exception to the "your app owns the data" rule — kept tiny (exceptions only, everything else 2) and always overridable via <code>data-decimals</code>.',
      'Both controls need accessible names — <code>aria-label</code> on each, or a wrapping <code>.bo-form-field</code> label naming the pair.',
      'Formatting for display (thousands separators, symbol placement) remains your app’s job — the input holds a plain number; <code>Intl.NumberFormat</code> at render time is the tool.',
      'The reformat is a programmatic value change with no reliable screen-reader announcement channel (WCAG 4.1.3) — when totals or other UI depend on it, announce the consequence in a committed-change <code>aria-live</code> status (the editable-grid pattern shows the recipe); the field itself reads its new value on next focus/arrow.',
      'The JS is optional, not required. Without <code>initMoneyField()</code> the two controls still work — precision just doesn\'t follow the currency automatically. An htmx app that prefers the server owning precision can skip the behavior entirely and re-render the amount input with the new <code>step</code> on currency change (<code>hx-get</code> on the select) — the same outcome, server-side. And a single-currency form needs neither: a plain <code>.bo-input--numeric</code> with the currency in the label (<code>examples/po-app</code> captures every amount this way).',
    ]}
  />
  <DsaScore component="money" />
  <Related links={[
    ['/components/amount', 'Amount'],
    ['/components/quantity', 'Quantity'],
    ['/patterns/editable-grid', 'Editable grid (composite editor)'],
    ['/components/form', 'Forms'],
  ]} />
</Gallery>
