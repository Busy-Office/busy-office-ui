---
/* Standalone shell for /components/sidebar-nav (143.2), narrow variant.
   No Gallery: the rail collapses under `@container bo-shell (max-width:
   56rem)`, so it needs a real .bo-app-shell sized by the frame around it.
   Two routes rather than one embedded twice, because axe walks into iframes
   and two identically-named landmark sets trip landmark-unique. */
import '@busy-office/ui/css';
import PrefBootstrap from '../../../components/PrefBootstrap.astro';
import SidebarNavShellDemo from '../../../components/SidebarNavShellDemo.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PrefBootstrap />
    <title>Sidebar nav — narrow shell demo</title>
    <meta name="description" content="An isolated demo document showing the sidebar navigation collapsed to icons in a narrow app shell, embedded from the component page." />
    <style>
      html, body { margin: 0; block-size: 100%; }
      body { background: var(--bo-color-bg-canvas); color: var(--bo-color-text-primary); }
      .demo-main { padding: var(--bo-space-4); overflow: auto; }
    </style>
  </head>
  <body>
    <SidebarNavShellDemo label="narrow shell" />
  </body>
</html>
