import { monthGrid, DAY_NAMES, DAY_SHORT, weekdayOrder } from '../../lib/month-grid';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* Week-start demos are GENERATED, never hand-typed. A month is 35+ cells whose
   date must agree with the column it sits under, and getting that wrong is
   silent — the grid still looks like a calendar. The two demos below come from
   ONE function so they cannot drift apart. */

function month(year, monthIdx, weekStart /* 0 = Sunday, 1 = Monday */) {
  const head = weekdayOrder(weekStart)
    .map((d) => `<th scope="col"><abbr title="${DAY_NAMES[d]}">${DAY_SHORT[d]}</abbr></th>`).join('');
  const weeks = monthGrid(year, monthIdx, weekStart).map((week) => {
    const cells = week.map(({ iso, day, weekday, outside }) => {
      const weekend = weekday === 0 || weekday === 6;
      const cls = `bo-calendar__day${outside ? ' bo-calendar__day--outside' : ''}`;
      const mark = !outside && weekend ? ' data-day="closed"' : '';
      const sr = mark ? '<span class="bo-visually-hidden"> — non-working day</span>' : '';
      return `<td><span class="${cls}"${mark}><time datetime="${iso}">${day}</time>${sr}</span></td>`;
    });
    return `      <tr>${cells.join('')}</tr>`;
  });
  return `<div class="bo-calendar">
  <table class="bo-calendar__month">
    <caption>${weekStart === 0 ? 'Week starts Sunday' : 'Week starts Monday'} — September 2026</caption>
    <thead><tr>${head}</tr></thead>
    <tbody>
${weeks.join('\n')}
    </tbody>
  </table>
</div>`;
}

