---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const breadcrumbMarkup = `<nav aria-label="Breadcrumb">
  <ol class="bo-breadcrumb">
    <li><a href="/cost-centers">Cost centers</a></li>
    <li><a href="/cost-centers/cc-4021">CC-4021</a></li>
    <li aria-current="page">PO-88213</li>
  </ol>
</nav>
<!-- The current page is plain text, not a link — you don't link to where
     you already are. aria-current is the programmatic channel; the ol's
     list semantics + aria-label="Breadcrumb" are what make it a landmark
     a screen reader can jump to directly. -->`;
const offcanvasMarkup = `<button class="bo-btn bo-btn--secondary"
        data-dialog-trigger="drawer-nav" aria-label="Open navigation">☰ Menu</button>

<dialog class="bo-offcanvas" id="drawer-nav" data-state="closed"
        aria-labelledby="drawer-title">
  <div class="bo-offcanvas__header">
    <span id="drawer-title" class="bo-navbar__brand">busy-office</span>
    <form method="dialog">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button>
    </form>
  </div>
  <nav class="bo-sidebar-nav" aria-label="Main">…same markup as the sidebar…</nav>
</dialog>
<!-- Opens via initDialogs() — same wiring as any dialog: backdrop, Esc,
     focus-return and Tab loop are all inherited. -->`;
---
<Gallery title="Navigation">
  <p class="demo-note">
    The docs site itself is the live demo: navbar + sidebar inside
    <code>.bo-app-shell</code>. Narrow the window below 900px of shell width and the
    sidebar collapses to icon-only via a container query.
  </p>
  <ClassRef component="nav" />
  <section class="demo">
    <h2>Breadcrumb — path trail</h2>
    <p class="bo-u-text-muted">
      For deep ERP hierarchies (cost center → PO → line item) — a landmark
      <code>&lt;nav&gt;</code>, not just styled links, so it's directly reachable
      by screen-reader landmark navigation.
    </p>
    <nav aria-label="Breadcrumb">
      <ol class="bo-breadcrumb">
        <li><a href="#">Cost centers</a></li>
        <li><a href="#">CC-4021</a></li>
        <li aria-current="page">PO-88213</li>
      </ol>
    </nav>
    <pre><code>{breadcrumbMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Navbar — brand, spacer, actions</h2>
    <header class="bo-navbar" style="border: 1px solid var(--bo-color-border-default); border-radius: var(--bo-radius-md)">
      <span class="bo-navbar__brand">busy-office ERP</span>
      <span class="bo-badge bo-badge--accent">UAT</span>
      <span class="bo-navbar__spacer"></span>
      <input class="bo-input" type="search" aria-label="Search everywhere" placeholder="Search… (⌘K)" style="max-inline-size: 12rem" />
      <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Notifications">🔔</button>
      <button class="bo-btn bo-btn--ghost" aria-label="Account menu">J. Kim ▾</button>
    </header>
    <p class="bo-u-text-muted">The header every app starts with:
    <code>__brand</code> left, <code>__spacer</code> pushing everything after it to
    the end — search, notifications, account. An environment badge next to the brand
    is the cheapest "which system am I in" safeguard.</p>
  </section>
  <section class="demo">
    <h2>Embedded shell (independent container) — with grouped sidebar</h2>
    <div class="bo-app-shell" style="min-height: 18rem; max-inline-size: 700px; border: 1px solid var(--bo-color-border-default); border-radius: var(--bo-radius-md); overflow: hidden">
      <header class="bo-navbar bo-app-shell__header">
        <span class="bo-navbar__brand">Embedded app</span>
        <span class="bo-navbar__spacer"></span>
      </header>
      <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Embedded">
        <div class="bo-sidebar-nav__section">
          <div class="bo-sidebar-nav__heading">Purchasing</div>
          <ul>
            <li><a class="bo-sidebar-nav__link" href="#" aria-current="page"><span class="bo-icon bo-icon--invoice bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Invoices</span></a></li>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--check-circle bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Approvals</span></a></li>
          </ul>
        </div>
        <div class="bo-sidebar-nav__section">
          <div class="bo-sidebar-nav__heading">Finance</div>
          <ul>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--chart bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Ledger</span></a></li>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--settings bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Settings</span></a></li>
          </ul>
        </div>
      </nav>
      {/* div, not <main>: a second main landmark inside the docs page is an
          axe violation — the demo shows layout, not landmark semantics */}
      <div class="bo-app-shell__main">
        <p class="bo-u-text-muted">Sections (<code>__section</code> +
        <code>__heading</code>) group a real ERP's modules — headings hide with the
        labels when this 700px shell collapses to icons. Container queries, not
        media queries.</p>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Off-canvas drawer (mobile / narrow shells)</h2>
    <button class="bo-btn bo-btn--secondary" data-dialog-trigger="drawer-nav" aria-label="Open navigation">☰ Menu</button>
    <dialog class="bo-offcanvas" id="drawer-nav" data-state="closed" aria-labelledby="drawer-title">
      <div class="bo-offcanvas__header">
        <span id="drawer-title" class="bo-navbar__brand">busy-office</span>
        <form method="dialog">
          <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button>
        </form>
      </div>
      <nav class="bo-sidebar-nav" aria-label="Drawer demo">
        <ul>
          <li><a class="bo-sidebar-nav__link" href="#" aria-current="page"><span class="bo-icon bo-icon--invoice bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Invoices</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--check-circle bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Approvals</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--settings bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Settings</span></a></li>
        </ul>
      </nav>
    </dialog>
    <h3>Markup</h3>
    <pre><code>{offcanvasMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>End-side drawer — filters & detail panels</h2>
    <button class="bo-btn bo-btn--secondary" data-dialog-trigger="filter-drawer">Filters…</button>
    <dialog class="bo-offcanvas bo-offcanvas--end" id="filter-drawer" data-state="closed" aria-labelledby="fd-title">
      <div class="bo-offcanvas__header">
        <span id="fd-title" class="bo-navbar__brand">Filters</span>
        <form method="dialog">
          <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button>
        </form>
      </div>
      <div class="bo-stack" style="padding: var(--bo-space-4)">
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="fd-status">Status</label>
          <select class="bo-select" id="fd-status"><option>All</option><option>Pending</option></select>
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="fd-cc">Cost center</label>
          <input class="bo-input bo-input--code" id="fd-cc" placeholder="CC-…" />
        </div>
        <div class="bo-form-actions">
          <button class="bo-btn" type="button">Apply</button>
          <button class="bo-btn bo-btn--ghost" type="button">Clear</button>
        </div>
      </div>
    </dialog>
    <p class="bo-u-text-muted"><code>--end</code> slides the drawer in from the end
    edge — the home for filter panels and record previews (start side stays the
    navigation convention). Same dialog wiring, mirrored slide animation, RTL-aware.</p>
  </section>
  <script>
    import { initDialogs } from '@busy-office/ui/js';
    initDialogs();
  </script>
  <ApiTable component="nav"
    notes={['Current page carries <code>aria-current="page"</code>; icons are <code>aria-hidden</code>, labels stay in the accessibility tree when the rail collapses.',
            'The off-canvas drawer is a dialog variant — it inherits initDialogs() wiring (backdrop, Esc, focus-return, Tab loop).',
            'Breadcrumb: the current page is plain text, never a link — wrap the whole thing in <code>&lt;nav aria-label="Breadcrumb"&gt;</code> so it is a landmark.']} />
  <Related links={[["/concepts/container-queries", "Container queries"], ["/components/dialog", "Dialog"], ["/patterns/record-detail", "Record detail"]]} />
</Gallery>
