---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const breadcrumbMarkup = `<nav aria-label="Breadcrumb">
  <ol class="bo-breadcrumb">
    <li><a href="/cost-centers">Cost centers</a></li>
    <li><a href="/cost-centers/cc-4021">CC-4021</a></li>
    <li aria-current="page">PO-88213</li>
  </ol>
</nav>
<!-- The current page is plain text, not a link — you don't link to where
     you already are. aria-current is the programmatic channel; the ol's
     list semantics + aria-label="Breadcrumb" are what make it a landmark
     a screen reader can jump to directly. -->`;
const offcanvasMarkup = `<button class="bo-btn bo-btn--secondary"
        data-dialog-trigger="drawer-nav" aria-label="Open navigation">☰ Menu</button>

<dialog class="bo-offcanvas" id="drawer-nav" data-state="closed"
        aria-labelledby="drawer-title">
  <div class="bo-offcanvas__header">
    <span id="drawer-title" class="bo-navbar__brand">busy-office</span>
    <form method="dialog">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button>
    </form>
  </div>
  <nav class="bo-sidebar-nav" aria-label="Main">…same markup as the sidebar…</nav>
</dialog>
<!-- Opens via initDialogs() — same wiring as any dialog: backdrop, Esc,
     focus-return and Tab loop are all inherited. -->`;
---
<Gallery title="Navigation">
  <p class="demo-note">
    The docs site itself is the live demo: navbar + sidebar inside
    <code>.bo-app-shell</code>. Narrow the window below 900px of shell width and the
    sidebar collapses to icon-only via a container query.
  </p>
  <ClassRef component="nav" />
  <section class="demo">
    <h2>Breadcrumb — path trail</h2>
    <p class="bo-u-text-muted">
      For deep ERP hierarchies (cost center → PO → line item) — a landmark
      <code>&lt;nav&gt;</code>, not just styled links, so it's directly reachable
      by screen-reader landmark navigation.
    </p>
    <nav aria-label="Breadcrumb">
      <ol class="bo-breadcrumb">
        <li><a href="#">Cost centers</a></li>
        <li><a href="#">CC-4021</a></li>
        <li aria-current="page">PO-88213</li>
      </ol>
    </nav>
    <pre><code>{breadcrumbMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Embedded shell (independent container)</h2>
    <div class="bo-app-shell" style="min-height: 16rem; max-inline-size: 700px; border: 1px solid var(--bo-color-border-default); border-radius: var(--bo-radius-md); overflow: hidden">
      <header class="bo-navbar bo-app-shell__header">
        <span class="bo-navbar__brand">Embedded app</span>
      </header>
      <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Embedded">
        <ul>
          <li><a class="bo-sidebar-nav__link" href="#" aria-current="page"><span class="bo-sidebar-nav__icon">▤</span><span class="bo-sidebar-nav__label">Invoices</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-sidebar-nav__icon">✓</span><span class="bo-sidebar-nav__label">Approvals</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-sidebar-nav__icon">⚙</span><span class="bo-sidebar-nav__label">Settings</span></a></li>
        </ul>
      </nav>
      <main class="bo-app-shell__main">
        <p class="bo-u-text-muted">This shell is 700px wide → its sidebar is already collapsed to icons, while the page's own sidebar may not be. Container queries, not media queries.</p>
      </main>
    </div>
  </section>
  <section class="demo">
    <h2>Off-canvas drawer (mobile / narrow shells)</h2>
    <button class="bo-btn bo-btn--secondary" data-dialog-trigger="drawer-nav" aria-label="Open navigation">☰ Menu</button>
    <dialog class="bo-offcanvas" id="drawer-nav" data-state="closed" aria-labelledby="drawer-title">
      <div class="bo-offcanvas__header">
        <span id="drawer-title" class="bo-navbar__brand">busy-office</span>
        <form method="dialog">
          <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button>
        </form>
      </div>
      <nav class="bo-sidebar-nav" aria-label="Drawer demo">
        <ul>
          <li><a class="bo-sidebar-nav__link" href="#" aria-current="page"><span class="bo-sidebar-nav__icon" aria-hidden="true">▤</span><span class="bo-sidebar-nav__label">Invoices</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-sidebar-nav__icon" aria-hidden="true">✓</span><span class="bo-sidebar-nav__label">Approvals</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-sidebar-nav__icon" aria-hidden="true">⚙</span><span class="bo-sidebar-nav__label">Settings</span></a></li>
        </ul>
      </nav>
    </dialog>
    <h3>Markup</h3>
    <pre><code>{offcanvasMarkup}</code></pre>
  </section>
  <script>
    import { initDialogs } from '@busy-office/ui/js';
    initDialogs();
  </script>
  <ApiTable component="nav"
    notes={['Current page carries <code>aria-current="page"</code>; icons are <code>aria-hidden</code>, labels stay in the accessibility tree when the rail collapses.',
            'The off-canvas drawer is a dialog variant — it inherits initDialogs() wiring (backdrop, Esc, focus-return, Tab loop).',
            'Breadcrumb: the current page is plain text, never a link — wrap the whole thing in <code>&lt;nav aria-label="Breadcrumb"&gt;</code> so it is a landmark.']} />
  <Related links={[["/concepts/container-queries", "Container queries"], ["/components/dialog", "Dialog"], ["/patterns/record-detail", "Record detail"]]} />
</Gallery>
