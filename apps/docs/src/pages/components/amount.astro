---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const money = `<span class="bo-amount">
  <span class="bo-amount__currency">$</span>
  <span class="bo-amount__value">18,940<span class="bo-amount__fraction">.50</span></span>
</span>`;

const codeSuffix = `<span class="bo-amount">
  <span class="bo-amount__value">1,234.00</span>
  <span class="bo-amount__currency">EUR</span>
</span>`;

const precision = `<!-- 0 decimals (whole units) -->
<span class="bo-amount"><span class="bo-amount__currency">¥</span><span class="bo-amount__value">56,000</span></span>

<!-- 2 decimals (money) -->
<span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">4,208.00</span></span>

<!-- 4 decimals (unit price / FX rate) -->
<span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">0.0725</span></span>`;

const overdueDate = `<!-- two-channel: the badge carries the word, colour only adds hue -->
<span class="bo-cluster">
  <span class="bo-u-tabular">Aug 10, 2026</span>
  <span class="bo-badge bo-badge--danger">Overdue by 4 days</span>
</span>`;

const signed = `<!-- debit: parentheses OR a minus sign carry the meaning; red is the 2nd channel -->
<span class="bo-amount bo-amount--negative"><span class="bo-amount__currency">$</span><span class="bo-amount__value">(2,110.00)</span></span>
<span class="bo-amount bo-amount--negative"><span class="bo-amount__currency">$</span><span class="bo-amount__value">&minus;730.25</span></span>

<!-- credit: a + sign carries the meaning; green is the 2nd channel -->
<span class="bo-amount bo-amount--positive"><span class="bo-amount__currency">$</span><span class="bo-amount__value">+9,320.75</span></span>`;

const uom = `<!-- quantity × unit -->
<span class="bo-amount"><span class="bo-amount__value">4</span><span class="bo-amount__unit">&times; EA</span></span>

<!-- rate per unit -->
<span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">12.50</span><span class="bo-amount__unit">/ kg</span></span>

<!-- unit price beside a quantity -->
<span class="bo-amount bo-amount--muted"><span class="bo-amount__currency">$</span><span class="bo-amount__value">3.10</span><span class="bo-amount__unit">/ pc</span></span>`;

const custom = `<!-- an app-defined currency (points, credits, store scrip) works exactly
     like ISO codes and symbols — __currency accepts any text -->
<span class="bo-amount"><span class="bo-amount__value">2,400</span><span class="bo-amount__currency">PTS</span></span>
<span class="bo-amount"><span class="bo-amount__currency">₡</span><span class="bo-amount__value">18.50</span></span> <!-- an internal "credit" symbol -->`;

const editable = `<!-- Amount (.bo-amount) is a DISPLAY value — a <span>, not a form control;
     there is no ".bo-amount--input" variant, on purpose (an <input> can't host
     __currency/__fraction as nested markup and stay a single accessible value).
     For an EDITABLE money field, compose .bo-form-field + .bo-input--numeric
     directly — the currency belongs in the label, not invented affix markup. -->
<div class="bo-form-field">
  <label class="bo-form-field__label" for="am-unit-price">Unit price (USD)</label>
  <input class="bo-input bo-input--numeric" type="number" id="am-unit-price" value="12.50" min="0" step="0.01" inputmode="decimal" />
</div>`;

const mixedCurrency = `<table class="bo-data-table">
  <thead><tr><th>Invoice</th><th>Vendor</th><th class="bo-data-table__col--numeric">Amount</th></tr></thead>
  <tbody>
    <tr><td>INV-3391</td><td>Acme Supply Co. (US)</td><td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">4,208.00</span></span></td></tr>
    <tr><td>INV-3392</td><td>Ling Freight Pte Ltd (SG)</td><td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">SGD</span><span class="bo-amount__value">1,052.00</span></span></td></tr>
    <tr><td>INV-3393</td><td>Nakamura Parts KK (JP)</td><td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">¥</span><span class="bo-amount__value">92,500</span></span></td></tr>
    <tr><td>INV-3394</td><td>Al-Rashid Trading (BH)</td><td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">BHD</span><span class="bo-amount__value">120.500</span></span></td></tr>
  </tbody>
</table>`;

const columnDemo = `<div class="bo-data-table-container" tabindex="0">
  <table class="bo-data-table">
    <thead>
      <tr><th>Line item</th><th class="bo-data-table__col--numeric">Qty</th><th class="bo-data-table__col--numeric">Unit price</th><th class="bo-data-table__col--numeric">Amount</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Standing desk</td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__value">4</span><span class="bo-amount__unit">&times; EA</span></span></td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount bo-amount--muted"><span class="bo-amount__currency">$</span><span class="bo-amount__value">1,052.00</span></span></td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">4,208.00</span></span></td>
      </tr>
      <tr>
        <td>Monitor arm</td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__value">8</span><span class="bo-amount__unit">&times; EA</span></span></td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount bo-amount--muted"><span class="bo-amount__currency">$</span><span class="bo-amount__value">92.50</span></span></td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">740.00</span></span></td>
      </tr>
      <tr>
        <td>Restocking fee</td>
        <td class="bo-data-table__col--numeric">&mdash;</td>
        <td class="bo-data-table__col--numeric">&mdash;</td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount bo-amount--negative"><span class="bo-amount__currency">$</span><span class="bo-amount__value">(120.00)</span></span></td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <td>Total</td>
        <td class="bo-data-table__col--numeric"></td>
        <td class="bo-data-table__col--numeric"></td>
        <td class="bo-data-table__col--numeric"><span class="bo-amount bo-amount--strong"><span class="bo-amount__currency">$</span><span class="bo-amount__value">4,828.00</span></span></td>
      </tr>
    </tfoot>
  </table>
</div>`;

const markup = `<span class="bo-amount">
  <span class="bo-amount__currency">$</span>              <!-- symbol or ISO code, either side -->
  <span class="bo-amount__value">18,940                 <!-- your app formats grouping + precision -->
    <span class="bo-amount__fraction">.50</span>         <!-- optional: quiet the minor units -->
  </span>
  <span class="bo-amount__unit">/ kg</span>              <!-- optional unit of measure -->
</span>

<!-- modifiers: --negative  --positive  --strong  --muted  --block -->`;
---
<Gallery title="Amount">
  <p class="demo-note">
    A money or quantity value, laid out to scan down a column. This is CSS-first:
    <strong>your app formats the number</strong> (locale grouping, decimal precision,
    sign) and supplies the parts as markup — the component styles and aligns them, with
    tabular figures so every row lines up digit-for-digit. One component, driven by
    settings.
  </p>

  <p class="demo-note"><strong>The rule for this family:</strong> displaying a value is <a href={base + '/components/amount'}>Amount</a>'s job; capturing one is <a href={base + '/components/money'}>Money</a>'s (currency) or <a href={base + '/components/quantity'}>Quantity</a>'s (count). One display component for every numeric value; two entry components, split by what the value <em>is</em>.</p>


  <section class="demo">
    <h2>Money — symbol, grouping, minor units</h2>
    <Demo code={money} layout="row" />
    <p class="bo-u-text-muted"><code>__currency</code> and <code>__fraction</code> are
    quieted so the whole-number part reads first.</p>
  </section>

  <section class="demo">
    <h2>Currency as an ISO code (either side)</h2>
    <Demo code={codeSuffix} />
    <p class="bo-u-text-muted">Source order decides prefix vs suffix — <code>$</code>
    before, <code>EUR</code>/<code>kr</code> after. No modifier needed.</p>
  </section>

  <section class="demo">
    <h2>Custom / non-ISO currency</h2>
    <Demo code={custom} />
    <p class="bo-u-text-muted">Loyalty points, internal credits, any app-defined
    unit of value — <code>__currency</code> is plain text with no ISO allowlist.
    Same component, same alignment, no special-casing needed.</p>
  </section>

  <section class="demo">
    <h2>Precision — a setting, not a variant</h2>
    <Demo code={precision} layout="row" />
    <p class="bo-u-text-muted">Whole units, money, or 4-dp unit prices — same component;
    the digits come from your formatter.</p>
    <p class="bo-u-text-muted">
      <strong>Decimal precision is app/domain data, not a CSS rule</strong> — there's no
      <code>--decimals</code> modifier, because "how many decimals does this currency
      get" varies by currency, not by design choice. A starting reference (override per
      field, never hardcode as a single app-wide constant):
    </p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Currency</th><th scope="col" class="bo-data-table__col--numeric">Default decimals</th><th scope="col">Example</th></tr></thead>
        <tbody>
          <tr><td>USD, SGD, EUR</td><td class="bo-data-table__col--numeric">2</td><td>$4,208.00</td></tr>
          <tr><td>JPY, KRW</td><td class="bo-data-table__col--numeric">0</td><td>¥56,000</td></tr>
          <tr><td>BHD, KWD, OMR</td><td class="bo-data-table__col--numeric">3</td><td>BHD 12.500</td></tr>
          <tr><td>App-defined (points, credits, FX rates)</td><td class="bo-data-table__col--numeric">your call</td><td>2,400 PTS</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted"><a href="https://en.wikipedia.org/wiki/ISO_4217" target="_blank" rel="noopener">ISO 4217</a>
    publishes the standard minor-unit table if you need it beyond this reference — most
    apps already get this from an <code>Intl.NumberFormat</code> call or a currency-master
    table, which is exactly where this belongs (not this CSS layer).</p>
  </section>

  <section class="demo">
    <h2>Negative &amp; credit — two-channel</h2>
    <Demo code={signed} />
    <p class="bo-u-text-muted">The sign or parentheses live in the <em>text</em>, so
    colourblind and screen-reader users get the meaning without the colour.
    <code>--negative</code>/<code>--positive</code> only add the hue (both AA on surface
    and canvas, CI-gated).</p>
  </section>

  <section class="demo">
    <h2>The same contract for dates</h2>
    <Demo code={overdueDate} />
    <p class="bo-u-text-muted">An overdue date is the same decision as a negative
    amount: the meaning must survive without colour, so the word
    <em>Overdue</em> belongs in the text. This guidance moved here when
    <code>.bo-date</code> was deprecated — it was the only real decision that
    component carried, and it is a rule about <em>values</em>, not about a
    date-specific widget.</p>
  </section>

  <section class="demo">
    <h2>Block — right-aligned totals on cards</h2>
    <div class="bo-widget" style="inline-size: 100%; max-inline-size: 18rem">
      <div class="bo-widget__header"><span class="bo-widget__title">PO-88213 total</span></div>
      <div class="bo-widget__body">
        <span class="bo-amount bo-amount--block bo-amount--strong">
          <span class="bo-amount__currency">$</span>
          <span class="bo-amount__value">12,400<span class="bo-amount__fraction">.00</span></span>
        </span>
        <span class="bo-amount bo-amount--block bo-amount--muted" style="margin-block-start: var(--bo-space-1)">
          <span class="bo-amount__currency">$</span>
          <span class="bo-amount__value">1,240<span class="bo-amount__fraction">.00</span></span>
          <span class="bo-amount__unit">tax</span>
        </span>
      </div>
    </div>
    <p class="bo-u-text-muted"><code>--block</code> right-aligns a standalone amount
    — card totals, summary panels. Inside a table you don't need it: the cell's
    <code>__col--numeric</code> already aligns the column.</p>
  </section>
  <section class="demo">
    <h2>Unit of measure</h2>
    <Demo code={uom} />
    <p class="bo-u-text-muted"><code>__unit</code> carries <code>× EA</code>,
    <code>/ kg</code>, <code>pcs</code>, <code>hrs</code> — a quantity’s unit or a rate’s
    denominator. This is a read-only display value; for an <em>editable</em> count with
    its own unit, see <a href={base + '/components/quantity'}>Quantity</a> — same
    <code>__unit</code> convention, plus increment/decrement and native
    validation.</p>
  </section>

  <section class="demo">
    <h2>Editable money — a plain input, not <code>.bo-amount</code></h2>
    <Demo code={editable} />
    <p class="bo-u-text-muted"><code>.bo-amount</code> is read-only display; it's
    a <code>&lt;span&gt;</code>, not a form control, and there's deliberately no
    input variant of it (the nested <code>__currency</code>/<code>__fraction</code>
    parts can't live inside a native <code>&lt;input&gt;</code> and still be one
    accessible value). For data entry, use a plain <code>.bo-input--numeric</code>
    field — put the currency in the label, the same way <a href={base + '/components/quantity'}>Quantity</a>
    puts the unit in <code>__unit</code> text next to an editable control.</p>
  </section>

  <section class="demo">
    <h2>Mixed currencies in one table</h2>
    <div class="bo-data-table-container" tabindex="0">
      <Demo code={mixedCurrency} />
    </div>
    <p class="bo-u-text-muted">Right-alignment (<code>__col--numeric</code>) plus
    tabular figures keep every row's <em>digits</em> stacked even though the
    <code>__currency</code> affix text differs per row (<code>$</code>, <code>SGD</code>,
    <code>¥</code>, <code>BHD</code>) — verified live, not assumed: the affix sits
    outside the tabular-figure run, so a 3-letter code next to a 1-character symbol
    doesn't shift where the digits land. No dedicated fixed-width affix column
    needed for this case.</p>
  </section>

  <section class="demo">
    <h2>In a column — totals align, subtotal is strong</h2>
    <Demo code={columnDemo} />
    <p class="bo-u-text-muted">Amounts inherit the cell’s right-align
    (<code>__col--numeric</code>); tabular figures keep the decimal points stacked.
    <code>--strong</code> weights the total, <code>--muted</code> quiets the unit price.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>

  <ClassRef component="amount" />
  <ApiTable component="amount"
    notes={['CSS-first: your app formats the number (locale, grouping, precision, sign); the component styles the parts and aligns them with tabular figures.',
            'Negative/credit is two-channel — the sign or parentheses MUST be in the markup; <code>--negative</code>/<code>--positive</code> only add colour.',
            'Currency and unit are muted affixes; put the currency before or after the value by source order.',
            '<code>__currency</code> accepts a symbol, an ISO 4217 code, or an app-defined currency (points, credits) — no allowlist or validation in CSS.',
            'Decimal precision is per-currency domain data, not a CSS setting — there is no <code>--decimals</code> modifier; your app (or an <code>Intl.NumberFormat</code> call) decides and formats the digits before they reach this component.']} />
  <Related links={[["/components/quantity", "Quantity (editable counts)"], ["/components/money", "Money field (editable money)"], ["/components/data-table", "Data table"], ["/base/utilities", "Utilities (tabular)"], ["/patterns/invoice-list", "Invoice list pattern"]]} />
</Gallery>
