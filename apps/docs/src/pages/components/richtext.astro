---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
import keymapManifest from '@busy-office/ui/keymap';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const basic = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertOrderedList"
            aria-label="Numbered list" title="Numbered list"><span class="bo-icon bo-icon--list-numbered" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="createLink"
            aria-label="Link" title="Link"><span class="bo-icon bo-icon--link" aria-hidden="true"></span></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-dialog-trigger="rt-keys"
            aria-label="Keyboard shortcuts" title="Keyboard shortcuts"><span class="bo-icon bo-icon--keyboard" aria-hidden="true"></span></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true"
       role="textbox" aria-multiline="true" aria-label="Delivery notes"
       data-placeholder="Add a note — what arrived, and in what condition.">
    <p>Pallet 2 arrived <strong>damp on one corner</strong> — photos attached
    to the receipt. Count verified against the ASN.</p>
  </div>
</div>`;

const empty = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true" data-empty
       role="textbox" aria-multiline="true" aria-label="Rejection reason"
       data-placeholder="Why is this being rejected?"></div>
</div>`;

const invalid = `<div class="bo-form-field">
  <label class="bo-form-field__label" for="rt-reason">Rejection reason</label>
  <div class="bo-richtext">
    <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
      <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
              title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    </div>
    <div class="bo-richtext__content bo-prose" contenteditable="true" id="rt-reason" data-empty
         role="textbox" aria-multiline="true" aria-label="Rejection reason"
         aria-invalid="true" aria-describedby="rt-reason-err"
         data-placeholder="Why is this being rejected?"></div>
  </div>
  <p class="bo-form-field__message" id="rt-reason-err">A reason is required to reject.</p>
</div>`;

const collapsible = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting" id="rt-collapse-bar">
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost bo-richtext__toolbar-toggle" type="button"
            data-richtext-toggle aria-expanded="true" aria-controls="rt-collapse-bar"
            aria-label="Hide formatting toolbar" title="Hide formatting toolbar">&minus;</button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true"
       role="textbox" aria-multiline="true" aria-label="Internal note"
       data-placeholder="Internal note…">
    <p>Customer called about the short-shipped hose assembly.</p>
  </div>
</div>`;

const advanced = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="strikeThrough" aria-pressed="false"
            title="Strikethrough"><s>S</s></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="formatBlock" data-richtext-value="H2">H2</button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="formatBlock" data-richtext-value="H3">H3</button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="formatBlock" data-richtext-value="BLOCKQUOTE"
            aria-label="Blockquote" title="Blockquote"><span class="bo-icon bo-icon--quote" aria-hidden="true"></span></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="justifyLeft" aria-pressed="true"
            aria-label="Align left" title="Align left"><span class="bo-icon bo-icon--align-left" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="justifyCenter" aria-pressed="false"
            aria-label="Align centre" title="Align centre"><span class="bo-icon bo-icon--align-center" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="justifyRight" aria-pressed="false"
            aria-label="Align right" title="Align right"><span class="bo-icon bo-icon--align-right" aria-hidden="true"></span></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="outdent"
            aria-label="Decrease indent" title="Decrease indent"><span class="bo-icon bo-icon--outdent" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="indent"
            aria-label="Increase indent" title="Increase indent"><span class="bo-icon bo-icon--indent" aria-hidden="true"></span></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="createLink"
            aria-label="Link" title="Link"><span class="bo-icon bo-icon--link" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="removeFormat"
            aria-label="Clear formatting" title="Clear formatting"><span class="bo-icon bo-icon--clear-format" aria-hidden="true"></span></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertOrderedList"
            aria-label="Numbered list" title="Numbered list"><span class="bo-icon bo-icon--list-numbered" aria-hidden="true"></span></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true"
       role="textbox" aria-multiline="true" aria-label="Return instructions">
    <p>Restock only if the seal is unbroken. Otherwise route to Quality —
    see the exception process linked below.</p>
  </div>
</div>`;

const readonly = `<div class="bo-richtext bo-richtext--readonly">
  <div class="bo-richtext__content bo-prose" contenteditable="false" tabindex="0"
       role="textbox" aria-multiline="true" aria-readonly="true" aria-label="Approval note">
    <p>Approved with <em>one exception</em>: line 3 ships from the Hamburg
    warehouse instead.</p>
  </div>
</div>`;

const disabled = `<div class="bo-richtext bo-richtext--disabled">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost" type="button" disabled><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost" type="button" disabled><em>I</em></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="false"
       role="textbox" aria-multiline="true" aria-disabled="true" aria-label="Notes (locked)">
    <p>Posting period closed — notes are locked.</p>
  </div>
</div>`;


const canonical = `<!-- CHROME, not an engine: the framework styles the container,
     toolbar, and content area. What the toolbar DOES is your code —
     the light case below wires native contenteditable; a real editor
     library mounts inside __content instead.
     This is the RECOMMENDED ERP set: bold, italic, both lists, link.
     Everything past that is markup your sanitizer, export and print
     form all have to keep honouring. -->
<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <span class="bo-richtext__divider"></span>
    <button class="bo-btn bo-btn--ghost" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true" data-empty
       role="textbox" aria-multiline="true" aria-label="Notes"
       data-placeholder="Add a note…"></div>
</div>
<script type="module">
  // The light case, in full — this IS the consumer's entire wiring.
  // The mousedown guard is load-bearing: without it the button press
  // blurs the field and collapses the selection before the command runs.
  document.addEventListener('mousedown', (e) => {
    if (e.target.closest('[data-richtext-cmd]')) e.preventDefault();
  });
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-richtext-cmd]');
    if (!btn) return;
    document.execCommand(btn.dataset.richtextCmd);
  });

  // Toggle state follows the SELECTION, not the click. Ctrl/Cmd+B is
  // native and fires no click, so a click-only sync leaves the button
  // reading "off" while the text is bold — wrong for exactly the users
  // who rely on it. This also covers merely moving the caret into bold
  // text, which no click covers either.
  document.addEventListener('selectionchange', () => {
    const field = document.activeElement?.closest?.('.bo-richtext');
    if (!field) return;
    for (const btn of field.querySelectorAll('[data-richtext-cmd][aria-pressed]'))
      btn.setAttribute('aria-pressed', String(document.queryCommandState(btn.dataset.richtextCmd)));
  });

  // Placeholder. CSS cannot detect an empty contenteditable — :empty stops
  // matching the moment the browser leaves a <br> behind — so emptiness is
  // reported here, in one line, and styled by [data-empty] in CSS.
  document.addEventListener('input', (e) => {
    const el = e.target.closest?.('.bo-richtext__content');
    if (el) el.toggleAttribute('data-empty', !el.textContent.trim());
  });
</script>`;

/* The keyboard map is GENERATED, not written here: extract-keymap.mjs reads
   the @keymap block in richtext.css and emits dist/keymap.json, so this
   dialog cannot drift from what the component actually documents. Rendered
   into the demo string so the preview and its copyable code stay one
   source, per the Demo contract. */
const rtKeys = keymapManifest.components.find((c: any) => c.name === 'bo-richtext');
if (!rtKeys) throw new Error('keymap.json has no bo-richtext entry — did extract-keymap change?');
const kbdify = (combo: string) =>
  combo
    .split('+')
    .map((k) => `<kbd class="bo-kbd">${k.trim()}</kbd>`)
    .join(' + ');
const keymapDialog = `<dialog class="bo-dialog" id="rt-keys" aria-labelledby="rt-keys-title">
  <form method="dialog">
    <header class="bo-dialog__header">
      <h2 class="bo-dialog__title" id="rt-keys-title">Keyboard shortcuts</h2>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" value="cancel" aria-label="Close">✕</button>
    </header>
    <div class="bo-dialog__body">
      <p class="bo-u-text-muted">These come from the browser, not from this
      framework — they work whether or not the toolbar is showing.</p>
      <dl class="bo-kv">
${rtKeys.keys
  .map((k: any) => `        <div><dt>${kbdify(k.key)}</dt><dd>${k.does}</dd></div>`)
  .join('\n')}
      </dl>
    </div>
    <footer class="bo-dialog__footer">
      <button class="bo-btn" value="confirm">Close</button>
    </footer>
  </form>
</dialog>`;
---
<Gallery title="Rich text">
  <p class="demo-note">
    Formatted text in a form — delivery notes, approval comments, return
    instructions: a field-shaped container with a formatting toolbar and
    a content area, plus <code>.bo-prose</code> for displaying stored
    rich content anywhere. The framework ships the <strong>chrome, not
    an editing engine</strong> — see "Why no engine" below.
    <strong>Not for an ordinary note field</strong> — most ERP free-text
    is a plain <code>textarea.bo-input</code> (one class, already styled),
    and reaching for rich text commits you to sanitizing, storing and
    printing HTML forever. Step up only when someone genuinely needs bold,
    lists or links in the stored value; to <em>display</em> a value that is
    already rich, use <a href={base + '/components/prose'}>prose</a>, not a
    disabled editor.
  </p>

  <section class="demo">
    <h2>Basic — the recommended ERP set</h2>
    <Demo code={basic} />
    <p class="bo-u-text-muted"><strong>Five commands: bold, italic, both
    lists, link.</strong> That set covers every real ERP note — delivery
    notes, approval comments, return instructions, dunning text — and
    every one of the five survives a sanitizer allowlist, an export and a
    print form without argument. Everything past it is markup your
    downstream boundaries have to keep honouring, which is why the
    <a href="#advanced">full native surface</a> below is shown as a price
    list rather than a recommendation. Toolbar buttons are plain ghost
    buttons carrying <code>data-richtext-cmd</code>; the Markup section
    has the entire wiring, including the <code>mousedown</code> guard that
    keeps the selection alive. Try bold/italic/lists — or the keyboard
    shortcuts, which work without touching the toolbar at all.</p>
  </section>

  <section class="demo">
    <h2 id="shortcuts">Keyboard shortcuts — you already have them</h2>
    <Demo code={keymapDialog} />
    <p class="bo-u-text-muted"><strong>Every shortcut here is native
    <code>contenteditable</code>, shipped by the browser with zero
    framework JS.</strong> Verified by driving real key events at the
    Basic demo: Ctrl/Cmd&nbsp;+&nbsp;B on a selection produced
    <code>&lt;b&gt;…&lt;/b&gt;</code> with nothing of ours listening.
    <strong>Do not wire your own <code>keydown</code> for these</strong> —
    you would shadow the browser's and give up its edge cases (IME
    composition, undo grouping) for nothing.
    <strong>What DOES need wiring is the toolbar's
    <code>aria-pressed</code>, and it must follow
    <code>selectionchange</code> rather than <code>click</code></strong>:
    a hot key fires no click, so a click-only sync leaves Bold reading
    "off" while the text is bold — wrong for exactly the users who depend
    on it. That was a real defect here until 137.2, and the same fix
    covers merely moving the caret into bold text. The buttons advertise
    their shortcut through <code>title</code> and
    <code>aria-keyshortcuts</code>, and the toolbar's keyboard button
    opens this map. The table is generated from the
    <code>@keymap</code> block in <code>richtext.css</code>, so it cannot
    drift from what the component documents.</p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <caption class="bo-visually-hidden">Rich text keyboard shortcuts</caption>
        <thead><tr><th scope="col">Key</th><th scope="col">Does</th></tr></thead>
        <tbody>
          {rtKeys.keys.map((k: any) => (
            <tr>
              <td class="bo-data-table__col--code">{k.key}</td>
              <td>{k.does}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Hide the toolbar, keep the affordance</h2>
    <Demo code={collapsible} />
    <p class="bo-u-text-muted">A dense form with several note fields
    carries several full toolbars, which is mostly noise. Collapsing
    fixes that — but <strong>the toggle stays visible</strong>, so the
    field still says it is rich. That is deliberate and it is the same
    argument this framework uses to refuse a Notion-style floating
    toolbar: in a <em>form</em>, chrome that appears only once you select
    something hides the fact that the field takes formatting at all. A
    document can afford that; a field a user meets for eight seconds
    cannot. Two-channel as always —
    <code>aria-expanded</code> plus <code>aria-controls</code> on the
    toggle is the programmatic half, the hidden buttons are the visible
    half. The shortcuts keep working while it is collapsed.</p>
  </section>

  <section class="demo">
    <h2>Empty, and invalid</h2>
    <Demo code={empty} />
    <Demo code={invalid} />
    <p class="bo-u-text-muted"><strong>A placeholder needs one line of
    your JS, and the reason is worth knowing.</strong>
    <code>contenteditable</code> has no <code>placeholder</code>
    attribute, and CSS cannot supply one:
    <code>:empty::before</code> works <em>exactly once</em> — it shows on a
    pristine field, then the first type-then-delete leaves a
    <code>&lt;br&gt;</code> behind, <code>:empty</code> stops matching, and
    the hint never returns. <code>&lt;p&gt;&lt;/p&gt;</code>, which
    <code>execCommand</code> produces, never matched at all. Emptiness is a
    property of <em>text content</em> and selectors cannot read text
    content — so the framework styles
    <code>[data-empty]::before</code> and you toggle the attribute on
    <code>input</code>. <strong>Invalid is now on the field itself</strong>:
    until 136.1 <code>.bo-richtext</code> was the only control in the form
    family whose border never reddened, so on a form scanned for red boxes
    it was the box that never turned red. Pair
    <code>aria-invalid</code> with an
    <code>aria-describedby</code> message, as shown.</p>
  </section>

  <section class="demo">
    <h2 id="advanced">Advanced — everything native gives you, and why you want less</h2>
    <Demo code={advanced} />
    <p class="bo-u-text-muted"><strong>Read this as a price list, not a
    recommendation.</strong> Alignment and indentation in a stored ERP
    note are exactly the cost this page's opener warns about: markup that
    must now survive the sanitizer, the export and the print form, spent
    on centring text nobody asked to centre. Ship the
    <a href="#shortcuts">five-command set</a> unless someone can name the
    screen that needs more.</p>
    <p class="bo-u-text-muted">Still zero framework JS: every button here
    is <code>execCommand</code>/<code>queryCommandState</code>, the exact
    pattern Basic uses, extended two ways. <strong>Value-taking
    commands</strong> — H2/H3/quote read the tag from
    <code>data-richtext-value</code> and call
    <code>execCommand('formatBlock', false, tag)</code>; Link prompts for
    a URL and calls <code>createLink</code> with it (Cancel leaves the
    selection untouched). <strong>A mutually-exclusive group</strong> —
    the three align buttons sync <code>aria-pressed</code> across all
    three after every click, not just the one pressed, so at most one
    ever reads "on" (verified live: <code>justifyCenter</code> correctly
    clears Left's and Right's pressed state, not just sets its own).
    <strong>Clear does less than it sounds like</strong> — tested live,
    not assumed: <code>removeFormat</code> strips inline styling
    (bold/italic/alignment) but leaves block elements and links alone —
    a heading stays a heading and a link stays clickable after Clear.
    Removing those needs <code>formatBlock('P')</code>/<code>unlink</code>
    explicitly, which this demo does not wire, matching how little
    "clear formatting" actually promises.</p>
  </section>

  <section class="demo">
    <h2>Read-only and disabled</h2>
    <Demo code={readonly} />
    <Demo code={disabled} />
    <p class="bo-u-text-muted">Read-only mutes the field and hides the
    toolbar but keeps normal text (selectable, copyable); disabled mutes
    text too. Both are two-channel: the visible chrome plus
    <code>contenteditable="false"</code> with
    <code>aria-readonly</code>/<code>aria-disabled</code> in the markup —
    the modifier class alone is only the visible half. Read-only content
    also needs <code>tabindex="0"</code> (shown above): unlike a native
    readonly input, a non-editable div drops out of the tab order, and a
    note longer than the box must stay keyboard-scrollable. Disabled
    toolbars need <code>disabled</code> on the buttons themselves — the
    modifier's <code>pointer-events</code> only stops the mouse, not
    Tab/Enter.</p>
  </section>

  <section class="demo">
    <h2>Displaying stored content</h2>
    <p>Rendering a STORED note (record detail, comments, print) needs
    none of this chrome — that is the standalone
    <a href={base + '/components/prose'}>Prose</a> component: one class
    on a wrapper, native elements inside. Put the same class on
    <code>.bo-richtext__content</code> so content looks identical while
    being edited and when displayed.</p>
  </section>

  <section class="demo">
    <h2>Why no engine — and how to mount a real one</h2>
    <p>Undo stacks, HTML sanitization, and selection models are
    dedicated-library territory; shipping a half-engine would be the
    least-simple surface in this framework (the same reasoning as the
    htmx stance: ready, not coupled). The light case above is genuinely
    native — <code>execCommand</code> plus <code>contenteditable</code>,
    zero framework JS. <strong>Know its two caveats</strong>:
    <code>execCommand</code> is deprecated (it ships in every engine and
    is not going anywhere soon, but it will never be extended), and its
    output HTML varies by engine — bold may come back as
    <code>&lt;b&gt;</code>, <code>&lt;strong&gt;</code>, or a styled
    span, strikethrough as <code>&lt;strike&gt;</code> (verified live in
    this browser — the deprecated tag, not <code>&lt;s&gt;</code>), and
    list nesting differs — so write your server-side sanitizer allowlist
    against all the variants, not the one your dev browser produces. When
    notes outgrow bold/italic/lists (or those caveats
    bite), mount a real editor inside the chrome; the shape for
    ProseMirror-style libraries:</p>
    <pre><code>{`import { EditorState } from "prosemirror-state";
import { EditorView } from "prosemirror-view";
// keep the framework chrome; hand the CONTENT AREA to the engine
const host = document.querySelector(".bo-richtext__content");
host.removeAttribute("contenteditable");   // the engine manages its own
host.removeAttribute("role");              // engine content is structured —
                                           // role="textbox" would flatten it for AT
const view = new EditorView(host, {
  state: EditorState.create({ schema /* your schema + plugins */ }),
});
// your toolbar buttons dispatch the engine's commands instead of execCommand
// SANITIZE ON THE SERVER regardless of editor — stored HTML is untrusted input.`}</code></pre>
  </section>

  <section class="demo">
    <h2>Four things this framework will never wire — bring your own engine</h2>
    <p>The reference screenshot behind this page's own wishlist (roadmap
    113) showed four more toolbar buttons than <code>execCommand</code>
    can honestly support. Each is refused as new framework surface for
    the same reason the engine itself is refused (101.7's PDF/barcode
    precedent) — it is infrastructure or a distinct component, not a CSS
    framework's job — but a reader reaching for one deserves to be routed
    to the rung-4 recipe above, not left thinking rung 3 has a gap:</p>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Image upload</strong> — needs a server endpoint to
      receive the file and a URL to reference it; <code>execCommand
      ('insertImage', false, url)</code> only inserts an already-hosted
      URL. Your upload flow (drag-drop, progress, the endpoint) is
      application code either way; a mounted rung-4 engine's image
      plugin still calls back into it.</li>
      <li><strong>Table insertion</strong> — needs real table-building
      logic (insert/delete row and column, merge, keyboard navigation
      between cells) that no browser command provides. This is exactly
      the "half-engine" this page's own reasoning refuses to ship —
      ProseMirror/TipTap ship a table plugin built for this.</li>
      <li><strong>Checklist</strong> — reads like a list-style variant
      but needs custom list-item STATE (checked/unchecked) that
      <code>insertUnorderedList</code>/<code>insertOrderedList</code>
      have no concept of. A rung-4 engine's schema can define a
      checklist node; native <code>execCommand</code> cannot.</li>
      <li><strong>Color / highlight pickers</strong> — <code>execCommand
      ('foreColor'/'hiliteColor', false, color)</code> genuinely exists
      (verified live — it produces a deprecated <code>&lt;font
      color&gt;</code> tag, one more sanitizer-allowlist variant, same
      class as Bold's <code>&lt;b&gt;</code> and strikethrough's
      <code>&lt;strike&gt;</code> above), but the PICKER UI (swatches, a
      custom-color input, contrast guardrails against this framework's
      own token set) is a component of its own the framework does not
      ship — the command working is not the same as the toolbar control
      existing.</li>
    </ol>
    <p class="bo-u-text-muted">None of the four are demonstrated by a
    real ERP screen in this repo either (102.1's grill finding still
    holds: even <code>.bo-prose</code>'s rung has never been exercised
    against a pattern page) — the 99.4 front door applies if one ever
    is.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{canonical}</code></pre>
  </section>

  <script>
    // Docs-page wiring for the live demos — the same shape as the consumer
    // snippet in the Markup section, plus what the Advanced demo needs
    // (113.1: value-taking commands and the mutually-exclusive justify
    // group) and what 137 added (selection-driven state, placeholder,
    // toolbar collapse).
    import { initDialogs } from '@busy-office/ui/js';
    initDialogs(); // the keyboard-map dialog — data-dialog-trigger, no new JS

    document.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('[data-richtext-cmd]')) e.preventDefault();
    });

    // Every toggle in a field re-reads its own state. Called from
    // selectionchange (below) rather than from click, so a NATIVE hot key
    // and a plain caret move both keep the toolbar honest — a click-only
    // sync left Bold reading "off" while the text was bold (137.2).
    const syncField = (field: Element) => {
      for (const b of field.querySelectorAll<HTMLElement>('[data-richtext-cmd][aria-pressed]'))
        b.setAttribute('aria-pressed', String(document.queryCommandState(b.dataset.richtextCmd!)));
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-richtext-cmd]');
      if (!btn) return;
      const cmd = btn.dataset.richtextCmd!;
      let value = btn.dataset.richtextValue ?? '';
      if (cmd === 'createLink') {
        const url = prompt('Link URL:');
        if (!url) return;               // cancelled — leave the selection untouched
        value = url;
      }
      document.execCommand(cmd, false, value);
      const field = btn.closest('.bo-richtext');
      // The justify group is mutually exclusive, so the whole field is
      // re-read rather than just the button pressed — otherwise two read
      // "pressed" at once.
      if (field) syncField(field);
      else if (btn.hasAttribute('aria-pressed'))
        btn.setAttribute('aria-pressed', String(document.queryCommandState(cmd)));
    });

    document.addEventListener('selectionchange', () => {
      const field = (document.activeElement as HTMLElement)?.closest?.('.bo-richtext');
      if (field) syncField(field);
    });

    // Placeholder: CSS cannot detect an empty contenteditable (:empty stops
    // matching once the browser leaves a <br>), so emptiness is reported
    // here and styled by [data-empty].
    document.addEventListener('input', (e) => {
      const el = (e.target as HTMLElement).closest?.('.bo-richtext__content');
      if (el) el.toggleAttribute('data-empty', !el.textContent?.trim());
    });

    // Collapse: one line of state, both channels moved together.
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-richtext-toggle]');
      if (!t) return;
      const open = t.getAttribute('aria-expanded') !== 'true';
      t.setAttribute('aria-expanded', String(open));
      t.innerHTML = open ? '&minus;' : '+';
      const label = open ? 'Hide formatting toolbar' : 'Show formatting toolbar';
      t.setAttribute('aria-label', label);
      t.setAttribute('title', label);
    });
  </script>

