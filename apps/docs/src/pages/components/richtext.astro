        <label class="bo-segmented__option" for="rt-a-center" title="Align centre"><span class="bo-icon bo-icon--align-center" aria-hidden="true"></span><span class="bo-visually-hidden">Align centre</span></label>
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="rt-align" id="rt-a-right"
                 data-richtext-cmd="justifyRight">
        <label class="bo-segmented__option" for="rt-a-right" title="Align right"><span class="bo-icon bo-icon--align-right" aria-hidden="true"></span><span class="bo-visually-hidden">Align right</span></label>
      </div>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Indent">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="outdent"
            aria-label="Decrease indent" title="Decrease indent"><span class="bo-icon bo-icon--outdent" aria-hidden="true"></span></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="indent"
            aria-label="Increase indent" title="Increase indent"><span class="bo-icon bo-icon--indent" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Lists">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertOrderedList"
            aria-label="Numbered list" title="Numbered list"><span class="bo-icon bo-icon--list-numbered" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Insert">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="createLink"
