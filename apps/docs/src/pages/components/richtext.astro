---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
import keymapManifest from '@busy-office/ui/keymap';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const basic = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <div class="bo-richtext__group" role="group" aria-label="Text style">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="bold" aria-pressed="false"
              title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="italic" aria-pressed="false"
              title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Lists">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertUnorderedList"
              aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertOrderedList"
              aria-label="Numbered list" title="Numbered list"><span class="bo-icon bo-icon--list-numbered" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Insert">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="createLink"
              aria-label="Link" title="Link"><span class="bo-icon bo-icon--link" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Help">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-dialog-trigger="rt-keys"
              aria-label="Keyboard shortcuts" title="Keyboard shortcuts"><span class="bo-icon bo-icon--keyboard" aria-hidden="true"></span></button>
    </div>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true"
       role="textbox" aria-multiline="true" aria-label="Delivery notes"
       data-placeholder="Add a note — what arrived, and in what condition.">
    <p>Pallet 2 arrived <strong>damp on one corner</strong> — photos attached
    to the receipt. Count verified against the ASN.</p>
  </div>
</div>`;

const empty = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true" data-empty
       role="textbox" aria-multiline="true" aria-label="Rejection reason"
       data-placeholder="Why is this being rejected?"></div>
</div>`;

const invalid = `<div class="bo-form-field">
  <label class="bo-form-field__label" for="rt-reason">Rejection reason</label>
  <div class="bo-richtext">
    <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="bold" aria-pressed="false"
              title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    </div>
    <div class="bo-richtext__content bo-prose" contenteditable="true" id="rt-reason" data-empty
         role="textbox" aria-multiline="true" aria-label="Rejection reason"
         aria-invalid="true" aria-describedby="rt-reason-err"
         data-placeholder="Why is this being rejected?"></div>
  </div>
  <p class="bo-form-field__message" id="rt-reason-err">A reason is required to reject.</p>
</div>`;

const collapsible = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar-collapse" id="rt-collapse-bar">
    <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertUnorderedList"
              aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
    </div>
  </div>
  <button class="bo-btn bo-btn--ghost bo-btn--icon bo-richtext__toolbar-toggle" type="button"
          data-richtext-toggle aria-expanded="true" aria-controls="rt-collapse-bar"
          aria-label="Hide formatting toolbar (Alt + Shift + T)"
          title="Hide formatting toolbar (Alt + Shift + T)"
          aria-keyshortcuts="Alt+Shift+T"><span class="bo-icon bo-icon--format" aria-hidden="true"></span></button>
  <div class="bo-richtext__content bo-prose" contenteditable="true"
       role="textbox" aria-multiline="true" aria-label="Internal note"
       data-placeholder="Internal note…">
    <p>Customer called about the short-shipped hose assembly.</p>
  </div>
</div>`;

const lists = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertUnorderedList"
            aria-label="Bulleted list" title="Bulleted list"><span class="bo-icon bo-icon--list-bullet" aria-hidden="true"></span></button>
    <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="insertOrderedList"
            aria-label="Numbered list" title="Numbered list"><span class="bo-icon bo-icon--list-numbered" aria-hidden="true"></span></button>
  </div>
  <div class="bo-richtext__content bo-prose" contenteditable="true" data-empty
       role="textbox" aria-multiline="true" aria-label="Return instructions"
       data-placeholder="Type &quot;- &quot;, &quot;1. &quot; or &quot;5. &quot; to start a list, then Tab to nest…"></div>
</div>`;

const advanced = `<div class="bo-richtext">
  <div class="bo-richtext__toolbar" role="group" aria-label="Formatting">
    <div class="bo-richtext__group" role="group" aria-label="Text style">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="bold" aria-pressed="false"
            title="Bold (Ctrl/Cmd + B)" aria-keyshortcuts="Control+B Meta+B"><strong>B</strong></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="italic" aria-pressed="false"
            title="Italic (Ctrl/Cmd + I)" aria-keyshortcuts="Control+I Meta+I"><em>I</em></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="strikeThrough" aria-pressed="false"
            title="Strikethrough"><s>S</s></button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="removeFormat"
            aria-label="Clear formatting" title="Clear formatting"><span class="bo-icon bo-icon--clear-format" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Block format">
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="formatBlock" data-richtext-value="H2">H2</button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="formatBlock" data-richtext-value="H3">H3</button>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" data-richtext-cmd="formatBlock" data-richtext-value="BLOCKQUOTE"
            aria-label="Blockquote" title="Blockquote"><span class="bo-icon bo-icon--quote" aria-hidden="true"></span></button>
    </div>
    <div class="bo-richtext__group" role="group" aria-label="Alignment">
      <div class="bo-segmented">
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="rt-align" id="rt-a-left"
                 data-richtext-cmd="justifyLeft" checked>
        <label class="bo-segmented__option" for="rt-a-left" title="Align left"><span class="bo-icon bo-icon--align-left" aria-hidden="true"></span><span class="bo-visually-hidden">Align left</span></label>
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="rt-align" id="rt-a-center"
