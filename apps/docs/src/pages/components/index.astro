---
/**
 * The component catalogue (roadmap 249.9) — the section's front door, the same
 * role `patterns/index.astro` plays for patterns.
 *
 * EVERY FIELD ON EVERY CARD IS GENERATED. Nothing here is hand-typed:
 *   name, tagline, category   api.json  (meta.tagline / meta.category, 249.8)
 *   JS status                 behaviors.json byComponent  (0.8.0's `serves`)
 *   CSS floor                 floor.json perComponent      (249.3)
 *   DSA score + date          dsa-scores.json              (249.3)
 * A card whose data is missing renders the ABSENCE and says so, per 249.3's
 * standing rule that an absence is rendered and never left blank.
 *
 * NO MINIATURES, and this is the item's own open question answered with the
 * measurement it asked for. 249.9 proposed a build-time screenshot per card
 * via `browser-harness.mjs`. Measured before deciding, rendering the first
 * demo section of five real component pages at 640px:
 *
 *   launch 781ms · 1,006ms per component · ~40s for 40
 *   29 kB per PNG · ~1.1 MB for 40
 *
 * 1.1 MB is roughly TWELVE TIMES the whole framework's 93 kB minified, carried
 * in the repo and shipped in `dist`, to show a still picture of a demo that is
 * live, interactive and one click away on the card's own link. That is
 * re-photographing — the same thing the pattern recipe already refuses when it
 * bars per-domain demo variants — so the miniature is refused and the card
 * links to the living thing instead. The cost is written here rather than in a
 * commit message because it is the reason the design looks like this.
 */
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import api from '@busy-office/ui/api';
import behaviors from '@busy-office/ui/behaviors-manifest';
import floor from '@busy-office/ui/floor.json';
import dsa from '../../data/dsa-scores.json';
import { COMPONENT_GROUPS } from '../../data/component-nav.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* One card's worth of facts, joined from the four generated sources. Every
   lookup is defensive in the same direction: a miss renders a stated absence,
   never an empty cell that reads as "nothing to say". */
/* PAGE SLUG IS NOT THE CSS DIRECTORY NAME, and assuming it was cost two cards
   their whole data set on the first render: `/components/alerts` is the CSS
   dir `alert`, and `/components/state-patterns` is `state` (and `skeleton`).
   `api.json` ships the `pageSlug` map for exactly this, so it is inverted here
   rather than special-cased — CLAUDE.md's rule that names come from the
   generated source, never from a convention. */
const cssDirFor: Record<string, string> = Object.fromEntries(
  Object.entries((api as any).pageSlug ?? {}).map(([dir, page]) => [page as string, dir]),
);

function card(item: any) {
  const pageSlug = item.href.split('/').pop().split('#')[0];
  const slug = cssDirFor[pageSlug] ?? pageSlug;
  const meta = api.components?.[slug]?.meta ?? {};
  const inits: string[] = (behaviors as any).byComponent?.[slug] ?? [];
  const per = (floor as any).perComponent?.[slug];
  const score = (dsa as any).components?.[slug];

  const dims = score?.dimensions ?? {};
  const scored = Object.values(dims).filter((d: any) => typeof d?.score === 'number') as any[];
  const total = scored.reduce((a, d) => a + d.score, 0);

  return {
    anchorOnly: !api.components?.[slug],
    slug: pageSlug,
    label: item.label ?? meta.label ?? slug,
    tagline: meta.tagline ?? null,
    inits,
    floorLabel: per?.label ?? null,
    dsa: scored.length ? { total, max: scored.length * 3, when: score.scored } : null,
  };
}

const groups = COMPONENT_GROUPS.map((g: any) => ({ label: g.label, cards: g.items.map(card) }));
const total = groups.reduce((n: number, g: any) => n + g.cards.length, 0);
---
<Gallery
  title="Components"
  description="Every component this framework ships, with what it is for, whether it needs JavaScript, the browser floor of its own stylesheet, and its design-system score."
>
  <p class="demo-note">
    Every component in the framework — <strong>{total}</strong> of them — with
    the facts you need before opening one: what it is for, whether it works
    without JavaScript, the browser floor of <em>its own</em> stylesheet rather
    than the framework's, and its design-system score. Each card links to the
    live component page, where the thing actually renders.
    <strong>Not a gallery of screenshots</strong> — a still picture of a demo
    that is live one click away earns nothing, so the cards carry facts and the
    page carries the link.
  </p>

  {groups.map((g: any) => (
    <section class="demo">
      <h2>{g.label}</h2>
      <div class="bo-widget-grid" style="--bo-widget-min: 20rem">
        {g.cards.map((c: any) => (
          <div class="bo-widget">
            <div class="bo-widget__header">
              <span class="bo-widget__title">
                <a href={base + '/components/' + c.slug}>{c.label} →</a>
              </span>
            </div>
            <div class="bo-widget__body">
              <p class="bo-u-text-muted">{c.tagline ?? (c.anchorOnly ? 'A section of another component\u2019s page \u2014 no stylesheet of its own.' : 'No tagline in its CSS header yet.')}</p>
              {/* Two badges carry the decisions a reader makes FROM this card —
                  does it need JS, and how well is it scored. The floor is a
                  fact you check rather than scan, so it sits as muted text
                  below: three heavy badges per card made the grid unreadable
                  and pushed it to two columns. */}
              <div class="bo-cluster" style="--bo-cluster-gap: var(--bo-space-2); margin-block-start: var(--bo-space-3)">
                {c.inits.length === 0
                  ? <span class="bo-badge bo-badge--success">CSS only</span>
                  : <span class="bo-badge">Needs JS</span>}
                {c.dsa
                  ? <span class="bo-badge bo-badge--type">DSA {c.dsa.total}/{c.dsa.max}</span>
                  : <span class="bo-badge bo-badge--type">not scored</span>}
              </div>
              <p class="bo-u-text-muted" style="font-size: var(--bo-font-size-xs); margin-block-start: var(--bo-space-2)">
                {c.floorLabel ?? 'floor not derived'}
                {c.inits.length > 0 && <> · <code>{c.inits.join('()  ')}()</code></>}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <Related links={[
    ['/patterns/', 'Patterns — the assembled screens'],
    ['/getting-started/installation', 'Installation'],
    ['/reference/classes', 'Every class, generated'],
  ]} />
</Gallery>
