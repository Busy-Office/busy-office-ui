---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import Demo from '../../components/Demo.astro';
const tones = `<span class="bo-badge">Neutral</span>
<span class="bo-badge bo-badge--success">Approved</span>
<span class="bo-badge bo-badge--warning">Pending</span>
<span class="bo-badge bo-badge--danger">Rejected</span>
<span class="bo-badge bo-badge--accent">In review</span>`;
const typeChip = `<span class="bo-badge bo-badge--type">Purchase Order #4021</span>
<span class="bo-badge bo-badge--type">Invoice</span>
<span class="bo-badge bo-badge--type">Change Request</span>`;
---
<Gallery title="Badge">
  <p class="demo-note">
    Status badges for approval states and document statuses. The bare
    <code>.bo-badge</code> is the neutral tone. Foregrounds use the
    <code>--bo-color-*-text</code> tokens, which remap in dark mode to stay AA.
    A badge is decoration for sighted users — the status text itself is the
    accessible signal, so never encode status as color alone.
  </p>
  <section class="demo">
    <h2>Tones</h2>
    <Demo code={tones} layout="row" />
  </section>
  <section class="demo">
    <h2><code>--type</code> — record-type chip</h2>
    <p>An inverted-surface tag naming the record a card holds. A rectangle, not a
    pill; auto-inverts in dark mode.</p>
    <Demo code={typeChip} layout="row" />
  </section>
  <section class="demo">
    <h2>In a table — the number-one placement</h2>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 28rem">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Invoice #</th><th scope="col" class="bo-data-table__col--numeric">Amount</th><th scope="col">Status</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">INV-10234</td><td class="bo-data-table__col--numeric">$4,208.00</td><td><span class="bo-badge bo-badge--warning">Pending</span></td></tr>
          <tr><td class="bo-data-table__col--code">INV-10235</td><td class="bo-data-table__col--numeric">$18,940.50</td><td><span class="bo-badge bo-badge--success">Approved</span></td></tr>
          <tr><td class="bo-data-table__col--code">INV-10236</td><td class="bo-data-table__col--numeric">$730.25</td><td><span class="bo-badge bo-badge--danger">Rejected</span></td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">A status column of badges next to numeric cells —
    where badges actually live in an ERP. The tone word IS the text, so the meaning
    never depends on the hue alone.</p>
  </section>
  <ClassRef component="badge" />
  <ApiTable component="badge"
    notes={['A badge is decoration — the status TEXT is the accessible signal; never encode status as color alone.']} />
  <Related links={[["/concepts/accessibility", "Accessibility model"], ["/components/data-table", "Data table"]]} />
</Gallery>
