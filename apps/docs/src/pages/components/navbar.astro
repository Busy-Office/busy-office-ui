---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navbarMarkup = `<header class="bo-navbar bo-app-shell__header">
  <span class="bo-navbar__brand">busy-office ERP</span>
  <span class="bo-badge bo-badge--accent">UAT</span>
  <span class="bo-navbar__spacer"></span>   <!-- pushes what follows to the end -->
  <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Notifications">🔔</button>
</header>`;
---
<Gallery title="Navbar">
  <p class="demo-note">
    The application header: brand, environment marker, and the actions
    that belong to the whole app rather than the current screen. This
    page's own header is the live demo.
  </p>

  <section class="demo">
    <h2>Brand, spacer, actions</h2>
    <header class="bo-navbar" style="border: 1px solid var(--bo-color-border-default); border-radius: var(--bo-radius-md)">
      <span class="bo-navbar__brand">busy-office ERP</span>
      <span class="bo-badge bo-badge--accent">UAT</span>
      <span class="bo-navbar__spacer"></span>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Notifications">🔔</button>
    </header>
    <p class="bo-u-text-muted">One spacer element does the layout —
    everything before it sits at the start, everything after at the end.
    An environment badge (UAT, SANDBOX) next to the brand is the cheapest
    guard against someone approving a real invoice in a test system.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{navbarMarkup}</code></pre>
  </section>

  <ClassRef component="navbar" />
  <ApiTable component="navbar" notes={[
    'Use a real <code>&lt;header&gt;</code>; inside the app shell add <code>.bo-app-shell__header</code> so it takes the shell grid slot.',
    'The navbar is app-level. Screen-level actions belong in the page or the data-table toolbar, not up here.',
    'Icon-only buttons need an <code>aria-label</code> — the icon is decoration.',
  ]} />
  <DsaScore component="navbar" />
  <Related links={[
    ['/components/sidebar-nav', 'Sidebar navigation'],
    ['/components/breadcrumb', 'Breadcrumb'],
    ['/base/primitives', 'App shell'],
  ]} />
</Gallery>
