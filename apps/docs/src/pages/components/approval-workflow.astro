---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import Demo from '../../components/Demo.astro';
import DsaScore from '../../components/DsaScore.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const auditMarkup = `<ol class="bo-audit" role="list">
  <li class="bo-audit__entry">
    <time class="bo-audit__time" datetime="2026-08-10T15:02">08-10 15:02</time>
    <span><span class="bo-audit__actor">J. Kim</span> approved</span>
    <span class="bo-audit__detail">"Within Q3 budget."</span>
  </li>
</ol>
<!-- Grid-aligned: the time column self-sizes; details land in the content
     column automatically — no width tuning when formats change. -->`;
const discussionMarkup = `<!-- Same list, different kind of entry. --discussion says the
     detail IS the content, so it keeps body size and primary ink. -->
<ol class="bo-audit bo-audit--discussion" role="list">
  <li class="bo-audit__entry">
    <time class="bo-audit__time" datetime="2026-08-20T09:12">08-20 09:12</time>
    <div class="bo-audit__detail">
      <span class="bo-byline"><strong>M. Osei</strong> \u00b7 Requester</span>
      <div class="bo-prose"><p>Vendor confirmed a 3-week lead time on the coupling.
      Asked whether we split the line and take 40 now.</p></div>
    </div>
  </li>
  <li class="bo-audit__entry">
    <time class="bo-audit__time" datetime="2026-08-20T11:40">08-20 11:40</time>
    <div class="bo-audit__detail">
      <span class="bo-byline"><strong>J. Kim</strong> \u00b7 Cost-centre manager</span>
      <div class="bo-prose"><p>Split it \u2014 budget is committed either way and the
      line stoppage costs more than a second delivery.</p></div>
    </div>
  </li>
</ol>`;

const collabMarkup = `<!-- Internal is the default: no attribute, no edge. -->
<ol class="bo-audit bo-audit--discussion" role="list">
  <li class="bo-audit__entry" data-state="resolved">
    <time class="bo-audit__time" datetime="2026-08-21T08:05">08-21 08:05</time>
    <div class="bo-audit__detail">
      <span class="bo-byline"><strong>M. Osei</strong> \u00b7 Requester</span>
      <span class="bo-badge">Resolved</span>
      <div class="bo-prose"><p>Split raised as PO-88240 for the balance.</p></div>
    </div>
  </li>
  <li class="bo-audit__entry" data-visibility="external">
    <time class="bo-audit__time" datetime="2026-08-21T09:30">08-21 09:30</time>
    <div class="bo-audit__detail">
      <span class="bo-byline"><strong>M. Osei</strong> \u00b7 Requester</span>
      <span class="bo-badge bo-badge--warning">External \u00b7 sent to vendor</span>
      <div class="bo-prose"><p>Please confirm the revised delivery date for the
      40-unit first drop.</p></div>
    </div>
  </li>
</ol>

<!-- The COMPOSER carries it too, which is the point: you can see where the
     words go while you are writing them, not after. -->
<form class="bo-composer" data-visibility="external">
  <span class="bo-avatar bo-byline__avatar" aria-hidden="true">MO</span>
  <div class="bo-composer__body">
    <span class="bo-badge bo-badge--warning">External \u00b7 goes to the vendor</span>
    <label class="bo-visually-hidden" for="c-ext">Message to vendor</label>
    <textarea class="bo-input" id="c-ext" rows="2"></textarea>
    <div class="bo-composer__actions">
      <button class="bo-btn bo-btn--sm" type="button">Send to vendor</button>
    </div>
  </div>
</form>`;

const composerMarkup = `<form class="bo-composer">
  <span class="bo-avatar bo-byline__avatar" aria-hidden="true">RV</span>
  <div class="bo-composer__body">
    <textarea class="bo-input" rows="2"
              placeholder="Add a comment…" aria-label="Comment"></textarea>
    <div class="bo-composer__actions">
      <button class="bo-btn bo-btn--sm bo-btn--secondary" type="reset">Cancel</button>
      <button class="bo-btn bo-btn--sm" type="submit">Comment</button>
    </div>
  </div>
</form>
<!-- Submit posts a new .bo-audit__entry — your form handler's job, server or JS. -->`;
---
<Gallery title="Timeline & audit trail" description="A status timeline and a chronological audit trail for approval chains, with every state reaching assistive technology as text rather than colour alone.">
  <p class="demo-note">
    The approval-workflow pair: a status timeline (done / current / pending /
    rejected) and a chronological audit trail. Two-channel state throughout —
    glyphs are aria-hidden, state reaches AT via visually-hidden text and
    <code>aria-current</code>. Composed example:
    <a href={base + '/patterns/approval'}>the approval-workflow pattern</a>.
    <strong>Not for a flow the user is walking right now</strong> — a timeline
    reports history and status; use
    <a href={base + '/components/stepper'}>Stepper</a> when the point is which
    step they are on and what comes next.
  </p>
  <section class="demo">
    <h2>Timeline states</h2>
    <ol class="bo-timeline" role="list" style="max-inline-size: 24rem">
      <li class="bo-timeline__step" data-state="done">
        <span class="bo-timeline__marker" aria-hidden="true">✓</span>
        <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Completed: </span>Submitted</div><div class="bo-timeline__meta">R. Vance · <time datetime="2026-08-10T09:14">2026-08-10 09:14</time></div></div>
      </li>
      <li class="bo-timeline__step" data-state="current" aria-current="step">
        <span class="bo-timeline__marker" aria-hidden="true">●</span>
        <div><div class="bo-timeline__title">Cost-center approval</div><div class="bo-timeline__meta">waiting · 2 days</div></div>
      </li>
      <li class="bo-timeline__step" data-state="rejected">
        <span class="bo-timeline__marker" aria-hidden="true">✕</span>
        <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Rejected: </span>Finance release</div><div class="bo-timeline__meta">budget hold</div></div>
      </li>
      <li class="bo-timeline__step" data-state="pending">
        <span class="bo-timeline__marker" aria-hidden="true">4</span>
        <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Not started: </span>Archive</div></div>
      </li>
    </ol>
    <pre><code>{`<ol class="bo-timeline" role="list">
  <li class="bo-timeline__step" data-state="done">
    <span class="bo-timeline__marker" aria-hidden="true">✓</span>
    <div>
      <div class="bo-timeline__title"><span class="bo-visually-hidden">Completed: </span>Submitted</div>
      <div class="bo-timeline__meta">R. Vance · <time datetime="2026-08-10T09:14">2026-08-10 09:14</time></div>
    </div>
  </li>
  <li class="bo-timeline__step" data-state="current" aria-current="step">
    <span class="bo-timeline__marker" aria-hidden="true">●</span>
    <div><div class="bo-timeline__title">Cost-center approval</div></div>
  </li>
  <li class="bo-timeline__step" data-state="rejected">
    <span class="bo-timeline__marker" aria-hidden="true">✕</span>
    <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Rejected: </span>Finance release</div></div>
  </li>
  <li class="bo-timeline__step" data-state="pending">
    <span class="bo-timeline__marker" aria-hidden="true">4</span>
    <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Not started: </span>Archive</div></div>
  </li>
</ol>
<!-- Two-channel per state: the marker glyph + tint is one channel; the
     visually-hidden "Completed:/Rejected:/Not started:" prefix (and
     aria-current on the active step) is the announced one. -->`}</code></pre>
  </section>
  <section class="demo">
    <h2>Audit trail</h2>
    <ol class="bo-audit" role="list" style="max-inline-size: 28rem">
      <li class="bo-audit__entry">
        <time class="bo-audit__time" datetime="2026-08-10T09:14">08-10 09:14</time>
        <span><span class="bo-audit__actor">R. Vance</span> submitted PO-88213</span>
      </li>
      <li class="bo-audit__entry">
        <time class="bo-audit__time" datetime="2026-08-10T15:02">08-10 15:02</time>
        <span><span class="bo-audit__actor">J. Kim</span> approved</span>
        <span class="bo-audit__detail">"Within Q3 budget."</span>
      </li>
    </ol>
  </section>
  <section class="demo">
    <h2>Rejected → resubmitted — the real approval loop</h2>
    <ol class="bo-audit" role="list" style="max-inline-size: 28rem">
      <li class="bo-audit__entry">
        <time class="bo-audit__time" datetime="2026-08-11T10:20">08-11 10:20</time>
        <span><span class="bo-audit__actor">M. Osei</span> rejected</span>
        <span class="bo-audit__detail">"Wrong cost center — should be CC-2205, not CC-4021."</span>
      </li>
      <li class="bo-audit__entry">
        <time class="bo-audit__time" datetime="2026-08-11T11:05">08-11 11:05</time>
        <span><span class="bo-audit__actor">R. Vance</span> updated cost center and resubmitted</span>
      </li>
      <li class="bo-audit__entry">
        <time class="bo-audit__time" datetime="2026-08-11T14:41">08-11 14:41</time>
        <span><span class="bo-audit__actor">M. Osei</span> approved</span>
      </li>
    </ol>
    <p class="bo-u-text-muted">The loop every ERP actually runs: rejection with a
    reason in <code>__detail</code>, a fix, a resubmit. In the paired timeline the
    step flips <code>data-state="rejected"</code> → back to
    <code>current</code> on resubmit — the audit trail keeps the full history while
    the timeline shows only the present.</p>
  </section>
  <section class="demo">
    <h2><code>--discussion</code> — a comment thread</h2>
    <p class="bo-u-text-muted">
      A discussion is the same list carrying a different kind of entry, so it is
      a <em>setting</em>, not a second component. An audit trail's
      <code>__detail</code> is small print <em>about</em> a record; a comment is
      the content itself. Composing a thread without this modifier rendered the
      message at 12px underneath a 13px byline — the metadata outranking the
      thing it introduces — so <code>--discussion</code> returns the detail to
      body size and primary ink. Everything else is already shared: the time
      column, <a href={base + '/components/byline'}>Byline</a> for the author,
      <code>.bo-composer</code> below to write one.
    </p>
    <Demo code={discussionMarkup} />
    <p class="bo-u-text-muted">Use it for approval notes, chasing history and
    handover threads. It is a <strong>flat</strong> thread on purpose — no
    nesting, no replies-to-replies, no left/right bubbles. Those are messaging-app
    shapes; an ERP discussion hangs off a record and reads in one order.</p>
  </section>
  <section class="demo">
    <h2>Collaborating — who can see this, and what is settled</h2>
    <p class="bo-u-text-muted">
      A thread people <em>act on</em> needs two things a thread people only read
      does not. <code>data-visibility="external"</code> marks a comment that
      leaves the building, and <code>data-state="resolved"</code> marks a
      question that is settled.
    </p>
    <Demo code={collabMarkup} />
    <p class="bo-u-text-muted">
      <strong>Internal is the default</strong> — no attribute, no edge. Getting
      the hook wrong then means a message that should have gone out stayed in,
      which someone chases; the reverse is unrecoverable, which is why the
      dangerous direction is the one you have to type.
    </p>
    <p class="bo-u-text-muted">
      <strong>The edge is geometry, and the badge is the other channel.</strong>
      The stripe survives forced-colors and a monochrome print, but a stripe
      alone tells a screen-reader user nothing — so name the audience in a
      badge, as above. That is your text to write: "External \u00b7 sent to
      vendor" is useful, "External" on its own is not.
    </p>
    <p class="bo-u-text-muted">
      <strong>Why the composer carries it as well.</strong> Every ERP we
      measured against puts this on a small tab pair <em>above</em> an otherwise
      identical box — so the surface you are looking at while you type is the
      one thing that never says where the words are going, and a mis-click is a
      broadcast. Marking the composer means the answer is in front of you at the
      moment it matters. <strong>Not a permission check</strong>: this is a
      signal, and the server still decides who may post what.
    </p>
    <p class="bo-u-text-muted">
      Resolved returns the comment to the audit trail's own treatment, because
      that is what it now is — history. Only a <code>--discussion</code>
      resolves; an audit entry is immutable by definition.
      <strong>A visible "Resolved" marker is required, not optional</strong> —
      measured under <code>forced-colors: active</code>, the UA repaints both
      inks to the same black, so the ink difference is the whole signal in
      normal use and <em>no</em> signal there. The external edge is geometry
      and survives; this state has no non-colour channel of its own, so the
      marker is it.
    </p>
  </section>
  <section class="demo">
    <h2><code>.bo-composer</code> — writing a new entry</h2>
    <p class="bo-u-text-muted">
      How a new <code>.bo-audit</code> entry gets written, not just read. Layout
      only: an avatar (<code>.bo-byline__avatar</code>, composed — not
      duplicated) + a plain <code>.bo-input</code> textarea + an actions row.
    </p>
    <form class="bo-composer" style="max-inline-size: 28rem" onsubmit="return false">
      <span class="bo-avatar bo-byline__avatar" aria-hidden="true">RV</span>
      <div class="bo-composer__body">
        <textarea class="bo-input" rows="2"
                  placeholder="Add a comment…" aria-label="Comment"></textarea>
        <div class="bo-composer__actions">
          <button class="bo-btn bo-btn--sm bo-btn--secondary" type="reset">Cancel</button>
          <button class="bo-btn bo-btn--sm" type="submit">Comment</button>
        </div>
      </div>
    </form>
    <pre><code>{composerMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Markup — audit entry</h2>
    <pre><code>{auditMarkup}</code></pre>
  </section>
  <ClassRef component="approval-workflow" />
  <ApiTable component="approval-workflow"
    notes={['State text pattern is mandatory: <code>Completed:</code> / <code>Rejected:</code> / <code>Not started:</code> visually-hidden in the title — done vs rejected must be distinguishable non-visually.',
            'Use <code>&lt;time datetime&gt;</code> for audit timestamps.',
            'Markers are fixed-size status graphics (not controls) — they deliberately ignore density.',
            '<code>.bo-composer</code> is layout only — the textarea is a plain <code>.bo-input</code>, the avatar is <code>.bo-byline__avatar</code>; submit handling (posting a new <code>.bo-audit__entry</code>) is your form handler.']} />
  <DsaScore component="approval-workflow" />
  <Related links={[["/concepts/accessibility", "Accessibility model"], ["/patterns/approval", "Approval pattern"], ["/components/stepper", "Stepper"], ["/components/byline", "Byline"]]} />
</Gallery>
