---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const toastMarkup = `<!-- Region ships in your layout ONCE, before any toast exists,
     so injected toasts are announced: -->
<div class="bo-toast-region" role="status" aria-live="polite"></div>

<!-- Server/HTMX/JS injects: -->
<div class="bo-alert bo-alert--success bo-toast">
  <div><span class="bo-alert__title">Saved.</span> PO-88213 was approved.</div>
  <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss"
          aria-label="Dismiss">✕</button>
</div>`;
---
<Gallery title="Alerts & toasts">
  <p class="demo-note">
    Inline alerts use <code>role="alert"</code> (errors) or <code>role="status"</code>.
    Toasts are alerts injected into a persistent <code>aria-live</code> region — the
    region must exist before the first toast, or nothing is announced.
  </p>
  <ClassRef component="alert" />
  <section class="demo">
    <h2>Inline alerts</h2>
    <div class="bo-alert" role="status">
      <div><span class="bo-alert__title">Heads up.</span> Approvals sync runs at 18:00.</div>
    </div>
    <div class="bo-alert bo-alert--success" role="status">
      <div><span class="bo-alert__title">Saved.</span> All changes stored.</div>
    </div>
    <div class="bo-alert bo-alert--warning" role="status">
      <div><span class="bo-alert__title">Budget at 92%.</span> CC-4021 nears its limit.</div>
    </div>
    <div class="bo-alert bo-alert--danger" role="alert">
      <div><span class="bo-alert__title">Posting failed.</span> Period 2026-07 is closed.</div>
      <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
    </div>
  </section>
  <section class="demo">
    <h2>Toast recipe</h2>
    <p class="bo-u-text-muted">Toasts are ephemeral, so the sample is a trigger, not a
    static block — click it to see the real thing render, dismiss, and go away.</p>
    <button class="bo-btn bo-btn--secondary" type="button" id="toast-demo-trigger">Show toast</button>
    <div class="bo-toast-region" id="toast-demo-region" role="status" aria-live="polite"></div>
    <pre><code>{toastMarkup}</code></pre>
    <p class="bo-u-text-muted">Dismiss buttons work via <code>initAlerts()</code>
    (document delegation — injected toasts covered automatically). If you auto-dismiss,
    keep toasts visible ≥ 5s and pause the timer on hover/focus (WCAG 2.2.1). Toasts do
    <strong>not</strong> float above an open modal dialog (the dialog owns the top
    layer) — render confirmations inside the dialog instead.</p>
  </section>
  <script>
    import { initAlerts } from '@busy-office/ui/js';
    initAlerts();
    document.getElementById('toast-demo-trigger')?.addEventListener('click', () => {
      const region = document.getElementById('toast-demo-region')!;
      region.insertAdjacentHTML(
        'beforeend',
        `<div class="bo-alert bo-alert--success bo-toast">
          <div><span class="bo-alert__title">Saved.</span> PO-88213 was approved.</div>
          <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
        </div>`,
      );
    });
  </script>
  <ApiTable component="alert"
    js="Optional: initAlerts() — dismiss buttons remove their alert/toast (delegation covers injected toasts)."
    notes={['Inline alerts: <code>role="alert"</code> for errors, <code>role="status"</code> otherwise.',
            'The toast region must exist (with <code>aria-live</code>) BEFORE the first toast is injected.',
            'Toasts do not float above an open modal dialog (top layer).']} />
  <Related links={[["/concepts/js-behaviors", "JS behaviors"], ["/getting-started/htmx", "Using with HTMX"]]} />
</Gallery>
