---
import Gallery from '../../layouts/Gallery.astro';
const toastMarkup = `<!-- Region ships in your layout ONCE, before any toast exists,
     so injected toasts are announced: -->
<div class="eof-toast-region" role="status" aria-live="polite"></div>

<!-- Server/HTMX/JS injects: -->
<div class="eof-alert eof-alert--success eof-toast">
  <div><span class="eof-alert__title">Saved.</span> PO-88213 was approved.</div>
  <button class="eof-btn eof-btn--ghost eof-btn--icon eof-alert__dismiss"
          aria-label="Dismiss">✕</button>
</div>`;
---
<Gallery title="Alerts & toasts">
  <p class="demo-note">
    Inline alerts use <code>role="alert"</code> (errors) or <code>role="status"</code>.
    Toasts are alerts injected into a persistent <code>aria-live</code> region — the
    region must exist before the first toast, or nothing is announced.
  </p>
  <section class="demo">
    <h2>Inline alerts</h2>
    <div class="eof-alert" role="status">
      <div><span class="eof-alert__title">Heads up.</span> Approvals sync runs at 18:00.</div>
    </div>
    <div class="eof-alert eof-alert--success" role="status">
      <div><span class="eof-alert__title">Saved.</span> All changes stored.</div>
    </div>
    <div class="eof-alert eof-alert--warning" role="status">
      <div><span class="eof-alert__title">Budget at 92%.</span> CC-4021 nears its limit.</div>
    </div>
    <div class="eof-alert eof-alert--danger" role="alert">
      <div><span class="eof-alert__title">Posting failed.</span> Period 2026-07 is closed.</div>
      <button class="eof-btn eof-btn--ghost eof-btn--icon eof-alert__dismiss" aria-label="Dismiss">✕</button>
    </div>
  </section>
  <section class="demo">
    <h2>Toast recipe</h2>
    <pre><code>{toastMarkup}</code></pre>
    <p class="eof-u-text-muted">Dismiss buttons work via <code>initAlerts()</code>
    (document delegation — injected toasts covered automatically). If you auto-dismiss,
    keep toasts visible ≥ 5s and pause the timer on hover/focus (WCAG 2.2.1). Toasts do
    <strong>not</strong> float above an open modal dialog (the dialog owns the top
    layer) — render confirmations inside the dialog instead.</p>
  </section>
  <script>
    import { initAlerts } from '@busy-office/ui/js';
    initAlerts();
  </script>
</Gallery>
