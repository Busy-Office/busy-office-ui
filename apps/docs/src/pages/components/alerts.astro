---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toastMarkup =`<!-- Region ships in your layout ONCE, before any toast exists,
     so injected toasts are announced: -->
<div class="bo-toast-region" role="status" aria-live="polite"></div>

<!-- Server/HTMX/JS injects: -->
<div class="bo-alert bo-alert--success bo-toast">
  <div><span class="bo-alert__title">Saved.</span> PO-88213 was approved.</div>
  <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss"
          aria-label="Dismiss">✕</button>
</div>`;
const saveConfirmMarkup = `<form>
  <!-- Ships EMPTY and EXPOSED, like the toast region above. Not
       \`hidden\`: a hidden node is not rendered, so it is not in the
       accessibility tree — filling it while hidden and revealing it
       afterwards changes nothing anyone was listening to. -->
  <div id="save-result" role="status" aria-live="polite"></div>

  <!-- ...your fields... -->

  <div class="bo-form-actions">
    <button class="bo-btn" type="button">Cancel</button>
    <button class="bo-btn" type="submit">Save</button>
  </div>
</form>

<script type="module">
  // On your real save success (fetch/htmx response), not a click demo.
  // Replace the region's CONTENTS; never remove the region itself.
  // That is what makes the second save behave like the first.
  const box = document.createElement('div');
  box.className = 'bo-alert bo-alert--success';
  box.innerHTML =
    '<div><span class="bo-alert__title">Saved.</span> PO-88213 approved.</div>';
  document.getElementById('save-result').replaceChildren(box);
</script>`;
---
<Gallery title="Alerts & toasts" description="Inline alerts and toasts for busy-office-ui, including which ARIA role to use so an assistive technology announces only what actually arrives.">
  <p class="demo-note">
    Inline alerts announce only what <em>arrives</em>: add
    <code>role="alert"</code> (errors) or <code>role="status"</code> when the
    alert is inserted after load, and <a href={base + '/concepts/accessibility#live-regions'}>no
    role at all</a> when it is already in the HTML the browser parsed.
    Toasts are alerts injected into a persistent <code>aria-live</code> region — the
    region must exist before the first toast, or nothing is announced.
    <strong>Without the JS:</strong> everything above still works — the role,
    the live region and the styling are all markup. <code>initAlerts()</code>
    adds <em>dismissal only</em>, so the one thing you lose is the ✕ button;
    injecting toasts was always your code.
    <strong>Not for a field that failed validation</strong> — an error about
    one input belongs beside that input, as
    <a href={base + '/components/form'}>the form field's own message</a>,
    where it is programmatically tied to the control by
    <code>aria-describedby</code>; an alert floated above the form makes the
    reader hunt for which field it means. Use an alert for what happened to
    the <em>request</em> ("Save failed, nothing was changed"), and
    <a href={base + '/patterns/validation-summary'}>the validation summary</a>
    when several fields failed at once and the reader needs a route to each.
  </p>
  <section class="demo">
    <h2>Inline alerts</h2>
    {/* No live-region role on any of these four: this gallery shows what the
        severities LOOK like, and they are all present at load. The announcing
        case is demonstrated live by the toast section below, where the alert
        is genuinely injected. */}
    <div class="bo-alert">
      <div><span class="bo-alert__title">Heads up.</span> Approvals sync runs at 18:00.</div>
    </div>
    <div class="bo-alert bo-alert--success">
      <div><span class="bo-alert__title">Saved.</span> All changes stored.</div>
    </div>
    <div class="bo-alert bo-alert--warning">
      <div><span class="bo-alert__title">Budget at 92%.</span> CC-4021 nears its limit.</div>
    </div>
    <div class="bo-alert bo-alert--danger">
      <div><span class="bo-alert__title">Posting failed.</span> Period 2026-07 is closed.
        <a href="#">Open period settings</a></div>
      <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
    </div>
    <p class="bo-u-text-muted">The most-copied real variant after plain text: an
    alert whose body carries the way out — a link or retry, in the text where a
    screen reader meets it.</p>
  </section>
  <section class="demo">
    <h2>Dismissible — the button is the whole API</h2>
    <p>The page said "dismiss buttons work via <code>initAlerts()</code>" and showed
    none. Here is one, live: click the × and this alert is removed from the DOM.</p>
    <div class="bo-alert bo-alert--warning">
      <strong class="bo-alert__title">Rate card expires in 3 days</strong>
      Renew it before the next billing run.
      <button class="bo-alert__dismiss" type="button" aria-label="Dismiss">×</button>
    </div>
    <p class="bo-u-text-muted">Any <code>.bo-alert__dismiss</code> inside a
    <code>.bo-alert</code> removes it — no id, no wiring, no per-alert init. The
    behaviour is document-delegated, which is why a toast injected a minute from now is
    covered too.</p>
  </section>

  <section class="demo">
    <h2>Elevated — for a list of alerts, not a message about this page</h2>
    <p>The default alert is a flat strip with an accent bar: it belongs to the
    thing you are looking at, in the flow of the page.
    <code>.bo-alert--elevated</code> swaps that for a raised card, so a column of
    them reads as separate objects you scan rather than one long banner.</p>
    <div class="bo-alert bo-alert--elevated">
      <div><span class="bo-alert__title">Import finished</span> 240 rows staged for review.</div>
    </div>
    <div class="bo-alert bo-alert--elevated bo-alert--warning">
      <div><span class="bo-alert__title">Approval overdue</span> PO-88213 · 2 days</div>
    </div>
    <p class="bo-u-text-muted">Combine it with a severity variant or leave it
    plain — the card look and the accent colour are independent settings.
    <strong>The raised surface does replace the severity tint</strong>, so on an
    elevated card severity reads through the 3px accent bar alone, not the fill —
    which is the channel that survives forced-colors anyway.
    <strong>Not for a single message inside a form or a page section</strong>:
    there the flat inline alert is correct, because a shadow makes one message
    look like it floated in from somewhere else.
    <strong>And not the same as a toast</strong>, though they share the raised
    background — a toast sits <em>higher</em> (a larger shadow, because it floats
    over the page rather than sitting in it) and <code>.bo-toast</code> adds an
    entrance animation, which says <em>this just arrived</em>. An elevated alert is for entries already on the
    page at load, so animating them in would announce arrivals that never
    happened. Rule of thumb: a toast interrupts, an elevated alert is
    scanned. Used together on
    <a href={base + '/patterns/notification'}>the notification pattern</a>.</p>
  </section>

  <section class="demo">
    <h2>Toast recipe</h2>
    <p class="bo-u-text-muted">Toasts are ephemeral, so the sample is a trigger, not a
    static block — click it to see the real thing render, dismiss, and go away.</p>
    <button class="bo-btn bo-btn--secondary" type="button" id="toast-demo-trigger">Show toast</button>
    <div class="bo-toast-region" id="toast-demo-region" role="status" aria-live="polite"></div>
    <pre><code>{toastMarkup}</code></pre>
    <p class="bo-u-text-muted">Dismiss buttons work via <code>initAlerts()</code>
    (document delegation — injected toasts covered automatically). A dismissed toast
    fades and collapses over <code>--bo-motion-duration-fast</code> before it leaves the
    DOM, and the toasts above it close the gap over that same window rather than
    snapping — so dismissing the middle of a stack does not teleport the rest. An inline
    alert is still removed instantly: it sits in the document flow, where a collapse
    would move the page under you. Under <code>prefers-reduced-motion</code> the toast
    goes instantly too.
    <strong>There is no auto-dismiss timer here, by design</strong> — the framework
    never removes a toast the reader did not dismiss, because it cannot know whether
    they have read it. If you add one, keep toasts visible ≥ 5s, pause the timer on
    hover/focus, and never auto-dismiss one that carries the only route to an action
    (WCAG 2.2.1). Toasts do
    <strong>not</strong> float above an open modal dialog (the dialog owns the top
    layer) — render confirmations inside the dialog instead.</p>
  </section>

  <section class="demo">
    <h2>A save confirmation on a form with a sticky action bar</h2>
    <p class="bo-u-text-muted"><strong>Not a floating toast here.</strong> Both a
    toast and a sticky <a href={`${base}/components/form/`}>form action bar</a> anchor
    to the viewport's bottom-end corner, and a toast always wins the stacking order —
    measured, on <code>/patterns/detail-form</code> at 390&times;844: the Save button
    100% covered. A fixed clearance offset was tried and measured wrong too: pushed
    tall enough to clear the widest shipped action bar, it moved the SAME obstruction
    onto a real field instead — Tab from Vendor through the form and
    <code>Quantity for Standing desk</code> landed 100% behind the shifted region, an
    editable input the reader could no longer see. No fixed offset is safe: the toast
    is pinned to the viewport, the form scrolls its own content, and any constant
    either misses the action bar or migrates the collision onto whatever field native
    scroll-into-view happens to land on next.</p>
    <p class="bo-u-text-muted">The composition that measured clean is
    <strong>in-flow</strong>: the result is written into a region that sits in the
    form's own document flow, so the page reflows around it rather than a fixed layer
    painting over it. Two details carry that, and both are the reason the earlier
    attempt failed. The region ships <strong>empty and exposed</strong> — not
    <code>hidden</code>, because a hidden node is not rendered and so is not in the
    accessibility tree at all, which makes filling it and revealing it a change
    nothing was in a position to hear. And a save replaces the region's
    <strong>contents</strong>, never the region, so the second save behaves exactly
    like the first.</p>
    <button class="bo-btn bo-btn--secondary" type="button" id="save-confirm-trigger">Simulate save</button>
    <div id="save-confirm-region" role="status" aria-live="polite"></div>
    <div class="bo-form-field" style="margin-block-start: var(--bo-space-3)">
      <label class="bo-form-field__label" for="save-confirm-demo-field">A field below the confirmation</label>
      <input class="bo-input" id="save-confirm-demo-field" />
    </div>
    <pre><code>{saveConfirmMarkup}</code></pre>
    <p class="bo-u-text-muted">No dismiss button, and that is deliberate: dismissing
    removes the node the reader is focused on, which drops focus to the document body
    (<code>initAlerts()</code> removes its <code>.bo-alert</code> and hands focus
    nowhere). A result that is replaced by the next result does not need one.
    <strong>What was measured, and only this:</strong> on
    <code>/patterns/detail-form</code>, real Tab and Shift+Tab traversal between
    <code>Vendor</code> and <code>Save purchase order</code> — every field and both
    action buttons, each with a positive rendered box and its own centre hit-testing
    to itself — at 390 and 1440, light and dark, all three densities, and a 2-row
    wrapped action bar. No measured control intersected the message. That is a result
    about this composition on this form, not a general property of in-flow content,
    and it does not transfer to a floating overlay elsewhere on the page — the
    attempt above is what that costs. Whether a screen reader actually speaks the
    change is a separate question these checks do not answer; they assert the region
    is exposed before it is written to, which is the precondition for it.</p>
  </section>
  <script>
    import { initAlerts } from '@busy-office/ui/js';
    initAlerts();
    document.getElementById('toast-demo-trigger')?.addEventListener('click', () => {
      const region = document.getElementById('toast-demo-region')!;
      // Three toasts per click so stacking order, spacing AND the way the
      // stack closes its own gap on dismiss are all visible — ERP reality is
      // bursts (a save, a follow-on warning, the batch behind them), not
      // singles, and a two-toast stack cannot show a dismissal from the
      // MIDDLE, which is the case the exit collapse exists for.
      region.insertAdjacentHTML(
        'beforeend',
        `<div class="bo-alert bo-alert--success bo-toast">
          <div><span class="bo-alert__title">Saved.</span> PO-88213 was approved.</div>
          <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
        </div>
        <div class="bo-alert bo-alert--warning bo-toast">
          <div><span class="bo-alert__title">Budget at 92%.</span> CC-4021 nears its limit.</div>
          <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
        </div>
        <div class="bo-alert bo-toast">
          <div><span class="bo-alert__title">3 more queued.</span> The overnight batch is still posting.</div>
          <button class="bo-btn bo-btn--ghost bo-btn--icon bo-alert__dismiss" aria-label="Dismiss">✕</button>
        </div>`,
      );
    });
    let saveCount = 0;
    document.getElementById('save-confirm-trigger')?.addEventListener('click', () => {
      // Replace the CONTENTS of a region that is always there. The previous
      // shape toggled `hidden` on the alert itself and let initAlerts remove
      // it, which made the second save throw on a node that no longer
      // existed — the demo and the copyable recipe now share this one.
      const region = document.getElementById('save-confirm-region')!;
      saveCount += 1;
      const box = document.createElement('div');
      box.className = 'bo-alert bo-alert--success';
      box.innerHTML = `<div><span class="bo-alert__title">Saved.</span> PO-88213 was approved (save ${saveCount}).</div>`;
      region.replaceChildren(box);
    });
  </script>
  <ClassRef component="alert" />
  <ApiTable component="alert"
    js="Optional: initAlerts() — dismiss buttons remove their alert/toast (delegation covers injected toasts); a toast fades and collapses out first, an inline alert goes instantly."
    notes={[`Arrival decides the role, not severity — the <a href="${base}/concepts/accessibility#live-regions">live-region rule</a> is stated once there; short form: none at load, <code>role="alert"</code>/<code>role="status"</code> only when inserted after load.`,
            'The toast region must exist (with <code>aria-live</code>) BEFORE the first toast is injected.',
            'Toasts do not float above an open modal dialog (top layer).']} />
  <DsaScore component="alert" />
  <Related links={[["/concepts/js-behaviors", "JS behaviors"], ["/getting-started/htmx", "Using with HTMX"]]} />
</Gallery>
