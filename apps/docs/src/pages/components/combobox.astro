---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const markup = `<div class="bo-combobox">
  <input class="bo-input" type="text" role="combobox" id="cb-input"
      aria-expanded="false" aria-controls="cb-list" aria-autocomplete="list"
      autocomplete="off" placeholder="Search cost centers…" />
  <ul class="bo-combobox__listbox" id="cb-list" role="listbox" popover>
    <li class="bo-combobox__option" role="option" id="cb-opt-1" data-value="CC-1180">CC-1180 — Warehouse</li>
    <li class="bo-combobox__option" role="option" id="cb-opt-2" data-value="CC-2205">CC-2205 — Logistics</li>
    <li class="bo-combobox__option" role="option" id="cb-opt-3" data-value="CC-4021">CC-4021 — Procurement</li>
  </ul>
</div>

<script type="module">
  import { initCombobox } from "@busy-office/ui/js";
  initCombobox(); // once — filtering, arrow-key nav, Enter-to-commit, Esc/light-dismiss are already native
</script>`;
const formMarkup = `<div class="bo-form-field">
  <label class="bo-form-field__label" for="cc">Cost center</label>
  <!-- data-name: the behavior mirrors the committed data-value into a
       hidden input, so a plain form POST carries CC-1180, not the label -->
  <div class="bo-combobox" data-name="cost_center">
    <input class="bo-input" type="text" role="combobox" id="cc"
        aria-expanded="false" aria-controls="cc-list" aria-autocomplete="list" autocomplete="off" />
    <ul class="bo-combobox__listbox" id="cc-list" role="listbox" popover>
      <li class="bo-combobox__option" role="option" data-value="CC-1180">CC-1180 — Warehouse</li>
    </ul>
  </div>
</div>

<script type="module">
  // "must match a known value" — the list has just closed on focusout,
  // so this is the natural moment to validate.
  document.addEventListener("focusout", (e) => {
    const input = e.target.closest?.('[role="combobox"]');
    if (!input) return;
    const hidden = input.closest(".bo-combobox").querySelector('input[type="hidden"]');
    const ok = input.value === "" || (hidden && hidden.value);
    input.setAttribute("aria-invalid", String(!ok));
  });
</script>`;

const filterMarkup = [
  '// Own the matcher — the behavior only navigates options that are not hidden',
  'const fold = (t) => t.toLowerCase().normalize("NFD").replace(/[\\u0300-\\u036f]/g, "");',
  '',
  'document.addEventListener("input", (e) => {',
  '  const input = e.target.closest?.("[role=combobox][data-custom-filter]");',
  '  if (!input) return;',
  '  const words = fold(input.value).split(/\\s+/).filter(Boolean);   // token-based',
  '  for (const li of input.closest(".bo-combobox").querySelectorAll("[role=option]")) {',
  '    li.hidden = !words.every((w) => fold(li.textContent).includes(w));',
  '  }',
  '});',
].join("\n");

const asyncMarkup = [
  '<script type="module">',
  '  import { initCombobox } from "@busy-office/ui/js";',
  '  initCombobox();',
  '',
  '  const input = document.querySelector("#vendor");',
  '  const list = document.querySelector("#vendor-list");',
  '  let seq = 0;',
  '',
  '  input.addEventListener("input", debounce(async () => {',
  '    const mine = ++seq;                       // ignore out-of-order responses',
  '    list.innerHTML = option("Searching…", { disabled: true });',
  '    try {',
  '      const res = await fetch("/vendors?q=" + encodeURIComponent(input.value));',
  '      if (mine !== seq) return;               // a newer keystroke already won',
  '      const vendors = await res.json();',
  '      list.innerHTML = vendors.length',
  '        ? vendors.map((v) => option(v.name, { value: v.id })).join("")',
  '        : option("No matches", { disabled: true });',
  '    } catch {',
  '      if (mine !== seq) return;',
  '      list.innerHTML = option("Search unavailable — retry", { disabled: true });',
  '    }',
  '  }, 200));',
  '',
  '  // ids are minted by the behavior if you omit them, so a template',
  '  // render is safe; aria-disabled rows are skipped by the arrows.',
  '  function option(text, { value, disabled } = {}) {',
  '    return "<li class=\'bo-combobox__option\' role=\'option\'"',
  '      + (value ? " data-value=\'" + value + "\'" : "")',
  '      + (disabled ? " aria-disabled=\'true\'" : "")',
  '      + ">" + text + "</li>";',
  '  }',
  '</script>',
].join("\n");
---
<Gallery title="Combobox">
  <p class="demo-note">
    A single-select text field that filters a list as you type — for picking one value
    out of a longer list than a plain <a href={base + '/components/form'}>select</a> reads
    well, without the overhead of asking "which of these N do I want" up front. For
    picking <strong>several</strong> values, use the
    <a href={base + '/components/dropdown'}>multi-select dropdown</a> instead — different job.
  </p>

  <section class="demo">
    <h2>Basic</h2>
    <div class="bo-form-field" style="margin-block-end: 0">
      <label class="bo-form-field__label" for="demo-cb-input">Cost center</label>
      <div class="bo-combobox">
      <input class="bo-input" type="text" role="combobox" id="demo-cb-input"
          aria-expanded="false" aria-controls="demo-cb-list" aria-autocomplete="list"
          autocomplete="off" placeholder="Search cost centers…" />
      <ul class="bo-combobox__listbox" id="demo-cb-list" role="listbox" popover>
        <li class="bo-combobox__option" role="option" id="demo-cb-opt-1" data-value="CC-1180">CC-1180 — Warehouse</li>
        <li class="bo-combobox__option" role="option" id="demo-cb-opt-2" data-value="CC-2205">CC-2205 — Logistics</li>
        <li class="bo-combobox__option" role="option" id="demo-cb-opt-3" data-value="CC-4021">CC-4021 — Procurement</li>
        <li class="bo-combobox__option" role="option" id="demo-cb-opt-4" data-value="CC-3390">CC-3390 — Facilities</li>
      </ul>
      </div>
    </div>
    <p class="bo-u-text-muted">Type to filter (case-insensitive substring match against
    each option's full text — try "log" or "cc-33"), <kbd>↓</kbd>/<kbd>↑</kbd> to move
    through the filtered results, <kbd>Enter</kbd> to commit. The listbox is a real
    <code>[popover]</code> — <kbd>Esc</kbd> and clicking outside close it without
    changing the field's value, for free. Two honest caveats (owner test
    report, 2026-08-16): the popover is never <em>clipped</em> by a scroll
    container, but it is positioned once at open time and is not
    re-anchored — so the list <strong>closes on scroll</strong> rather than
    drifting away from its field; and <code>aria-expanded</code> is
    resynced on the listbox's <code>toggle</code> event, so a test must
    assert after a task, not synchronously in the keypress.</p>
  </section>

  <section class="demo">
    <h2>What the open list looks like — active option</h2>
    <div class="bo-combobox" style="max-inline-size: 20rem">
      <input class="bo-input" type="text" role="combobox" value="cc"
          aria-expanded="true" aria-controls="static-cb-list" aria-autocomplete="list"
          aria-activedescendant="static-opt-2" autocomplete="off" aria-label="Cost center (static snapshot)" readonly />
      <div class="bo-combobox__listbox" role="listbox" id="static-cb-list" style="position: static; margin-block-start: var(--bo-space-1)">
        <div class="bo-combobox__option" role="option" id="static-opt-1">CC-1180 — Warehouse</div>
        <div class="bo-combobox__option" role="option" id="static-opt-2" aria-selected="true">CC-2205 — Logistics</div>
        <div class="bo-combobox__option" role="option" id="static-opt-3">CC-4021 — Procurement</div>
      </div>
    </div>
    <p class="bo-u-text-muted">A static snapshot (no popover) so the
    <strong>active option</strong> styling is visible without interacting:
    <kbd>↓</kbd>/<kbd>↑</kbd> move <code>aria-selected</code> +
    <code>aria-activedescendant</code> down the filtered list — that's the
    highlighted row.</p>
  </section>
  <section class="demo">
    <h2>No matches — the list closes, the field tells the story</h2>
    <p class="bo-u-text-muted">When the filter matches nothing, the behavior
    <strong>closes the listbox</strong> (<code>aria-expanded="false"</code>) rather
    than showing an empty popup — the typed text stays in the field. If "must match
    a known value" matters, validate on commit/submit: pair the field with the
    standard <a href={base + '/components/form'}>error message</a> ("Unknown cost center")
    or the <a href={base + '/patterns/validation-summary'}>validation summary</a> — don't
    invent an in-popup empty state the pattern doesn't have.</p>
  </section>
  <section class="demo">
    <h2>In a filter bar — labeled, composed</h2>
    <form class="bo-filter-bar" role="search" aria-label="PO filters">
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="fb-cb">Cost center</label>
        <div class="bo-combobox">
          <input class="bo-input" type="text" role="combobox" id="fb-cb"
              aria-expanded="false" aria-controls="fb-cb-list" aria-autocomplete="list"
              autocomplete="off" placeholder="Type to search…" />
          <ul class="bo-combobox__listbox" id="fb-cb-list" role="listbox" popover>
            <li class="bo-combobox__option" role="option" id="fb-opt-1" data-value="CC-1180">CC-1180 — Warehouse</li>
            <li class="bo-combobox__option" role="option" id="fb-opt-2" data-value="CC-2205">CC-2205 — Logistics</li>
          </ul>
        </div>
      </div>
      <button class="bo-btn bo-btn--secondary" type="submit">Apply</button>
    </form>
    <p class="bo-u-text-muted">The real placement: inside a
    <a href={base + '/components/filters'}>filter bar</a>, wrapped in a
    <code>.bo-form-field</code> with a proper <code>&lt;label for&gt;</code> —
    the combobox is a form control first.</p>
  </section>
  <section class="demo">
    <h2>WAI-ARIA APG combobox pattern, not a custom widget</h2>
    <p>The input carries <code>role="combobox"</code>, <code>aria-expanded</code>,
    <code>aria-controls</code>, and <code>aria-autocomplete="list"</code>; the popup is
    a real <code>role="listbox"</code> with <code>role="option"</code> children.
    <code>initCombobox()</code> keeps <code>aria-activedescendant</code> in sync as the
    active option changes — nothing is simulated with generic <code>&lt;div&gt;</code>s.
    On commit, it fires <code>bo:combobox-select</code>
    (<code>detail: {'{'} value, text {'}'}</code>) — your code reads
    <code>e.detail.value</code> for the machine value (<code>data-value</code> on the
    chosen option) and persists it (a hidden input, a form submit, an <code>hx-patch</code>).</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>

  <script>
    import { initCombobox } from '@busy-office/ui/js';
    initCombobox();
  </script>


  <section class="demo">
    <h2>Form integration — the machine value</h2>
    <div class="bo-form-field" style="margin-block-end: 0">
      <label class="bo-form-field__label" for="fi-cb">Cost center</label>
      <div class="bo-combobox" data-name="cost_center">
        <input class="bo-input" type="text" role="combobox" id="fi-cb"
            aria-expanded="false" aria-controls="fi-list" aria-autocomplete="list"
            autocomplete="off" placeholder="Search cost centers…" />
        <ul class="bo-combobox__listbox" id="fi-list" role="listbox" popover>
          <li class="bo-combobox__option" role="option" id="fi-o1" data-value="CC-1180">CC-1180 — Warehouse</li>
          <li class="bo-combobox__option" role="option" id="fi-o2" data-value="CC-2205">CC-2205 — Logistics</li>
          <li class="bo-combobox__option" role="option" id="fi-o3" data-value="CC-4021">CC-4021 — Procurement</li>
        </ul>
      </div>
    </div>
    <p class="bo-u-text-muted">Pick one, then inspect the DOM: the widget
    carries <code>data-name="cost_center"</code>, so committing writes
    <code>&lt;input type="hidden" name="cost_center" value="CC-1180"&gt;</code>
    inside it. A plain form POST now sends the <strong>machine value</strong>,
    not the display label — no JavaScript of your own, no framework.</p>
    <pre><code>{formMarkup}</code></pre>
    <p class="bo-u-text-muted">Validation for "must match a known value":
    the field can hold free text the user typed, so check it on
    <code>focusout</code> — the list has just closed, which is the
    natural moment. Server-side, treat the hidden value as authoritative
    and re-render with <code>aria-invalid</code> if it is missing.</p>
  </section>

  <section class="demo">
    <h2>Field states</h2>
    <div class="bo-stack" style="max-inline-size: 26rem">
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="st-1">Disabled</label>
        <input class="bo-input" id="st-1" role="combobox" aria-expanded="false" value="CC-1180 — Warehouse" disabled />
      </div>
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="st-2">Read-only</label>
        <input class="bo-input" id="st-2" role="combobox" aria-expanded="false" value="CC-2205 — Logistics" readonly />
      </div>
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="st-3">Required &amp; invalid</label>
        <input class="bo-input" id="st-3" role="combobox" aria-expanded="false" required
            aria-invalid="true" aria-describedby="st-3-err" value="CC-9999" />
        <span class="bo-form-field__message" id="st-3-err" role="alert">No such cost center — pick one from the list</span>
      </div>
    </div>
    <p class="bo-u-text-muted">Nothing combobox-specific: the field is a
    <code>.bo-input</code>, so every <a href={base + '/components/form'}>form
    field state</a> applies unchanged. Disabled and read-only differ —
    read-only text stays selectable and still submits.</p>
  </section>

  <section class="demo">
    <h2>Filtering semantics</h2>
    <p>Exactly what the built-in filter does, so you can predict it:
    <strong>case-insensitive</strong>, <strong>single substring</strong>,
    matched against the option's <strong>full text content</strong>, with
    the query trimmed. It is <strong>not</strong> token-based
    (<code>cc warehouse</code> matches nothing), <strong>not</strong>
    accent-folded (<code>zurich</code> does not match <code>Zürich</code>),
    and not fuzzy. When you need more, own the filter: hide and show
    options yourself on <code>input</code> — the behavior only ever
    considers non-<code>hidden</code> options, so your matcher composes
    with its keyboard and ARIA handling.</p>
    <pre><code>{filterMarkup}</code></pre>
  </section>

  <section class="demo">
    <h2>Async / server-driven options</h2>
    <p>The common ERP case: too many options to ship up front. Fetch on
    input, replace the <code>&lt;li&gt;</code>s, and let the behavior keep
    doing keyboard and ARIA. Ids are minted automatically if you omit
    them, so a template render is safe.</p>
    <pre><code>{asyncMarkup}</code></pre>
  </section>

  <section class="demo">
    <h2>Keyboard reference</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Key</th><th scope="col">Behaviour</th></tr></thead>
        <tbody>
          <tr><td>Printable characters</td><td>Filter; open the list if anything matches</td></tr>
          <tr><td><kbd class="bo-kbd">↓</kbd> / <kbd class="bo-kbd">↑</kbd></td><td>Move the active option; <strong>clamps at the ends</strong> — deliberately no wrap-around</td></tr>
          <tr><td><kbd class="bo-kbd">Home</kbd> / <kbd class="bo-kbd">End</kbd></td><td>Move the text caret, not the active option (correct for an editable combobox)</td></tr>
          <tr><td><kbd class="bo-kbd">PageUp</kbd> / <kbd class="bo-kbd">PageDown</kbd></td><td>Not handled</td></tr>
          <tr><td><kbd class="bo-kbd">Enter</kbd> (option active)</td><td>Commit, close, dispatch <code>bo:combobox-select</code></td></tr>
          <tr><td><kbd class="bo-kbd">Enter</kbd> (open, nothing active)</td><td>Swallowed — never submits the surrounding form; commits the sole match if exactly one remains</td></tr>
          <tr><td><kbd class="bo-kbd">Enter</kbd> (list closed)</td><td>Submits the form natively, as any text input would</td></tr>
          <tr><td><kbd class="bo-kbd">Esc</kbd></td><td>Close, keep the typed text</td></tr>
          <tr><td><kbd class="bo-kbd">Tab</kbd></td><td>Close, clear the active option, move on</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <ClassRef component="combobox" />
  <ApiTable
    component="combobox"
    js="Required: initCombobox() — without it the field is a plain text input; typing does not filter or open the list."
    notes={[
      'Single-select only — the committed value lives in the input\'s text, not on any option (options never carry a persisted "chosen" marker across reopens). For choosing several values, use the <a href="' + base + '/components/dropdown">multi-select dropdown</a> instead.',
      'The listbox is a native <code>[popover]</code> — never clipped by scrolling containers, and <kbd>Esc</kbd>/light-dismiss close it without touching the field value at no extra cost. It is NOT re-anchored on scroll (CSS anchor positioning is below the browser floor), so it closes instead.',
      'Focus leaving the widget closes the list and clears the active option — that is also the natural moment to run "must match a known value" validation.',
      'Options carrying <code>aria-disabled="true"</code> are shown but skipped by the arrows and rejected by Enter and click.',
      'Options rendered without an <code>id</code> get one minted at activation time, so <code>aria-activedescendant</code> is never an empty string.',
      'Filtering is a case-insensitive substring match against each option\'s full text, computed client-side against the options already in the markup — for a server-driven / async result list, swap the options\' <code>hidden</code> state yourself in response to your own fetch instead of relying on the built-in filter.',
      'Commit dispatches <code>bo:combobox-select</code> with <code>{ value, text }</code> — <code>value</code> comes from the chosen option\'s <code>data-value</code> (falls back to its text if absent).',
    ]}
  />
  <Related links={[["/components/dropdown", "Dropdown (multi-select)"], ["/components/form", "Forms"], ["/components/filters", "Filters"], ["/components/tag-input", "Tag input"], ["/concepts/accessibility", "Accessibility model"]]} />
</Gallery>
