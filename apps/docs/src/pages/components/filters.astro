---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const filterMarkup = `<!-- A real <form>, so type="reset" works and role="search" sits on it. -->
<form class="bo-filter-bar" role="search" aria-label="Invoice filters">
  <input class="bo-input" type="search" name="q" aria-label="Search invoices" />
  <select class="bo-select" name="status" aria-label="Status">…</select>
  <span class="bo-chip bo-chip--active">Status: Pending
    <button class="bo-chip__remove" type="button"
            aria-label="Remove filter Status: Pending">✕</button>
  </span>
  <button class="bo-btn bo-btn--ghost" type="reset">Clear all</button>
</form>`;
---
<Gallery title="Filters">
  <p class="demo-note">
    Filter bar + applied-filter chips. Each chip's remove button names its filter in
    the <code>aria-label</code>. Filtering itself is your code (form submit or HTMX).
    <strong>Not for one or two fields</strong> — a single search input in the
    <a href={base + '/components/table-toolbar'}>table toolbar</a> reads better
    than a bar and chips; the chips earn their place once a user can have
    several filters applied at once and lose track of them.
  </p>
  <section class="demo">
    <form class="bo-filter-bar" role="search" aria-label="Invoice filters">
      <input class="bo-input" type="search" name="q" aria-label="Search invoices" placeholder="Search…" />
      <select class="bo-select" name="status" aria-label="Status">
        <option>All statuses</option><option>Pending</option><option>Approved</option>
      </select>
      <span class="bo-chip bo-chip--active">Status: Pending
        <button class="bo-chip__remove" type="button" aria-label="Remove filter Status: Pending">✕</button>
      </span>
      <span class="bo-chip bo-chip--active">CC-4021
        <button class="bo-chip__remove" type="button" aria-label="Remove filter CC-4021">✕</button>
      </span>
      <button class="bo-btn bo-btn--ghost" type="reset">Clear all</button>
    </form>
  </section>
  <section class="demo">
    <h2>Filtering something — bar + multi-select + matching rows</h2>
    <form class="bo-filter-bar" role="search" aria-label="PO filters">
      <button class="bo-btn bo-btn--secondary" popovertarget="flt-cc" data-multiselect-label="Cost center" type="button">Cost center</button>
      <div class="bo-dropdown__menu" id="flt-cc" popover data-multiselect>
        <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" checked /> CC-4021</label>
        <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" /> CC-1180</label>
      </div>
      <span class="bo-chip bo-chip--active">CC-4021
        <button class="bo-chip__remove" type="button" aria-label="Remove filter CC-4021">✕</button>
      </span>
      <span class="bo-chip">Overdue only</span>
    </form>
    <div class="bo-data-table-container" tabindex="0" style="margin-block-start: var(--bo-space-2); max-inline-size: 28rem">
      <table class="bo-data-table">
        <thead><tr><th scope="col">PO #</th><th scope="col">Cost center</th><th scope="col" class="bo-data-table__col--numeric">Amount</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">PO-88210</td><td class="bo-data-table__col--code">CC-4021</td><td class="bo-data-table__col--numeric">$4,208.00</td></tr>
          <tr><td class="bo-data-table__col--code">PO-88211</td><td class="bo-data-table__col--code">CC-4021</td><td class="bo-data-table__col--numeric">$18,940.50</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">The full loop: the
    <a href={base + '/components/dropdown'}>multi-select dropdown</a> is where chip values
    come from, the active chip echoes the applied filter, the rows below match it.
    Also the base vs <code>--active</code> chip contrast — an inactive chip
    ("Overdue only") is an available filter, an active one is applied and
    removable.</p>
  </section>
  <section class="demo">
    <h2>Saved views <span class="bo-badge">opt-in</span></h2>
    <p class="bo-u-text-muted">
      Views are just links (server-rendered, zero new CSS) — but which one is
      "active" and what the filter bar's fields show shouldn't be hand-set per
      page. <code>initSavedViews()</code> derives both from the URL: it reads
      <code>location.search</code>, fills matching <code>.bo-filter-bar</code>
      fields, and marks whichever <code>[data-saved-views]</code> link's own
      querystring matches the current one <code>aria-current="page"</code> —
      clearing it from the others. Try it: click a saved view below, watch the
      filter bar and the active chip update to match.
    </p>
    <form class="bo-filter-bar" role="search" aria-label="Saved-view invoice filters" style="margin-block-end: var(--bo-space-2)">
      <input class="bo-input" type="search" name="q" aria-label="Search invoices" placeholder="Search…" />
      <select class="bo-select" name="status" aria-label="Status">
        <option value="">All statuses</option>
        <option value="pending">Pending</option>
        <option value="overdue">Overdue</option>
      </select>
    </form>
    <div class="bo-cluster">
      <nav class="bo-cluster" aria-label="Saved views" data-saved-views style="--bo-cluster-gap: var(--bo-space-1)">
        <a class="bo-chip" href="?status=pending">My pending</a>
        <a class="bo-chip" href="?status=overdue">Overdue</a>
        <a class="bo-chip" href="?q=CC-4021">All CC-4021</a>
      </nav>
      <button class="bo-btn bo-btn--ghost" popovertarget="view-menu">Save view ▾</button>
      <div class="bo-dropdown__menu" id="view-menu" popover>
        <button class="bo-dropdown__item" type="button">Save current filters…</button>
        <button class="bo-dropdown__item" type="button">Manage views…</button>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{filterMarkup}</code></pre>
  </section>
  <script>
    import { initDropdowns, initSavedViews } from '@busy-office/ui/js';
    initDropdowns();
    initSavedViews();
  </script>
  <ClassRef component="filters" />
  <ApiTable component="filters"
    js="Optional: initSavedViews() — populates a .bo-filter-bar's fields from the URL querystring and marks the matching [data-saved-views] link aria-current."
    notes={['Make the bar a real <code>&lt;form role="search"&gt;</code> so <code>type="reset"</code> works.',
            'Chip remove buttons name their filter in <code>aria-label</code>; 24px hit area is built in.',
            'Saved views are just links — persistence (naming, saving, deleting a view) is your code; the behavior only keeps the UI in sync with whichever view the URL says is active.']} />
  <DsaScore component="filters" />
  <Related links={[["/components/data-table", "Data table"], ["/components/dropdown", "Dropdown"]]} />
</Gallery>
