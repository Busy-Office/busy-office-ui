---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const filterMarkup = `<!-- A real <form>, so type="reset" works and role="search" sits on it. -->
<form class="bo-filter-bar" role="search" aria-label="Invoice filters">
  <input class="bo-input" type="search" name="q" aria-label="Search invoices" />
  <select class="bo-select" name="status" aria-label="Status">…</select>
  <span class="bo-chip bo-chip--active">Status: Pending
    <button class="bo-chip__remove" type="button"
            aria-label="Remove filter Status: Pending">✕</button>
  </span>
  <button class="bo-btn bo-btn--ghost" type="reset">Clear all</button>
</form>`;
---
<Gallery title="Filters">
  <p class="demo-note">
    Filter bar + applied-filter chips. Each chip's remove button names its filter in
    the <code>aria-label</code>. Filtering itself is your code (form submit or HTMX).
  </p>
  <ClassRef component="filters" />
  <section class="demo">
    <form class="bo-filter-bar" role="search" aria-label="Invoice filters">
      <input class="bo-input" type="search" name="q" aria-label="Search invoices" placeholder="Search…" style="max-inline-size: 12rem" />
      <select class="bo-select" name="status" style="inline-size:auto" aria-label="Status">
        <option>All statuses</option><option>Pending</option><option>Approved</option>
      </select>
      <span class="bo-chip bo-chip--active">Status: Pending
        <button class="bo-chip__remove" type="button" aria-label="Remove filter Status: Pending">✕</button>
      </span>
      <span class="bo-chip bo-chip--active">CC-4021
        <button class="bo-chip__remove" type="button" aria-label="Remove filter CC-4021">✕</button>
      </span>
      <button class="bo-btn bo-btn--ghost" type="reset">Clear all</button>
    </form>
  </section>
  <section class="demo">
    <h2>Saved views</h2>
    <div class="bo-cluster">
      <nav class="bo-cluster" aria-label="Saved views" style="--bo-cluster-gap: var(--bo-space-1)">
        <a class="bo-chip bo-chip--active" href="#" aria-current="page">My pending</a>
        <a class="bo-chip" href="#">Overdue &gt; 30d</a>
        <a class="bo-chip" href="#">All CC-4021</a>
      </nav>
      <button class="bo-btn bo-btn--ghost" popovertarget="view-menu">Save view ▾</button>
      <div class="bo-dropdown__menu" id="view-menu" popover>
        <button class="bo-dropdown__item" type="button">Save current filters…</button>
        <button class="bo-dropdown__item" type="button">Manage views…</button>
      </div>
    </div>
    <p class="bo-u-text-muted">A saved view is just a link that restores a filter
    querystring — chips with <code>aria-current="page"</code> for the active view, plus
    a dropdown for save/manage. Server-rendered, zero new CSS.</p>
  </section>
  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{filterMarkup}</code></pre>
  </section>
  <script>
    import { initDropdowns } from '@busy-office/ui/js';
    initDropdowns();
  </script>
  <ApiTable component="filters"
    notes={['Make the bar a real <code>&lt;form role="search"&gt;</code> so <code>type="reset"</code> works.',
            'Chip remove buttons name their filter in <code>aria-label</code>; 24px hit area is built in.']} />
  <Related links={[["/components/data-table", "Data table"], ["/components/dropdown", "Dropdown"]]} />
</Gallery>
