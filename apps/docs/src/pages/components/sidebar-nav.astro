---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import DemoFrame from '../../components/DemoFrame.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sidebarMarkup = `<nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Main">
  <div class="bo-sidebar-nav__section">
    <div class="bo-sidebar-nav__heading">Purchasing</div>
    <ul>
      <li><a class="bo-sidebar-nav__link" href="/invoices" aria-current="page">
        <span class="bo-icon bo-icon--invoice bo-sidebar-nav__icon" aria-hidden="true"></span>
        <span class="bo-sidebar-nav__label">Invoices</span>
      </a></li>
    </ul>
  </div>
</nav>`;
---
<Gallery title="Sidebar navigation" description="The module rail of an ERP: grouped links that collapse to icons when the shell is narrow rather than when the viewport is.">
  <p class="demo-note">
    The module rail of an ERP — grouped links that collapse to icons when
    the <em>shell</em> is narrow, not when the viewport is. This page's own
    sidebar is the live demo; the embedded shell below proves the
    container-query behaviour independently.
    <strong>Not for navigating within one screen</strong> — this rail moves
    the reader between destinations, and every entry is somewhere else. A
    long record's own sections are not destinations: jumping to "Delivery"
    should scroll, not navigate, and marking it
    <code>aria-current="page"</code> would claim a page change that never
    happened. That is <a href={base + '/patterns/object-page'}>object
    page</a>'s anchor bar, or plain
    <a href={base + '/components/tabs'}>tabs</a> when the sections are
    mutually exclusive.
  </p>

  <section class="demo">
    <h2>Both rail states, in real shells</h2>
    <div class="sbn-frames">
      <div>
        <div class="sbn-scaler">
          <DemoFrame src={base + '/components/demos/sidebar-nav-wide/'} title="Sidebar nav in a wide app shell — labels visible" class="sbn-frame sbn-frame--wide" />
        </div>
        <p class="bo-u-text-muted">Shell wider than 56rem — labels visible.</p>
      </div>
      <div>
        <DemoFrame src={base + '/components/demos/sidebar-nav-narrow/'} title="Sidebar nav in a narrow app shell — collapsed to icons" class="sbn-frame sbn-frame--narrow" />
        <p class="bo-u-text-muted">Shell at 56rem or narrower — collapsed to icons.</p>
      </div>
    </div>
    <p class="bo-u-text-muted"><strong>These are iframes, and they have to be.</strong>
    The rail collapses under <code>@container bo-shell (max-width: 56rem)</code>,
    so it answers to the width of its <em>shell</em>, not the viewport. A demo
    inline on this page has no such container, so it rendered the expanded rail
    at every width — including 390 — and the state the component is most
    interesting for could not be shown at all. A frame gives the demo its own
    document and its own container, so the two panes above differ by nothing but
    how wide their shell is. Drag the browser narrow and they stay as they are;
    that is the point.</p>
  </section>

  <section class="demo">
    <h2>Grouped sections in an embedded shell</h2>
    <div class="bo-app-shell demo-frame demo-shell-frame" style="min-block-size: 18rem; max-inline-size: 700px">
      <header class="bo-navbar bo-app-shell__header">
        <span class="bo-navbar__brand">Embedded app</span>
        <span class="bo-navbar__spacer"></span>
      </header>
      <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Embedded">
        <div class="bo-sidebar-nav__section">
          <div class="bo-sidebar-nav__heading">Purchasing</div>
          <ul>
            <li><a class="bo-sidebar-nav__link" href="#" aria-current="page"><span class="bo-icon bo-icon--invoice bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Invoices</span></a></li>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--check-circle bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Approvals</span></a></li>
          </ul>
        </div>
        <div class="bo-sidebar-nav__section">
          <div class="bo-sidebar-nav__heading">Finance</div>
          <ul>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--chart bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Ledger</span></a></li>
            <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--doc bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Statements</span></a></li>
          </ul>
        </div>
      </nav>
      {/* div, not <main>: a second main landmark inside the docs page is an
          axe violation — the demo shows layout, not landmark semantics */}
      <div class="bo-app-shell__main">
        <p class="bo-u-text-muted">Sections (<code>__section</code> +
        <code>__heading</code>) group a real ERP's modules — headings hide with the
        labels when this 700px shell collapses to icons. Container queries, not
        media queries.</p>
      </div>
    </div>
    <p class="bo-u-text-muted"><strong>How many entries fit before the top
    group scrolls away.</strong> The rail is one scrolling column, so a long
    second group pushes the first out of view — and the first group is usually
    the one you need from anywhere (the modules). Measured on a real suite
    shell with 7 module entries: at a 900px-tall viewport the modules stay
    visible up to <strong>11</strong> entries in the second group and are gone
    by 17; on a 700px laptop the limit is <strong>11</strong>. If a group needs
    more than that, the answer is not a taller rail — move the long list into
    the page (a <a href={base + '/components/tabs'}>tab strip</a> or an
    <a href={base + '/patterns/object-page'}>anchor bar</a> belongs to the
    screen, not the chrome), or split the module. A second, narrower icon rail
    is what large suites use, and this framework deliberately does not ship one
    yet: no screen here has hit the limit, and adding a column to
    <code>.bo-app-shell</code> — the most-composed layout in the framework — on
    a hypothetical is how a grid grows a slot nobody fills (roadmap 130.2,
    GAP-1).</p>
  </section>

  <section class="demo">
    <h2>A label longer than the rail</h2>
    {/* The rail STANDALONE, not inside .bo-app-shell — deliberately. The
        icon-only collapse is a `@container bo-shell` query, so inside a demo
        shell narrow enough to fit this page the labels are visually hidden and
        there is nothing to show. Outside a shell the query never matches, so
        this renders the expanded rail at any viewport, including 390. */}
    <nav class="bo-sidebar-nav demo-frame" aria-label="Long labels">
      <div class="bo-sidebar-nav__section">
        <div class="bo-sidebar-nav__heading">Reference</div>
        <ul>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--doc bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Accessibility Conformance Report</span></a></li>
          <li><a class="bo-sidebar-nav__link" href="#"><span class="bo-icon bo-icon--grid bo-sidebar-nav__icon" aria-hidden="true"></span><span class="bo-sidebar-nav__label">Tokens</span></a></li>
        </ul>
      </div>
    </nav>
    <p class="bo-u-text-muted">
      A label wider than the rail <strong>wraps onto another line</strong>. It is not
      truncated and it does not widen the rail. Wrapping is the deliberate choice: an
      ellipsis hides the part of a name that distinguishes it — "Accessibility
      Conformance…" and "Accessibility Conformance Report" read alike — and letting the
      label push the rail wider puts a horizontal scrollbar inside the navigation, so a
      reader has to drag sideways to finish reading a link. Both were real: this rail
      spilled 15.7px and scrolled until it was fixed. Nothing here is configurable, so
      long module names are safe to use without measuring them first.
    </p>
    <p class="bo-u-text-muted">
      <strong>On a narrow screen you are seeing icons, not wrapped text</strong>, and
      that is the same rule as above rather than an exception to it: this demo sits
      inside the docs' own app shell, so when that shell is narrow the rail collapses
      to icon-only and every label is visually hidden — wrapping only applies where
      there are labels to wrap. Widen the window to see it.
    </p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{sidebarMarkup}</code></pre>
  </section>

  <ClassRef component="sidebar-nav" />
  <ApiTable component="sidebar-nav" notes={[
    'The current page carries <code>aria-current="page"</code> — that is the programmatic channel; the visual highlight is the other half.',
    'Icons are <code>aria-hidden</code> and labels stay in the accessibility tree when the rail collapses, so a screen-reader user never loses the link text.',
    'Collapse is driven by a named container query on the shell — the same sidebar behaves correctly inside a split view, which a media query cannot do.',
    'Sections (<code>__section</code> + <code>__heading</code>) group modules; headings hide with the labels when the rail collapses.',
  ]} />
  <DsaScore component="sidebar-nav" />
  <Related links={[
    ['/base/primitives', 'App shell'],
    ['/concepts/container-queries', 'Container queries'],
    ['/components/offcanvas', 'Drawers'],
    ['/components/navbar', 'Navbar'],
  ]} />
</Gallery>
<style>
  /* :global() is load-bearing. Astro scopes a page's <style> to elements the
     PAGE renders, and this iframe is rendered by DemoFrame — a different
     component with a different scope id — so an unscoped selector matched
     nothing and every frame silently fell back to the HTML default 300x150.
     Measured, not spotted: both rails reported a 300px shell. (RfDevice
     avoids this only because its sizing lives in a global stylesheet.) */
  .sbn-frames { display: grid; gap: var(--bo-space-5); }
  :global(.sbn-frame) {
    inline-size: 100%;
    block-size: 20rem;
    border: var(--bo-border-width) solid var(--bo-color-border-default);
    border-radius: var(--bo-radius-md);
  }
  /* 40rem keeps this shell under the 56rem breakpoint at ANY reader viewport,
     so the collapsed rail is guaranteed rather than incidental. */
  :global(.sbn-frame--narrow) { max-inline-size: 40rem; }

  /* The wide frame is a FIXED 60rem and is scaled down to fit. Sizing it at
     100% instead looked right and was not: the docs content column is 1088px
     at a 1600px viewport but well under the 56rem (896px) breakpoint on a
     smaller screen, so the "wide" pane quietly collapsed too and both demos
     showed the same state — measured, both rails 52px. A demo of a
     breakpoint has to hold its side of the breakpoint on every screen. */
  /* transform: scale() shrinks what you SEE, never what the element occupies
     in layout — so the 60rem frame still claimed 60rem and pushed the page
     sideways (measured: 594px of overflow at 390). The wrapper clips it, and
     min-inline-size: 0 stops the grid column sizing itself to the unscaled
     child, which is a grid item's default (auto) behaviour. */
  .sbn-frames > * { min-inline-size: 0; }
  .sbn-scaler { overflow: hidden; max-inline-size: 100%; }
  :global(.sbn-frame--wide) {
    inline-size: 60rem;
    transform-origin: top left;
  }
</style>

<script>
  /* Scale the fixed 60rem frame to whatever width the column actually has,
     and shrink the wrapper to the scaled height so it leaves no gap. */
  const scaler = document.querySelector<HTMLElement>('.sbn-scaler');
  const wide = document.querySelector<HTMLIFrameElement>('.sbn-frame--wide');
  if (scaler && wide) {
    const fit = () => {
      const avail = scaler.getBoundingClientRect().width;
      const natural = wide.offsetWidth || 1;
      const scale = Math.min(1, avail / natural);
      wide.style.transform = `scale(${scale})`;
      scaler.style.blockSize = `${wide.offsetHeight * scale}px`;
    };
    fit();
    window.addEventListener('resize', fit);
  }
</script>

