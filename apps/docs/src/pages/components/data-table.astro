---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const poAppHref = 'https://github.com/Busy-Office/busy-office-ui/tree/main/examples/po-app';
const tableMarkup = `<!-- tabindex="0": the container scrolls when the table
     overflows, and a scrollable region must be keyboard-reachable -->
<div class="bo-data-table-container" tabindex="0">
  <div class="bo-data-table__toolbar">
    <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
      <button class="bo-btn bo-btn--secondary" type="button">Approve</button>
    </div>
    <span class="bo-data-table__selection-count"></span> <!-- live "n selected" -->
    <input class="bo-input" type="search" aria-label="Filter invoices" />
  </div>
  <table class="bo-data-table">
    <thead><tr>
      <th scope="col"><input type="checkbox"
          class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
      <th scope="col" aria-sort="ascending">
        <button class="bo-data-table__sort-btn" type="button">Invoice #</button>
      </th>
      <th scope="col" class="bo-data-table__col--numeric">Amount</th>
    </tr></thead>
    <tbody><tr>
      <td><input type="checkbox" name="id" value="INV-1"
          class="bo-checkbox bo-data-table__row-select" aria-label="Select INV-1" /></td>
      <!-- name/value make the selection POSTable:
           hx-include=".bo-data-table__row-select:checked" or a plain form. -->
      <td class="bo-data-table__col--code">INV-1</td>
      <td class="bo-data-table__col--numeric">$4,208.00</td>
    </tr></tbody>
  </table>
</div>
<script type="module">
  import { initDataTables } from "@busy-office/ui/js";
  initDataTables(); // select-all, live count, O(1) toolbar reveal
</script>
<!-- Sorting contract: YOUR code (server or client) re-orders rows and sets
     aria-sort on the <th>; the CSS draws the indicator from aria-sort. -->`;
const gridMarkup = `<table class="bo-data-table" data-grid-nav>
  <thead><tr>
    <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
    <th scope="col">Invoice #</th>
    <th scope="col" class="bo-data-table__col--numeric">Amount</th>
  </tr></thead>
  <tbody><tr>
    <td><input type="checkbox" class="bo-checkbox bo-data-table__row-select" aria-label="Select INV-1" /></td>
    <td class="bo-data-table__col--code">INV-1</td>
    <td class="bo-data-table__col--numeric">$4,208.00</td>
  </tr></tbody>
</table>
<script type="module">
  import { initDataGrid } from "@busy-office/ui/js";
  initDataGrid(); // role=grid, two-axis roving tabindex, Enter/Escape into-and-out-of a cell's widget
</script>`;
const rowEditMarkup = `<table class="bo-data-table" data-row-edit>
  <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Qty</th><th scope="col"><span class="bo-visually-hidden">Actions</span></th></tr></thead>
  <tbody>
    <tr data-row-id="WIDGET-A">
      <td>Widget A</td>
      <td class="bo-data-table__col--numeric">
        <input class="bo-input bo-input--seamless bo-input--numeric" value="12" aria-label="Quantity for Widget A" />
      </td>
      <td class="bo-data-table__row-edit-actions">
        <span class="bo-badge bo-badge--warning" data-row-edit-dirty hidden>Unsaved</span>
        <button class="bo-btn bo-btn--sm" type="button" data-row-edit-save hidden>Save</button>
        <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-row-edit-cancel hidden>Cancel</button>
      </td>
    </tr>
  </tbody>
</table>
<script type="module">
  import { initRowEdit } from "@busy-office/ui/js";
  initRowEdit();
  document.addEventListener("bo:row-save", (e) => {
    // e.detail = { row, rowId } — versioned payload, see JS behaviors → Intent events
  });
</script>`;
const rows = [
  { no: 'INV-10234', vendor: 'Acme Supply Co.', cc: 'CC-4021', amount: '$4,208.00', status: 'Pending', tone: 'warning' },
  { no: 'INV-10235', vendor: 'Globex Industrial', cc: 'CC-4021', amount: '$18,940.50', status: 'Approved', tone: 'success' },
  { no: 'INV-10236', vendor: 'Initech GmbH', cc: 'CC-1180', amount: '$730.25', status: 'Rejected', tone: 'danger' },
  { no: 'INV-10237', vendor: 'Umbrella Logistics', cc: 'CC-2205', amount: '$2,110.00', status: 'Pending', tone: 'warning' },
  { no: 'INV-10238', vendor: 'Stark Components', cc: 'CC-1180', amount: '$56,000.00', status: 'Approved', tone: 'success' },
];
---
<Gallery title="Data table">
  <p class="demo-note">
    Check a row — the bulk-action toolbar appears via <code>:has()</code>, zero JS.
    Sticky header, tabular numerals, density-aware row heights, container-query
    auto-compaction below 480px container width. Two tiers, same markup family:
    <strong>Simple</strong> (below) covers selection/sort/filter for free; reach for
    <strong>Advanced</strong> (<code>data-grid-nav</code> + <code>initDataGrid()</code>,
    further down this page) only when a screen genuinely needs full two-axis
    keyboard navigation — most tables don't.
  </p>
  <section class="demo">
    <h2>Simple — select, sort, filter</h2>
    <div class="bo-data-table-container" tabindex="0">
      <div class="bo-data-table__toolbar">
        <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
          <button class="bo-btn bo-btn--secondary" type="button">Approve</button>
          <button class="bo-btn bo-btn--danger" type="button">Reject</button>
        </div>
        <span class="bo-data-table__selection-count"></span>
        <input class="bo-input" type="search" aria-label="Filter invoices" placeholder="Filter invoices…" style="max-inline-size: 16rem" />
      </div>
      <table class="bo-data-table">
        <thead>
          <tr>
            <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
            <th scope="col" aria-sort="ascending">
              <button class="bo-data-table__sort-btn" type="button">Invoice #</button>
            </th>
            <th scope="col">Vendor</th>
            <th scope="col" class="bo-data-table__col--secondary">Cost center</th>
            <th scope="col" class="bo-data-table__col--numeric">Amount</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><input type="checkbox" class="bo-checkbox bo-data-table__row-select" aria-label={`Select ${r.no}`} /></td>
              <td class="bo-data-table__col--code">{r.no}</td>
              <td>{r.vendor}</td>
              <td class="bo-data-table__col--secondary bo-data-table__col--code">{r.cc}</td>
              <td class="bo-data-table__col--numeric">{r.amount}</td>
              <td><span class={`bo-badge bo-badge--${r.tone}`}>{r.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="demo">
    <h2>Toolbar — column visibility &amp; export <span class="bo-badge">opt-in</span></h2>
    <div class="bo-data-table-container" tabindex="0">
      <div class="bo-data-table__toolbar">
        <div class="bo-cluster" style="--bo-cluster-gap: var(--bo-space-2)">
          <button class="bo-btn bo-btn--secondary" popovertarget="cols-menu-demo" data-multiselect-label="Columns">Columns</button>
          <div class="bo-dropdown__menu" id="cols-menu-demo" popover data-multiselect>
            <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" data-col-toggle="vendor" checked /> Vendor</label>
            <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" data-col-toggle="cc" checked /> Cost center</label>
            <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" data-col-toggle="status" checked /> Status</label>
          </div>
          <button class="bo-btn bo-btn--secondary" type="button" data-table-export data-table-export-format="csv">Export</button>
        </div>
      </div>
      <table class="bo-data-table">
        <thead>
          <tr>
            <th scope="col" data-col="no">Invoice #</th>
            <th scope="col" data-col="vendor">Vendor</th>
            <th scope="col" data-col="cc">Cost center</th>
            <th scope="col" class="bo-data-table__col--numeric" data-col="amount">Amount</th>
            <th scope="col" data-col="status">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.slice(0, 3).map((r) => (
            <tr>
              <td class="bo-data-table__col--code" data-col="no">{r.no}</td>
              <td data-col="vendor">{r.vendor}</td>
              <td class="bo-data-table__col--code" data-col="cc">{r.cc}</td>
              <td class="bo-data-table__col--numeric" data-col="amount">{r.amount}</td>
              <td data-col="status"><span class={`bo-badge bo-badge--${r.tone}`}>{r.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted"><strong>Columns</strong> is the same multi-select
    dropdown pattern as elsewhere (<code>data-multiselect</code>, real checkboxes)
    — checking/unchecking a <code>data-col-toggle</code> box shows/hides every
    <code>&lt;th&gt;</code>/<code>&lt;td&gt;</code> with the matching
    <code>data-col</code>, scoped to this table only. <strong>Export</strong>
    dispatches <code>bo:table-export</code> with a <code>format</code> — this
    behavior only tracks the intent, generating and downloading the actual file
    is your code (fetch a server export endpoint, or build a client-side CSV/PDF)
    — same split as <code>bo:row-save</code> and <code>bo:scan</code>. Try it:
    uncheck a column, then click Export.</p>
  </section>
  <section class="demo">
    <h2>Advanced — keyboard grid navigation <span class="bo-badge">opt-in</span></h2>
    <p class="bo-u-text-muted">
      The second tier: <code>data-grid-nav</code> + <code>initDataGrid()</code> turns
      the table into a WAI-ARIA APG "Grid": <code>role="grid"</code> (cells get their
      <code>gridcell</code>/<code>columnheader</code> roles implicitly — no per-cell
      markup needed), <code>aria-selected</code> synced from the row checkboxes, and
      two-axis roving tabindex — Tab enters the grid at ONE cell, arrow keys move the
      cursor (clamped, no wrap), <kbd>Enter</kbd> focuses a cell's single widget (the
      checkbox), <kbd>Esc</kbd> hands focus back to the cell. Reach for this when a
      screen is genuinely spreadsheet-like (dense data entry, heavy keyboard use) —
      the Simple tier above is enough for most tables, including ones with sort and
      bulk-select. Click into the table below, then try arrow keys.
    </p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-grid-nav id="grid-nav-demo">
        <thead>
          <tr>
            <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
            <th scope="col">Invoice #</th>
            <th scope="col" class="bo-data-table__col--numeric">Amount</th>
          </tr>
        </thead>
        <tbody>
          {rows.slice(0, 3).map((r) => (
            <tr>
              <td><input type="checkbox" class="bo-checkbox bo-data-table__row-select" aria-label={`Select ${r.no}`} /></td>
              <td class="bo-data-table__col--code">{r.no}</td>
              <td class="bo-data-table__col--numeric">{r.amount}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <pre><code>{gridMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Narrow container → auto-compaction</h2>
    <div style="max-inline-size: 420px">
      <div class="bo-data-table-container" tabindex="0">
        <table class="bo-data-table bo-data-table--striped">
          <thead>
            <tr>
              <th scope="col">Invoice #</th>
              <th scope="col">Vendor</th>
              <th scope="col" class="bo-data-table__col--secondary">Cost center</th>
              <th scope="col" class="bo-data-table__col--numeric">Amount</th>
            </tr>
          </thead>
          <tbody>
            {rows.slice(0, 3).map((r) => (
              <tr>
                <td class="bo-data-table__col--code">{r.no}</td>
                <td>{r.vendor}</td>
                <td class="bo-data-table__col--secondary">{r.cc}</td>
                <td class="bo-data-table__col--numeric">{r.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="bo-u-text-muted">The cost-center column hides itself; rows tighten — driven by the container's width, not the viewport.
    <strong>Reflow requirement (WCAG 1.4.10):</strong> data hidden by compaction must stay
    reachable — give rows a detail view (like the PO # link pattern) or don't mark
    columns <code>--secondary</code>.</p>
  </section>
  <section class="demo">
    <h2>Inline edit — seamless inputs in cells</h2>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 24rem">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Qty</th></tr></thead>
        <tbody>
          <tr>
            <td>Widget A</td>
            <td class="bo-data-table__col--numeric">
              <input class="bo-input bo-input--seamless bo-input--numeric" value="12" aria-label="Quantity for Widget A" />
            </td>
          </tr>
          <tr>
            <td>Widget B</td>
            <td class="bo-data-table__col--numeric">
              <input class="bo-input bo-input--seamless bo-input--numeric" value="4" aria-label="Quantity for Widget B" />
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">The cell is <em>always</em> a real input
    (<code>.bo-input--seamless</code>): it reads as text until hover/focus, so keyboard
    and screen-reader semantics never flip between display and edit modes. Persist with
    a form submit or <code>hx-patch</code> on change.</p>
  </section>
  <section class="demo">
    <h2>Multi-row inline edit — dirty state + save/cancel</h2>
    <p class="bo-u-text-muted">This is the <strong>simple</strong> starting
    point of the editable-table path — plain cells, dirty badge,
    Save/Cancel. The graded continuation (combobox lookup cells, every
    cell type, realtime totals, save-per-change, a full PO line-items
    editor) lives on the
    <a href={base + '/patterns/editable-grid'}>Editable grid pattern</a>.</p>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 28rem">
      <table class="bo-data-table" data-row-edit>
        <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Qty</th><th scope="col"><span class="bo-visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <tr data-row-id="WIDGET-A">
            <td>Widget A</td>
            <td class="bo-data-table__col--numeric">
              <input class="bo-input bo-input--seamless bo-input--numeric" value="12" aria-label="Quantity for Widget A (editable row)" />
            </td>
            <td class="bo-data-table__row-edit-actions">
              <span class="bo-badge bo-badge--warning" data-row-edit-dirty hidden>Unsaved</span>
              <button class="bo-btn bo-btn--sm" type="button" data-row-edit-save hidden>Save</button>
              <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-row-edit-cancel hidden>Cancel</button>
            </td>
          </tr>
          <tr data-row-id="WIDGET-B">
            <td>Widget B</td>
            <td class="bo-data-table__col--numeric">
              <input class="bo-input bo-input--seamless bo-input--numeric" value="4" aria-label="Quantity for Widget B (editable row)" />
            </td>
            <td class="bo-data-table__row-edit-actions">
              <span class="bo-badge bo-badge--warning" data-row-edit-dirty hidden>Unsaved</span>
              <button class="bo-btn bo-btn--sm" type="button" data-row-edit-save hidden>Save</button>
              <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-row-edit-cancel hidden>Cancel</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Same seamless input as above, plus
    <code>data-row-edit</code> on the table: typing marks the row
    <code>data-row-state="dirty"</code> (amber tint, same visual channel the
    error row state uses) and reveals that row's badge + Save/Cancel. Cancel
    resets the row's inputs to their last-saved value; Save dispatches a
    <code>bo:row-save</code> event with the row and its <code>data-row-id</code>
    — your code persists it (fetch, <code>hx-patch</code>, form submit), this
    behavior only tracks dirty state. Try it: edit a quantity below.</p>
  </section>
  <section class="demo">
    <h2>The full list screen, assembled</h2>
    <div class="bo-data-table-container" tabindex="0">
      <div class="bo-data-table__toolbar">
        <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
          <button class="bo-btn bo-btn--secondary" type="button">Approve</button>
        </div>
        <span class="bo-data-table__selection-count"></span>
        <input class="bo-input" type="search" aria-label="Filter" placeholder="Filter…" style="max-inline-size: 14rem" />
      </div>
      <table class="bo-data-table bo-data-table--sticky-col">
        <thead><tr>
          <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
          <th scope="col">Invoice #</th><th scope="col">Vendor</th>
          <th scope="col" class="bo-data-table__col--numeric">Amount</th><th scope="col">Status</th>
        </tr></thead>
        <tbody>
          {rows.slice(0, 3).map((r) => (
            <tr>
              <td><input type="checkbox" class="bo-checkbox bo-data-table__row-select" aria-label={`Select ${r.no}`} /></td>
              <td class="bo-data-table__col--code">{r.no}</td>
              <td>{r.vendor}</td>
              <td class="bo-data-table__col--numeric">{r.amount}</td>
              <td><span class={`bo-badge bo-badge--${r.tone}`}>{r.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="bo-data-table__footer">
        <label class="bo-choice">Rows
          <select class="bo-select" style="inline-size:auto" aria-label="Rows per page"><option>25</option><option>50</option></select>
        </label>
        <nav class="bo-pagination" aria-label="Pagination">
          <button class="bo-pagination__btn" type="button" disabled aria-label="Previous page">‹</button>
          <a class="bo-pagination__btn" aria-current="page" href="#">1</a>
          <a class="bo-pagination__btn" href="#">2</a>
          <button class="bo-pagination__btn" type="button" aria-label="Next page">›</button>
          <span class="bo-pagination__info">1–25 of 312</span>
        </nav>
      </div>
    </div>
    <p class="bo-u-text-muted">Everything on one screen the way a real invoice list
    ships: toolbar + <code>--sticky-col</code> (the selection column stays put when
    the table scrolls sideways) + the <code>__footer</code> carrying rows-per-page
    and <a href={base + '/components/pagination'}>pagination</a>. Scroll the table
    horizontally in a narrow window to see the sticky column earn its keep.</p>
  </section>
  <section class="demo">
    <h2>Loading & error rows</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-loading="true" aria-busy="true">
        <thead><tr><th scope="col">Invoice #</th><th scope="col" class="bo-data-table__col--numeric">Amount</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">INV-10234</td><td class="bo-data-table__col--numeric">$4,208.00</td></tr>
          <tr><td class="bo-data-table__col--code">INV-10235</td><td class="bo-data-table__col--numeric">$18,940.50</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted"><code>data-loading="true"</code> (or
    <code>aria-busy</code>) dims the table and blocks interaction mid-swap — flip it
    from your fetch/HTMX code. For first-load, prefer
    <a href={base + '/components/state-patterns'}>skeleton rows</a>.</p>
    <div class="bo-data-table-container" tabindex="0" style="margin-block-start: var(--bo-space-4)">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Invoice #</th><th scope="col">Problem</th><th scope="col" class="bo-data-table__col--numeric">Amount</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">INV-10240</td><td>—</td><td class="bo-data-table__col--numeric">$1,120.00</td></tr>
          <tr data-row-state="error"><td class="bo-data-table__col--code">INV-10241</td><td><span class="bo-badge bo-badge--danger">Duplicate</span> already posted as INV-10198</td><td class="bo-data-table__col--numeric">$5,300.00</td></tr>
          <tr><td class="bo-data-table__col--code">INV-10242</td><td>—</td><td class="bo-data-table__col--numeric">$980.00</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted"><code>data-row-state="error"</code> — the tint plus a
    start border, and the badge/message in the row carries the reason (two-channel:
    never the color alone). This is the visual channel the dirty row state
    above reuses in amber.</p>
  </section>
  <section class="demo">
    <h2>Performance at scale — measured, not guessed</h2>
    <p>Measured 2026-08-15 against the full table stack (sticky header, row
    checkboxes, badges, container query, <code>initDataTables()</code>) in the
    <a href={poAppHref}><code>examples/po-app</code></a> stress harness (<code>/stress?n=…</code>):</p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col" class="bo-data-table__col--numeric">Rows</th><th scope="col" class="bo-data-table__col--numeric">Initial render</th><th scope="col" class="bo-data-table__col--numeric">Select-all</th><th scope="col" class="bo-data-table__col--numeric">Post-bulk-check style flush</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--numeric">1,000</td><td class="bo-data-table__col--numeric">85 ms</td><td class="bo-data-table__col--numeric">4 ms</td><td class="bo-data-table__col--numeric">negligible</td></tr>
          <tr><td class="bo-data-table__col--numeric">5,000</td><td class="bo-data-table__col--numeric">174 ms</td><td class="bo-data-table__col--numeric">18 ms</td><td class="bo-data-table__col--numeric">231 ms</td></tr>
          <tr><td class="bo-data-table__col--numeric">20,000</td><td class="bo-data-table__col--numeric">558 ms</td><td class="bo-data-table__col--numeric">49 ms</td><td class="bo-data-table__col--numeric">610 ms</td></tr>
          <tr><td class="bo-data-table__col--numeric">5,000 <span class="bo-badge">4× CPU throttle</span></td><td class="bo-data-table__col--numeric">1,625 ms</td><td class="bo-data-table__col--numeric">15 ms</td><td class="bo-data-table__col--numeric">174 ms</td></tr>
          <tr><td class="bo-data-table__col--numeric">20,000 <span class="bo-badge">4× CPU throttle</span></td><td class="bo-data-table__col--numeric">3,783 ms</td><td class="bo-data-table__col--numeric">60 ms</td><td class="bo-data-table__col--numeric">686 ms</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">The 4×-throttle rows approximate older corporate
    hardware (added after the decisions grill challenged the single-machine
    evidence). Render and scroll scale linearly with no cliff; the recurring cost
    is the <em>bulk-select style recalculation</em> (the selected-row tint
    re-evaluating per row) — it repeats on EVERY bulk toggle, staying under 700 ms
    even throttled. The genuine pain point is initial render at 20k rows on slow
    hardware (~3.8 s). Practical guidance: a few thousand rows are fine as-is;
    beyond that, paginate server-side (<a href={base + '/components/pagination'}>page
    numbers or load-more</a>) — which dense ERP screens want anyway for
    findability. <strong>There are no virtualization hooks</strong>: windowing
    breaks Ctrl-F, select-all semantics, and screen-reader row counts, and
    pagination is the answer at the scale where tables stop being scannable.
    Re-open condition, not dogma: if a real deployment measures interaction costs
    breaching ~1 s at row counts it genuinely cannot paginate, the
    <code>/stress</code> harness in <a href={poAppHref}><code>examples/po-app</code></a> is kept for
    exactly that re-measurement.</p>
  </section>
  <section class="demo">
    <h2>Grouped rows + subtotals</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead><tr>
          <th scope="col">PO #</th>
          <th scope="col">Vendor</th>
          <th scope="col" class="bo-data-table__col--numeric">Amount</th>
        </tr></thead>
        <tbody>
          <tr><th scope="rowgroup" colspan="3">CC-1180 — Facilities</th></tr>
          <tr><td class="bo-data-table__col--code">PO-88212</td><td>Initech GmbH</td><td class="bo-data-table__col--numeric">$730.25</td></tr>
          <tr><td class="bo-data-table__col--code">PO-88214</td><td>Stark Components</td><td class="bo-data-table__col--numeric">$56,000.00</td></tr>
          <tr><td colspan="2" class="bo-data-table__col--right">Subtotal CC-1180</td><td class="bo-data-table__col--numeric">$56,730.25</td></tr>
        </tbody>
        <tbody>
          <tr><th scope="rowgroup" colspan="3">CC-4021 — Warehouse</th></tr>
          <tr><td class="bo-data-table__col--code">PO-88210</td><td>Acme Supply Co.</td><td class="bo-data-table__col--numeric">$4,208.00</td></tr>
          <tr><td colspan="2" class="bo-data-table__col--right">Subtotal CC-4021</td><td class="bo-data-table__col--numeric">$4,208.00</td></tr>
        </tbody>
        <tbody>
          <tr><td colspan="2" class="bo-data-table__col--right"><strong>Grand total</strong></td><td class="bo-data-table__col--numeric"><strong>$60,938.25</strong></td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">No grouping component exists because none is needed —
    this composes from plain HTML table semantics the CSS already styles: one
    <code>&lt;tbody&gt;</code> per group, the group header a
    <code>&lt;th scope="rowgroup" colspan&gt;</code> row (bold by default; the
    <code>scope</code> declares it heads its <code>&lt;tbody&gt;</code> — screen-reader
    support for rowgroup association varies, so keep group names ALSO in prose/
    captions when the grouping is load-bearing), subtotal and grand-total rows are ordinary
    rows using <code>__col--right</code>/<code>__col--numeric</code>. Proven in the
    <a href={poAppHref}><code>examples/po-app</code></a> "Spend by cost center" screen, both themes.
    Don't combine with <code>--striped</code> (stripes land arbitrarily on summary
    rows) or with row-select/sort (sorting across grouped bodies is your code's
    problem — regroup server-side instead).</p>
  </section>
  <section class="demo">
    <h2>Column alignment</h2>
    <p>Put the same modifier on the <code>&lt;th&gt;</code> and every <code>&lt;td&gt;</code>
    in a column: <code>--left</code>, <code>--center</code>, <code>--right</code>, or
    <code>--numeric</code> (right-aligned <em>and</em> tabular figures, for amounts).</p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead>
          <tr>
            <th scope="col" class="bo-data-table__col--left">Item (left)</th>
            <th scope="col" class="bo-data-table__col--center">Status (center)</th>
            <th scope="col" class="bo-data-table__col--right">Weight (right)</th>
            <th scope="col" class="bo-data-table__col--numeric">Amount (numeric)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="bo-data-table__col--left">Standing desk</td>
            <td class="bo-data-table__col--center"><span class="bo-badge bo-badge--success">Approved</span></td>
            <td class="bo-data-table__col--right">12 kg</td>
            <td class="bo-data-table__col--numeric">1,208.00</td>
          </tr>
          <tr>
            <td class="bo-data-table__col--left">Monitor arm</td>
            <td class="bo-data-table__col--center"><span class="bo-badge bo-badge--warning">Pending</span></td>
            <td class="bo-data-table__col--right">3 kg</td>
            <td class="bo-data-table__col--numeric">92.50</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Alignment is a single class per cell and wins over the
    default (start) reliably — headers and body cells align together.</p>
  </section>
