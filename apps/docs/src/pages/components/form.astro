---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const groupedNumeric = `<!-- data-grouped on a PLAIN numeric input — same
     mechanism as Money and Quantity: grouped on blur, raw value submitted
     via a generated hidden input. + initGroupedNumber() once. -->
<div class="bo-form-field" style="max-inline-size: 16rem">
  <label class="bo-form-field__label" for="grp-budget">Annual budget</label>
  <input class="bo-input bo-input--numeric" id="grp-budget" type="number"
      step="0.01" value="2500000" name="budget" data-grouped
      data-locale="en-US" aria-describedby="grp-budget-hint" />
  <span class="bo-form-field__hint" id="grp-budget-hint">Groups on blur — click in, type a number, tab away</span>
</div>`;

const fieldsRow = `<form class="bo-form-row" novalidate>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="vendor">Vendor</label>
    <input class="bo-input" id="vendor" required aria-describedby="vendor-hint" placeholder="Acme Supply Co." />
    <span class="bo-form-field__hint" id="vendor-hint">Registered vendor name (required — note the automatic asterisk)</span>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="amount">Amount (USD)</label>
    <input class="bo-input bo-input--numeric" id="amount" type="number" step="0.01" inputmode="decimal" value="4208.00" />
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="cc">Cost center</label>
    <input class="bo-input bo-input--code" id="cc" required aria-invalid="true" aria-describedby="cc-error" value="CC-XXXX" />
    <span class="bo-form-field__message" id="cc-error">Unknown cost center code</span>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="status">Status</label>
    <select class="bo-select" id="status">
      <option>Pending</option>
      <option>Approved</option>
      <option>Rejected</option>
    </select>
  </div>
</form>`;

const dates = `<form class="bo-form-row" novalidate>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="d-need">Needed by</label>
    <input class="bo-input" id="d-need" type="date" value="2026-09-15"
        min="2026-08-24" max="2026-12-31" />
    <p class="bo-form-field__hint">min/max fence the fiscal window — the browser enforces it</p>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="d-cut">Cut-off</label>
    <input class="bo-input" id="d-cut" type="datetime-local" value="2026-09-15T17:00" />
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="d-shift">Shift start</label>
    <input class="bo-input" id="d-shift" type="time" value="06:00" step="900" />
    <p class="bo-form-field__hint">step="900" — quarter hours only</p>
  </div>
</form>`;

const reqDisabled = `<form class="bo-form-row" novalidate>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="req-native">Vendor</label>
    <input class="bo-input" id="req-native" required placeholder="required attribute" />
    <span class="bo-form-field__hint">Asterisk from the native <code>required</code> attribute.</span>
  </div>
  <div class="bo-form-field bo-form-field--required">
    <label class="bo-form-field__label" for="req-class">Approver</label>
    <input class="bo-input" id="req-class" aria-required="true" placeholder="--required class" />
    <span class="bo-form-field__hint"><code>--required</code> class draws the asterisk, but it is CSS only — pair it with <code>aria-required="true"</code> on the control, or a screen reader gets the asterisk with nothing programmatic behind it.</span>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="dis-input">PO number</label>
    <input class="bo-input bo-input--code" id="dis-input" value="PO-88213" disabled />
    <span class="bo-form-field__hint">Disabled — system-assigned, never editable here.</span>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="dis-select">Currency</label>
    <select class="bo-select" id="dis-select" disabled><option>USD</option></select>
    <span class="bo-form-field__hint">Disabled select — fixed by company policy.</span>
  </div>
</form>`;

const densityDemo = `<div data-density="compact">
  <form class="bo-form-row" novalidate aria-label="Compact density">
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="den-c1">Vendor (compact)</label>
      <input class="bo-input" id="den-c1" placeholder="28px controls" />
    </div>
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="den-c2">Status</label>
      <select class="bo-select" id="den-c2"><option>Pending</option></select>
    </div>
  </form>
</div>
<div data-density="spacious" style="margin-block-start: var(--bo-space-4)">
  <form class="bo-form-row" novalidate aria-label="Spacious density">
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="den-s1">Vendor (spacious)</label>
      <input class="bo-input" id="den-s1" placeholder="44px controls" />
    </div>
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="den-s2">Status</label>
      <select class="bo-select" id="den-s2"><option>Pending</option></select>
    </div>
  </form>
</div>`;

const seamless = `<p>Recorded value until hover/focus, then visibly a field:
  <input class="bo-input bo-input--seamless" value="Acme Supply Co." aria-label="Vendor (inline edit)" />
  — a form input first, at home in prose and detail views too.</p>`;

const sections = `<form>
  <fieldset class="bo-form-section">
    <legend class="bo-form-section__legend">Vendor details</legend>
    <div class="bo-form-row">
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="fs-name">Name</label>
        <input class="bo-input" id="fs-name" />
      </div>
      <div class="bo-form-field">
        <label class="bo-form-field__label" for="fs-vat">VAT ID</label>
        <input class="bo-input bo-input--code" id="fs-vat" />
      </div>
    </div>
  </fieldset>
  <div class="bo-form-actions">
    <button class="bo-btn bo-btn--secondary" type="button">Cancel</button>
    <button class="bo-btn" type="submit">Save vendor</button>
  </div>
</form>`;

const dependentSelects = `<div class="bo-form-row">
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="dep-country">Country</label>
    <select class="bo-select" id="dep-country" name="country"
        hx-get="/cities" hx-trigger="change" hx-target="#dep-city" hx-swap="innerHTML">
      <option value="">Select a country…</option>
      <option value="DE">Germany</option>
      <option value="US">United States</option>
    </select>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="dep-city">City</label>
    <select class="bo-select" id="dep-city" name="city" disabled>
      <option value="">Select a country first</option>
    </select>
  </div>
</div>`;

const labelStart = `<fieldset class="bo-form-section bo-form-section--label-start">
  <legend class="bo-form-section__legend">Invoice header</legend>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="ls-vendor">Vendor</label>
    <input class="bo-input" id="ls-vendor" value="Acme Supply Co." />
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="ls-terms">Payment terms</label>
    <select class="bo-select" id="ls-terms">
      <option>Net 30</option><option>Net 60</option>
    </select>
    <span class="bo-form-field__hint">From the vendor master; override per invoice.</span>
  </div>
  <div class="bo-form-field">
    <label class="bo-form-field__label" for="ls-note">Internal note</label>
    <textarea class="bo-input" id="ls-note" rows="3">Q3 blanket order.</textarea>
  </div>
</fieldset>`;

const choices = `<div class="bo-cluster">
  <label class="bo-choice"><input type="checkbox" class="bo-checkbox" checked /> Notify approver</label>
  <label class="bo-choice"><input type="checkbox" class="bo-checkbox" disabled /> Disabled option</label>
  <label class="bo-choice"><input type="radio" name="pri" class="bo-radio" checked /> Normal</label>
  <label class="bo-choice"><input type="radio" name="pri" class="bo-radio" /> Urgent</label>
  <label class="bo-choice">Urgent first <input type="checkbox" class="bo-checkbox" /></label>
</div>`;

const fieldMarkup = `<div class="bo-form-field">
  <label class="bo-form-field__label" for="cc">Cost center</label>
  <input class="bo-input bo-input--code" id="cc" required
         aria-invalid="true" aria-describedby="cc-error" value="CC-XXXX" />
  <span class="bo-form-field__message" id="cc-error">
    Unknown cost center code
  </span>
</div>
<!-- CSS shows the error visuals; aria-invalid + aria-describedby are what
     reach a screen reader. No role="alert": this markup came back from the
     server, so it is present at LOAD and a live region announces nothing.
     Both halves are the contract, not just the :has() trick. -->`;
---
<Gallery title="Forms" description="Form fields, sections and layout for data entry, with validation state driven by CSS and paired with the ARIA attributes that make it announced.">
  <p class="demo-note">
    Form fields, sections, and layout for data entry. Validation state is
    CSS-driven via <code>:has()</code>, paired with the ARIA attributes that
    make it announced.
  </p>
  <section class="demo">
    <h2>Fields — label, hint, error</h2>
    <Demo code={fieldsRow} />
    <p class="bo-u-text-muted">The error visuals are pure CSS
    (<code>:has()</code> on the field wrapper reads <code>aria-invalid</code>)
    — the ARIA half (<code>aria-invalid</code> +
    <code>aria-describedby</code>) is what reaches a screen reader. Both
    halves are the contract. This error is present at load, so it carries no
    <code>role="alert"</code>: add one only when the message
    <a href={base + '/concepts/accessibility#live-regions'}>arrives after
    load</a>. <strong>What the message says</strong>: name the violated
    constraint and include the datum the user needs to act — &ldquo;Unknown
    cost center code&rdquo;, or the
    <a href={base + '/patterns/editable-grid'}>editable grid</a>&rsquo;s
    &ldquo;Exceeds on-hand (200)&rdquo; — never a bare &ldquo;Invalid
    value&rdquo;. (Screen-level voices differ by design: the
    <a href={base + '/patterns/validation-summary'}>validation summary</a>
    opens with &ldquo;There is a problem&rdquo;, and document-level strips say
    what is still possible — each stated on its own page.)</p>
  </section>
  <section class="demo" id="dates">
    <h2>Dates and times</h2>
    <Demo code={dates} />
    <p class="bo-u-text-muted"><strong>The framework adds nothing here, and
    that is the answer rather than an omission.</strong> A native
    <code>type="date"</code> already brings the locale's field order, the
    platform's own picker, keyboard segment entry, and validation from
    <code>min</code>/<code>max</code> — all of which an invented widget would
    have to re-implement and would get wrong in at least one locale. Put
    <code>.bo-input</code> on it and it matches every other control on the
    row: measured against a text input at 28/36/44px for compact, comfortable
    and spacious — identical at all three.</p>
    <p class="bo-u-text-muted">The ERP-shaped parts are attributes, not CSS.
    <code>min</code>/<code>max</code> fence a posting period, so the browser
    refuses a date outside it. <code>step</code> on a time field quantises to
    the shift grid. For a <strong>range</strong>, use two fields and set the
    second's <code>min</code> from the first — one line of your own code.
    <strong>Not for a fiscal period</strong> ("P3 2026"): that is a different
    field with its own vocabulary and a date picker is the wrong control for
    it — use a select or a
    <a href={base + '/components/combobox'}>combobox</a> over your period
    list.</p>
    <p class="bo-u-text-muted">To <em>display</em> a date rather than take
    one, the contract is on <a href={base + '/components/amount'}>Amount</a> —
    text plus a worded status badge, never colour alone. The older
    <a href={base + '/components/date'}>Date display component</a> is
    deprecated and kept only until the next major.</p>
  </section>

  <section class="demo">
    <h2>Required & disabled</h2>
    <Demo code={reqDisabled} />
  </section>
  <section class="demo">
    <h2>Density — the same row at compact vs spacious</h2>
    <Demo code={densityDemo} />
    <p class="bo-u-text-muted">One attribute on any wrapper — control heights, font
    sizes, and field gaps move together. Compact for back-office grids, spacious for
    touch/warehouse screens.</p>
  </section>
  <section class="demo">
    <h2>Seamless — inline edit that reads as text</h2>
    <Demo code={seamless} />
    <p class="bo-u-text-muted">The same input the
    <a href={base + '/components/data-table'}>data table</a> uses for cell
    editing.</p>
  </section>
  <section class="demo">
    <h2>Grouped numeric input — <code>data-grouped</code></h2>
    <Demo code={groupedNumeric} />
    <p class="bo-u-text-muted">Thousands separators appear <strong>on
    blur</strong>, never while typing; the submitted value stays the raw
    number (a generated hidden input carries it). One behavior serves this
    plain input, <a href={base + '/components/money'}>Money</a> and
    <a href={base + '/components/quantity'}>Quantity</a> — locale from
    <code>data-locale</code>, precision from <code>step</code>/<code>data-decimals</code>.
    Without JS the field is a native number input: correct, ungrouped.</p>
  </section>


  <section class="demo">
    <h2>Sections &amp; the action bar</h2>
    <Demo code={sections} />
    <p class="bo-u-text-muted">A <code>.bo-form-section</code> is a real
    <code>&lt;fieldset&gt;</code> (its legend is the group's accessible name), and
    <code>.bo-form-actions</code> sticks to the bottom — the framework sets
    <code>scroll-padding-block-end</code> on the scroll container so keyboard focus
    is never hidden underneath it. The full multi-section edit screen, with its
    data contract and dirty-state handling, is
    <a href={base + '/patterns/detail-form'}>the detail-form pattern</a>.
    The bar <strong>wraps</strong> rather than clipping: a screen with three
    or four actions keeps all of them at phone width, on as many rows as it
    takes. Until 2026-08-23 it did not, and the first button was silently
    cut off at 390 — found by building a real screen out of shipped CSS, not
    by a gate, because content overflowing the start edge never shows up in
    an overflow check.</p>
    <h3>Four actions at phone width</h3>
    <div class="demo-phone-screen">
      <div class="bo-form-actions" id="wrap-demo">
        <button class="bo-btn bo-btn--ghost" type="button">Delete</button>
        <button class="bo-btn bo-btn--secondary" type="button">Save as draft</button>
        <button class="bo-btn bo-btn--secondary" type="button">Cancel</button>
        <button class="bo-btn" type="button">Submit for approval</button>
      </div>
    </div>
    <p class="bo-u-text-muted">Four buttons that cannot fit one row at 390px.
    Every one stays reachable; the primary action stays last, where the eye
    and the thumb both end up.</p>
  </section>
  <section class="demo">
    <h2>Dependent selects (HTMX)</h2>
    <Demo code={dependentSelects} />
    <p class="bo-u-text-muted">Picking a country repopulates the city
    select — plain <code>hx-get</code>/<code>hx-trigger="change"</code>/
    <code>hx-target</code> on the <em>driving</em> <code>.bo-select</code>,
    same attributes every other swap on this page uses. No framework
    surface needed: this composes entirely from existing markup.</p>
    <p class="bo-u-text-muted"><strong>Escalate only when this stops
    fitting.</strong> A hidden element with
    <code>hx-trigger="change from:#driving-select"</code> decouples the
    listener from the select itself when several independent things need
    to react to one change. <a href={base + '/getting-started/htmx'}>OOB
    swaps</a> update several dependent selects from one response when a
    single field drives more than one of them at once. Reach for a small
    <code>htmx:after:swap</code>/<code>htmx.ajax()</code> handler only for
    real conditional branching a declarative trigger can't express, and
    sparingly — it is the one strategy here that adds JS.</p>
    <p class="bo-u-text-muted"><strong>Not swapping the whole
    form.</strong> Re-rendering the entire <code>&lt;form&gt;</code> on
    every change is the one shape to avoid: focus moves to wherever the
    swap lands, values in fields the change didn't touch can be dropped
    by a naive server render, and a screen reader gets no signal about
    what actually changed. The same reasoning already governs this
    framework's swap targets elsewhere — <a href={base + '/patterns/master-detail'}>master-detail</a>'s
    panel is deliberately a narrow swap target, never a navigation, so
    the list around it never loses its place.</p>
  </section>
  <section class="demo">
    <h2>Label-start sections</h2>
    <Demo code={labelStart} />
    <p class="bo-u-text-muted">
      <code>--label-start</code> puts every field's label in a shared column
      instead of stacking it above — the dense two-column shape classic ERP
      detail screens use. The values are <strong>top</strong> (the default
      above, unchanged) and <strong>start</strong>, not left/right: start is
      logical, so it flips to the visual right under <code>dir="rtl"</code>,
      and "right" was refused outright — no major design system ships a
      label to the right of a text field, because it puts the value in front
      of the reader before they know what it labels. Different label lengths
      ("Vendor" vs "Payment terms") still start every control at one shared
      edge — the section is a CSS Grid and each field a <code>subgrid</code>
      row, the exact technique <a href={base + '/components/kv'}>key-value
      facts</a> already ships for read-only rows, reused rather than
      invented twice. <strong>Section-level and all-or-nothing on
      purpose</strong> — fields inside share one label column or the section
      doesn't use this at all; there is no per-field override. <strong>Not
      combinable with <code>.bo-form-row</code></strong> — the two answer
      the same "how do I lay out several fields" question two different
      ways. Below 30rem the section collapses back to labels-on-top on its
      own, the same width every other collapsing container in this
      framework (tabs, stepper, the data table) uses — resize this page
      narrow to see it happen with no JS and no breakpoint of your own.</p>
  </section>
  <section class="demo">
    <h2>Choices</h2>
    <Demo code={choices} />
    <p class="bo-u-text-muted">A checkbox/radio's label sits wherever its
    text sits in the markup — <code>.bo-choice</code> is a plain inline-flex
    pairing with no positional CSS, so "the label on the left" or "on the
    right" is just which side of the input the text is written on (the last
    item above). <strong>This is why choice controls get no
    <code>--label-start</code> modifier</strong>: the effect the modifier
    gives text fields, choices already have for free.</p>
  </section>
  <section class="demo">
    <h2>Typing on a phone — the attribute recipe per field</h2>
    <p>Nothing here is a component: these are plain HTML attributes that
    decide which keyboard a phone shows and what its bottom-right key
    says. They cost nothing, and getting them wrong is the most-felt
    mobile defect in a data-entry screen — a numeric keypad for a part
    code, or a "Go" key that submits the form three fields early.</p>
    <div class="demo-phone-screen">
      <form class="bo-form-section">
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-item">Item code</label>
          <input class="bo-input bo-input--code" id="tr-item" name="item"
              autocapitalize="characters" autocorrect="off" spellcheck="false"
              enterkeyhint="next" placeholder="ABC-10924" />
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-qty">Quantity</label>
          <input class="bo-input bo-input--numeric" id="tr-qty" name="qty" type="number"
              inputmode="numeric" step="1" min="0" enterkeyhint="next" />
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-amount">Unit price</label>
          <input class="bo-input bo-input--numeric" id="tr-amount" name="price" type="number"
              inputmode="decimal" step="0.01" enterkeyhint="next" />
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-search">Find a vendor</label>
          <input class="bo-input" id="tr-search" name="q" type="search"
              enterkeyhint="search" placeholder="Search vendors…" />
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-email">Contact email</label>
          <input class="bo-input" id="tr-email" name="email" type="email"
              inputmode="email" autocomplete="email" enterkeyhint="next" />
        </div>
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="tr-note">Note</label>
          <textarea class="bo-input" id="tr-note" name="note" rows="2" enterkeyhint="enter"></textarea>
        </div>
        <div class="bo-form-actions">
          <button class="bo-btn" type="button">Save line</button>
        </div>
      </form>
    </div>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Field</th><th scope="col">Attributes</th><th scope="col">Why this one</th></tr></thead>
        <tbody>
          <tr>
            <td><code>#tr-item</code> Item / part / bin code</td>
            <td><code>autocapitalize="characters"</code> <code>autocorrect="off"</code> <code>spellcheck="false"</code> <code>enterkeyhint="next"</code></td>
            <td>the trio generic mobile-form advice skips, because consumer forms have no part numbers: a phone otherwise lower-cases <code>abc-10924</code>, autocorrects it to a word, and underlines it red. No <code>inputmode</code> — codes are alphanumeric, and forcing the numeric pad hides the letters</td>
          </tr>
          <tr>
            <td><code>#tr-qty</code> Whole quantity</td>
            <td><code>type="number"</code> <code>inputmode="numeric"</code> <code>step="1"</code> <code>enterkeyhint="next"</code></td>
            <td><code>numeric</code>, not <code>decimal</code>: a keypad with a decimal point on a field that rejects decimals invites the error</td>
          </tr>
          <tr>
            <td><code>#tr-amount</code> Money / measured quantity</td>
            <td><code>type="number"</code> <code>inputmode="decimal"</code> <code>step="0.01"</code> <code>enterkeyhint="next"</code></td>
            <td>the decimal pad carries the separator the locale actually uses. With <code>data-grouped</code> the behavior swaps <code>type</code> to <code>text</code> on upgrade and keeps <code>inputmode="decimal"</code> — grouping and a numeric type cannot coexist</td>
          </tr>
          <tr>
            <td><code>#tr-search</code> Search / filter</td>
            <td><code>type="search"</code> <code>enterkeyhint="search"</code></td>
            <td>the key says Search, and iOS adds the clear affordance</td>
          </tr>
          <tr>
            <td><code>#tr-email</code> Contact email</td>
            <td><code>type="email"</code> <code>inputmode="email"</code> <code>autocomplete="email"</code> <code>enterkeyhint="next"</code></td>
            <td><code>autocomplete</code> is the one that saves real typing; the token list is the spec's, never a made-up name — a wrong token silently disables autofill</td>
          </tr>
          <tr>
            <td><code>#tr-note</code> Free-text note</td>
            <td><code>enterkeyhint="enter"</code></td>
            <td>a textarea's Enter must stay a newline; <code>done</code> or <code>send</code> here teaches people that Enter submits, which it does not</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted"><strong>The rule for
    <code>enterkeyhint</code></strong>: it describes what the key DOES in
    your flow, not where the field sits. Every field above says
    <code>next</code> because each is followed by another; only the last
    field before a submit earns <code>done</code>, and only a field that
    posts on Enter earns <code>go</code> or <code>send</code>. A scan
    field is the interesting case — the scanner sends Enter itself, so
    <code>enterkeyhint</code> is cosmetic there and the
    <a href={base + '/components/scan'}>scan input</a> owns that
    behaviour instead. None of this needs JS, a component, or a
    breakpoint, which is why it lives here as a recipe rather than as
    surface: <strong>the framework cannot know your field's meaning</strong>,
    and these attributes are exactly the place where meaning has to be
    stated by hand.</p>
  </section>
