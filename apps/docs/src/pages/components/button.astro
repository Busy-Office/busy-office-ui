---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const variants = `<button class="bo-btn">Primary</button>
<button class="bo-btn bo-btn--secondary">Secondary</button>
<button class="bo-btn bo-btn--ghost">Ghost</button>
<button class="bo-btn bo-btn--danger">Danger</button>
<button class="bo-btn bo-btn--danger-ghost">Reject</button>
<button class="bo-btn bo-btn--icon" aria-label="Settings">⚙</button>`;
const sizes = `<button class="bo-btn">Default</button>
<button class="bo-btn bo-btn--sm">Small</button>
<button class="bo-btn bo-btn--sm bo-btn--ghost bo-btn--icon" aria-label="Move up">↑</button>`;
const states = `<button class="bo-btn" disabled>Disabled</button>
<button class="bo-btn" data-loading="true">Saving…</button>`;
const iconText = `<button class="bo-btn"><span class="bo-icon bo-icon--check-circle" aria-hidden="true"></span>Approve</button>
<button class="bo-btn bo-btn--secondary"><span class="bo-icon bo-icon--truck" aria-hidden="true"></span>Ship</button>
<button class="bo-btn bo-btn--icon" aria-label="Settings"><span class="bo-icon bo-icon--grid" aria-hidden="true"></span></button>
<button class="bo-btn">Text only</button>`;
---
<Gallery title="Button">
  <p class="demo-note">
    The action primitive: variants for emphasis, a small size for dense
    toolbars, and disabled/loading states.
  </p>
  <section class="demo">
    <h2>Variants</h2>
    <Demo code={variants} />
    <p class="bo-u-text-muted"><code>--danger-ghost</code> is a destructive action
    that sits beside a solid primary without competing with it (Approve / Reject).</p>
  </section>
  <section class="demo">
    <h2>Sizes</h2>
    <Demo code={sizes} />
    <p class="bo-u-text-muted"><code>--sm</code> is a 24px control (the WCAG target
    floor) for inline / row actions.</p>
  </section>
  <section class="demo">
    <h2>States</h2>
    <Demo code={states} />
  </section>
  <section class="demo">
    <h2>Icon only, text only, icon + text</h2>
    <Demo code={iconText} />
    <p class="bo-u-text-muted">One primitive, three shapes — no new class for
    any of them: a plain <code>.bo-icon</code> beside text composes because
    <code>.bo-btn</code> is already <code>inline-flex</code> with a gap.
    Every icon here carries <code>aria-hidden="true"</code>, per
    <a href={base + '/components/icon'}>the icon component's own contract</a>
    — checked live: whether the icon is hidden or not changes nothing today
    (the mask has no text content to announce, and the icon-only button's
    <code>aria-label</code> overrides the whole subtree either way), but
    hiding it is the documented default and costs nothing to keep, so every
    demo does it consistently rather than only where it happens to matter
    right now.</p>
  </section>
  <section class="demo">
    <h2>Per-region density override</h2>
    <div class="bo-cluster" data-density="compact">
      <button class="bo-btn bo-btn--secondary">Compact</button>
      <span>← this cluster is <code>data-density="compact"</code> regardless of the global setting</span>
    </div>
  </section>
  <section class="demo">
    <h2>Row actions — small ghosts in a table cell</h2>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 26rem">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Invoice #</th><th scope="col" class="bo-data-table__col--numeric">Amount</th><th scope="col"><span class="bo-visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <tr>
            <td class="bo-data-table__col--code">INV-10234</td>
            <td class="bo-data-table__col--numeric">$4,208.00</td>
            <td>
              <button class="bo-btn bo-btn--sm bo-btn--ghost bo-btn--icon" type="button" aria-label="Edit INV-10234">✎</button>
              <button class="bo-btn bo-btn--sm bo-btn--ghost bo-btn--icon" type="button" aria-label="Duplicate INV-10234">⧉</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">What <code>--sm --ghost --icon</code> exists for:
    per-row actions that don't shout. Each icon button names its ROW in the
    <code>aria-label</code> ("Edit INV-10234", never just "Edit"); for more than
    two actions, collapse into a <a href={base + '/components/dropdown'}>row dropdown</a>.</p>
  </section>
  <section class="demo">
    <h2>Button group — a toolbar, not a choice</h2>
    <div class="bo-btn-group">
      <button class="bo-btn bo-btn--secondary bo-btn--icon" type="button" aria-label="Copy link"><span class="bo-icon bo-icon--doc" aria-hidden="true"></span></button>
      <button class="bo-btn bo-btn--secondary bo-btn--icon" type="button" aria-label="Duplicate"><span class="bo-icon bo-icon--invoice" aria-hidden="true"></span></button>
      <button class="bo-btn bo-btn--secondary" type="button" popovertarget="btngrp-menu">More <span aria-hidden="true">▾</span></button>
    </div>
    {/* The popover menu is a SIBLING of .bo-btn-group, not a child: it
        renders in the top layer regardless of DOM position (that's the
        whole point of [popover]), but border-radius:last-child cares
        about DOM position — nesting it inside the group made the menu
        div the true last child and left the trigger's outer corner
        square. Caught live, not assumed. */}
    <div class="bo-dropdown__menu" id="btngrp-menu" popover>
      <button class="bo-dropdown__item" type="button">Export PDF</button>
      <button class="bo-dropdown__item" type="button">Configure…</button>
    </div>
    <script type="module">
      import { initDropdowns } from '@busy-office/ui/js';
      initDropdowns();
    </script>
    <p class="bo-u-text-muted"><code>.bo-btn-group</code> visually joins
    independent buttons into one control — every button stays its own
    click target. <strong>Not</strong> <code>.bo-segmented</code>: that is
    radios, for picking exactly one of a small set (My approvals / Team
    approvals); a button group is a toolbar where every action fires on
    its own. Each button keeps its own border, focus ring and disabled
    state — only the shared edge between two buttons collapses to one
    line, so <code>:focus-visible</code> still outlines a single button,
    never the whole group.</p>
  </section>
  <ClassRef component="button" />
  <ApiTable component="button"
    notes={['Loading state: flip <code>data-loading="true"</code> (or rely on <code>aria-busy</code>) — CSS handles the rest.',
            'Icon-only buttons (<code>--icon</code>) require an <code>aria-label</code>.',
            'Icon + text needs no modifier — a <code>.bo-icon</code> beside text composes for free; keep the icon <code>aria-hidden="true"</code>.',
            '<code>.bo-btn-group</code> joins a row of buttons into one toolbar — independent actions, not a single-choice picker (that is <code>.bo-segmented</code>).']} />
  <DsaScore component="button" />
  <Related links={[["/concepts/tokens", "Design tokens"], ["/base/colors", "Color scales"]]} />
</Gallery>
