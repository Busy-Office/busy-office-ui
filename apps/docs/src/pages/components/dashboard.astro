---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const statMarkup = `<div class="bo-widget">
  <div class="bo-stat">
    <span class="bo-stat__label">Open invoices</span>
    <span class="bo-stat__value">1,284</span>
    <span class="bo-stat__delta bo-stat__delta--bad">
      <span aria-hidden="true">▲</span> +12%
      <span aria-hidden="true">⚠</span>
      <span class="bo-visually-hidden">increase, worse,</span> vs July
    </span>
  </div>
</div>
<!-- Valence has two channels: the visible ⚠ on BAD deltas (arrow + sign only
     carry direction — a colorblind reader can't tell good ▲ from bad ▲) and
     the visually-hidden text for screen readers. Glyphs are aria-hidden so
     AT hears "+12%, increase, worse, vs July" without triangle noise. -->`;
---
<Gallery title="Dashboard">
  <p class="demo-note">
    Widgets are named containers: a table inside a half-width widget auto-compacts
    while the same table full-width does not. Stat values use proportional figures
    (<code>tabular-nums</code> is reserved for columns); compact big values
    server-side (12.9K, $4.2M). One hero figure per view, maximum.
  </p>
  <ClassRef component="dashboard" />
  <section class="demo">
    <div class="bo-widget-grid" style="--bo-widget-min: 13rem">
      <div class="bo-widget">
        <div class="bo-stat">
          <span class="bo-stat__label">Open invoices</span>
          <span class="bo-stat__value">1,284</span>
          <span class="bo-stat__delta bo-stat__delta--bad"><span aria-hidden="true">▲</span> +12% <span aria-hidden="true">⚠</span><span class="bo-visually-hidden">increase, worse,</span> vs July</span>
        </div>
      </div>
      <div class="bo-widget">
        <div class="bo-stat">
          <span class="bo-stat__label">Approved this week</span>
          <span class="bo-stat__value">$412K</span>
          <span class="bo-stat__delta bo-stat__delta--good"><span aria-hidden="true">▲</span> +8% <span class="bo-visually-hidden">increase, better,</span> vs last week</span>
        </div>
      </div>
      <div class="bo-widget">
        <div class="bo-stat">
          <span class="bo-stat__label">Avg. approval time</span>
          <span class="bo-stat__value">2.4d</span>
          <span class="bo-stat__delta bo-stat__delta--good"><span aria-hidden="true">▼</span> −0.6d <span class="bo-visually-hidden">decrease, better,</span> vs Q2</span>
        </div>
      </div>
      <div class="bo-widget">
        <div class="bo-stat">
          <span class="bo-stat__label">Blocked</span>
          <span class="bo-stat__value">17</span>
          <span class="bo-stat__delta">unchanged vs July</span>
        </div>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Hero figure + span-2 widget</h2>
    <div class="bo-widget-grid" style="--bo-widget-min: 13rem">
      <div class="bo-widget bo-widget--span-2">
        <div class="bo-stat bo-stat--hero">
          <span class="bo-stat__label">Awaiting your approval</span>
          <span class="bo-stat__value">23</span>
          <span class="bo-stat__delta bo-stat__delta--bad"><span aria-hidden="true">▲</span> +6 <span aria-hidden="true">⚠</span><span class="bo-visually-hidden">increase, worse,</span> since yesterday</span>
        </div>
      </div>
      <div class="bo-widget">
        <div class="bo-stat">
          <span class="bo-stat__label">Oldest waiting</span>
          <span class="bo-stat__value">9d</span>
        </div>
      </div>
    </div>
    <p class="bo-u-text-muted">The hero tile spans two columns
    (<code>.bo-widget--span-2</code>) and collapses to one when the <em>grid</em>
    (a named container) drops below its two-column width. One hero per view, max.</p>
  </section>
  <section class="demo">
    <h2>Widget with an embedded table (container-driven compaction)</h2>
    <div class="bo-widget-grid">
      <div class="bo-widget">
        <div class="bo-widget__header">
          <span class="bo-widget__title">Pending approvals</span>
          <a href="#" class="bo-u-text-muted" style="font-size: var(--bo-font-size-xs)">View all</a>
        </div>
        <div class="bo-widget__body bo-widget__body--flush">
          <div class="bo-data-table-container" style="border: none">
            <table class="bo-data-table">
              <thead><tr><th scope="col">Invoice #</th><th scope="col">Vendor</th><th scope="col" class="bo-data-table__col--secondary">Cost center</th><th scope="col" class="bo-data-table__col--numeric">Amount</th></tr></thead>
              <tbody>
                <tr><td class="bo-data-table__col--code">INV-10234</td><td>Acme Supply Co.</td><td class="bo-data-table__col--secondary">CC-4021</td><td class="bo-data-table__col--numeric">$4,208.00</td></tr>
                <tr><td class="bo-data-table__col--code">INV-10237</td><td>Umbrella Logistics</td><td class="bo-data-table__col--secondary">CC-2205</td><td class="bo-data-table__col--numeric">$2,110.00</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="bo-widget">
        <div class="bo-widget__header"><span class="bo-widget__title">Notes</span></div>
        <div class="bo-widget__body">
          <p class="bo-u-text-muted">Resize the window: the table's secondary column
          hides when its <em>widget</em> gets narrow — container queries, not media queries.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Widget parts — header, body, band</h2>
    <p>A widget is <code>__header</code> / <code>__body</code> / <code>__band</code>.
    The band footer carries a status message (<code>--msg</code>) or actions — one
    durable strip. This is what record and approval cards are built from.</p>
    <div class="bo-widget-grid" style="--bo-widget-min: 15rem">
      <article class="bo-widget">
        <header class="bo-widget__header"><span class="bo-widget__title">Actions band</span></header>
        <div class="bo-widget__body">Body content.</div>
        <footer class="bo-widget__band"><button class="bo-btn">Approve</button><button class="bo-btn bo-btn--danger-ghost">Reject</button></footer>
      </article>
      <article class="bo-widget">
        <header class="bo-widget__header"><span class="bo-widget__title">Message band</span></header>
        <div class="bo-widget__body">Body content.</div>
        <footer class="bo-widget__band bo-widget__band--msg">Approved by J. Kim · 12 Aug 2026</footer>
      </article>
    </div>
  </section>
  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{statMarkup}</code></pre>
  </section>
  <ApiTable component="dashboard"
    notes={['Delta valence needs two channels: the visible <code>⚠</code> on bad deltas AND visually-hidden text ("increase, worse,").',
            'Stat values use proportional figures; compact big numbers server-side (12.9K, $4.2M). One hero per view.',
            'Widgets are named containers (<code>bo-widget</code>); the grid is <code>bo-widget-grid</code> — span-2 collapses at the grid&#39;s 2-column threshold.']} />
  <Related links={[["/concepts/container-queries", "Container queries"], ["/base/colors", "Colors & tokens"], ["/patterns/approval", "Approval pattern"]]} />
</Gallery>
