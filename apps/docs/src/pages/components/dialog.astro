---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const dialogMarkup = `<dialog class="bo-dialog" id="approve-dialog"
        aria-labelledby="approve-title" data-state="closed">
  <form method="dialog">
    <header class="bo-dialog__header">
      <h2 class="bo-dialog__title" id="approve-title">Approve purchase order</h2>
      <button class="bo-btn bo-btn--ghost bo-btn--icon" value="cancel"
              aria-label="Close">✕</button>
    </header>
    <div class="bo-dialog__body">…</div>
    <footer class="bo-dialog__footer">
      <button class="bo-btn bo-btn--secondary" value="cancel">Cancel</button>
      <button class="bo-btn" value="confirm">Approve</button>
    </footer>
  </form>
</dialog>
<button class="bo-btn" data-dialog-trigger="approve-dialog">Approve PO…</button>

<script type="module">
  import { initDialogs } from "@busy-office/ui/js";
  initDialogs(); // once, ever — event delegation; HTMX swaps need no re-init
</script>`;
---
<Gallery title="Dialog">
  <p class="demo-note">
    Native <code>&lt;dialog&gt;</code> + <code>initDialogs()</code>: browser handles
    backdrop, ESC, and focus return; the behavior adds trigger wiring, a Tab loop, and
    <code>data-state</code> for the enter animation.
  </p>
  <ClassRef component="dialog" />
  <section class="demo">
    <button class="bo-btn" data-dialog-trigger="approve-dialog">Approve PO…</button>

    <dialog class="bo-dialog" id="approve-dialog" aria-labelledby="approve-title" data-state="closed">
      <form method="dialog">
        <header class="bo-dialog__header">
          <h2 class="bo-dialog__title" id="approve-title">Approve purchase order</h2>
          <button class="bo-btn bo-btn--ghost bo-btn--icon" value="cancel" aria-label="Close">✕</button>
        </header>
        <div class="bo-dialog__body bo-stack">
          <p>Approve <strong>PO-88213</strong> for <span class="bo-u-tabular">$12,400.00</span>?</p>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="comment">Comment (optional)</label>
            <textarea class="bo-input" id="comment" rows="2"></textarea>
          </div>
        </div>
        <footer class="bo-dialog__footer">
          <button class="bo-btn bo-btn--secondary" value="cancel">Cancel</button>
          <button class="bo-btn" value="confirm">Approve</button>
        </footer>
      </form>
    </dialog>
  </section>
  <section class="demo">
    <h2>Wide — for tables and two-column forms</h2>
    <button class="bo-btn bo-btn--secondary" data-dialog-trigger="lines-dialog">Review line items…</button>
    <dialog class="bo-dialog bo-dialog--wide" id="lines-dialog" aria-labelledby="lines-title" data-state="closed">
      <form method="dialog">
        <header class="bo-dialog__header">
          <h2 class="bo-dialog__title" id="lines-title">PO-88213 — line items</h2>
          <button class="bo-btn bo-btn--ghost bo-btn--icon" value="cancel" aria-label="Close">✕</button>
        </header>
        <div class="bo-dialog__body">
          <div class="bo-data-table-container" tabindex="0">
            <table class="bo-data-table" data-density="compact">
              <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Qty</th><th scope="col" class="bo-data-table__col--numeric">Unit</th><th scope="col" class="bo-data-table__col--numeric">Total</th></tr></thead>
              <tbody>
                <tr><td>Standing desk</td><td class="bo-data-table__col--numeric">4</td><td class="bo-data-table__col--numeric">$1,208.00</td><td class="bo-data-table__col--numeric">$4,832.00</td></tr>
                <tr><td>Monitor arm</td><td class="bo-data-table__col--numeric">8</td><td class="bo-data-table__col--numeric">$92.50</td><td class="bo-data-table__col--numeric">$740.00</td></tr>
                <tr><td>Cable tray</td><td class="bo-data-table__col--numeric">12</td><td class="bo-data-table__col--numeric">$18.90</td><td class="bo-data-table__col--numeric">$226.80</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <footer class="bo-dialog__footer">
          <button class="bo-btn bo-btn--secondary" value="cancel">Close</button>
        </footer>
      </form>
    </dialog>
    <p class="bo-u-text-muted"><code>--wide</code> raises the max width for content
    that genuinely needs it — an embedded table (compact density pairs well here) or
    a two-column form. Default width is right for confirmations; don't reach for
    wide by default.</p>
  </section>
  <section class="demo">
    <h2>Destructive confirm — no accidental dismiss</h2>
    <button class="bo-btn bo-btn--danger" data-dialog-trigger="reject-dialog">Reject PO…</button>
    <dialog class="bo-dialog" id="reject-dialog" aria-labelledby="reject-title" data-state="closed" data-dismissible="false">
      <form method="dialog">
        <header class="bo-dialog__header">
          <h2 class="bo-dialog__title" id="reject-title">Reject PO-88213?</h2>
          <button class="bo-btn bo-btn--ghost bo-btn--icon" value="cancel" aria-label="Close">✕</button>
        </header>
        <div class="bo-dialog__body">
          <p>The requester will be notified and the PO returns to draft. This can't
          be undone from this screen.</p>
        </div>
        <footer class="bo-dialog__footer">
          <button class="bo-btn bo-btn--secondary" value="cancel">Keep it</button>
          <button class="bo-btn bo-btn--danger" value="confirm">Reject</button>
        </footer>
      </form>
    </dialog>
    <p class="bo-u-text-muted">Clicking the backdrop closes a dialog <strong>by
    default</strong> (light dismiss). For destructive or must-choose flows, opt out
    with <code>data-dismissible="false"</code> — Esc and the explicit buttons still
    work, only the accidental backdrop click is disarmed. Pair the destructive
    action with <code>.bo-btn--danger</code> and lead with the safe choice.</p>
  </section>
  <ApiTable
    component="dialog"
    js="REQUIRED: initDialogs() — dialogs never open without it. Call once; delegation survives all swaps."
    notes={[
      'ARIA contract: <code>aria-labelledby</code> pointing at the title is YOUR markup; backdrop, Esc, and focus-return come free from native <code>showModal()</code>.',
      'The Tab focus loop and <code>data-state</code> animation sync are supplied by the behavior.',
      'Toasts cannot float above an open modal (top layer) — render confirmations inside the dialog.',
    ]}
  />
  <section class="demo">
    <h2>Markup — the canonical dialog recipe</h2>
    <pre><code>{dialogMarkup}</code></pre>
  </section>
  <script>
    import { initDialogs } from '@busy-office/ui/js';
    initDialogs();
  </script>
  <Related links={[["/concepts/js-behaviors", "JS behaviors"], ["/concepts/accessibility", "Accessibility model"]]} />
</Gallery>
