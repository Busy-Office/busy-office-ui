---
import Gallery from '../../layouts/Gallery.astro';
const dialogMarkup = `<dialog class="eof-dialog" id="approve-dialog"
        aria-labelledby="approve-title" data-state="closed">
  <form method="dialog">
    <header class="eof-dialog__header">
      <h2 class="eof-dialog__title" id="approve-title">Approve purchase order</h2>
      <button class="eof-btn eof-btn--ghost eof-btn--icon" value="cancel"
              aria-label="Close">✕</button>
    </header>
    <div class="eof-dialog__body">…</div>
    <footer class="eof-dialog__footer">
      <button class="eof-btn eof-btn--secondary" value="cancel">Cancel</button>
      <button class="eof-btn" value="confirm">Approve</button>
    </footer>
  </form>
</dialog>
<button class="eof-btn" data-dialog-trigger="approve-dialog">Approve PO…</button>

<script type="module">
  import { initDialogs } from "@busy-office/ui/js";
  initDialogs(); // once, ever — event delegation; HTMX swaps need no re-init
</script>`;
---
<Gallery title="Dialog">
  <p class="demo-note">
    Native <code>&lt;dialog&gt;</code> + <code>initDialogs()</code>: browser handles
    backdrop, ESC, and focus return; the behavior adds trigger wiring, a Tab loop, and
    <code>data-state</code> for the enter animation.
  </p>
  <section class="demo">
    <button class="eof-btn" data-dialog-trigger="approve-dialog">Approve PO…</button>

    <dialog class="eof-dialog" id="approve-dialog" aria-labelledby="approve-title" data-state="closed">
      <form method="dialog">
        <header class="eof-dialog__header">
          <h2 class="eof-dialog__title" id="approve-title">Approve purchase order</h2>
          <button class="eof-btn eof-btn--ghost eof-btn--icon" value="cancel" aria-label="Close">✕</button>
        </header>
        <div class="eof-dialog__body eof-stack">
          <p>Approve <strong>PO-88213</strong> for <span class="eof-u-tabular">$12,400.00</span>?</p>
          <div class="eof-form-field">
            <label class="eof-form-field__label" for="comment">Comment (optional)</label>
            <textarea class="eof-input" id="comment" rows="2"></textarea>
          </div>
        </div>
        <footer class="eof-dialog__footer">
          <button class="eof-btn eof-btn--secondary" value="cancel">Cancel</button>
          <button class="eof-btn" value="confirm">Approve</button>
        </footer>
      </form>
    </dialog>
  </section>
  <section class="demo">
    <h2>Markup — the canonical dialog recipe</h2>
    <pre><code>{dialogMarkup}</code></pre>
  </section>
  <script>
    import { initDialogs } from '@busy-office/ui/js';
    initDialogs();
  </script>
</Gallery>
