---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const skeletonRows = `<div class="bo-stack bo-stack--tight" role="status" aria-busy="true" aria-label="Loading purchase orders">
  <span class="bo-skeleton" style="inline-size: 40%"></span>
  <span class="bo-skeleton" style="inline-size: 90%"></span>
  <span class="bo-skeleton" style="inline-size: 75%"></span>
</div>`;

const skeletonCard = `<div class="bo-cluster" style="--bo-cluster-gap: var(--bo-space-3); align-items: center" role="status" aria-busy="true" aria-label="Loading vendor">
  <span class="bo-skeleton bo-skeleton--circle"></span>
  <div class="bo-stack bo-stack--tight" style="flex: 1">
    <span class="bo-skeleton" style="inline-size: 50%"></span>
    <span class="bo-skeleton bo-skeleton--block"></span>
  </div>
</div>`;

const emptyState = `<div class="bo-state">
  <span class="bo-state__icon" aria-hidden="true">📭</span>
  <p class="bo-state__title">No purchase orders yet</p>
  <p class="bo-state__description">Orders you create will show up here.</p>
  <div class="bo-state__actions">
    <button class="bo-btn">Create purchase order</button>
  </div>
</div>`;

/* The SAME component as emptyState above — no `--empty` modifier exists, and
   none is needed. What separates first-run empty from filtered-empty is the
   CONTENT: which filters caused it, and the one-click way out. Kept as its own
   copyable string because it was the only state section on this page a reader
   could see but not copy. */
const filteredEmptyState = `<div class="bo-state">
  <span class="bo-state__icon" aria-hidden="true">🔍</span>
  <p class="bo-state__title">No POs match these filters</p>
  <p class="bo-state__description">Status "Rejected" + CC-4021 has no results in this period.</p>
  <div class="bo-state__actions">
    <button class="bo-btn bo-btn--secondary" type="button">Clear filters</button>
  </div>
</div>`;

const errorState = `<div class="bo-state bo-state--error">
  <span class="bo-state__icon" aria-hidden="true">⚠</span>
  <p class="bo-state__title">Couldn't load purchase orders</p>
  <p class="bo-state__description">Something went wrong on our end. Try again, or check back shortly.</p>
  <div class="bo-state__actions">
    <button class="bo-btn bo-btn--secondary">Retry</button>
  </div>
</div>`;
---
<Gallery title="Loading, empty &amp; error states" description="The three states every data view needs — loading, nothing to show, and something went wrong — as one component with two settings.">
  <p class="demo-note">
    Three states every data view needs: loading (<code>.bo-skeleton</code>),
    nothing to show (<code>.bo-state</code>), and something went wrong
    (<code>.bo-state--error</code>) — one component, two settings, not two
    separate components. The icon <em>shape</em> differs, not just its color,
    and the title always says which state it is.
    <strong>Not for a failure inside an otherwise-working screen</strong> —
    a full-view error state replaces everything, so using it when one
    fragment failed throws away all the content that DID load. A widget
    that could not refresh or a save that was rejected wants an inline
    <a href={base + '/components/alerts'}>alert</a> beside the thing it is
    about, with the rest of the screen left standing; these states are for
    when there is genuinely nothing else to show.
  </p>

  <section class="demo">
    <h2>Skeleton — text lines</h2>
    <p class="bo-u-text-muted">
      Pair with <code>aria-busy="true"</code> on the loading region — the
      shimmer is the visual channel, <code>aria-busy</code> is the
      programmatic one. Widths are set inline per line so the placeholder
      roughly matches the real content's ragged edge.
    </p>
    <Demo code={skeletonRows} />
  </section>
  <section class="demo">
    <h2><code>--circle</code> / <code>--block</code></h2>
    <p class="bo-u-text-muted">An avatar + two-line card placeholder.</p>
    <Demo code={skeletonCard} />
  </section>
  <ClassRef component="skeleton" />
  <ApiTable component="skeleton" notes={[
    'The shimmer is a continuous loop, not a one-shot transition, so it is NOT driven by the --bo-motion-duration-* tokens — it gets an explicit prefers-reduced-motion override instead (same reasoning as .bo-motion-spin in the Motion module).',
  ]} />
  <DsaScore component="skeleton" />

  <section class="demo">
    <h2>Table first-load — skeleton rows</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Invoice #</th><th scope="col">Vendor</th><th scope="col" class="bo-data-table__col--numeric">Amount</th></tr></thead>
        <tbody aria-busy="true">
          {[1, 2, 3].map(() => (
            <tr>
              <td><span class="bo-skeleton" style="inline-size: 6rem"></span></td>
              <td><span class="bo-skeleton" style="inline-size: 10rem"></span></td>
              <td class="bo-data-table__col--numeric"><span class="bo-skeleton" style="inline-size: 5rem"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">The #1 ERP loading case: real header (columns are
    known), skeleton rows sized like the data they stand in for,
    <code>aria-busy</code> on the <code>&lt;tbody&gt;</code>. For a mid-session
    re-fetch of a table that already has rows, use
    <a href={base + '/components/data-table'}><code>data-loading</code></a> instead — keep
    the stale rows visible and dimmed.</p>
    <pre><code>{`<tbody aria-busy="true">
  <tr>
    <td><span class="bo-skeleton" style="inline-size: 6rem"></span></td>
    <td><span class="bo-skeleton" style="inline-size: 10rem"></span></td>
    <td class="bo-data-table__col--numeric"><span class="bo-skeleton" style="inline-size: 5rem"></span></td>
  </tr>
  …
</tbody>`}</code></pre>
  </section>
  <section class="demo">
    <h2>The motion, and why it is timed this way</h2>
    <div class="bo-stack" id="sk-motion">
      <span class="bo-skeleton" style="inline-size: 60%"></span>
      <span class="bo-skeleton" style="inline-size: 85%"></span>
      <span class="bo-skeleton" style="inline-size: 45%"></span>
    </div>
    <div class="bo-cluster" style="margin-block-start: var(--bo-space-3)">
      <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-sk-speed="1">Normal (1.5s)</button>
      <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-sk-speed="4">Slow it 4&times;</button>
      <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-sk-speed="0">Pause</button>
    </div>
    <p class="bo-u-text-muted"><strong>One sweep, left to right, every 1.5
    seconds.</strong> Published guidance puts the comfortable band at
    <strong>1.5–2s</strong>: under a second reads as glitchy and anxious, over
    two as broken. Slow it 4&times; above to see the band's path clearly — the
    controls are here because a loop that never stops is easy to look straight
    past, which is exactly how this animation shipped broken.</p>
    <p class="bo-u-text-muted"><strong>It used to run four times too far.</strong>
    The gradient is twice the width of its box, and the old keyframes moved it
    from 200% to &minus;200% — four box-widths per cycle, so the highlight
    crossed roughly twice every 1.5s. The duration matched the guidance while
    the <em>travel</em> did not, which is what made it feel fast. Percentage
    <code>background-position</code> aligns the P% point of the image with the
    P% point of the box, so at <code>200%</code> the band starts a full box
    off-screen; <code>100% &rarr; 0%</code> is exactly one pass.
    <strong>Easing matters too</strong>: <code>ease-in-out</code> accelerates
    the band through the middle, which reads as hurried even at the right
    duration. A travelling highlight wants <code>linear</code>.</p>
    <p class="bo-u-text-muted"><strong>Reduced motion stops it and keeps the
    block.</strong> The placeholder still occupies its space and still pairs
    with <code>aria-busy</code>, so nothing is lost — only the movement. That
    also answers the WCAG <em>Pause, Stop, Hide</em> concern for animation
    that outlasts five seconds: the user's own OS preference is the control.</p>
  </section>

  <section class="demo">
    <h2>Empty</h2>
    <Demo code={emptyState} />
  </section>
  <section class="demo">
    <h2>Empty — "no results match your filters"</h2>
    <Demo code={filteredEmptyState} />
    <p class="bo-u-text-muted">Distinct from first-run empty: name the filters that
    caused it and offer the one-click way out — otherwise users assume data loss.
    <strong>It is the same component with different words</strong> — there is no
    <code>--empty</code> modifier and none is needed. A first-run empty says
    "nothing exists yet" and offers <em>create</em>; a filtered empty says
    "nothing matches" and offers <em>clear</em>. Getting that wrong is what
    makes users think their data is gone.</p>
  </section>
  <section class="demo">
    <h2><code>--error</code></h2>
    <Demo code={errorState} />
  </section>
  <ClassRef component="state" />
  <ApiTable component="state" notes={[
    'A .bo-state is decoration around a message — the title/description TEXT is the accessible signal; the icon carries aria-hidden="true" so it is never announced as unlabeled content.',
  ]} />
  <DsaScore component="state" />

  <Related links={[
    ["/base/motion", "Motion"],
    ["/components/dashboard", "Dashboard"],
    ["/concepts/accessibility", "Accessibility model"],
  ]} />
</Gallery>
<script>
  // Showcase control (142.2). Scales the animation duration rather than
  // swapping keyframes, so what you slow down is exactly what ships.
  const box = document.getElementById('sk-motion');
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-sk-speed]');
    if (!btn || !box) return;
    const factor = Number(btn.dataset.skSpeed);
    for (const el of box.querySelectorAll<HTMLElement>('.bo-skeleton')) {
      el.style.animationPlayState = factor === 0 ? 'paused' : 'running';
      if (factor > 0) el.style.animationDuration = `${1.5 * factor}s`;
    }
  });
</script>

