---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readOnly = `<!-- a count, read-only: Amount with a unit -->
<span class="bo-amount">
  <span class="bo-amount__value">1,250</span>
  <span class="bo-amount__unit">ea</span>
</span>`;

const basic = `<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" value="4" min="0" max="99" step="1" inputmode="numeric" aria-label="Quantity" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
</div>`;

const unit = `<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" value="12" min="0" max="500" step="1" inputmode="numeric" aria-label="Quantity" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
  <span class="bo-quantity__unit">kg</span>
</div>`;

const fractional = `<!-- fractional units (weight, volume, time) need a decimal step AND
     inputmode="decimal" — "numeric" implies an integer-only keypad on mobile -->
<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" value="2.50" min="0" max="500" step="0.25" inputmode="decimal" aria-label="Quantity" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
  <span class="bo-quantity__unit">kg</span>
</div>`;

const boundary = `<!-- render the correct disabled state server-side when the starting value is already at a boundary -->
<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity" disabled>&minus;</button>
  <input class="bo-quantity__input" type="number" value="0" min="0" max="10" step="1" inputmode="numeric" aria-label="Quantity" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
</div>
<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" value="10" min="0" max="10" step="1" inputmode="numeric" aria-label="Quantity (at max)" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity" disabled>+</button>
</div>`;

const field = `<div class="bo-form-field">
  <label class="bo-form-field__label" for="qf-1">Quantity</label>
  <div class="bo-quantity">
    <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
    <input class="bo-quantity__input" type="number" id="qf-1" value="150" min="0" max="100" step="1" inputmode="numeric" aria-invalid="true" aria-describedby="qf-1-msg" />
    <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
    <span class="bo-quantity__unit">ea</span>
  </div>
  <p class="bo-form-field__message" id="qf-1-msg" role="alert">Only 100 in stock.</p>
</div>`;

const spacious = `<div data-density="spacious">
  <div class="bo-quantity">
    <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
    <input class="bo-quantity__input" type="number" value="4" min="0" max="99" step="1" inputmode="numeric" aria-label="Quantity" />
    <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
  </div>
</div>`;

const display = `<p>Received <span class="bo-quantity bo-quantity--display">
  <span class="bo-quantity__value">2.50</span>
  <span class="bo-quantity__unit">kg</span>
</span> of <span class="bo-quantity bo-quantity--display">
  <span class="bo-quantity__value">5.00</span>
  <span class="bo-quantity__unit">kg</span>
</span> ordered.</p>`;

const unitSelect = `<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" value="2.50" min="0" step="0.01" inputmode="decimal" aria-label="Quantity" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
  <select class="bo-select bo-quantity__unit-select" aria-label="Unit">
    <option>kg</option>
    <option>g</option>
    <option>each</option>
    <option>box</option>
  </select>
</div>`;

const tableColumn = `<table class="bo-data-table">
  <thead><tr><th>Item</th><th class="bo-data-table__col--numeric">Qty</th></tr></thead>
  <tbody>
    <tr><td>Standing desk</td><td class="bo-data-table__col--numeric">
      <div class="bo-quantity">
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
        <input class="bo-quantity__input" type="number" value="4" min="0" max="99" step="1" inputmode="numeric" aria-label="Quantity" />
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
        <span class="bo-quantity__unit">ea</span>
      </div>
    </td></tr>
    <tr><td>Bulk cable (kg)</td><td class="bo-data-table__col--numeric">
      <div class="bo-quantity">
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
        <input class="bo-quantity__input" type="number" value="2.50" min="0" max="500" step="0.25" inputmode="decimal" aria-label="Quantity" />
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
        <span class="bo-quantity__unit">kg</span>
      </div>
    </td></tr>
  </tbody>
</table>`;

const markup = `<div class="bo-quantity">
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
  <input class="bo-quantity__input" type="number" min="0" max="99" step="1" inputmode="numeric" />
  <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
  <span class="bo-quantity__unit">ea</span>  <!-- optional -->
</div>

<script type="module">
  import { initQuantity } from "@busy-office/ui/js";
  initQuantity(); // once — wires the step buttons; ArrowUp/Down + typing already work natively
</script>`;
---
<Gallery title="Quantity">
  <p class="demo-note">
    A count field, not a currency one — see <a href={base + '/components/amount'}>Amount</a> for
    money. A real <code>type="number"</code> input with increment/decrement buttons;
    <code>min</code>/<code>max</code>/<code>step</code> are native attributes, so
    validation, keyboard behavior, and the buttons' clamping all read from the same
    source of truth.
  </p>

  <p class="demo-note"><strong>The rule for this family:</strong> displaying a value is <a href={base + '/components/amount'}>Amount</a>'s job; capturing one is <a href={base + '/components/money'}>Money</a>'s (currency) or <a href={base + '/components/quantity'}>Quantity</a>'s (count). One display component for every numeric value; two entry components, split by what the value <em>is</em>.</p>

  <section class="demo">
    <h2>Basic</h2>
    <Demo code={basic} />
    <p class="bo-u-text-muted"><strong>Requires <code>initQuantity()</code></strong> —
      without it the buttons are inert, but the input itself still works (native number
      keyboard behavior, and it's a real form field either way).</p>
  </section>

  <section class="demo">
    <h2>With a unit</h2>
    <Demo code={unit} />
    <p class="bo-u-text-muted"><code>__unit</code> is optional, plain text — an ISO/standard
    unit (<code>kg</code>, <code>m</code>, <code>L</code>) or an app-defined custom UOM
    (<code>box</code>, <code>pallet</code>), same as <a href={base + '/components/amount'}>Amount</a>'s
    <code>__currency</code> — no allowlist, just text.</p>
  </section>

  <section class="demo">
    <h2>Read-only display — use Amount</h2>
    <Demo code={readOnly} />
    <p class="bo-u-text-muted">There is no <code>.bo-quantity--display</code>.
    One existed briefly, purely to mirror this component's name, and no screen
    ever used one — every screen that shows a count uses
    <a href={base + '/components/amount'}>Amount</a> with its
    <code>__unit</code> part, which already aligns and tabulates every numeric
    value in a column. It was removed before it reached a release rather than
    kept for symmetry (grill 2026-08-19).</p>
  </section>

  <section class="demo">
    <h2>Interactive unit — precision follows it</h2>
    <Demo code={unitSelect} />
    <p class="bo-u-text-muted">Swap the static <code>__unit</code> span for a
    real <code>&lt;select class="bo-select bo-quantity__unit-select"&gt;</code>:
    changing unit re-derives the input's <code>step</code>/decimals from the
    built-in unit table (kg 2.50 → each 3 → g 3.00) and reformats the value —
    the same mechanics as the <a href={base + '/components/money'}>Money
    field</a>'s currency select. <code>data-decimals</code> on an option or
    the container overrides the table.</p>
  </section>

  <section class="demo">
    <h2>Fractional units — <code>step</code> IS the precision</h2>
    <Demo code={fractional} />
    <p class="bo-u-text-muted">Whole-count units (<code>ea</code>, <code>box</code>) use
    <code>step="1"</code> with <code>inputmode="numeric"</code>; fractional units (weight,
    volume, time) need a decimal <code>step</code> — <code>0.25</code>, <code>0.01</code> —
    AND <code>inputmode="decimal"</code>, since <code>numeric</code> implies an
    integer-only keypad on mobile. <strong>There is no <code>--decimals</code> modifier</strong> —
    a static field's precision is the <code>step</code> you write; a
    <code>__unit-select</code> field derives it from the built-in unit table
    below, with <code>data-decimals</code> overriding either way.</p>
  </section>

  <section class="demo">
    <h2>Unit decimals reference — the complete built-in table</h2>
    <p>Every unit the built-in table knows, case-insensitive.
    <strong>Anything not listed leaves the field's precision entirely
    alone</strong> — real master-data UOM codes (<code>MT</code>,
    <code>ltr</code>, <code>cbm</code>, <code>bundle</code>…) are almost
    never these exact strings, and an unknown unit must never rewrite your
    value (Slice 19 hardening: the earlier default-0 silently rounded
    fractional quantities). Unlike currencies there is no
    ISO-closed list of units, so this is a pragmatic common-ERP set —
    your <code>data-decimals</code> override extends it per field without
    waiting for the table.</p>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 44rem">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Category</th><th scope="col">Units</th><th scope="col" class="bo-data-table__col--numeric">Decimals</th><th scope="col">Example</th></tr></thead>
        <tbody>
          <tr><td>Whole counts</td><td class="bo-data-table__col--code">ea each pc pcs unit item box carton pallet</td><td class="bo-data-table__col--numeric">0</td><td>4 ea</td></tr>
          <tr><td>Weight</td><td class="bo-data-table__col--code">kg g t lb oz</td><td class="bo-data-table__col--numeric">2</td><td>2.50 kg — bulk trade often quotes <code>t</code> at 3 dp, pharma/food <code>kg</code> at 3: override per field</td></tr>
          <tr><td>Weight (fine)</td><td class="bo-data-table__col--code">mg</td><td class="bo-data-table__col--numeric">3</td><td>12.500 mg</td></tr>
          <tr><td>Volume</td><td class="bo-data-table__col--code">L mL gal</td><td class="bo-data-table__col--numeric">2</td><td>3.75 L</td></tr>
          <tr><td>Length / area / cubic</td><td class="bo-data-table__col--code">m cm mm ft in m² m³ (m2 m3)</td><td class="bo-data-table__col--numeric">2</td><td>1.20 m</td></tr>
          <tr><td>Time — labor/machine</td><td class="bo-data-table__col--code">hr hrs h</td><td class="bo-data-table__col--numeric">2</td><td>1.75 hrs</td></tr>
          <tr><td>Time — whole minutes</td><td class="bo-data-table__col--code">min</td><td class="bo-data-table__col--numeric">0</td><td>45 min</td></tr>
          <tr><td>Everything else</td><td>any app-defined UOM</td><td class="bo-data-table__col--numeric">left alone</td><td>2.5 MT stays 2.5</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Programmatic access:
    <code>unitDecimals('kg') → 2</code> (<code>undefined</code> for unknown units), exported next to
    <code>initQuantity</code> — the same shape as the Money field's
    <code>currencyDecimals</code>.</p>
  </section>

  <section class="demo">
    <h2>At a boundary</h2>
    <Demo code={boundary} />
    <p class="bo-u-text-muted">Buttons disable at <code>min</code>/<code>max</code> —
    render the correct <code>disabled</code> server-side for the starting value;
    <code>initQuantity()</code> keeps it in sync reactively after that (clicking,
    typing, or the native spinner keys).</p>
  </section>

  <section class="demo">
    <h2>Inside a form field (validation)</h2>
    <Demo code={field} />
    <p class="bo-u-text-muted">Composes with <code>.bo-form-field</code> like any other
    control — the same two-channel error state (border + message + <code>aria-invalid</code>
    or <code>:user-invalid</code>) applies for free, nothing quantity-specific needed.</p>
  </section>

  <section class="demo">
    <h2>In a table column</h2>
    <div class="bo-data-table-container" tabindex="0">
      <Demo code={tableColumn} />
    </div>
    <p class="bo-u-text-muted">Same component, dropped straight into a
    <code>__col--numeric</code> cell — no table-specific variant needed. Editable
    line-item quantities (a whole-count row and a fractional-unit row here) work
    the same as any other <code>.bo-quantity</code>, increment/decrement included.</p>
  </section>

  <section class="demo">
    <h2>Large-target (warehouse-floor) variant</h2>
    <Demo code={spacious} />
    <p class="bo-u-text-muted">There's no separate "large" modifier — density IS the
    size variant. <code>data-density="spacious"</code> (44px controls) already meets the
    WCAG 2.5.8 minimum target size; scope it to a warehouse-floor screen the same way
    you'd scope <code>compact</code> to a dense table.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>

  <script>
    import { initQuantity } from '@busy-office/ui/js';
    initQuantity();
  </script>

  <ClassRef component="quantity" />
  <ApiTable component="quantity"
    notes={['A count, not currency — see Amount for money values.',
            '<code>min</code>/<code>max</code>/<code>step</code> live on the native <code>&lt;input type="number"&gt;</code>; the step buttons read the same attributes, so there is only one source of truth for the valid range.',
            'Button disabled state at a boundary is kept in sync reactively by <code>initQuantity()</code> — render the correct initial <code>disabled</code> server-side if the starting value is already at min/max.',
            'Composes with <code>.bo-form-field</code> for validation — no quantity-specific error styling.',
            '<code>__unit</code> accepts an ISO/standard unit or an app-defined custom UOM — no allowlist, same convention as Amount\'s <code>__currency</code>.',
            'Decimal precision is expressed via the native <code>step</code> attribute, not a CSS modifier — fractional units need <code>inputmode="decimal"</code>, not the default <code>numeric</code>.',
            'With a <code>__unit-select</code>, precision follows the built-in unit table (see the reference above) — a deliberate, overridable exception to "your app owns the data", mirroring the Money field\'s currency table; <code>data-decimals</code> always wins.',
            '<code>--display</code> is the read-only form — a span composition with <code>__value</code> + <code>__unit</code>, no JS; the same display-vs-edit split as Amount vs this component.']} />
  <Related links={[["/components/amount", "Amount"], ["/components/money", "Money field"], ["/patterns/editable-grid", "Editable grid (composite editor)"], ["/components/form", "Forms"], ["/concepts/density", "Density"]]} />
</Gallery>
