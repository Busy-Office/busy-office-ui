---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
const ddMarkup = `<button class="bo-btn bo-btn--secondary" popovertarget="row-actions">Actions ▾</button>
<div class="bo-dropdown__menu" id="row-actions" popover>
  <button class="bo-dropdown__item" type="button">Duplicate</button>
  <button class="bo-dropdown__item" type="button">Export PDF</button>
  <hr class="bo-dropdown__separator" />
  <button class="bo-dropdown__item bo-dropdown__item--danger" type="button">Void</button>
</div>
<script type="module">
  import { initDropdowns } from "@busy-office/ui/js";
  initDropdowns(); // anchors the menu to its invoker + close-on-select
</script>`;
const multiselectMarkup = `<button class="bo-btn bo-btn--secondary" popovertarget="cc-menu" data-multiselect-label="Cost center">Cost center</button>
<div class="bo-dropdown__menu" id="cc-menu" popover data-multiselect>
  <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-1180" /> CC-1180</label>
  <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-2205" /> CC-2205</label>
  <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-4021" /> CC-4021</label>
</div>
<script type="module">
  import { initDropdowns } from "@busy-office/ui/js";
  initDropdowns(); // same call — multi-select is data-multiselect on the menu, no separate init
</script>`;
---
<Gallery title="Dropdown">
  <p class="demo-note">
    The menu is a native <code>[popover]</code>: it renders in the browser top layer, so
    it is <strong>never clipped</strong> by scrolling table containers and never loses a
    z-index fight with sticky headers or frozen columns. Esc and light dismiss are
    native (and Esc closes the innermost layer first inside a dialog).
    <code>initDropdowns()</code> adds invoker anchoring and close-on-select.
  </p>
  <section class="demo">
    <div class="bo-cluster">
      <button class="bo-btn bo-btn--secondary" popovertarget="demo-actions">Actions ▾</button>
      <div class="bo-dropdown__menu" id="demo-actions" popover>
        <button class="bo-dropdown__item" type="button">Duplicate</button>
        <button class="bo-dropdown__item" type="button">Export PDF</button>
        <hr class="bo-dropdown__separator" />
        <button class="bo-dropdown__item bo-dropdown__item--danger" type="button">Void</button>
      </div>
      <button class="bo-btn bo-btn--ghost" popovertarget="demo-end">End-aligned ▾</button>
      <div class="bo-dropdown__menu bo-dropdown__menu--end" id="demo-end" popover>
        <a class="bo-dropdown__item" href="#">Open in new tab</a>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Inside a data table (the point of the top layer)</h2>
    <div class="bo-data-table-container" tabindex="0" style="max-inline-size: 28rem">
      <table class="bo-data-table bo-data-table--sticky-col">
        <thead><tr><th scope="col">Invoice #</th><th scope="col">Vendor</th><th scope="col"><span class="bo-visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <tr>
            <td class="bo-data-table__col--code">INV-10234</td>
            <td>Acme Supply Co.</td>
            <td>
              <button class="bo-btn bo-btn--ghost bo-btn--icon" popovertarget="row-1-menu" aria-label="Actions for INV-10234">⋯</button>
              <div class="bo-dropdown__menu" id="row-1-menu" popover>
                <button class="bo-dropdown__item" type="button">Approve</button>
                <button class="bo-dropdown__item bo-dropdown__item--danger" type="button">Reject</button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">The row menu escapes the scrolling container — with an
    absolutely-positioned menu this would be clipped.</p>
  </section>
  <section class="demo">
    <h2>Multi-select</h2>
    <div class="bo-cluster">
      <button class="bo-btn bo-btn--secondary" popovertarget="demo-cc" data-multiselect-label="Cost center">Cost center</button>
      <div class="bo-dropdown__menu" id="demo-cc" popover data-multiselect>
        <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-1180" /> CC-1180</label>
        <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-2205" /> CC-2205</label>
        <label class="bo-dropdown__item"><input type="checkbox" class="bo-checkbox" name="cc" value="CC-4021" /> CC-4021</label>
      </div>
    </div>
    <p class="bo-u-text-muted">Real checkboxes, not a custom widget —
    <code>data-multiselect</code> on the menu keeps it open across selections and
    updates the trigger's label ("Cost center" → "Cost center (2)") from
    <code>data-multiselect-label</code>. Tab + Space, no extra keyboard wiring
    needed. Every other menu on the page still closes on select.</p>
    <pre><code>{multiselectMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{ddMarkup}</code></pre>
  </section>
  <script>
    import { initDropdowns } from '@busy-office/ui/js';
    initDropdowns();
  </script>
  <ClassRef component="dropdown" />
  <ApiTable component="dropdown"
    js="Recommended: initDropdowns() — anchors the top-layer popover to its invoker and closes on select. Without it the menu opens centered."
    notes={[
      'The menu is a native <code>[popover]</code>: never clipped by scroll containers, never z-fought by sticky headers; Esc and light dismiss are native.',
      'Multi-select: add <code>data-multiselect</code> to the menu and use real <code>&lt;input type="checkbox"&gt;</code> items (wrapped in a <code>&lt;label&gt;</code>, not a button). Same <code>initDropdowns()</code> call — no separate init function.',
    ]} />
  <Related links={[["/concepts/js-behaviors", "JS behaviors"], ["/components/data-table", "Data table"]]} />
</Gallery>
