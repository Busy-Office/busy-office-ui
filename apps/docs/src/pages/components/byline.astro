---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markup = `<span class="bo-byline"><strong>R. Vance</strong> · Requester · 10 Aug 2026</span>`;
---
<Gallery title="Byline" description="An author, role and timestamp provenance line for a record header, a comment, a feed item or an audit note. One class, plain markup, domain-neutral.">
  <p class="demo-note">
    An author · role · timestamp provenance line — for a record header, a comment, a
    feed item, an audit note. The name is emphasis ink; the rest is secondary. One
    class, plain markup, domain-neutral.
    <strong>Not for packing actor, role and timestamp into a grid cell</strong> —
    a stack of comments or feed entries each carrying their own byline is exactly
    right, because each one is a separate thing the reader reads. A
    <em>table</em> is not: packing actor and timestamp into one cell buries
    the value that differs inside two that repeat, and neither can be
    sorted or filtered on. Give them their own
    <a href={base + '/components/data-table'}>data table</a> columns — the
    line is whether the reader scans DOWN a column, not how many items
    there are. A cell carrying ONE value — a name, with
    <code>__avatar</code> beside it — is not what that rules out: nothing
    repeats, so nothing is buried, and it is the assignee column that
    <a href={base + '/components/avatar'}>avatar</a> documents.
  </p>

  <section class="demo">
    <h2>Default</h2>
    <p><span class="bo-byline"><strong>R. Vance</strong> · Requester · 10 Aug 2026, 9:08</span></p>
    <p><span class="bo-byline"><strong>J. Kim</strong> · Cost-centre manager</span></p>
  </section>

  <section class="demo">
    <h2><code>--compact</code> — dense feeds &amp; card sub-lines</h2>
    <p><span class="bo-byline bo-byline--compact"><strong>M. Okafor</strong> · Warehouse · 13 Aug</span></p>
  </section>

  <section class="demo">
    <h2><code>__avatar</code> — initials or a photo</h2>
    <p class="bo-u-text-muted">
      Optional part, composed from the standalone
      <a href={base + '/components/avatar'}>Avatar</a>: the disc takes
      BOTH classes — <code>.bo-avatar</code> paints it,
      <code>.bo-byline__avatar</code> switches that one byline to a flex
      row. The name already carries the identity as text, so the avatar
      is <code>aria-hidden</code> — decoration, not a second copy of the
      same information.
    </p>
    <p><span class="bo-byline">
      <span class="bo-avatar bo-byline__avatar" aria-hidden="true">RV</span>
      <strong>R. Vance</strong> · Requester · 10 Aug 2026
    </span></p>
    <p><span class="bo-byline">
      <span class="bo-avatar bo-byline__avatar" aria-hidden="true">
        <img src="/favicon.svg" alt="" />
      </span>
      <strong>J. Kim</strong> · Cost-centre manager
    </span></p>
  </section>

  <section class="demo">
    <h2>In context — heading an approval comment</h2>
    <div class="bo-widget" style="inline-size: 100%; max-inline-size: 24rem">
      <div class="bo-widget__body">
        <span class="bo-byline">
          <span class="bo-avatar bo-byline__avatar" aria-hidden="true">JK</span>
          <span><strong>J. Kim</strong> · approved · <time datetime="2026-08-10T15:02">Aug 10, 15:02</time></span>
        </span>
        <p style="margin-block-start: var(--bo-space-2)">"Within Q3 budget — released for payment."</p>
      </div>
    </div>
    <p class="bo-u-text-muted">Where bylines live: heading a comment or approval
    note on a record card, next to the <a href={base + '/components/approval-workflow'}>audit
    trail</a> that logs the same event in one line.</p>
  </section>
<section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>
  <ClassRef component="byline" />
  <ApiTable component="byline"
    notes={['Just markup + one class — wrap the name in <code>&lt;strong&gt;</code> for emphasis ink.',
            'Pairs with a record-type chip (<code>.bo-badge--type</code>) in a widget header — see the record-detail pattern.',
            'The <code>__avatar</code> part is decoration, not a caption — <code>aria-hidden="true"</code> always, since the name is already text in the byline itself.']} />
  <DsaScore component="byline" />
  <Related links={[["/components/badge", "Badge"], ["/components/ordered-list", "Ordered list"], ["/patterns/record-detail", "Record detail pattern"]]} />
</Gallery>
