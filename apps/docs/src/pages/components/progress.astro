---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
import Demo from '../../components/Demo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const basic = `<progress class="bo-progress" max="100" value="71" aria-label="71% of budget consumed"></progress>
<span class="bo-u-text-muted">71% consumed</span>`;

const tones = `<progress class="bo-progress" max="100" value="42"></progress>
<span class="bo-u-text-muted">42% consumed</span><br>
<progress class="bo-progress bo-progress--warning" max="100" value="83"></progress>
<span class="bo-u-text-muted">83% consumed — approaching budget</span><br>
<progress class="bo-progress bo-progress--danger" max="100" value="97"></progress>
<span class="bo-u-text-muted">97% consumed — review before approving</span>`;

const markup = `<!-- A real <progress> element — value/max semantics and the progressbar
     role come from the platform; the class only re-skins it. ALWAYS pair
     with visible text: the fill and its tone are one channel each. -->
<progress class="bo-progress" max="100" value="71"></progress>
<span class="bo-u-text-muted">71% consumed</span>`;
---
<Gallery title="Progress">
  <p class="demo-note">
    Continuous progress — budget consumption, import jobs, storage quotas. A styled
    <strong>native <code>&lt;progress&gt;</code></strong> element (the platform's
    value/max semantics and implicit <code>progressbar</code> role come free — zero
    JS, zero ARIA). Distinct from <a href={base + '/components/stepper'}>Stepper</a>, which is
    for discrete named steps. Always pair it with visible text ("71% consumed") —
    the fill is one channel.
  </p>

  <section class="demo">
    <h2>Basic</h2>
    <Demo code={basic} />
    <p class="bo-u-text-muted">Born from a real dogfood finding: unstyled native
    <code>&lt;progress&gt;</code> renders platform-blue chrome that ignores the
    theme in both light and dark — this class is the token-true re-skin.</p>
  </section>

  <section class="demo">
    <h2>Tones — threshold states</h2>
    <Demo code={tones} />
    <p class="bo-u-text-muted"><code>--warning</code> / <code>--danger</code> for
    approaching/exceeded thresholds. The tone is decoration on top of the text —
    the accompanying text must say it ("approaching budget"), never the color
    alone. Fill-on-track contrast for all three tones is gate-checked at 3:1
    (WCAG 1.4.11) in both themes.</p>
  </section>

  <section class="demo">
    <h2>On a dashboard card</h2>
    <div class="bo-widget" style="inline-size: 100%; max-inline-size: 16rem">
      <div class="bo-widget__header"><span class="bo-widget__title">Budget — CC-4021</span></div>
      <div class="bo-widget__body">
        <div class="bo-stat">
          <span class="bo-stat__label">consumed</span>
          <span class="bo-stat__value">93%</span>
        </div>
        <progress class="bo-progress bo-progress--danger" max="100" value="93"
          aria-label="93% of CC-4021 budget consumed" style="inline-size: 100%; margin-block-start: var(--bo-space-2)"></progress>
      </div>
    </div>
    <p class="bo-u-text-muted">The dashboard pairing: a
    <a href={base + '/components/dashboard#card'}>stat tile</a> carries the number, the bar
    makes the trend scannable at a glance across a grid of cost centers.</p>
  </section>
  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>

  <ClassRef component="progress" />
  <ApiTable
    component="progress"
    notes={[
      'A native <code>&lt;progress&gt;</code> element, not a div — <code>value</code>/<code>max</code> and the <code>progressbar</code> role are platform semantics; the framework only styles it. Give it an accessible name (<code>aria-label</code> or a <code>&lt;label&gt;</code>) — adjacent prose text is NOT programmatically associated, and the name can carry the real value when you visually cap the bar ("112% of budget consumed" with <code>value="100"</code>).',
      'Always pair with visible text ("71% consumed") — the fill is one channel, and tones are decoration on top of the text, never a substitute for it.',
      'Under forced-colors the element reverts to platform rendering (<code>appearance: auto</code>) — custom fills would otherwise vanish entirely.',
      'Always set <code>value</code> — indeterminate (<code>value</code>-less) progress is NOT supported by this styling (<code>appearance: none</code> suppresses the platform\'s indeterminate animation, so "unknown" would render as an empty bar). For unknown-duration work, use <a href="' + base + '/components/state-patterns">Skeleton</a> instead. If a determinate flow LOSES its value mid-stream (an import stalls, the server stops reporting), keep the bar at its last value and let the paired text say so ("stalled at 93%") — don\'t swap components mid-flow.',
      'For discrete named steps (Submitted → Approved → Paid), use <a href="' + base + '/components/stepper">Stepper</a> instead.',
    ]}
  />
  <DsaScore component="progress" />
  <Related links={[["/components/stepper", "Stepper"], ["/components/dashboard", "Dashboard"], ["/concepts/accessibility", "Accessibility model"]]} />
</Gallery>
