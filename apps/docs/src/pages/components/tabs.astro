---
import Gallery from '../../layouts/Gallery.astro';
import ClassRef from '../../components/ClassRef.astro';
import Related from '../../components/Related.astro';
import ApiTable from '../../components/ApiTable.astro';
import DsaScore from '../../components/DsaScore.astro';
const tabsMarkup = `<div class="bo-tabs">
  <div class="bo-tabs__list" role="tablist" aria-label="Purchase order">
    <button class="bo-tabs__tab" role="tab" id="t-details"
            aria-selected="true" aria-controls="p-details">Details</button>
    <button class="bo-tabs__tab" role="tab" id="t-lines" tabindex="-1"
            aria-selected="false" aria-controls="p-lines">Lines</button>
  </div>
  <div class="bo-tabs__panel" role="tabpanel" id="p-details"
       aria-labelledby="t-details" tabindex="0">…</div>
  <div class="bo-tabs__panel" role="tabpanel" id="p-lines"
       aria-labelledby="t-lines" tabindex="0" hidden>…</div>
</div>
<script type="module">
  import { initTabs } from "@busy-office/ui/js";
  initTabs(); // once — arrow keys, Home/End, roving tabindex
</script>`;

/* One panel PER tab. They shared a single `aria-controls="ov-p"` when this demo
   was written for 30.1, which looked right and worked exactly once: initTabs()
   loops every tab setting `panel.hidden = !selected`, so with nine tabs
   pointing at one panel the last one in DOM order wins and hides it (owner
   report, 2026-08-18). */
const overflowTabs = ['Overview','Lines','Schedule','Invoices','Receipts','Approvals','Attachments','Audit trail','Settings'];
/* Twelve, and a 15rem rail below, so the vertical demo actually overflows —
   30.1's tab demo was built with three tabs to show scrolling and could never
   scroll, which is how a defect hid behind a claim for a week. */
const verticalTabs = ['General','Addresses','Contacts','Payment terms','Bank details','Tax','Purchasing','Invoicing','Approvals','Documents','Notes','Audit trail'];
---
<Gallery title="Tabs">
  <p class="demo-note">
    ARIA tabs pattern: CSS styles <code>aria-selected</code>, panels hide via the
    <code>hidden</code> attribute, <code>initTabs()</code> adds roving tabindex and
    arrow-key navigation with automatic activation.
  </p>
  <section class="demo">
    <div class="bo-tabs">
      <div class="bo-tabs__list" role="tablist" aria-label="Purchase order">
        <button class="bo-tabs__tab" role="tab" id="t-details" aria-selected="true" aria-controls="p-details">Details</button>
        <button class="bo-tabs__tab" role="tab" id="t-lines" tabindex="-1" aria-selected="false" aria-controls="p-lines">Lines <span class="bo-badge">3</span></button>
        <button class="bo-tabs__tab" role="tab" id="t-history" tabindex="-1" aria-selected="false" aria-controls="p-history">History</button>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="p-details" aria-labelledby="t-details" tabindex="0">
        <div class="bo-form-row">
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="tab-vendor">Vendor</label>
            <input class="bo-input" id="tab-vendor" value="Umbrella Logistics" readonly />
          </div>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="tab-total">Total</label>
            <input class="bo-input bo-input--numeric" id="tab-total" value="$12,400.00" readonly />
          </div>
        </div>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="p-lines" aria-labelledby="t-lines" tabindex="0" hidden>
        <div class="bo-data-table-container" tabindex="0">
          <table class="bo-data-table" data-density="compact">
            <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Qty</th><th scope="col" class="bo-data-table__col--numeric">Total</th></tr></thead>
            <tbody>
              <tr><td>Pallet jack</td><td class="bo-data-table__col--numeric">2</td><td class="bo-data-table__col--numeric">$5,600.00</td></tr>
              <tr><td>Shrink wrap (roll)</td><td class="bo-data-table__col--numeric">40</td><td class="bo-data-table__col--numeric">$1,800.00</td></tr>
              <tr><td>Labels</td><td class="bo-data-table__col--numeric">12</td><td class="bo-data-table__col--numeric">$5,000.00</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="p-history" aria-labelledby="t-history" tabindex="0" hidden>
        <ol class="bo-audit" role="list">
          <li class="bo-audit__entry">
            <time class="bo-audit__time" datetime="2026-08-10T09:14">08-10 09:14</time>
            <span><span class="bo-audit__actor">R. Vance</span> submitted</span>
          </li>
        </ol>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>More tabs than fit</h2>
    <div class="bo-tabs" style="max-inline-size: 34rem">
      <div class="bo-tabs__list" role="tablist" aria-label="Module areas">
        {overflowTabs.map((label, i) => (
          <button class="bo-tabs__tab" role="tab" id={`ov-t-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}
                  aria-controls={`ov-p-${i}`}>{label}</button>
        ))}
      </div>
      {overflowTabs.map((label, i) => (
        <div class="bo-tabs__panel" role="tabpanel" id={`ov-p-${i}`} aria-labelledby={`ov-t-${i}`}
             tabindex="0" hidden={i !== 0}>
          <p class="bo-u-text-muted">{label} panel. Nine tabs in a 34rem strip: the list scrolls,
          it never wraps and never clips, and <strong>each tab owns its own panel</strong> —
          sharing one panel between tabs looks fine until the second click.</p>
        </div>
      ))}
    </div>
    <p class="bo-u-text-muted">
      A tab strip wider than its container <strong>scrolls sideways</strong>. It
      never wraps and never clips, so no tab is unreachable.
    </p>
    <p class="bo-u-text-muted">
      <strong>The edge fades when there is more to reach</strong> — on the right when
      you are at the start, on the left when you are at the end, both when you are in
      the middle. It appears only when the strip actually overflows, so a strip that
      fits is never dimmed.
    </p>
    <p class="bo-u-text-muted">
      It is a <code>mask</code> rather than a gradient background on purpose: a
      background fade has to know the colour behind it, and this list sits on the page
      canvas here but on a card surface inside an app. A mask fades to transparency, so
      it composites correctly over whatever is actually there. The fade is also dropped
      under <code>forced-colors</code>, where costing contrast to give a hint is the
      wrong trade.
    </p>
    <p class="bo-u-text-muted">
      Why a fade and not arrow buttons: arrows would need either an overlay background
      (the same colour problem) or a wrapper injected into your markup, to duplicate what
      shift+wheel, a trackpad swipe and the arrow keys already do. Keyboard users never
      needed it — arrow keys move between tabs and the browser brings the focused one
      into view, including tabs that are off-screen.
    </p>
  </section>

  <section class="demo">
    <h2>A left rail instead of a strip</h2>
    <div class="bo-tabs bo-tabs--vertical" style="max-inline-size: 44rem; block-size: 15rem">
      <div class="bo-tabs__list" role="tablist" aria-label="Vendor settings">
        {verticalTabs.map((label, i) => (
          <button class="bo-tabs__tab" role="tab" id={`vt-t-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}
                  aria-controls={`vt-p-${i}`}>{label}</button>
        ))}
      </div>
      {verticalTabs.map((label, i) => (
        <div class="bo-tabs__panel" role="tabpanel" id={`vt-p-${i}`} aria-labelledby={`vt-t-${i}`}
             tabindex="0" hidden={i !== 0}>
          <p class="bo-u-text-muted">{label} settings. Twelve sections in a 15rem box: the
          tab list scrolls on its own, and this panel stays put.</p>
        </div>
      ))}
    </div>
    <p class="bo-u-text-muted">
      Add <code>bo-tabs--vertical</code>. That is the whole change — same markup, same
      <code>initTabs()</code>, same parts. Settings screens reach for this once there are
      more sections than fit comfortably across the top, and because the rail runs down
      the page it holds far more of them.
    </p>
    <p class="bo-u-text-muted">
      <strong>The arrow keys follow the rail.</strong> Up and Down move between tabs here;
      Left and Right do in the horizontal strip above. You do not set
      <code>aria-orientation</code> — the behavior reads how the list is actually laid out
      and sets it, which matters because that answer changes with the container width.
    </p>
    <p class="bo-u-text-muted">
      <strong>The rail scrolls when it is taller than its box</strong>, and the fade moves to
      the top and bottom edges to match. Height comes from the panel beside it, so a rail
      with a few tabs simply doesn't scroll and is never dimmed. This demo pins 15rem to
      show the overflow; an app usually gets it from the surrounding screen.
    </p>
    <p class="bo-u-text-muted">
      <strong>Narrow containers get the strip back.</strong> Below 30rem — measured on the
      tab set's own width, not the window's, so a rail inside a widget collapses while the
      page around it is still wide — the rail becomes the horizontal strip, the panel moves
      underneath, and the arrow keys return to Left and Right. Resize this page to see it.
    </p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{tabsMarkup}</code></pre>
    <p class="bo-u-text-muted"><strong>Tabs require <code>initTabs()</code> — there is
    no CSS-only fallback.</strong> Without it the pre-set <code>tabindex="-1"</code>
    leaves tabs 2+ keyboard-unreachable. Arrow keys are direction-aware in RTL.</p>
  </section>
  <script>
    import { initTabs } from '@busy-office/ui/js';
    initTabs();
  </script>
  <ClassRef component="tabs" />
  <ApiTable component="tabs"
    js="REQUIRED: initTabs() — without it tabs 2+ are keyboard-unreachable and inert; there is no CSS-only fallback."
    notes={['ARIA contract: role=tablist/tab/tabpanel, aria-controls/aria-labelledby, panels hidden via the <code>hidden</code> attribute; add <code>role="list"</code> where lists are styled.',
            'Arrow keys are RTL-aware; activation is automatic on focus move.']} />
  <DsaScore component="tabs" />
  <Related links={[["/concepts/js-behaviors", "JS behaviors"], ["/concepts/accessibility", "Accessibility model"]]} />
</Gallery>
