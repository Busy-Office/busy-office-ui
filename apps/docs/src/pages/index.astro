---
// Landing — standalone layout (no docs sidebar). Every number below is
// COMPUTED at build time from the shipped artifacts (site-proposal grill:
// landing claims are script-derived or they don't ship).
import { readFileSync } from 'node:fs';
import { gzipSync } from 'node:zlib';
import { createRequire } from 'node:module';
import '@busy-office/ui/css';
import api from '@busy-office/ui/api';
import contrast from '@busy-office/ui/contrast';

const require = createRequire(import.meta.url);
const minCss = readFileSync(
  require.resolve('@busy-office/ui/css/min'),
  'utf8',
);
const gzipKb = (gzipSync(Buffer.from(minCss)).length / 1024).toFixed(1);
const minKb = (minCss.length / 1024).toFixed(0);
const componentCount = Object.keys(api.components).length;
const contrastPairs = Object.values(contrast.themes)
  .flat()
  .filter((p: any) => p.pass).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const brandCss = `/* brand.css — unlayered, so it wins. An accent swap is a FAMILY swap: */
:root {
  --bo-color-accent-solid: #0f766e;   /* your teal, >= 4.5:1 under white */
  --bo-color-accent-strong: #115e59;
  --bo-color-focus-ring: #0d9488;     /* else focus stays blue */
  --bo-color-bg-selected: #f0fdfa;    /* else selected rows stay blue */
  --bo-font-sans: "Your Corporate Sans", system-ui, sans-serif;
}
/* full recipe incl. the dark-mode rule -> Theming guide */`;
const semanticSide = `<table class="bo-data-table">
  <thead><tr>
    <th scope="col" aria-sort="ascending">
      <button class="bo-data-table__sort-btn">Invoice #</button>
    </th>
    <th class="bo-data-table__col--numeric">Amount</th>
  </tr></thead>
  …`;
const utilitySide = `<table class="w-full text-sm text-left rtl:text-right
  text-gray-500 dark:text-gray-400">
  <thead class="text-xs text-gray-700 uppercase
    bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
  <tr><th scope="col" class="px-6 py-3 font-semibold
    tracking-wider whitespace-nowrap sticky top-0
    cursor-pointer hover:bg-gray-100 …">`;
const htmxSnippet = `<tbody hx-get="/invoices" hx-trigger="every 30s"
       hx-swap="outerHTML settle:300ms">
<!-- .htmx-settling rows flash on update; selection state
     re-derives automatically on htmx:afterSwap -->`;
const pilotKb = (
  gzipSync(
    Buffer.from(
      readFileSync(require.resolve('@busy-office/ui/css/tokens.min'), 'utf8') +
        readFileSync(require.resolve('@busy-office/ui/css/reset.min'), 'utf8') +
        readFileSync(require.resolve('@busy-office/ui/css/components/data-table.min'), 'utf8'),
    ),
  ).length / 1024
).toFixed(1);
const pilotSnippet = `import "@busy-office/ui/css/tokens.min";
import "@busy-office/ui/css/reset.min";
import "@busy-office/ui/css/components/data-table.min";
/* one screen, ~${pilotKb} kB gzipped — the exact files above.
   Your unlayered CSS already outranks all of it. */`;

const invoices = [
  ['INV-10234', 'Acme Supply Co.', 'CC-4021', '$4,208.00', 'Pending', 'warning'],
  ['INV-10235', 'Globex Industrial', 'CC-4021', '$18,940.50', 'Approved', 'success'],
  ['INV-10236', 'Initech GmbH', 'CC-1180', '$730.25', 'Rejected', 'danger'],
  ['INV-10237', 'Umbrella Logistics', 'CC-2205', '$2,110.00', 'Pending', 'warning'],
  ['INV-10238', 'Stark Components', 'CC-1180', '$56,000.00', 'Approved', 'success'],
  ['INV-10239', 'Wayne Industrial', 'CC-2205', '$9,320.75', 'Pending', 'warning'],
];
---
<html lang="en" data-density="compact">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>busy-office-ui — CSS for screens that do work</title>
    <meta name="description" content="CSS-first UI framework for ERP and back-office: semantic components, density as a dimension, the cascade as the API." />
  </head>
  <body>
    <header class="bo-navbar">
      <a class="bo-navbar__brand" href={base + '/'}>busy-office-ui</a>
      <span class="bo-badge">v0.1.0</span>
      <span class="bo-navbar__spacer"></span>
      <nav class="bo-cluster" aria-label="Site">
        <a href={base + '/getting-started/installation'}>Docs</a>
        <a href={base + '/components/data-table'}>Components</a>
        <a href={base + '/patterns/invoice-list'}>Patterns</a>
        <a href="https://github.com/Busy-Office/busy-office-ui">GitHub</a>
      </nav>
    </header>

    <main class="landing">
      <!-- ============ HERO: a system record, live ============ -->
      <section class="hero">
        <div class="hero__copy">
          <p class="eyebrow">BUSY-OFFICE / UI · SYSTEM RECORD</p>
          <h1>CSS for screens<br />that do work.</h1>
          <p class="lede">
            A CSS-first framework for ERP and back-office applications:
            semantic components, density as a first-class dimension, and
            modern CSS with the cascade as the API.
          </p>
          <div class="bo-cluster">
            <a class="bo-btn" href={base + '/getting-started/first-screen'}>Build your first screen</a>
            <a class="bo-btn bo-btn--secondary" href={base + '/components/button'}>Components</a>
          </div>
          <pre class="install"><code>npm i @busy-office/ui</code></pre>
          <p class="install__note">Not on npm yet — pre-publish hardening. Pilot today by
            <a href={base + '/getting-started/installation'}>copying <code>dist/</code> from the repo</a>;
            the package lands as-is when it ships.</p>
          <dl class="meta">
            <div><dt>Bundle</dt><dd><a href="https://github.com/Busy-Office/busy-office-ui/blob/main/apps/docs/src/pages/index.astro">{gzipKb} kB gz</a> <span class="meta__sub">{minKb} kB min · per-component files · computed at build</span></dd></div>
            <div><dt>Dependencies</dt><dd>0 <span class="meta__sub">JS optional — 5 call-once behaviors</span></dd></div>
            <div><dt>Contrast</dt><dd><a href={base + '/base/colors'}>{contrastPairs / 2} pairs × 2 themes</a> <span class="meta__sub">all AA, CI-gated</span></dd></div>
            <div><dt>API</dt><dd><a href={base + '/getting-started/versioning'}>Versioned</a> <span class="meta__sub">classes, tokens, ARIA are semver surface</span></dd></div>
            <div><dt>Floor</dt><dd>Chrome 119 · FF 128 · Safari 17.4 <span class="meta__sub">modern CSS instead of a runtime</span></dd></div>
          </dl>
        </div>

        <div class="hero__demo bo-widget" aria-label="Live demo">
          <div class="bo-widget__header">
            <span class="bo-widget__title">Live — this is the framework, not a screenshot</span>
            <span class="bo-cluster" style="--bo-cluster-gap: var(--bo-space-2)">
              <label class="bo-choice" for="hero-density">Density
                <select class="bo-select" id="hero-density" style="inline-size:auto">
                  <option value="compact" selected>Compact</option>
                  <option value="comfortable">Comfortable</option>
                  <option value="spacious">Spacious</option>
                </select>
              </label>
              <label class="bo-choice" for="hero-theme">Theme
                <select class="bo-select" id="hero-theme" style="inline-size:auto">
                  <option value="light" selected>Light</option>
                  <option value="dark">Dark</option>
                </select>
              </label>
            </span>
          </div>
          <div class="bo-widget__body bo-widget__body--flush hero__tablewrap">
            <div class="bo-data-table-container" style="border:none" id="hero-table">
              <div class="bo-data-table__toolbar">
                <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
                  <button class="bo-btn" type="button">Approve selected</button>
                </div>
                <span class="bo-data-table__selection-count"></span>
                <span class="bo-u-text-muted">check a row →</span>
              </div>
              <table class="bo-data-table bo-data-table--sticky-col">
                <thead><tr>
                  <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
                  <th scope="col" aria-sort="ascending"><button class="bo-data-table__sort-btn" type="button">Invoice #</button></th>
                  <th scope="col">Vendor</th>
                  <th scope="col" class="bo-data-table__col--secondary">Cost center</th>
                  <th scope="col" class="bo-data-table__col--numeric">Amount</th>
                  <th scope="col">Status</th>
                </tr></thead>
                <tbody>
                  {invoices.map(([no, vendor, cc, amount, status, tone]) => (
                    <tr>
                      <td><input type="checkbox" name="id" value={no} class="bo-checkbox bo-data-table__row-select" aria-label={`Select ${no}`} /></td>
                      <td class="bo-data-table__col--code">{no}</td>
                      <td class="bo-u-text-truncate">{vendor}</td>
                      <td class="bo-data-table__col--secondary bo-data-table__col--code">{cc}</td>
                      <td class="bo-data-table__col--numeric">{amount}</td>
                      <td><span class={`bo-badge bo-badge--${tone}`}>{status}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ WHY: the framework's own dashboard ============ -->
      <section class="why">
        <h2>Built from the back office out</h2>
        <div class="bo-widget-grid" style="--bo-widget-min: 19rem">
          <div class="bo-widget">
            <div class="bo-widget__header"><span class="bo-widget__title">Density is a dimension</span></div>
            <div class="bo-widget__body">
              <p>One attribute — <code>data-density</code> — remaps a token tier:
              30 / 40 / 48px rows, cascading, overridable per region. Users pick;
              text never clips.</p>
              <div class="bo-cluster">
                <span class="bo-badge bo-badge--accent" data-density="compact" style="padding-block: 0.125rem">compact</span>
                <span class="bo-badge bo-badge--accent">comfortable</span>
                <span class="bo-badge bo-badge--accent" style="padding-block: 0.375rem">spacious</span>
                <a href={base + '/concepts/density'}>Density →</a>
              </div>
            </div>
          </div>

          <div class="bo-widget">
            <div class="bo-widget__header"><span class="bo-widget__title">The cascade is the API</span></div>
            <div class="bo-widget__body">
              <p>All framework CSS lives in <code>@layer</code>; your unlayered CSS
              always wins. Re-brand by remapping tokens — live:</p>
              <pre><code>{brandCss}</code></pre>
              <div class="brand-demo bo-cluster">
                <button class="bo-btn" type="button">Re-skinned button</button>
                <a href={base + '/concepts/cascade'}>The contract →</a>
              </div>
            </div>
          </div>

          <div class="bo-widget bo-widget--span-2">
            <div class="bo-widget__header"><span class="bo-widget__title">The same table, both ways</span></div>
            <div class="bo-widget__body">
              <div class="compare">
                <div>
                  <p class="compare__label">Semantic components</p>
                  <pre><code>{semanticSide}</code></pre>
                </div>
                <div>
                  <p class="compare__label">Utility classes</p>
                  <pre><code>{utilitySide}</code></pre>
                </div>
              </div>
              <p class="bo-u-text-muted">Markup you can read in a diff at screen #200. State lives in
              <code>aria-sort</code>, <code>data-*</code>, and real elements — not class strings.</p>
            </div>
          </div>

          <div class="bo-widget">
            <div class="bo-widget__header"><span class="bo-widget__title">State has two channels</span></div>
            <div class="bo-widget__body">
              <p>Every state ships a visible non-color cue AND a programmatic one.
              Build-checked contrast; honest ledger for the rest.</p>
              <p class="bo-stat__delta bo-stat__delta--bad" style="font-size: var(--bo-font-size-base)">
                <span aria-hidden="true">▲</span> +12% <span aria-hidden="true">⚠</span>
                <span class="bo-visually-hidden">increase, worse,</span> vs July
              </p>
              <p><a href={base + '/concepts/accessibility'}>Accessibility model →</a></p>
            </div>
          </div>

          <div class="bo-widget">
            <div class="bo-widget__header"><span class="bo-widget__title">HTMX-ready, not HTMX-coupled</span></div>
            <div class="bo-widget__body">
              <pre><code>{htmxSnippet}</code></pre>
              <p><a href={base + '/getting-started/htmx'}>The integration →</a></p>
            </div>
          </div>

          <div class="bo-widget">
            <div class="bo-widget__header"><span class="bo-widget__title">Prints like a report</span></div>
            <div class="bo-widget__body">
              <p>ERP screens get printed and signed. Headers repeat per page, rows
              never split, status colors force, nav disappears — ⌘P on the
              <a href={base + '/patterns/invoice-list'}>invoice pattern</a> to see it.</p>
              <p><a href={base + '/base/print'}>Print layer →</a></p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ PILOT: the adoption bridge ============ -->
      <section class="pilot">
        <h2>Pilot one screen</h2>
        <p>No framework earns 200 screens on a landing page. Take one screen —
        à la carte, into your existing app:</p>
        <pre><code>{pilotSnippet}</code></pre>
        <p>What you're <em>not</em> signing up for: semantic tokens, documented
        class names, and <code>data-*</code>/ARIA contracts are
        <a href={base + '/getting-started/versioning'}>the versioned API</a>; the
        cascade contract means leaving is incremental overrides, not a rewrite.
        The exit is cheap by design — verify it, don't trust it.</p>
      </section>

      <!-- ============ REVIEWED ============ -->
      <section class="reviewed">
        <h2>Reviewed like it matters</h2>
        <p>Every slice went through an adversarial multi-seat design review before
        sign-off: {componentCount} components, three review rounds, every gate
        finding fixed or on the public ledger. Two rules that came out of it are
        now <strong>build-enforced</strong>: every container query is named, and
        every state signal carries a non-color cue plus a programmatic channel.
        The full trail — findings, NO-GO verdicts, and the fixes that answered
        them — is
        <a href="https://github.com/Busy-Office/busy-office-ui/tree/main/.roundtable">public in the repo</a>.</p>
      </section>

      <footer class="footer">
        <div class="bo-cluster bo-cluster--split">
          <span>MIT · <a href="https://github.com/Busy-Office/busy-office-ui">GitHub</a> ·
            <a href="https://github.com/Busy-Office/busy-office-ui/blob/main/CHANGELOG.md">Changelog</a> ·
            <a href="https://github.com/Busy-Office/busy-office-ui/tree/main/examples/po-app">Example app (Docker)</a></span>
          <span class="bo-u-text-muted">Floor: Chrome/Edge 119 · Firefox 128 · Safari 17.4 — modern CSS is the point.</span>
        </div>
      </footer>
    </main>

    <script>
      import { initDataTables } from '@busy-office/ui/js';
      initDataTables();
      // Hero switchers scope to the demo card only — zero layout shift below.
      const table = document.getElementById('hero-table')!;
      const density = document.getElementById('hero-density') as HTMLSelectElement;
      density.addEventListener('change', () => {
        table.dataset.density = density.value;
      });
      const theme = document.getElementById('hero-theme') as HTMLSelectElement;
      theme.addEventListener('change', () => {
        (document.querySelector('.hero__demo') as HTMLElement).dataset.theme = theme.value;
      });
    </script>
  </body>
</html>

<style is:global>
  /* Landing chrome — unlayered on purpose (the escape hatch, demonstrated). */
  .landing {
    max-inline-size: 74rem;
    margin-inline: auto;
    padding: var(--bo-space-8) var(--bo-space-6) var(--bo-space-12);
    display: flex;
    flex-direction: column;
    gap: var(--bo-space-12);
  }
  .bo-navbar a { color: var(--bo-color-text-secondary); text-decoration: none; }
  .bo-navbar a:hover { color: var(--bo-color-text-primary); }

  /* Hero: the system record. Mono display type — the face of data and code. */
  .hero {
    display: grid;
    grid-template-columns: minmax(20rem, 2fr) 3fr;
    gap: var(--bo-space-8);
    align-items: start;
  }
  .eyebrow {
    font-family: var(--bo-font-mono);
    font-size: var(--bo-font-size-xs);
    letter-spacing: 0.08em;
    color: var(--bo-color-text-muted);
    margin-block-end: var(--bo-space-2);
  }
  .hero h1 {
    font-family: var(--bo-font-mono);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-block-end: var(--bo-space-4);
  }
  .lede {
    font-size: var(--bo-font-size-md);
    color: var(--bo-color-text-secondary);
    max-inline-size: 34ch;
    margin-block-end: var(--bo-space-5);
  }
  .install__note {
    font-size: var(--bo-font-size-xs);
    color: var(--bo-color-text-muted);
    max-inline-size: 36ch;
  }
  .install {
    margin-block: var(--bo-space-5) var(--bo-space-2);
    padding: var(--bo-space-3) var(--bo-space-4);
    background: var(--bo-color-bg-muted);
    border: 1px solid var(--bo-color-border-default);
    border-radius: var(--bo-radius-md);
    font-size: var(--bo-font-size-sm);
    inline-size: fit-content;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--bo-space-3) var(--bo-space-6);
    margin: 0;
    border-block-start: 1px solid var(--bo-color-border-default);
    padding-block-start: var(--bo-space-4);
  }
  .meta dt {
    font-family: var(--bo-font-mono);
    font-size: var(--bo-font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bo-color-text-muted);
  }
  .meta dd { margin: 0; font-weight: var(--bo-font-weight-medium); }
  .meta__sub { display: block; font-size: var(--bo-font-size-xs); color: var(--bo-color-text-muted); font-weight: var(--bo-font-weight-normal); }
  .meta a { color: inherit; }

  /* Fixed-height demo card: density/theme switching cannot shift the page. */
  .hero__demo { background: var(--bo-color-bg-surface); }
  .hero__tablewrap { block-size: 21rem; overflow: auto; scrollbar-gutter: stable; }

  /* Why grid */
  .why h2, .pilot h2, .reviewed h2 {
    font-family: var(--bo-font-mono);
    font-size: var(--bo-font-size-xl);
    margin-block-end: var(--bo-space-5);
  }
  .landing pre {
    background: var(--bo-color-bg-muted);
    border: 1px solid var(--bo-color-border-default);
    border-radius: var(--bo-radius-sm);
    padding: var(--bo-space-3);
    font-size: var(--bo-font-size-xs);
    overflow-x: auto;
    margin-block: var(--bo-space-3);
  }
  .bo-widget__body p { margin-block: 0 var(--bo-space-3); }
  /* min-width:0 lets each pre's overflow-x:auto contain wide code instead of
     forcing the grid track (and the page) wider — no horizontal body scroll. */
  .bo-widget__body { min-inline-size: 0; }
  .bo-widget__body > * { min-width: 0; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: var(--bo-space-4); }
  .compare > * { min-width: 0; }
  .compare__label {
    font-family: var(--bo-font-mono);
    font-size: var(--bo-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bo-color-text-muted);
  }
  /* The cascade demo: an unlayered scoped override, doing exactly what it says. */
  .brand-demo .bo-btn { --bo-btn-bg: #0f766e; --bo-btn-bg-hover: #115e59; }

  .pilot, .reviewed {
    max-inline-size: 46rem;
  }
  .pilot p, .reviewed p { color: var(--bo-color-text-secondary); }

  .footer {
    border-block-start: 1px solid var(--bo-color-border-default);
    padding-block-start: var(--bo-space-5);
    font-size: var(--bo-font-size-sm);
  }

  @media (max-width: 64rem) {
    .hero { grid-template-columns: 1fr; }
    .hero__tablewrap { block-size: 18rem; }
    .compare { grid-template-columns: 1fr; }
    .bo-widget--span-2 { grid-column: auto; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * { animation: rise 0.5s var(--bo-motion-easing-standard) backwards; }
    .hero__copy > *:nth-child(2) { animation-delay: 0.05s; }
    .hero__copy > *:nth-child(3) { animation-delay: 0.1s; }
    .hero__copy > *:nth-child(4) { animation-delay: 0.15s; }
    .hero__copy > *:nth-child(5) { animation-delay: 0.2s; }
    .hero__copy > *:nth-child(6) { animation-delay: 0.25s; }
    @keyframes rise { from { opacity: 0; translate: 0 0.5rem; } }
  }
</style>
