---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ONE array, three surfaces (roadmap 152.1). The four shells used to be
   hand-written twice on this page — once for "what it answers", once for
   "wrong when" — with no source behind either, and the owner's ask for a
   template per shell would have made it three. Two hand-maintained lists that
   must agree is the drift this repo keeps paying for, so the lists are derived
   and the templates join them rather than becoming a fourth.

   The templates are STRUCTURE, not a rendering. A live .bo-app-shell cannot be
   previewed inside this page — it is the page's own shell, and nesting it
   would fight the real one for the viewport. base/primitives reached the same
   conclusion and shows the shell as code with placeholders; this follows that
   precedent for all four. It is also the form an agent can actually use:
   something to copy, not a picture to interpret. */
/* The ONE band the stylesheet declares for the shell, in both units, so the
   prose below never restates it from memory. `.bo-app-shell` sets
   `container-name: bo-shell`; `sidebar-nav.css` is the only rule that queries
   it. If a second band is ever added, this page is wrong until it moves. */
const SHELL_BAND_REM = 56;
const SHELL_BAND_PX = SHELL_BAND_REM * 16;

/* Device classes, defined by what the CONTAINER is doing rather than by any
   device-sniffing — the whole point of the matrix below. The px ranges are
   descriptive ("a tablet usually lands here"), never something the CSS tests. */
const DEVICES = [
  { key: 'desktop', label: 'Desktop', range: `shell wider than ${SHELL_BAND_PX}px` },
  { key: 'tablet', label: 'Tablet', range: `roughly 768–${SHELL_BAND_PX}px` },
  { key: 'mobile', label: 'Mobile', range: 'roughly 320–767px' },
  { key: 'rf', label: 'RF scanner', range: 'handheld, one task, gloved hands' },
];

/* Every `note` below was MEASURED in a headless browser against the shipped
   stylesheet, not reasoned about (roadmap 156.1); the `no` verdicts that are
   editorial rather than dimensional trace to the shell's own `wrongWhen`
   text, which is on this page already. `check-claims` re-drives the numeric
   ones on every build. */
const SHELLS = [
  {
    name: 'App shell',
    href: '/base/primitives',
    devices: {
      desktop: { ok: 'yes', note: 'Rail 224px, labels visible.' },
      tablet: {
        ok: 'yes',
        note: `At ${SHELL_BAND_PX}px and below the rail collapses to a 52px icon strip.`,
      },
      mobile: {
        ok: 'yes',
        note: 'Same 52px rail — there is no separate mobile drawer. Labels are visually hidden, not removed, so they still have accessible names.',
      },
      rf: {
        ok: 'no',
        note: 'Chrome the reader never uses. Use RF full-screen.',
      },
    },
    answers: '"Where in the suite am I?" — persistent navigation, most screens, most of the day.',
    builtFromCode: '.bo-app-shell',
    builtFrom: ': header + sidebar + main',
    wrongWhen:
      'the screen is a single dedicated task on a single-purpose device — the persistent chrome becomes pure overhead the reader never uses (that’s RF full-screen’s case).',
    template: `<div class="bo-app-shell">                      <!-- container: bo-shell -->
  <header class="bo-navbar bo-app-shell__header">…</header>
  <nav class="bo-sidebar-nav bo-app-shell__sidebar">…</nav>
  <main class="bo-app-shell__main">
    <nav aria-label="Breadcrumb">…</nav>
    <h1>…</h1>
    …the pattern that fills the shell goes here…
  </main>
</div>`,
  },
  {
    name: 'Role home',
    href: '/patterns/role-home',
    devices: {
      desktop: { ok: 'yes', note: 'Widget grid resolves to 3 columns at 1440px.' },
      tablet: { ok: 'yes', note: '2 columns. Never hand-place widgets to force this.' },
      mobile: { ok: 'yes', note: '1 column at 390px. The grid reflows on its own.' },
      rf: { ok: 'no', note: 'A day-start dashboard, not one task. Use RF full-screen.' },
    },
    answers: '"What does MY role need today?" — the first screen after sign-in, one per role.',
    builtFrom: "App shell's main, filled with widgets scoped to a role",
    wrongWhen:
      'used as a general dashboard/reporting surface — it is scoped to ONE role’s daily start, not an analytics page.',
    template: `<main class="bo-app-shell__main">
  <h1>…the role, not the app…</h1>
  <!-- Widgets reflow on their own; do not hand-place them into columns. -->
  <div class="bo-widget-grid">
    <section class="bo-widget">
      <div class="bo-widget__header"><h2 class="bo-widget__title">…</h2></div>
      <div class="bo-widget__body">…a worklist, a count, one chart…</div>
    </section>
    …more widgets…
  </div>
</main>`,
  },
  {
    name: 'RF full-screen',
    href: '/patterns/rf-landing',
    devices: {
      desktop: {
        ok: 'no',
        note: 'Removes navigation a multi-task reader immediately wants back.',
      },
      tablet: { ok: 'depends', note: 'Only if the tablet IS the dedicated device.' },
      mobile: { ok: 'depends', note: 'Same test: one job, or not this shell.' },
      rf: { ok: 'yes', note: 'Its case. data-density="spacious" gives 44px controls.' },
    },
    answers: '"One task, no distraction" — a handheld scanner, gloved hands, a single action per screen.',
    builtFrom: 'No app shell at all — chrome-free, isolated document',
    wrongWhen:
      'the reader has a full-size screen and more than one task in the same session — dropping the app shell there just removes navigation the reader will immediately want back.',
    template: `<!-- No .bo-app-shell: the chrome is the thing being removed.
     data-density="spacious" IS the gloved-hand variant — there is no
     --large modifier and there should not be one. -->
<main data-density="spacious">
  <h1>…the one task…</h1>
  <form class="bo-stack">
    <div class="bo-form-field">…scan input…</div>
    <button class="bo-btn" type="submit">…the single action…</button>
  </form>
</main>`,
  },
  {
    name: 'Split master-detail',
    href: '/patterns/master-detail',
    devices: {
      desktop: { ok: 'yes', note: 'Detail pane 816px at 1440px.' },
      tablet: { ok: 'depends', note: 'Tightens to a 382px detail pane at 834px — workable, watch the content.' },
      mobile: {
        ok: 'no',
        note: 'Breaks: the list pane is a fixed 22rem that never shrinks, so at 390px the detail pane is 36px. Swap the split for the offcanvas drawer that pattern already ships.',
      },
      rf: { ok: 'no', note: 'Two panes on a handheld. Use RF full-screen.' },
    },
    answers: '"Show me the list AND the one I picked" — browsing many records without losing the list.',
    builtFrom: "App shell's main, split into a list pane + detail pane",
    wrongWhen:
      'the record is long enough that a narrow detail pane can’t hold it without its own internal scroll-and-search — that is when object page replaces the cramped pane.',
    /* Stated plainly because it is true and easy to miss: this shell has NO
       shipped primitive. /patterns/master-detail draws the split with a
       page-local class, so the two panes are your grid, not the framework's. */
    template: `<main class="bo-app-shell__main">
  <!-- No framework split primitive ships. The two panes are YOUR grid —
       one declaration, and it is the only CSS this shell needs. -->
  <div class="your-split">          <!-- e.g. grid-template-columns: 22rem 1fr -->
    <section aria-label="List">…a data table, one row per record…</section>
    <section aria-label="Detail">…the record you picked…</section>
  </div>
</main>`,
  },
];
---
<Gallery title="Layouts — the four shells">
  <p class="demo-note">
    An ERP suite is not one screen shape wearing different content — it is
    <strong>four different shells</strong>, each already shipped, each solving
    a different "where does the reader stand" question. This page is a map,
    not a new pattern: pick the shell here first, then reach for the pattern
    that fills it. <strong>Not a component or a fifth option</strong> — every
    row below is a link to something that already exists; a screen that
    doesn't fit one of the four is a new shell, not a variant of these.
  </p>

  <section class="demo">
    <h2>The four shells</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead>
          <tr>
            <th scope="col">Shell</th>
            <th scope="col">What it answers</th>
            <th scope="col">Built from</th>
          </tr>
        </thead>
        <tbody>
          {SHELLS.map((s) => (
            <tr>
              <td><strong><a href={base + s.href}>{s.name}</a></strong></td>
              <td>{s.answers}</td>
              <td>{s.builtFromCode && <code>{s.builtFromCode}</code>}{s.builtFrom}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">All four are shipped primitives or patterns.
    This page adds no CSS and no component — it names when each is the
    right call, the same job
    <a href={base + '/concepts/review-anatomy'}>review-screen anatomy</a>
    does one level down, for the three ways to show a single record.</p>
  </section>

  <section class="demo" id="devices">
    <h2>Which shell works on which device</h2>
    <p class="bo-u-text-muted">Jump to a device:
      {DEVICES.map((d, i) => (
        <>{i > 0 && ' · '}<a href={`#device-${d.key}`}>{d.label}</a></>
      ))}
    </p>
    <p><strong>Desktop, tablet and mobile are not three layouts.</strong> They are
    the same shells answering to width. <code>.bo-app-shell</code> declares
    <code>container-name: bo-shell</code>, and the whole stylesheet contains exactly
    one shell band — <code>@container bo-shell (max-width: {SHELL_BAND_REM}rem)</code>.
    It keys on the <em>container</em>, not the viewport, so a shell embedded in a
    panel responds to the panel. <strong>Do not branch your markup per device</strong>;
    there is nothing to branch on.</p>

    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <caption class="bo-u-text-muted">Measured in a browser against the shipped
        stylesheet, not estimated. ✓ supported · ~ depends · ✕ use something else.</caption>
        <thead>
          <tr>
            <th scope="col">Shell</th>
            {DEVICES.map((d) => <th scope="col">{d.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {SHELLS.map((s) => (
            <tr>
              <th scope="row"><a href={base + s.href}>{s.name}</a></th>
              {DEVICES.map((d) => {
                const c = s.devices[d.key];
                const mark = c.ok === 'yes' ? '✓' : c.ok === 'no' ? '✕' : '~';
                const word = c.ok === 'yes' ? 'Supported' : c.ok === 'no' ? 'Use something else' : 'Depends';
                return (
                  <td>
                    {/* Two channels: the glyph is never the only signal — the
                        word carries the verdict for anyone who cannot resolve
                        a symbol, and it is what a screen reader announces. */}
                    <strong><span aria-hidden="true">{mark}</span> {word}</strong>
                    <span class="bo-u-text-muted"> — {c.note}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* The table above is the scan view — every shell against every device, and
        it is what a reader compares in. These sections answer the other
        question, the one a reader arrives with: "I am building for a tablet,
        what can I use?" So they list only what you CAN reach for, and collapse
        everything ruled out into one redirect line. Restating all four verdicts
        here would just be the table again in a taller shape — and the table is
        already the thing that scrolls on a phone. */}
    {DEVICES.map((d) => {
      const usable = SHELLS.filter((s) => s.devices[d.key].ok !== 'no');
      const ruledOut = SHELLS.filter((s) => s.devices[d.key].ok === 'no');
      return (
        <div id={`device-${d.key}`}>
          <h3>{d.label} <span class="bo-u-text-muted">— {d.range}</span></h3>
          <ul class="bo-stack bo-stack--tight docs-list">
            {usable.map((s) => (
              <li>
                <a href={base + s.href}>{s.name}</a>
                {s.devices[d.key].ok === 'depends' && <strong> only if</strong>}{' '}
                {s.devices[d.key].note}
              </li>
            ))}
          </ul>
          {ruledOut.length > 0 && (
            <p class="bo-u-text-muted">
              <strong>Not here:</strong>{' '}
              {ruledOut.map((s, i) => (
                <>{i > 0 && ', '}{s.name}</>
              ))}
              {' — '}
              {ruledOut.length === 1 ? 'see the table for what to use instead.' : 'the table says what to use instead.'}
            </p>
          )}
        </div>
      );
    })}

    <p class="bo-u-text-muted"><strong>Crossing the band can give content MORE
    room, not less</strong> — the one result here that surprises. At {SHELL_BAND_PX}px
    the rail drops from 224px to 52px, so <code>main</code> gains 171px in the same
    breath the window got narrower: measured, a role home goes from 1 widget column
    at 897px to 2 columns at {SHELL_BAND_PX}px. If you are testing a layout, test
    <em>both sides</em> of the band, not just the narrow end.</p>
  </section>

  <section class="demo">
    <h2>Deciding — three questions, not taste</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Is this a dedicated device with one job</strong> — a
        warehouse scanner, a kiosk — where the surrounding chrome would
        just eat screen real estate a gloved thumb can't use anyway?
        <a href={base + '/patterns/rf-landing'}>RF full-screen</a>, no app
        shell. Everything else below assumes the app shell is present.</li>
      <li><strong>Otherwise, is this the FIRST screen after sign-in</strong>,
        answering "what needs me today" before the reader has chosen a
        task? <a href={base + '/patterns/role-home'}>Role home</a> — its own
        page inside the app shell's main, scoped per role rather than one
        screen for everyone.</li>
      <li><strong>Otherwise: does the reader need the list AND a record's
        detail on screen at once</strong>, switching between records without
        losing their place in the list? Yes →
        <a href={base + '/patterns/master-detail'}>split master-detail</a>.
        No — a single list, or a single record filling the page on its own —
        → the app shell's main holds that content directly (a
        <a href={base + '/patterns/list-report'}>list report</a> or one of
        the <a href={base + '/concepts/review-anatomy'}>three record-review
        shapes</a>), no further layout decision needed.</li>
    </ol>
    <p class="bo-u-text-muted">Answering those three is the whole choice.
    A screen that seems to need two of these at once (a role home that also
    wants a permanent detail pane, say) is usually two decisions sharing one
    page — split it, per the "design the decision, not the screen" test on
    <a href={base + '/concepts/design-language'}>the design-language
    page</a> — rather than merging two shells into a new one.</p>
  </section>

  <section class="demo">
    <h2>Spacing the shell's main — the one composition that bites</h2>
    <p>When a screen's sections run together, the framework's own answer is the
    <a href={base + '/base/primitives'}>stack</a> primitive — so putting
    <code>bo-stack</code> on <code>.bo-app-shell__main</code> is the first
    thing a careful reader tries. <strong>Put it on an inner element
    instead.</strong></p>
    <p><code>__main</code> is a height-constrained scroller. Making it a flex
    column makes its children flex items, and a flex item that is itself a
    scroll container has an automatic minimum size of <strong>zero</strong> —
    so a table container directly inside it collapses to nothing: measured at
    <code>clientHeight 0</code> against <code>scrollHeight 200</code>, a header
    row and no data, on a screen that still looked plausible. Two correct
    primitives composing into silent data loss, and the composition that breaks
    is the one a careful reader tries first (roadmap 133.3).</p>
    <p class="bo-u-text-muted">The framework now defends the general case:
    <code>.bo-stack &gt; *</code> is <code>flex-shrink: 0</code>, because a
    stack distributes <em>rhythm</em>, not space — a stack that does not fit
    should overflow its scroller, visibly, rather than squeeze its children
    away. That costs nothing existing (applied across 3346 stack children on
    this site, zero heights changed). The advice above still stands, because
    it is about which element owns the spacing, not only about the collapse.</p>

    <h2>When each shell is the WRONG choice</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead>
          <tr>
            <th scope="col">Shell</th>
            <th scope="col">Wrong when…</th>
          </tr>
        </thead>
        <tbody>
          {SHELLS.map((s) => (
            <tr>
              <td>{s.name}</td>
              <td>{s.wrongWhen}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Two of those have a named destination worth
    following: a cross-role analytics surface is
    <a href={base + '/patterns/reporting-dashboard'}>reporting dashboard</a>,
    and a record too long for a narrow pane is
    <a href={base + '/patterns/object-page'}>object page</a> — a full-width
    page with in-page navigation, per its own scope note (roadmap 52.2).</p>
  </section>

  <section class="demo">
    <h2>The template for each shell</h2>
    <p class="bo-u-text-muted">Structure only — copy one and fill it in. These
    are <strong>outlines, not renderings</strong>: a live
    <code>.bo-app-shell</code> cannot be shown inside this page, because it is
    this page's own shell and would fight the real one for the viewport. What
    is below is the part you actually reuse.</p>
    {SHELLS.map((s) => (
      <div>
        <h3><a href={base + s.href}>{s.name}</a></h3>
        <pre><code>{s.template}</code></pre>
      </div>
    ))}
    <p class="bo-u-text-muted">Every class above ships — the build fails on an
    invented <code>bo-*</code> class or <code>data-*</code> value, so these
    templates cannot quietly drift from the framework. The one exception is
    named as one: <code>your-split</code> is deliberately yours, because
    <strong>no split primitive ships</strong>.</p>
  </section>

  <Related links={[
    ["/base/primitives", "App shell & primitives"],
    ["/patterns/role-home", "Role home"],
    ["/patterns/rf-landing", "RF full-screen"],
    ["/patterns/master-detail", "Split master-detail"],
    ["/concepts/review-anatomy", "Review-screen anatomy (choosing among the three record-review shapes)"],
  ]} />
</Gallery>
