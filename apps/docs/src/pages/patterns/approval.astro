---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const timelineMarkup = `<!-- State has TWO channels, always: the visible glyph (aria-hidden)
     AND visually-hidden state text. role="list" restores list semantics
     that list-style:none strips in some AT. -->
<ol class="bo-timeline" role="list">
  <li class="bo-timeline__step" data-state="done">
    <span class="bo-timeline__marker" aria-hidden="true">✓</span>
    <div>
      <div class="bo-timeline__title">
        <span class="bo-visually-hidden">Completed: </span>Submitted
      </div>
      <div class="bo-timeline__meta">R. Vance ·
        <time datetime="2026-08-10T09:14">2026-08-10 09:14</time></div>
    </div>
  </li>
  <li class="bo-timeline__step" data-state="current" aria-current="step">
    <span class="bo-timeline__marker" aria-hidden="true">●</span>
    <div>
      <div class="bo-timeline__title">Cost-center approval</div>
      <div class="bo-timeline__meta">waiting on M. Okafor</div>
    </div>
  </li>
  <li class="bo-timeline__step" data-state="rejected">
    <span class="bo-timeline__marker" aria-hidden="true">✕</span>
    <div>
      <div class="bo-timeline__title">
        <span class="bo-visually-hidden">Rejected: </span>Finance release
      </div>
    </div>
  </li>
  <li class="bo-timeline__step" data-state="pending">
    <span class="bo-timeline__marker" aria-hidden="true">4</span>
    <div>
      <div class="bo-timeline__title">
        <span class="bo-visually-hidden">Not started: </span>Archive
      </div>
    </div>
  </li>
</ol>`;
---
<Gallery title="Pattern: approval workflow">
  <p class="demo-note">
    <strong>Who uses it</strong>: an approver named in the chain — a manager,
    a cost-centre owner, finance. <strong>How often</strong>: whenever a
    document reaches their step, which for most approvers is a handful of
    times a week. <strong>What "done" looks like</strong>: the decision
    recorded, the next person notified, nothing silently stuck. The composed
    slice-3 screen: wizard stepper, status timeline, approval queue (the
    data-table pattern you already know), and the audit trail. State always
    has two channels: a visible non-color cue (the glyph) <em>and</em>
    programmatic state (visually-hidden text / <code>aria-current</code>) —
    one without the other is a defect.
    <strong>Not for a record with no decision to make</strong> — a plain edit to a
    record's own fields, with nobody else's sign-off in the way, is
    <a href={base + '/patterns/record-detail'}>record-detail</a>'s job; reach for
    this pattern only when a chain of people, not just the owner, has to act
    before the record can move.
  </p>
  <section class="demo">
    <h2>Wizard stepper (document creation)</h2>
    <ol class="bo-stepper" role="list" style="max-inline-size: 40rem">
      <li class="bo-stepper__step" data-state="done"><span class="bo-stepper__marker" aria-hidden="true">✓</span><span class="bo-stepper__label"><span class="bo-visually-hidden">Completed: </span>Header</span></li>
      <li class="bo-stepper__step" data-state="done"><span class="bo-stepper__marker" aria-hidden="true">✓</span><span class="bo-stepper__label"><span class="bo-visually-hidden">Completed: </span>Line items</span></li>
      <li class="bo-stepper__step" aria-current="step"><span class="bo-stepper__marker">3</span><span class="bo-stepper__label">Approvers</span></li>
      <li class="bo-stepper__step"><span class="bo-stepper__marker">4</span><span class="bo-stepper__label"><span class="bo-visually-hidden">Not started: </span>Review</span></li>
    </ol>
  </section>
  <section class="demo">
    <h2>Status timeline (incl. rejected) + audit trail</h2>
    <div class="bo-grid" style="--bo-grid-min: 18rem">
      <div>
        <h3 class="bo-u-text-muted" style="font-size: var(--bo-font-size-sm)">PO-88213 status</h3>
        <ol class="bo-timeline" role="list">
          <li class="bo-timeline__step" data-state="done">
            <span class="bo-timeline__marker" aria-hidden="true">✓</span>
            <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Completed: </span>Submitted</div><div class="bo-timeline__meta">R. Vance · <time datetime="2026-08-10T09:14">2026-08-10 09:14</time></div></div>
          </li>
          <li class="bo-timeline__step" data-state="done">
            <span class="bo-timeline__marker" aria-hidden="true">✓</span>
            <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Completed: </span>Manager approval</div><div class="bo-timeline__meta">J. Kim · <time datetime="2026-08-10T15:02">2026-08-10 15:02</time></div></div>
          </li>
          <li class="bo-timeline__step" data-state="current" aria-current="step">
            <span class="bo-timeline__marker" aria-hidden="true">●</span>
            <div><div class="bo-timeline__title">Cost-center approval</div><div class="bo-timeline__meta">waiting on M. Okafor · 2 days</div></div>
          </li>
          <li class="bo-timeline__step" data-state="rejected">
            <span class="bo-timeline__marker" aria-hidden="true">✕</span>
            <div><div class="bo-timeline__title"><span class="bo-visually-hidden">Rejected: </span>Finance release</div><div class="bo-timeline__meta">returned by A. Chen · budget hold</div></div>
          </li>
        </ol>
      </div>
      <div>
        <h3 class="bo-u-text-muted" style="font-size: var(--bo-font-size-sm)">Audit trail</h3>
        <ol class="bo-audit" role="list">
          <li class="bo-audit__entry">
            <time class="bo-audit__time" datetime="2026-08-10T09:14">08-10 09:14</time>
            <span><span class="bo-audit__actor">R. Vance</span> submitted PO-88213</span>
          </li>
          <li class="bo-audit__entry">
            <time class="bo-audit__time" datetime="2026-08-10T15:02">08-10 15:02</time>
            <span><span class="bo-audit__actor">J. Kim</span> approved</span>
            <span class="bo-audit__detail">"Within Q3 budget."</span>
          </li>
          <li class="bo-audit__entry">
            <time class="bo-audit__time" datetime="2026-08-11T08:30">08-11 08:30</time>
            <span><span class="bo-audit__actor">System</span> reminded M. Okafor</span>
          </li>
        </ol>
      </div>
    </div>
  </section>
  <section class="demo">
    <h2>Approval queue</h2>
    <p class="bo-u-text-muted">The queue is the standard selectable data table with
    bulk Approve/Reject — see <a href={base + '/patterns/list-report'}>the list-report pattern</a>;
    nothing new to learn.</p>
  </section>
  <section class="demo">
    <h2>On a phone — the decision, not the document</h2>
    <div style="max-inline-size: 390px">
      <div class="bo-widget">
        <div class="bo-widget__header">
          <span class="bo-widget__title">PO-88213 · Northwind Supply</span>
          <span class="bo-badge bo-badge--warning">Pending</span>
        </div>
        <div class="bo-stack bo-stack--tight">
          <dl class="bo-kv bo-kv--rows">
            <div><dt>Amount</dt><dd><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">48,200<span class="bo-amount__fraction">.00</span></span></span></dd></div>
            <div><dt>Requested by</dt><dd>M. Osei</dd></div>
            <div><dt>Waiting since</dt><dd><span class="bo-u-tabular">3 days</span></dd></div>
            <div><dt>Budget after</dt><dd><span class="bo-u-tabular">$11,800</span> left</dd></div>
          </dl>
          <p><a href={base + '/patterns/object-page'}>Open the full request →</a></p>
        </div>
      </div>
      <div class="bo-btn-group bo-btn-group--bar" style="margin-block-start: var(--bo-space-3)">
        <button class="bo-btn bo-btn--secondary" type="button">Reject</button>
        <button class="bo-btn" type="button">Approve</button>
      </div>
    </div>
    <p class="bo-u-text-muted">An approver on a phone is deciding, not
    reading. Ship the <strong>three facts the decision turns on</strong> —
    what, how much, and what it leaves — plus a link to everything else,
    and put the decision within thumb reach: the same
    <a href={base + '/components/button'}><code>--bar</code></a> the RF
    screens use, docked by the consumer's own sticky line. What does NOT
    survive the trip: the audit trail (link it), the bulk queue (deciding
    twenty things by thumb is how rubber-stamping happens), and the
    rejection note as a typed essay — offer reasons as buttons and let
    the essay be optional. <strong>Not a second pattern</strong>: it is
    this pattern at 390px, so the routes, the contract and the 409 story
    below are unchanged.</p>
  </section>
  <section class="demo">
    <h2>Markup — timeline</h2>
    <pre><code>{timelineMarkup}</code></pre>
  </section>

  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Record summary</strong> <span class="bo-u-text-muted">(not in this demo — see <a href={base + '/patterns/record-detail'}>record-detail</a> for the shape)</span> — enough to decide without leaving: amount, vendor, cost centre.</li>
      <li><strong>Status timeline</strong> — the chain so far, with the current step marked <code>aria-current="step"</code>.</li>
      <li><strong>Decision cluster</strong> <span class="bo-u-text-muted">(not in this demo)</span> — Approve / Reject; Reject requires a reason, so both open the dialog.</li>
      <li><strong>Dialog</strong> <span class="bo-u-text-muted">(not in this demo — same shape as <a href={base + '/patterns/master-detail'}>master-detail</a>'s edit dialog)</span> — the note (<a href={base + '/components/richtext'}>rich text</a>) plus optional extra approvers.</li>
      <li><strong>Audit trail</strong> — every decision with actor, timestamp and note; append-only.</li>
    </ol>
    <p class="bo-u-text-muted">Follows the <a href={base + '/concepts/review-anatomy'}>review-screen anatomy</a>
    contract, spent on the moment where the reader must decide rather than just
    read — see that page for the other two shapes.</p>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns / on failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">POST /po/:id/approve</td><td>the updated timeline + audit fragment</td></tr>
          <tr><td class="bo-data-table__col--code">POST /po/:id/reject</td><td>same, with the reason recorded; reason is REQUIRED server-side, not just in the UI</td></tr>
          <tr><td class="bo-data-table__col--code">any decision on a decided record</td><td>409 → re-render the timeline as it now is, with a banner naming who decided and when</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Awaiting your decision</td><td>buttons visible and enabled — this is the only state where they appear</td></tr>
          <tr><td>Awaiting someone else</td><td>the timeline shows whose turn it is; no buttons for you</td></tr>
          <tr><td>Already decided (409)</td><td>never silently overwrite — show the decision that won and let the user re-read</td></tr>
          <tr><td>Submitting</td><td>dialog buttons disabled; the dialog stays open until the swap lands so a failure keeps the typed note</td></tr>
          <tr><td>Not an approver</td><td>the screen is read-only; approval controls are absent, not disabled</td></tr>
          <tr><td>Delegated / out of office</td><td>name the delegate in the timeline — an approval chain that silently reroutes is an audit problem</td></tr>
          <tr><td>On a phone</td><td>the decision card + a docked <code>--bar</code>; the audit trail and line items become links, not collapsed sections — a collapsed audit trail on a phone is read by nobody and still costs the scroll</td></tr>
          <tr><td>Decided on a phone, stale in a tab</td><td>the same 409 as anywhere: the desktop tab that still shows buttons must lose, and say who won — a phone decision is not a lesser one</td></tr>
          <tr><td>No JS</td><td>fully functional — this page has no JS dependency; the stepper, status timeline and audit trail are all plain lists with no hidden state to reveal. The decision dialog and Approve/Reject buttons are not part of this static demo (see the note above); in a real build those would be an ordinary <code>&lt;form&gt;</code> POST, which also needs no JS to submit</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 3 of 4</span></p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/approval-workflow'}>Timeline & audit</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
    </ul>
  </section>

  <Related links={[["/components/approval-workflow", "Timeline & audit"], ["/components/stepper", "Stepper"], ["/components/dialog", "Dialog"], ["/patterns/kanban", "Kanban board (multiple records moving through the same steps at once)"]]} />
</Gallery>
