---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import { monthGrid } from '../../lib/month-grid';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* The delivery calendar is GENERATED from its own dates, never hand-typed.
   A month is 35+ cells whose label and submitted value must agree, and
   hand-written tables are exactly where this repo has produced rows labelled
   with another row's name. Deriving both from one Date makes that class of bug
   unrepresentable. */
const CLOSED_WEEKDAYS = new Set([6, 0]);           // Sat, Sun — dock closed
const HOLIDAYS = new Map([['2026-09-07', 'Company shutdown']]);
const SELECTED = '2026-09-15';

function deliveryMonth(year, monthIdx) {
  /* Monday-first, matching this grid's own thead. Where the week starts is a
     property of the data, not a setting on the component — see
     /components/calendar. The date maths is shared so the two pages cannot
     drift; only the CELLS differ here (disabled submit buttons carrying a
     delivery date, rather than plain spans). */
  return monthGrid(year, monthIdx, 1).map((week) => {
    const days = week.map(({ iso: key, day, weekday, outside }) => {
      const holiday = HOLIDAYS.get(key);
      const closed = CLOSED_WEEKDAYS.has(weekday);
      let cell;
      if (outside) {
        cell = `<span class="bo-calendar__day bo-calendar__day--outside">${day}</span>`;
      } else if (holiday) {
        cell = `<button class="bo-calendar__day" type="submit" name="delivery-date" value="${key}" data-day="holiday" disabled>${day}<span class="bo-visually-hidden"> — ${holiday}, no receiving</span></button>`;
      } else if (closed) {
        cell = `<button class="bo-calendar__day" type="submit" name="delivery-date" value="${key}" data-day="closed" disabled>${day}<span class="bo-visually-hidden"> — dock closed</span></button>`;
      } else if (key === SELECTED) {
        cell = `<button class="bo-calendar__day" type="submit" name="delivery-date" value="${key}" data-day="selected" aria-pressed="true">${day}<span class="bo-visually-hidden"> — requested delivery date</span></button>`;
      } else {
        cell = `<button class="bo-calendar__day" type="submit" name="delivery-date" value="${key}">${day}</button>`;
      }
      return `<td>${cell}</td>`;
    });
    return `      <tr>${days.join('')}</tr>`;
  }).join('\n');
}

const DOW = [['Monday','Mo'],['Tuesday','Tu'],['Wednesday','We'],['Thursday','Th'],['Friday','Fr'],['Saturday','Sa'],['Sunday','Su']];
const deliveryCalendar = `<form method="get" class="bo-calendar">
  <table class="bo-calendar__month">
    <caption>Requested delivery date — September 2026</caption>
    <thead><tr>${DOW.map(([full, ab]) => `<th scope="col"><abbr title="${full}">${ab}</abbr></th>`).join('')}</tr></thead>
    <tbody>
${deliveryMonth(2026, 8)}
    </tbody>
  </table>
</form>`;
---
<Gallery title="Pattern: multi-column detail form">
  <p class="demo-note">
    <strong>Who uses it</strong>: whoever owns the record — a buyer
    editing a PO, an admin fixing vendor details; occasional, high-stakes
    edits where losing work is unacceptable. <strong>What "done" looks
    like</strong>: every change saved (or explicitly discarded) with no
    silent loss. The edit-screen counterpart to
    <a href={base + '/patterns/record-detail'}>record detail</a>:
    a full purchase-order edit form, composed entirely from existing components —
    <code>.bo-form-section</code> fieldsets, the <code>.bo-form-row</code> auto-fit
    column grid, the line-items data table, and a sticky <code>.bo-form-actions</code>
    bar. Nothing new to learn; <code>.bo-form-row</code> already collapses to one
    column on narrow screens by construction (<code>auto-fit</code>, not a fixed
    column count) — resize the window to see it.
    <strong>Not for reading a record</strong> — a form styles fields for
    ENTRY, and rendering read-only values as inputs tells the user they can
    change things they cannot. Read surfaces are
    <a href={base + '/patterns/record-detail'}>record detail</a> and
    <a href={base + '/patterns/object-page'}>object page</a>.
  </p>
  <section class="demo">
    {/* An edit screen with no identity line cannot tell you WHICH record you
        are editing — this pattern had none at all before roadmap 24.6. Same
        composed shape as /patterns/record-detail. */}
    <div class="bo-cluster bo-cluster--split" style="margin-block-end: var(--bo-space-3)">
      <span class="bo-cluster">
        <span class="bo-badge bo-badge--type">Purchase order</span>
        <strong class="bo-u-tabular">PO-88213</strong>
        <span class="bo-badge bo-badge--warning">Draft</span>
      </span>
      <span class="bo-u-text-muted">Last saved 10 Aug 2026 09:14</span>
    </div>
    <form novalidate>
      <fieldset class="bo-form-section">
        <legend class="bo-form-section__legend">Header</legend>
        <div class="bo-form-row">
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-vendor">Vendor</label>
            <input class="bo-input" id="df-vendor" value="Acme Supply Co." required />
          </div>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-cc">Cost center</label>
            <input class="bo-input bo-input--code" id="df-cc" value="CC-4021" />
          </div>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-date">Order date</label>
            <input class="bo-input" id="df-date" type="date" value="2026-08-10" />
          </div>
        </div>
      </fieldset>
      <fieldset class="bo-form-section">
        <legend class="bo-form-section__legend">Payment &amp; delivery</legend>
        <div class="bo-form-row">
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-terms">Terms</label>
            <select class="bo-select" id="df-terms">
              <option>Net 30</option><option>Net 60</option><option>Due on receipt</option>
            </select>
          </div>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-ship">Ship via</label>
            <select class="bo-select" id="df-ship"><option>Freightline</option><option>Standard courier</option></select>
          </div>
          <div class="bo-form-field">
            <label class="bo-form-field__label" for="df-notes">Notes</label>
            <input class="bo-input" id="df-notes" placeholder="Optional" />
          </div>
        </div>
      </fieldset>
      <fieldset class="bo-form-section">
        <legend class="bo-form-section__legend">Line items</legend>
        <div class="bo-data-table-container" tabindex="0">
          <table class="bo-data-table">
            <thead><tr>
              <th scope="col">Item</th>
              <th scope="col" class="bo-data-table__col--numeric">Qty</th>
              <th scope="col" class="bo-data-table__col--numeric">Unit price</th>
              <th scope="col" class="bo-data-table__col--numeric">Amount</th>
            </tr></thead>
            <tbody>
              <tr>
                <td>SKU-3391 · Standing desk</td>
                <td class="bo-data-table__col--numeric">
                  <input class="bo-input bo-input--seamless bo-input--numeric" value="4" aria-label="Quantity for Standing desk" />
                </td>
                <td class="bo-data-table__col--numeric">302.00</td>
                <td class="bo-data-table__col--numeric">1,208.00</td>
              </tr>
              <tr>
                <td>SKU-1180 · Monitor arm</td>
                <td class="bo-data-table__col--numeric">
                  <input class="bo-input bo-input--seamless bo-input--numeric" value="8" aria-label="Quantity for Monitor arm" />
                </td>
                <td class="bo-data-table__col--numeric">115.50</td>
                <td class="bo-data-table__col--numeric">924.00</td>
              </tr>
            </tbody>
          </table>
        </div>
      </fieldset>
      <div class="bo-form-actions">
        <button class="bo-btn bo-btn--secondary" type="button">Cancel</button>
        <button class="bo-btn" type="submit">Save purchase order</button>
      </div>
    </form>
  </section>

  <section class="demo">
    <h2>Requested delivery date — the days you cannot pick</h2>
    <div set:html={deliveryCalendar} />
    <p class="bo-u-text-muted">This grid starts its week on <strong>Monday</strong>
    (ISO&nbsp;8601), which suits a European buyer. Where the week starts is a
    property of your data, not a setting on the component — see
    <a href={base + '/components/calendar'}>calendar</a> for why the framework
    ships no <code>data-week-start</code>, and generate the month accordingly.</p>
    <p class="bo-u-text-muted">The plain <code>&lt;input type="date"&gt;</code> above is
    right for <em>order date</em> — any day is valid, and the native picker is
    already good. A <em>requested delivery date</em> is a different question: the
    dock is shut at weekends and closed for the company shutdown on the 7th, so
    some days are not offers. Those days are real
    <code>&lt;button disabled&gt;</code>s, so the constraint is enforced by the
    control rather than by a validation message after the fact — and each carries
    a visually-hidden reason, because a day that is merely greyed out tells a
    screen-reader user nothing. This is the one thing a native date input cannot
    express: a <em>set</em> of marked days.</p>
  </section>

  <section class="demo">
    <h2>Variant: field-per-row layout (master-data maintenance)</h2>
    <p class="bo-u-text-muted">
      Some one-record edits read better as a table than a form —
      <strong>master-data maintenance, the SM30 case</strong>: a back-office
      user opens one vendor and corrects a handful of fields (a name typo, a
      credit limit, a date), a few times a week, with each field given the
      input its type deserves. One row per <em>field</em>, still one record,
      still this pattern — not <a href={base + '/patterns/editable-grid'}>the
      editable grid</a>, which is many ROWS, one record per row.
    </p>
    <form method="post" action="/vendors/V-1001">
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-row-edit data-density="compact">
        <caption class="bo-visually-hidden">Vendor master data, one row per field</caption>
        <thead>
          <tr><th scope="col" style="inline-size: 14rem">Field</th><th scope="col">Value</th></tr>
        </thead>
        <tbody>
          <tr data-row-id="name">
            <th scope="row">Vendor name<br /><span class="bo-u-text-muted" style="font-weight: 400">Legal entity as registered</span></th>
            <td><input class="bo-input bo-input--seamless" id="df-fe-name" aria-label="Vendor name" value="Umbrella Logistics GmbH" /></td>
          </tr>
          <tr data-row-id="credit">
            <th scope="row">Credit limit<br /><span class="bo-u-text-muted" style="font-weight: 400">Per open order</span></th>
            <td>
              <div class="bo-money">
                <select class="bo-select bo-select--seamless bo-money__currency" aria-label="Currency">
                  <option selected>EUR</option><option>USD</option><option>JPY</option>
                </select>
                <input class="bo-input bo-input--numeric bo-input--seamless bo-money__amount" type="number" step="0.01" id="df-fe-credit" aria-label="Credit limit" value="250000.00" />
              </div>
            </td>
          </tr>
          <tr data-row-id="active">
            <th scope="row">Active<br /><span class="bo-u-text-muted" style="font-weight: 400">Blocks new orders when off</span></th>
            <td><input class="bo-checkbox" type="checkbox" id="df-fe-active" aria-label="Active" checked /></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="bo-data-table__footer">
      <span class="bo-badge bo-badge--warning" data-any-dirty hidden>Unsaved changes</span>
      <button class="bo-btn bo-btn--secondary" type="reset">Cancel</button>
      <button class="bo-btn" type="submit">Save vendor</button>
    </div>
    </form>
    <p class="bo-u-text-muted">
      <strong>One Save at the bottom, not one per row.</strong> These rows
      are the FIELDS OF ONE RECORD, not a list of records — a Save per field
      means six requests for one logical edit, a Cancel that undoes a third
      of what the user changed, and, measured on the first version of this
      variant, a button sitting <strong>228px from the field it
      saves</strong> in an actions column taking 37% of the table. Per-row
      Save belongs to <a href={base + '/patterns/editable-grid'}>the
      editable grid</a>, where each row really is a record. Seamless
      (<code>--seamless</code>) on every field, including money — a screen
      where some fields read as text and others as boxes tells the user the
      boxed ones are editable and the rest are not, backwards from the
      truth. Zero new CSS: <a href={base + '/components/data-table'}>the
      data table</a> with <code>data-row-edit</code>, ordinary typed
      inputs — the page's own <a href={base + '/patterns/editable-grid'}>line
      items</a> table above stays plain (no dirty tracking, by this page's
      own design); this variant is the one place on the page that wires
      <code>initRowEdit()</code>.
    </p>
  </section>

  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Sections</strong> — real <code>&lt;fieldset&gt;</code>s
      (<code>.bo-form-section</code>); the legend is the group's accessible name, so
      a screen reader announces "Header, group" before the fields.</li>
      <li><strong>Rows</strong> — <code>.bo-form-row</code> is an auto-fit grid, so
      columns collapse by available width with no breakpoint to maintain.</li>
      <li><strong>Line items</strong> — a plain table here (one seamless numeric
      cell per row, no dirty tracking, kept simple for this page's own scope);
      nest the fully-wired <a href={base + '/patterns/editable-grid'}>editable
      grid</a> — <code>data-row-edit</code>, per-row dirty state independent of
      the header fields — where line items need Save/Cancel of their own.</li>
      <li><strong>Delivery calendar</strong> — <a href={base + '/components/calendar'}>calendar</a>
      for the one field whose valid days are constrained; closed and holiday days
      are disabled submit buttons, not styling.</li>
      <li><strong>Action bar</strong> — sticky <code>.bo-form-actions</code>;
      the framework sets <code>scroll-padding-block-end</code> so focus never lands
      under it.</li>
      <li><strong>Field-per-row variant</strong> (below) — <a href={base + '/components/inline-editing'}>inline
      editing</a> on <code>&lt;th scope="row"&gt;</code> labels instead of
      fieldsets, for the master-data case where the record IS the table.</li>
    </ol>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns</th><th scope="col">On failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">GET /po/:id/edit</td><td>the full form, values filled server-side</td><td>404 → the not-found screen</td></tr>
          <tr><td class="bo-data-table__col--code">POST /po/:id</td><td>redirect to the record on success</td><td>422 → the SAME form re-rendered with <code>aria-invalid</code> + messages, values preserved</td></tr>
          <tr><td class="bo-data-table__col--code">POST /po/:id/lines</td><td>one row fragment (editable-grid save)</td><td>422 → that row with its cell error</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Server-side validation is the contract behind
    <code>aria-invalid</code>: re-render with the user's values, never a blank form,
    and point <code>aria-describedby</code> at the message. Pair with the
    <a href={base + '/patterns/validation-summary'}>validation summary</a> when more
    than two fields can fail at once.</p>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Pristine</td><td>Save enabled (a no-op save is harmless and simpler than tracking every field)</td></tr>
          <tr><td>Dirty</td><td>an unsaved marker near the action bar; warn on navigate-away via <code>beforeunload</code> — app code, four lines</td></tr>
          <tr><td>Saving</td><td>action bar buttons disabled + <code>aria-busy</code> on the form</td></tr>
          <tr><td>Field error</td><td><code>aria-invalid</code> + message, focus moved to the first invalid field</td></tr>
          <tr><td>Read-only (viewer role)</td><td>render <a href={base + '/components/kv'}>key-value facts</a> instead of inputs — not disabled inputs</td></tr>
          <tr><td>Conflict (someone else saved)</td><td>409 → banner naming who and when, with reload-or-overwrite; never silently clobber</td></tr>
          <tr><td>No JS</td><td>the top PO form has no script of its own — its Cancel is <code>type="button"</code> (already inert, with or without JS) and Save is a native <code>submit</code>, so nothing changes without JS. The field-per-row variant's inputs stay natively editable, and its Cancel (<code>type="reset"</code>) and Save (<code>type="submit"</code>) both work via plain HTML with no JS; only <code>initRowEdit()</code>'s live "Unsaved changes" badge and <code>initMoneyField()</code>'s currency-precision reformatting are lost</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Keyboard walkthrough &amp; print</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><kbd class="bo-kbd">Tab</kbd> runs header fields → line items → action bar; the sticky bar never hides the focused field.</li>
      <li>Inside line items, each cell is a real control — focus IS edit (see <a href={base + '/patterns/editable-grid'}>editable grid</a>).</li>
      <li><kbd class="bo-kbd">Enter</kbd> in a text field submits the form natively; keep Save as the form's submit button so that stays true.</li>
      <li>After a failed save, move focus to the first invalid field — the browser does this for native validation; do it yourself for server errors.</li>
    </ol>
    <p class="bo-u-text-muted"><strong>Print</strong>: the
    <a href={base + '/base/print'}>print layer</a> drops the action bar and renders
    fields as values, so a printed edit screen reads as a document rather than a
    form.</p>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 2 of 4</span></p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/form'}>Forms</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/patterns/editable-grid'}>Editable grid</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/patterns/validation-summary'}>Validation summary</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/calendar'}>Calendar</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/inline-editing'}>Inline editing</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/money'}>Money</a></li>
    </ul>
  </section>

  <script>
    import { initRowEdit, initMoneyField } from '@busy-office/ui/js';
    initRowEdit();
    initMoneyField();

    /* The field-per-row variant's dirty badge — same three-line split as
       the pattern it was folded from (109.19): the framework marks each
       ROW dirty, aggregating that into one "unsaved changes" badge is
       application state. */
    const feTable = document.querySelector('table[data-row-edit]');
    const feBadge = document.querySelector('[data-any-dirty]');
    const feSync = () => { feBadge.hidden = !feTable.querySelector('tr[data-row-state="dirty"]'); };
    document.addEventListener('input', feSync);
    document.addEventListener('change', feSync);
    document.addEventListener('reset', () => setTimeout(feSync, 0));
  </script>

  <Related links={[
    ["/components/form", "Forms"],
    ["/components/calendar", "Calendar"],
    ["/components/data-table", "Data table"],
    ["/components/inline-editing", "Inline editing"],
    ["/patterns/record-detail", "Record detail (read-only counterpart)"],
    ["/concepts/container-queries", "Container queries"],
  ]} />
</Gallery>
