---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = Array.from({ length: 14 }, (_, i) => ({
  no: `INV-10${234 + i}`,
  vendor: ['Acme Supply Co.', 'Globex Industrial', 'Initech GmbH', 'Umbrella Logistics', 'Stark Components'][i % 5],
  cc: ['CC-4021', 'CC-1180', 'CC-2205'][i % 3],
  due: `2026-08-${String(12 + (i % 15)).padStart(2, '0')}`,
  amount: `$${(Math.abs(Math.sin(i + 1)) * 20000 + 500).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}`,
  status: ['Pending', 'Approved', 'Rejected'][i % 3],
  tone: ['warning', 'success', 'danger'][i % 3],
}));
---
<Gallery title="Pattern: list report" description="The flagship ERP screen: find the records that need action, act on them in bulk, and never lose your place. Composed entirely from shipped components.">
  <p class="demo-note">
    <strong>Who uses it</strong>: AP clerks, all day — the screen they
    live in. <strong>What "done" looks like</strong>: find the invoices
    that need action, act on them in bulk, and never lose your place.
    Composed entirely from shipped components; the
    <a href={base + '/components/data-table'}>data table page</a>
    documents the table itself, this page documents the screen.
    <strong>Not for a single record's full detail</strong> — once a clerk
    opens one invoice to review or act on it alone, that screen is a
    <a href={base + '/patterns/record-detail'}>record detail</a> (or an
    <a href={base + '/patterns/object-page'}>object page</a> for a richer
    one); list-report's job stops at finding and bulk-acting on rows, not
    deep-diving into one.
  </p>
  <section class="demo">
    {/* GAP-17 / Slice 139: a header-actions row that stands whether the
        table is empty or full — the pattern used to name a primary action
        only inside the empty state (States, below), so six of seven suite
        list screens shipped with no way to create a record at all. bo-btn +
        bo-cluster--split, zero new CSS.
        The title is a real <h1> on a real screen — this demo uses a <span>
        for the same reason GAP-5's fix does on object-page: every demo here
        nests inside the docs page's own <h1>, so a second one here would be
        a defect the docs' own axe sweep would go green on, same trap. */}
    <div class="bo-cluster bo-cluster--split">
      <span>Invoices</span>
      <div class="bo-cluster">
        <button class="bo-btn bo-btn--ghost bo-btn--icon" type="button" aria-label="Refresh invoices">⟳</button>
        <button class="bo-btn" type="button">+ New invoice</button>
      </div>
    </div>
    {/* A saved view is a URL. The switcher is a GET form of radios, so
        picking one navigates to ?view=… — shareable, bookmarkable,
        pasteable into a ticket. hx-boost="false" for the same reason the
        bulk form opts out: this docs site boosts body-wide and there is
        no server behind the demo. */}
    <form class="bo-cluster" method="get" data-density="compact" hx-boost="false"
        style="margin-block-end: var(--bo-space-2)">
      <div class="bo-segmented" role="group" aria-label="Saved views">
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="view" id="lv-open" value="open" checked>
        <label class="bo-segmented__option" for="lv-open">All open · 312</label>
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="view" id="lv-mine" value="mine">
        <label class="bo-segmented__option" for="lv-mine">Mine · 18</label>
        <input class="bo-segmented__input bo-visually-hidden" type="radio" name="view" id="lv-overdue" value="overdue">
        <label class="bo-segmented__option" for="lv-overdue">Overdue · 7</label>
      </div>
      <button class="bo-btn bo-btn--secondary" type="submit">Go</button>
      <button class="bo-btn bo-btn--secondary" popovertarget="lv-menu">Views ▾</button>
      <div class="bo-dropdown__menu" id="lv-menu" popover>
        <button class="bo-dropdown__item" type="button">Save current filters as a view…</button>
        <button class="bo-dropdown__item" type="button">Rename “Mine”</button>
        <button class="bo-dropdown__item" type="button">Make this my default</button>
        <button class="bo-dropdown__item" type="button">Delete “Mine”</button>
      </div>
    </form>
    <form class="bo-cluster" data-density="compact">
      <input class="bo-input" type="search" aria-label="Search invoices" placeholder="Search…" style="max-inline-size: 12rem" />
      <select class="bo-select" aria-label="Status filter">
        <option>All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option>
      </select>
      <select class="bo-select" aria-label="Cost center filter">
        <option>All cost centers</option><option>CC-4021</option><option>CC-1180</option><option>CC-2205</option>
      </select>
      <button class="bo-btn bo-btn--secondary" type="button">Apply</button>
      <button class="bo-btn bo-btn--ghost" type="reset">Clear</button>
    </form>
    {/* hx-boost="false": this docs site boosts the whole body, and boost
        intercepts FORM submits too — it swapped #main-content and threw
        focus to <body>. A real app posts this form with hx-post, which
        boost leaves alone; a demo form with no server has to opt out. */}
    <form id="il-bulk" hx-boost="false">
    <div class="bo-data-table-container" tabindex="0" style="max-block-size: 24rem" data-density="compact">
      <div class="bo-data-table__toolbar">
        <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
          <button class="bo-btn bo-btn--secondary" type="submit">Approve selected</button>
          <button class="bo-btn bo-btn--danger" type="button">Reject selected</button>
        </div>
        <span class="bo-data-table__selection-count"></span>
        <span class="bo-u-text-muted">14 invoices</span>
      </div>
      <table class="bo-data-table bo-data-table--sticky-col">
        <thead>
          <tr>
            <th scope="col"><input type="checkbox" class="bo-checkbox bo-data-table__select-all" aria-label="Select all" /></th>
            <th scope="col" aria-sort="ascending"><button class="bo-data-table__sort-btn" type="button">Invoice #</button></th>
            <th scope="col">Vendor</th>
            <th scope="col" class="bo-data-table__col--tertiary">Cost center</th>
            <th scope="col" class="bo-data-table__col--secondary">Due</th>
            <th scope="col" class="bo-data-table__col--numeric">Amount</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><input type="checkbox" class="bo-checkbox bo-data-table__row-select" aria-label={`Select ${r.no}`} /></td>
              <td class="bo-data-table__col--code">{r.no}</td>
              <td class="bo-u-text-truncate">{r.vendor}</td>
              <td class="bo-data-table__col--tertiary bo-data-table__col--code">{r.cc}</td>
              <td class="bo-data-table__col--secondary bo-u-tabular">{r.due}</td>
              <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">{r.amount.slice(1, -3)}<span class="bo-amount__fraction">{r.amount.slice(-3)}</span></span></span></td>
              <td><span class={`bo-badge bo-badge--${r.tone}`}>{r.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="bo-data-table__footer">
        <nav class="bo-pagination" aria-label="Invoice pages">
          <button class="bo-pagination__btn" type="button" disabled aria-label="Previous page">‹</button>
          <a class="bo-pagination__btn" aria-current="page" href="?page=1">1</a>
          <a class="bo-pagination__btn" href="?page=2">2</a>
          <a class="bo-pagination__btn" href="?page=3">3</a>
          <a class="bo-pagination__btn" href="?page=2" aria-label="Next page">›</a>
          <span class="bo-pagination__info">1–6 of 312</span>
        </nav>
      </div>
    </div>
    </form>
    <p class="bo-u-text-muted">The rows and the bulk buttons are one
    <code>&lt;form&gt;</code>, which is what makes step 4 below work:
    <kbd class="bo-kbd">Enter</kbd> from any row checkbox runs the bulk
    action, so a selection thirty rows down is zero keypresses from acting
    instead of thirty-two. Only the safe action is
    <code>type="submit"</code> — <em>Reject</em> stays
    <code>type="button"</code>, so implicit submission can never reach a
    destructive one.</p>
  </section>

  <section class="demo">
    <h2>Filtering: typed tokens, not a filter dialog</h2>
    <p>ERP users live in a handful of named views and rarely compose
    filters from scratch. So the ad-hoc case gets <strong>one search
    field</strong> that accepts typed tokens, and there is deliberately no
    adapt-filters dialog:</p>
    <div class="bo-cluster" role="group" aria-label="Active filters">
      <span class="bo-u-text-muted">Filtering by</span>
      <span class="bo-chip">status: pending
        <a class="bo-chip__remove" href="#" aria-label="Remove filter status pending">&times;</a></span>
      <span class="bo-chip">vendor: acme
        <a class="bo-chip__remove" href="#" aria-label="Remove filter vendor acme">&times;</a></span>
    </div>
    <p class="bo-u-text-muted" style="margin-block-start: var(--bo-space-3)">Zero
    new framework surface: the field is a plain
    <code>&lt;input type="search"&gt;</code> and each active token is the
    <a href={base + '/components/filters'}><code>.bo-chip</code></a> that
    already ships. Reads as a sentence, stays keyboardable, and survives
    being bookmarked because it is all in the URL.</p>

    <h3>The parse contract is the server's</h3>
    <ul class="bo-stack bo-stack--tight docs-list">
      <li><code>key:value</code> where <code>key</code> is one your server
      recognises; everything else is free text.</li>
      <li><strong>An unknown key stays free text</strong> — it is not a
      token with no matches. A vendor genuinely called
      <code>ref:99</code> must still be findable, so guessing is worse than
      not tokenising.</li>
      <li>Multiple tokens are AND; free text searches the columns you
      choose. Both live in the single <code>q</code> parameter.</li>
      <li>Each chip's remove control is a plain <code>&lt;a href&gt;</code>
      carrying <code>q</code> minus that token — removing a filter needs no
      JavaScript, and works with the back button.</li>
    </ul>
    <p class="bo-u-text-muted">Working implementation in
    <a href="https://github.com/Busy-Office/busy-office-ui/tree/main/examples/po-app">examples/po-app</a>:
    <code>status:pending vendor:stark</code> narrows to one row, dropping
    the status token widens it to six, and the chips track both.</p>
  </section>

  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Header actions</strong> — a
      <a href={base + '/base/primitives'}>cluster</a> split with
      <code>bo-cluster--split</code>: the screen's title, and a
      <a href={base + '/components/button'}>primary create action</a> plus
      refresh. Renders whether the table is empty or full — this is the
      region that was missing (GAP-17): the pattern used to name a primary
      action only inside the empty state below, so nothing stood above a
      populated table.</li>
      <li><strong>Saved-view switcher</strong> — a
      <a href={base + '/components/segmented'}>segmented control</a> of named
      views inside a GET form (so a view is a URL) plus a
      <a href={base + '/components/dropdown'}>dropdown</a> for save/rename/
      default/delete. Zero new CSS; the persistence contract is in Data
      contract below.</li>
      <li><strong>Filter bar</strong> — a plain <code>&lt;form&gt;</code> in a
      <a href={base + '/base/primitives'}>cluster</a> with
      <a href={base + '/components/filters'}>filter</a> controls. Submits on Apply;
      Clear is a native <code>type="reset"</code>.</li>
      <li><strong>Toolbar</strong> (<code>.bo-data-table__toolbar</code>) — bulk
      actions appear only when rows are selected; the selection count is filled by
      <code>initDataTables()</code>.</li>
      <li><strong>Table</strong> (<code>.bo-data-table--sticky-col</code>) — sticky
      header, frozen select column, <code>aria-sort</code> on the sorted header,
      <a href={base + '/components/badge'}>status badges</a> carrying text, not just
      color. Columns declare their priority: Cost center is
      <code>--tertiary</code> (drops first as the container narrows), Due is
      <code>--secondary</code> — the
      <a href={base + '/components/data-table'}>ladder</a> keeps a narrow
      screen on the columns the row cannot be understood without.</li>
      <li><strong>Footer</strong> — rows-per-page +
      <a href={base + '/components/pagination'}>pagination</a>, or a load-more
      button; pick one and keep it (see Scaling).</li>
    </ol>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <p>What the server must return for this screen to work — the HTMX/fetch
    boundary:</p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns</th><th scope="col">Swaps into</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">GET /invoices?status=&amp;cc=&amp;q=&amp;page=</td><td>the <code>&lt;tbody&gt;</code> rows + an out-of-band footer</td><td class="bo-data-table__col--code">#invoice-rows</td></tr>
          <tr><td class="bo-data-table__col--code">POST /invoices/bulk-approve</td><td>the affected rows, re-rendered with new badges</td><td class="bo-data-table__col--code">#invoice-rows</td></tr>
          <tr><td class="bo-data-table__col--code">GET /invoices?page=n</td><td>next page rows (append) or a full replace</td><td class="bo-data-table__col--code">#invoice-rows</td></tr>
          <tr><td class="bo-data-table__col--code">GET /invoices?view=mine</td><td>the server RESOLVES the view name to its filters and renders the list — the view is a saved query living server-side, not a client blob; the response also re-renders the switcher so counts and the selected chip are never stale</td><td class="bo-data-table__col--code">full page (a view change is a navigation)</td></tr>
          <tr><td class="bo-data-table__col--code">POST /views &#123;name, query, scope&#125;</td><td>201 + the re-rendered switcher including the new chip. <code>scope</code> is private or shared: a shared view others depend on cannot be silently redefined, so editing one is a new version with the old URL still resolving</td><td class="bo-data-table__col--code">the switcher</td></tr>
          <tr><td class="bo-data-table__col--code">POST /views — 409 name taken</td><td>the form re-renders with the conflict named ("you already have a view called Mine") — never auto-suffix to "Mine (2)", which is how people end up with four views they cannot tell apart</td><td class="bo-data-table__col--code">the save form</td></tr>
          <tr><td class="bo-data-table__col--code">PATCH /views/:id/default</td><td>which view a bare <code>GET /invoices</code> resolves to for THIS user; a default is per-user, and a shared link always beats it — the URL a colleague sent must show what they saw</td><td class="bo-data-table__col--code">the switcher</td></tr>
          <tr><td class="bo-data-table__col--code">GET /invoices?view=x — 403 / 404</td><td>fall back to the user's default AND SAY SO ("that view is not shared with you — showing All open"); silently swapping the list is how someone acts on the wrong rows</td><td class="bo-data-table__col--code">full page + an alert</td></tr>
          <tr><td class="bo-data-table__col--code">any request, 5xx or timeout</td><td>the Error state above (<code>.bo-alert--danger</code> + retry, last good rows kept); <code>POST /invoices/bulk-approve</code> failing per row is separate — still 200, the failure is the returned row's own <code>data-row-state="error"</code>, not a transport-level error</td><td class="bo-data-table__col--code">unswapped; alert renders in place</td></tr>
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Rows carry <code>data-row-id</code> so partial
    responses can target one row. Selection state is CLIENT state — a swap that
    replaces rows clears it, which is the honest behaviour after a bulk action.
    Filters belong in the URL query so a filtered list is linkable and survives
    reload — and that is exactly what makes a <strong>saved view a URL</strong>
    here rather than a stored client preference. The switcher is a plain GET
    form of radios: picking a view navigates to <code>?view=…</code>, so a
    view can be bookmarked, pasted into a ticket, or sent to a colleague and
    they see the same rows. That is the one thing the reference
    implementations' variant managers cannot do — theirs is a personal client
    blob behind a dropdown — and it costs no component: a
    <a href={base + '/components/segmented'}>segmented control</a> and a
    <a href={base + '/components/dropdown'}>dropdown</a>, both already
    shipped. The framework ships no view MANAGER, on purpose: naming,
    sharing and permissions are your data model, and the contract rows
    above are what that model owes the screen.</p>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Loading (first paint)</td><td><a href={base + '/components/state-patterns'}>Skeleton rows</a> — never an empty table that fills in</td></tr>
          <tr><td>Loading (refetch)</td><td><code>data-loading="true"</code> + <code>aria-busy</code> on the table: dims and blocks interaction mid-swap</td></tr>
          <tr><td>Empty (no data yet)</td><td>the header action stays — it is not only the empty state's action anymore — and a <a href={base + '/components/state-patterns'}><code>.bo-state</code></a> repeats it in-place so the reader does not have to look up</td></tr>
          <tr><td>Empty (filters exclude everything)</td><td>the same <a href={base + '/components/state-patterns'}><code>.bo-state</code></a> with DIFFERENT words — name the filters that caused it and offer "Clear filters", not "Create". There is no <code>--empty</code>/<code>--filtered</code> modifier; the wording is the whole difference</td></tr>
          <tr><td>Error</td><td><code>.bo-alert--danger</code> above the table with a retry; keep the last good rows visible</td></tr>
          <tr><td>Row error</td><td><code>data-row-state="error"</code> + a badge naming the reason (two-channel)</td></tr>
          <tr><td>Partial failure after bulk</td><td>re-render the failed rows in the error state and summarise: "8 approved, 2 failed"</td></tr>
          <tr><td>No permission</td><td>bulk buttons absent (not disabled) — a control you can never use is noise</td></tr>
          <tr><td>No saved views yet</td><td>the switcher is absent entirely, not an empty control — a segmented control with one option is a label pretending to be a choice; the Views menu keeps "Save current filters as a view…"</td></tr>
          <tr><td>View selected, filters then changed</td><td>the chip stays selected but the screen says the view is modified ("Overdue · edited") and the Views menu offers Save / Reset — silently drifting off a named view is how someone reports numbers from a filter they never chose</td></tr>
          <tr><td>Shared view link the reader can't see</td><td>their default renders WITH an alert naming the swap; the rows shown must never be mistaken for the rows sent</td></tr>
          <tr><td>Shared view deleted by its owner</td><td>the URL still resolves, to a stated "this view no longer exists" + the default — an audit trail that dead-ends on a 404 is a support call</td></tr>
          <tr><td>No JS</td><td>row checkboxes and the bulk-action buttons are real inputs inside a native <code>&lt;form&gt;</code>, so picking rows and submitting still works end to end; only <code>initDataTables()</code>'s conveniences are lost — the header checkbox no longer toggles every row (it's just an unwired checkbox), and the "n selected" live region never updates, so a screen-reader user gets no running count of the selection</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Keyboard walkthrough</h2>
    <p>The path an AP clerk actually takes, with nothing custom bound:</p>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><kbd class="bo-kbd">Tab</kbd> into the filter bar, type, <kbd class="bo-kbd">Enter</kbd> to apply — a native form submit.</li>
      <li><kbd class="bo-kbd">Tab</kbd> to the select-all checkbox; <kbd class="bo-kbd">Space</kbd> toggles the page's rows and announces the count via the live region.</li>
      <li><kbd class="bo-kbd">Tab</kbd> through row checkboxes, <kbd class="bo-kbd">Space</kbd> to pick individual invoices.</li>
      <li><kbd class="bo-kbd">Enter</kbd> from any row checkbox runs the bulk
      action — no journey back to the toolbar at all. That is native implicit
      form submission, not framework code: the rows and the buttons are one
      <code>&lt;form&gt;</code>, and focus stays on the checkbox you pressed.
      Without the form the toolbar is one
      <kbd class="bo-kbd">Shift</kbd>+<kbd class="bo-kbd">Tab</kbd> per row you
      passed plus two — thirty-two presses from row 30, which is what this
      page measured before the form was added.</li>
      <li>Sorting: the header is a real <code>&lt;button&gt;</code>, so it is
      keyboard-reachable and announced as a control — but <strong>sorting
      itself is your code</strong>. The framework ships none. Your handler
      sets <code>aria-sort</code> on the <code>&lt;th&gt;</code>; leaving a
      hardcoded <code>aria-sort</code> on a header that never sorts announces
      an order that isn't real.</li>
    </ol>
    <p class="bo-u-text-muted">The table deliberately does NOT take a roving
    tabindex — screen-reader table browse mode is worth more than 2-D arrow
    navigation on a read-mostly list (<code>data-grid-nav</code> is opt-in per
    table when a screen really is grid-first).</p>
  </section>

  <section class="demo">
    <h2>Print behaviour</h2>
    <p>ERP lists get printed and signed. The
    <a href={base + '/base/print'}>print layer</a> repeats the table header on every
    page, never splits a row, drops the toolbar/pagination/filter chrome, and forces
    status colors so a badge survives a monochrome printer. Print the page to see
    it — no print-specific markup required.</p>
  </section>

  <section class="demo">
    <h2>Scaling notes</h2>
    <ul class="bo-stack bo-stack--tight docs-list">
      <li><strong>Rows</strong>: measured render costs (1k → 20k, including a 4×
      CPU throttle) are on the
      <a href={base + '/components/data-table'}>data table page</a>. Past ~5k rows,
      paginate server-side — the framework has no virtualiser and does not pretend
      to.</li>
      <li><strong>Pagination vs load-more</strong>: pagination when clerks cite
      "page 3" and need a stable position; load-more for scanning feeds. Don't ship
      both on one screen.</li>
      <li><strong>Columns</strong>: past ~10, the frozen select column plus
      horizontal scroll carries it; consider a column chooser rather than shrinking
      type.</li>
      <li><strong>Languages</strong>: German column labels run ~35% longer —
      headers wrap by design, so verify at compact density in the longest locale
      you ship.</li>
    </ul>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 2 of 4</span> —
    read-many-records tier.</p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/data-table'}>Data table</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/button'}>Button</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/pagination'}>Pagination</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/filters'}>Filters</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/form'}>Forms</a></li>
    </ul>
  </section>

  <script>
    import { initDataTables } from '@busy-office/ui/js';
    initDataTables();
    // Demo only: the bulk form has no server here, so keep Enter from
    // navigating. The submit event still fires — which is exactly what the
    // documented-claims gate asserts.
    document.getElementById('il-bulk')?.addEventListener('submit', (e) => e.preventDefault());
  </script>
  <Related links={[["/getting-started/first-screen", "Build this step by step"], ["/components/data-table", "Data table"], ["/components/filters", "Filters"], ["/patterns/record-detail", "Record detail (the row's destination)"]]} />
</Gallery>
