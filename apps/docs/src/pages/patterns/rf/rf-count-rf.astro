---
/* Isolated rf-essentials proof for /patterns/rf-count — same rule as
   goods-receipt-rf: no Gallery, no main bundle; this page must prove the
   profile (Chrome/WebView 108) is sufficient on its own. */
import CountScreen from '../../../components/rf/CountScreen.astro';
import PrefBootstrap from '../../../components/PrefBootstrap.astro';
import SocialMeta from '../../../components/SocialMeta.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cssHref = base + '/assets/rf-essentials.min.css';
/* Hoisted, not retyped (roadmap 249.17): <title>, <meta name="description">
   and the og:/twitter: tags all read the SAME literal, so they cannot drift.
   check-metadata.mjs asserts on the BUILT page that they agree. */
const socialTitle = 'RF count — rf-essentials profile';
const socialDescription = 'The RF count screen as an isolated document, loading only the rf-essentials CSS profile to prove that profile is sufficient on its own.';
---
<!doctype html>
<html lang="en" data-density="spacious">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PrefBootstrap density="spacious" lockDensity />
    <title>{socialTitle}</title>
    <meta name="description" content={socialDescription} />
    <SocialMeta title={socialTitle} description={socialDescription} />
    <link rel="stylesheet" href={cssHref} />
    <style>
      body {
        margin: 0;
        padding: var(--bo-space-3);
        background: var(--bo-color-bg-canvas);
        color: var(--bo-color-text-primary);
      }
    </style>
  </head>
  <body>
    <main aria-label="RF count, rf-essentials profile demo">
      <h1 class="bo-visually-hidden">RF count</h1>
      <CountScreen />
    </main>
  </body>
</html>
