---
/* Isolated rf-essentials proof for /patterns/rf-putaway — same rule as
   goods-receipt-rf: no Gallery, no main bundle; this page must prove the
   profile (Chrome/WebView 108) is sufficient on its own. */
import PutawayScreen from '../../../components/rf/PutawayScreen.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cssHref = base + '/assets/rf-essentials.min.css';
---
<!doctype html>
<html lang="en" data-density="spacious">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RF putaway — rf-essentials profile</title>
    <link rel="stylesheet" href={cssHref} />
    <style>
      body {
        margin: 0;
        padding: var(--bo-space-3);
        background: var(--bo-color-bg-canvas);
        color: var(--bo-color-text-primary);
      }
    </style>
  </head>
  <body>
    <main aria-label="RF putaway, rf-essentials profile demo">
      <h1 class="bo-visually-hidden">RF putaway</h1>
      <PutawayScreen />
    </main>
  </body>
</html>
