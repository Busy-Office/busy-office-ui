  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns / on failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">PATCH /po/:id/lines/:lineId</td><td>the saved row re-rendered (authoritative values — rounding, derived fields); 422 → the same row with cell errors</td></tr>
          <tr><td class="bo-data-table__col--code">POST /po/:id/lines</td><td>a new row fragment appended to the tbody</td></tr>
          <tr><td class="bo-data-table__col--code">DELETE /po/:id/lines/:lineId</td><td>204 and remove the row client-side; 409 if the line was already invoiced</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Clean</td><td>no badge, no buttons — the row looks like a read-only row</td></tr>
          <tr><td>Dirty</td><td>the Unsaved badge plus Save/Cancel; Cancel restores last-saved values and re-fires input events so totals revert</td></tr>
          <tr><td>Saving (live mode)</td><td>saves are coalesced per row per tick; a row removed in the same tick is never saved</td></tr>
          <tr><td>Cell error</td><td><code>aria-invalid</code> + the message inside that cell&rsquo;s form field, with the row tinted</td></tr>
          <tr><td>Conflict</td><td>409 → re-render that row with the server values and say who changed it; never merge silently</td></tr>
          <tr><td>Read-only line</td><td>render the value as text — an invoiced line that looks editable is a support call</td></tr>
        </tbody>
      </table>
    </div>
  </section>

