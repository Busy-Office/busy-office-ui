---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import AppTile from '../../components/AppTile.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const favourites = [
  { icon: 'cart', label: 'Purchasing' },
  { icon: 'invoice', label: 'Invoices' },
  { icon: 'check-circle', label: 'Goods receipt' },
  { icon: 'chart', label: 'Reports' },
];
/* Payables and Receivables carry INITIALS, not glyphs. There is no mark an ERP
   user reliably reads as "accounts payable", and the two nearest candidates —
   `invoice` and `doc` — are both a page outline, which is how Payables ended up
   wearing the same mark as Invoices. AP/AR is what the folder tile below
   already calls them. */
const finance = [
  { icon: 'doc', label: 'General ledger' },
  { initials: 'AP', label: 'Payables' },
  { initials: 'AR', label: 'Receivables' },
  { label: 'Currencies' },   // inline <svg>, see the tile below
];
/* The launcher's own catalogue. Hand-written rather than AppTile because each
   tile needs a stable identity and its own keywords, and AppTile's props are
   {label, icon, initials} with a hardcoded href="#" — widening a shared
   component for one page's filter is exactly the coupling this task refuses. */
const launcher = [
  { group: 'Finance', apps: [
    { id: 'gl', label: 'General ledger', keywords: 'accounts journal posting' },
    { id: 'ap', label: 'Payables', keywords: 'vendor invoice bills AP' },
    { id: 'ar', label: 'Receivables', keywords: 'customer dunning AR' },
    { id: 'fx', label: 'Currencies', keywords: 'exchange rate forex' },
  ] },
  { group: 'Logistics', apps: [
    { id: 'wh', label: 'Warehouse', keywords: 'bins putaway storage' },
    { id: 'ship', label: 'Shipping', keywords: 'carrier despatch freight' },
    { id: 'count', label: 'Stock counts', keywords: 'cycle inventory stocktake' },
  ] },
  { group: 'Purchasing', apps: [
    { id: 'po', label: 'Purchase orders', keywords: 'PO procurement ordering' },
    { id: 'req', label: 'Requisitions', keywords: 'request approval intake' },
  ] },
];

const logistics = [
  { icon: 'box', label: 'Warehouse' },
  { icon: 'truck', label: 'Shipping' },
  { icon: 'grid', label: 'Stock counts' },
];
---
<Gallery title="Pattern: app launch" description="The first screen after sign-in, where the right app is one tap away whether it is a favourite or three levels deep in a category.">
  <p class="demo-note">
    <strong>Who uses it</strong>: anyone opening the suite, every session —
    the first screen after sign-in. <strong>What "done" looks like</strong>:
    the right app is one tap away, whether it's a favourite or three deep in
    a category. A suite entry screen — the icon-grid launcher (the "Bento UI"
    / tablet-launcher archetype from the
    <a href={base + '/concepts/density'}>device-coverage table</a> — same
    <code>.bo-widget-grid</code> container-query mechanism as a dashboard, at a
    smaller tile size, <strong>not</strong> a new grid component). Tiles are plain
    links composed into <code>.bo-widget</code> cards with real
    <a href={base + '/components/icon'}>CSS icons</a> (themable <code>currentColor</code>
    glyphs) where a glyph is genuinely right, an initials chip where none is, and
    inline <code>&lt;svg&gt;</code> where a tenant brings their own; the category row is the
    ordinary <a href={base + '/components/tabs'}>tabs</a> pattern; a "folder" tile is just a
    widget whose body holds a cluster of small tiles. Zero new CSS.
    <strong>Not for returning a user to a specific record they already know</strong> —
    a bookmark, a notification, or a saved link should land directly on
    <a href={base + '/patterns/object-page'}>the object page</a> or
    <a href={base + '/patterns/list-report'}>the list report</a>, never route back
    through the launcher grid to get there.
  </p>

  <section class="demo">
    <h2>Favourites</h2>
    <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
      {favourites.map((a) => <AppTile {...a} />)}
    </div>
  </section>

  <section class="demo">
    <h2>All applications — category tabs</h2>
    <div class="bo-tabs">
      <div class="bo-tabs__list" role="tablist" aria-label="Application categories">
        <button class="bo-tabs__tab" role="tab" id="al-t-fin" aria-selected="true" aria-controls="al-p-fin">Finance</button>
        <button class="bo-tabs__tab" role="tab" id="al-t-log" tabindex="-1" aria-selected="false" aria-controls="al-p-log">Logistics</button>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="al-p-fin" aria-labelledby="al-t-fin" tabindex="0">
        <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
          {finance.filter((a) => a.label !== 'Currencies').map((a) => <AppTile {...a} />)}
          {/* The per-tenant slot: any inline <svg> works, and inherits
              currentColor exactly like a shipped glyph. This is the international
              currency sign (¤) — deliberately not "$", which would bake one
              locale into a screen this framework expects to ship worldwide. */}
          <AppTile label="Currencies">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="6" />
              <line x1="7.8" y1="7.8" x2="5" y2="5" />
              <line x1="16.2" y1="7.8" x2="19" y2="5" />
              <line x1="7.8" y1="16.2" x2="5" y2="19" />
              <line x1="16.2" y1="16.2" x2="19" y2="19" />
            </svg>
          </AppTile>
        </div>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="al-p-log" aria-labelledby="al-t-log" tabindex="0" hidden>
        <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
          {logistics.map((a) => <AppTile {...a} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="demo">
    <h2>A "folder" tile — grouped apps</h2>
    <div class="bo-widget-grid" style="--bo-widget-min: 12rem">
      <a href="#" class="bo-widget">
        <div class="bo-widget__body" style="text-align: center">
          <span class="bo-cluster" aria-hidden="true" style="justify-content: center; --bo-cluster-gap: var(--bo-space-1)">
            <span class="bo-badge">GL</span><span class="bo-badge">AP</span><span class="bo-badge">AR</span><span class="bo-badge">FX</span>
          </span>
          <span style="display: block; margin-block-start: var(--bo-space-2); color: var(--bo-color-text-primary)">Finance apps</span>
        </div>
      </a>
      <a href="#" class="bo-widget">
        <div class="bo-widget__body" style="text-align: center">
          <span class="bo-cluster" aria-hidden="true" style="justify-content: center; --bo-cluster-gap: var(--bo-space-1)">
            <span class="bo-badge">WH</span><span class="bo-badge">SH</span><span class="bo-badge">ST</span>
          </span>
          <span style="display: block; margin-block-start: var(--bo-space-2); color: var(--bo-color-text-primary)">Logistics apps</span>
        </div>
      </a>
    </div>
    <p class="bo-u-text-muted">A folder is a single link to a category page (or a
    dialog listing its apps) whose face previews the members as badges — not a
    hover-expanding stack. One click, one navigation; the preview is
    <code>aria-hidden</code> so the link's accessible name is just "Finance apps".</p>
  </section>

  <script>
    import { initTabs, initDialogs } from '@busy-office/ui/js';
    initTabs();
    initDialogs();

    /* Page-local filter. Deliberately not extracted into a shared behavior —
       see the comparison in this page's prose and roadmap 373.5.

       Two properties the checks depend on, both from HIDING rather than
       styling: `hidden` takes a tile out of the accessibility tree AND out of
       the tab order, and the framework's own focus trap filters by visibility,
       so a filtered-out tile cannot be reached by Tab. Setting `display:none`
       in CSS would look identical and do the same, but `hidden` says it in the
       DOM where a check can read it. */
    const search = document.getElementById('al-search') as HTMLInputElement | null;
    if (search) {
      const dialog = document.getElementById('al-launcher')!;
      const count = document.getElementById('al-count')!;
      const empty = document.getElementById('al-empty')!;
      /* Keywords live in a JSON block rather than a data-* attribute: a
         `data-` hook the framework does not document is a promise nothing
         keeps, and check:data-hooks is right to refuse one. Identity is the
         element's own id. */
      const keywords: Record<string, string> =
        JSON.parse(document.getElementById('al-keywords')?.textContent || '{}');
      const apps = [...dialog.querySelectorAll<HTMLElement>('.al-app')];
      const groups = [...dialog.querySelectorAll<HTMLElement>('.al-group')];

      const apply = () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const app of apps) {
          const key = app.id.replace(/^al-app-/, '');
          const hay = `${app.textContent} ${keywords[key] ?? ''}`.toLowerCase();
          const match = !q || hay.includes(q);
          app.hidden = !match;
          if (match) shown += 1;
        }
        // A group with nothing left in it is noise, not context.
        for (const g of groups) {
          g.hidden = ![...g.querySelectorAll<HTMLElement>('.al-app')].some((a) => !a.hidden);
        }
        empty.hidden = shown > 0;
        count.textContent = q
          ? `${shown} application${shown === 1 ? '' : 's'} match ${search.value.trim()}`
          : `${shown} application${shown === 1 ? '' : 's'}`;
      };
      search.addEventListener('input', apply);

      /* ESCAPE CLOSES THE LAUNCHER, EVEN MID-QUERY. `type="search"` carries a
         native Escape-to-clear, and Chromium lets that CONSUME the key: with a
         query typed, the first Escape emptied the box and left the dialog open
         with focus still in the input, so closing took two presses. Measured
         on the built page before this handler existed; the empty-field case
         worked, which is exactly why it read as fine.

         `dialog.close()` on keydown rather than swapping to `type="text"`:
         the type carries the platform's own clear affordance and its
         search-shaped semantics, and dropping those to work around a key
         collision trades a real affordance for a smaller diff. The native
         clear still runs — the field empties AND the dialog closes, which is
         what "Escape closes it" has to mean if the page says so. `<dialog>`
         returns focus to the trigger on close by itself. */
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && (dialog as HTMLDialogElement).open) {
          (dialog as HTMLDialogElement).close();
        }
      });

      /* Re-filter on close (roadmap 377.2). Chromium's Escape-clear fires
         `search`, not `input`, so the grid kept the old query under an empty
         box and the reopened launcher disagreed with itself. `close` fires
         after that clear, on every engine, so the grid always follows whatever
         the field holds — cleared or not. */
      (dialog as HTMLDialogElement).addEventListener('close', apply);

      // Run once so the count is populated before anyone types.
      apply();
    }
  </script>

  <style>
    /* Page-local sizing for THIS launcher only, keyed to its own id. A grid the
       reader scans wants the viewport; prose does not, which is why the shipped
       dialog keeps a 32rem measure and why this is not a new modifier. */
    #al-launcher.al-launcher {
      max-inline-size: min(64rem, calc(100vw - var(--bo-space-6)));
      inline-size: 100%;
      max-block-size: calc(100vh - var(--bo-space-6));
      overflow: auto;
    }
    /* Long app names wrap instead of widening the grid track at 390. */
    #al-launcher .al-app { overflow-wrap: anywhere; }
  </style>

  <section class="demo">
    <h2>A searchable launcher for a catalogue too big to scan</h2>
    <p class="demo-note">The grids above are the answer when someone can
    <em>see</em> their app. Past roughly two screens of tiles they cannot, and
    scrolling a category tree to find &ldquo;Receivables&rdquo; is slower than
    typing it. This is the same catalogue behind a
    <a href={base + '/components/dialog/'}>dialog</a> with a search box —
    composed from what already ships, with no new component and no new
    fullscreen modifier.</p>

    <script type="application/json" id="al-keywords" set:html={JSON.stringify(
      Object.fromEntries(launcher.flatMap((g) => g.apps.map((a) => [a.id, a.keywords])))
    )} />

    <button class="bo-btn" type="button"
            data-dialog-trigger="al-launcher" id="al-launcher-open">Open the launcher</button>

    <dialog class="bo-dialog al-launcher" id="al-launcher" aria-labelledby="al-launcher-title">
      <form method="dialog" class="bo-cluster" style="justify-content: space-between; padding: var(--bo-space-4) var(--bo-space-4) 0">
        <h2 id="al-launcher-title">All applications</h2>
        <button class="bo-btn bo-btn--ghost" id="al-launcher-close" value="close">Close</button>
      </form>
      <div style="padding: var(--bo-space-4)">
        <div class="bo-form-field">
          <label class="bo-form-field__label" for="al-search">Search applications</label>
          <input class="bo-input" id="al-search" type="search" autofocus
                 placeholder="Type a name or a keyword…" autocomplete="off" />
        </div>
        <p class="bo-visually-hidden" id="al-count" role="status" aria-live="polite"></p>
        {launcher.map((g) => (
        <section class="al-group">
          <h3 class="bo-u-text-muted" style="margin-block: var(--bo-space-3) var(--bo-space-2)">{g.group}</h3>
          <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
            {g.apps.map((a) => (
              <a href="#" class="bo-widget al-app" id={`al-app-${a.id}`}
                 style="text-align: center; padding-block: var(--bo-space-4)">{a.label}</a>
            ))}
          </div>
        </section>
      ))}
        <div class="bo-state" id="al-empty" hidden>
          <span class="bo-state__icon" aria-hidden="true">🔍</span>
          <p class="bo-state__title">No applications match</p>
          <p class="bo-state__description">Try a shorter word, or clear the box to see everything.</p>
        </div>
      </div>
    </dialog>

    <p class="bo-u-text-muted"><strong>Why this one is allowed to fill the
    viewport.</strong> A dialog is normally kept to a measure &mdash; 32rem, because
    prose stops being readable past it. A launcher is not prose: it is a grid
    the reader scans, and a narrow column turns one glance into a scroll. The
    sizing here is <strong>page-local</strong>, a few lines against this
    dialog&rsquo;s own id, not a new <code>--fullscreen</code> modifier that every
    future dialog could reach for.</p>

    <p class="bo-u-text-muted"><strong>Which of the three to reach for.</strong>
    The <a href={base + '/patterns/app-launch/'}>tile grids</a> above win when the
    catalogue fits on a screen or two &mdash; recognition beats recall, and no
    typing is faster than typing. This launcher wins when it does not fit and
    the reader knows roughly what the thing is called. The
    <a href={base + '/patterns/command-bar/'}>command bar</a> wins when they
    know exactly, and want to jump without leaving the keyboard &mdash; it
    searches <em>actions</em> as well as apps, and it is a different keyboard
    model. <strong>Not for a list of records</strong>; that is a
    <a href={base + '/patterns/list-report/'}>list report</a> with a filter.</p>

    <p class="bo-u-text-muted"><strong>What is real here and what is not.</strong>
    Opening, the search, Escape, Close and the focus moves are real, and
    <strong>seven cases in <code>check:claims</code> drive them with real key
    and pointer events</strong> &mdash; including the one that used to be
    broken: with a query typed, <code>type="search"</code> carries a native
    Escape-to-clear that consumed the key, so closing took two presses. One
    press closes it now, and the build fails if that regresses. The tiles are <code>href="#"</code>, like every other
    tile on this page &mdash; they go nowhere. <strong>The dialog needs
    JavaScript</strong>: <code>initDialogs()</code> opens it, so without JS the
    trigger does nothing and the catalogue above remains the way in. That is why
    the grids stay on this page rather than being replaced by the launcher.
    Filtering, the result count and what the tiles link to are yours.</p>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{`<!-- A tile is a link styled as a card. The grid is the SAME .bo-widget-grid
     a dashboard uses — --bo-widget-min sets the tile size; the grid's own
     container query reflows it on tablet/narrow widths for free. -->
<div class="bo-widget-grid" style="--bo-widget-min: 9rem">
  <a href="/purchasing" class="bo-widget"
      style="text-align: center; padding-block: var(--bo-space-4)">
    <!-- No color on the mark: the reset's own a { color: accent } already
         gives the tile its accent, and the label below opts OUT of it. -->
    <span class="bo-icon bo-icon--cart" aria-hidden="true"
        style="font-size: 2rem; margin-inline: auto"></span>
    <span style="color: var(--bo-color-text-primary)">Purchasing</span>
  </a>
  …
</div>
<!-- Category row = the ordinary tabs pattern; each panel holds its own grid. -->`}</code></pre>
  </section>


  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>App shell</strong> — header + sidebar + main; the shell is the pattern.</li>
      <li><strong>Entry tiles</strong> — a <code>.bo-grid</code> of cards, each a task the user starts here.</li>
      <li><strong>Counts / badges</strong> — "12 awaiting approval" on a tile: the reason this screen exists rather than a static menu.</li>
      <li><strong>Recent items</strong> — a short list back into records the user touched last.</li>
    </ol>
    <p>
      <strong>One glyph per app, never reused in a launcher.</strong> A tile grid is
      scanned by shape before it is read, so two apps wearing the same mark cost the
      user the whole benefit of the grid. If no distinct glyph exists, use the
      initials chip rather than an approximate one — an approximate mark is worse
      than letters, because it is confidently wrong. This page practises that:
      Payables and Receivables are <span class="bo-badge">AP</span> and
      <span class="bo-badge">AR</span> rather than two near-identical document
      outlines, which is exactly the bug this section now rules out.
    </p>
    <p>
      <strong>The icon set is not the limit.</strong> A launcher is product content —
      your app list is yours, and no framework can ship the right glyphs for
      it. Any inline <code>&lt;svg&gt;</code> drops into the same slot and inherits
      <code>currentColor</code>, so it themes with everything else for free.
      Currencies above is one: the international currency sign, hand-drawn in six
      lines of SVG, with nothing added to the framework.
    </p>
    <pre><code>{`<a href="/currencies" class="bo-widget">
  <svg viewBox="0 0 24 24" width="32" height="32" fill="none"
       stroke="currentColor" stroke-width="2" aria-hidden="true">
    …your mark…
  </svg>
  <span>Currencies</span>
</a>`}</code></pre>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns / on failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">GET /home</td><td>the tile grid; counts may be computed asynchronously</td></tr>
          <tr><td class="bo-data-table__col--code">GET /home/counts</td><td>a fragment swapped into the badges once available — tiles must render WITHOUT it. On failure (5xx/timeout), the badges simply never appear; that is a silent degrade, not an error banner — a tile grid failing loudly over a missing count would be worse than the count just being absent</td></tr>
          <tr><td class="bo-data-table__col--code">GET /recent</td><td>the recent-items list; empty for a new user</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Loading</td><td>tiles render immediately — nothing here depends on data, only on which apps this user may open</td></tr>
          <tr><td>Per-tile counts (if your deployment adds them)</td><td>not part of <code>AppTile</code>'s three marks (icon / initials / svg) — a count badge is a fourth kind this component does not ship; add it as a sibling element inside the tile, and drop it silently rather than showing a stale or zero count</td></tr>
          <tr><td>Empty (new tenant)</td><td>a first-run state naming the one setup action, not an empty grid</td></tr>
          <tr><td>No permission</td><td>omit tiles the user cannot open — a disabled tile teaches nothing</td></tr>
          <tr><td>Error</td><td>inline alert above the grid with retry; keep whatever tiles did load</td></tr>
          <tr><td>No JS</td><td>the category tabs are plain <code>&lt;button role="tab"&gt;</code> elements with no native switching behavior — without <code>initTabs()</code>'s click handler, the second panel (marked <code>hidden</code> in the markup) never un-hides, so only the Finance tiles are ever reachable; the Logistics apps behind the second tab are effectively invisible</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 1 of 4</span></p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/base/primitives'}>App shell & grid</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/dashboard'}>Cards</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
    </ul>
  </section>

