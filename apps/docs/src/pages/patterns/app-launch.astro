---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import AppTile from '../../components/AppTile.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const favourites = [
  { icon: 'cart', label: 'Purchasing' },
  { icon: 'invoice', label: 'Invoices' },
  { icon: 'check-circle', label: 'Goods receipt' },
  { icon: 'chart', label: 'Reports' },
];
/* Payables and Receivables carry INITIALS, not glyphs. There is no mark an ERP
   user reliably reads as "accounts payable", and the two nearest candidates —
   `invoice` and `doc` — are both a page outline, which is how Payables ended up
   wearing the same mark as Invoices. AP/AR is what the folder tile below
   already calls them. */
const finance = [
  { icon: 'doc', label: 'General ledger' },
  { initials: 'AP', label: 'Payables' },
  { initials: 'AR', label: 'Receivables' },
  { label: 'Currencies' },   // inline <svg>, see the tile below
];
const logistics = [
  { icon: 'box', label: 'Warehouse' },
  { icon: 'truck', label: 'Shipping' },
  { icon: 'grid', label: 'Stock counts' },
];
---
<Gallery title="Pattern: app launch">
  <p class="demo-note">
    <strong>Who uses it</strong>: anyone opening the suite, every session —
    the first screen after sign-in. <strong>What "done" looks like</strong>:
    the right app is one tap away, whether it's a favourite or three deep in
    a category. A suite entry screen — the icon-grid launcher (the "Bento UI"
    / tablet-launcher archetype from the
    <a href={base + '/concepts/density'}>device-coverage table</a> — same
    <code>.bo-widget-grid</code> container-query mechanism as a dashboard, at a
    smaller tile size, <strong>not</strong> a new grid component). Tiles are plain
    links composed into <code>.bo-widget</code> cards with real
    <a href={base + '/components/icon'}>CSS icons</a> (themable <code>currentColor</code>
    glyphs) where a glyph is genuinely right, an initials chip where none is, and
    inline <code>&lt;svg&gt;</code> where a tenant brings their own; the category row is the
    ordinary <a href={base + '/components/tabs'}>tabs</a> pattern; a "folder" tile is just a
    widget whose body holds a cluster of small tiles. Zero new CSS.
    <strong>Not for returning a user to a specific record they already know</strong> —
    a bookmark, a notification, or a saved link should land directly on
    <a href={base + '/patterns/object-page'}>the object page</a> or
    <a href={base + '/patterns/list-report'}>the list report</a>, never route back
    through the launcher grid to get there.
  </p>

  <section class="demo">
    <h2>Favourites</h2>
    <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
      {favourites.map((a) => <AppTile {...a} />)}
    </div>
  </section>

  <section class="demo">
    <h2>All applications — category tabs</h2>
    <div class="bo-tabs">
      <div class="bo-tabs__list" role="tablist" aria-label="Application categories">
        <button class="bo-tabs__tab" role="tab" id="al-t-fin" aria-selected="true" aria-controls="al-p-fin">Finance</button>
        <button class="bo-tabs__tab" role="tab" id="al-t-log" tabindex="-1" aria-selected="false" aria-controls="al-p-log">Logistics</button>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="al-p-fin" aria-labelledby="al-t-fin" tabindex="0">
        <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
          {finance.filter((a) => a.label !== 'Currencies').map((a) => <AppTile {...a} />)}
          {/* The per-tenant slot: any inline <svg> works, and inherits
              currentColor exactly like a shipped glyph. This is the international
              currency sign (¤) — deliberately not "$", which would bake one
              locale into a screen this framework expects to ship worldwide. */}
          <AppTile label="Currencies">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="6" />
              <line x1="7.8" y1="7.8" x2="5" y2="5" />
              <line x1="16.2" y1="7.8" x2="19" y2="5" />
              <line x1="7.8" y1="16.2" x2="5" y2="19" />
              <line x1="16.2" y1="16.2" x2="19" y2="19" />
            </svg>
          </AppTile>
        </div>
      </div>
      <div class="bo-tabs__panel" role="tabpanel" id="al-p-log" aria-labelledby="al-t-log" tabindex="0" hidden>
        <div class="bo-widget-grid" style="--bo-widget-min: 9rem">
          {logistics.map((a) => <AppTile {...a} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="demo">
    <h2>A "folder" tile — grouped apps</h2>
    <div class="bo-widget-grid" style="--bo-widget-min: 12rem">
      <a href="#" class="bo-widget">
        <div class="bo-widget__body" style="text-align: center">
          <span class="bo-cluster" aria-hidden="true" style="justify-content: center; --bo-cluster-gap: var(--bo-space-1)">
            <span class="bo-badge">GL</span><span class="bo-badge">AP</span><span class="bo-badge">AR</span><span class="bo-badge">FX</span>
          </span>
          <span style="display: block; margin-block-start: var(--bo-space-2); color: var(--bo-color-text-primary)">Finance apps</span>
        </div>
      </a>
      <a href="#" class="bo-widget">
        <div class="bo-widget__body" style="text-align: center">
          <span class="bo-cluster" aria-hidden="true" style="justify-content: center; --bo-cluster-gap: var(--bo-space-1)">
            <span class="bo-badge">WH</span><span class="bo-badge">SH</span><span class="bo-badge">ST</span>
          </span>
          <span style="display: block; margin-block-start: var(--bo-space-2); color: var(--bo-color-text-primary)">Logistics apps</span>
        </div>
      </a>
    </div>
    <p class="bo-u-text-muted">A folder is a single link to a category page (or a
    dialog listing its apps) whose face previews the members as badges — not a
    hover-expanding stack. One click, one navigation; the preview is
    <code>aria-hidden</code> so the link's accessible name is just "Finance apps".</p>
  </section>

  <script>
    import { initTabs } from '@busy-office/ui/js';
    initTabs();
  </script>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{`<!-- A tile is a link styled as a card. The grid is the SAME .bo-widget-grid
     a dashboard uses — --bo-widget-min sets the tile size; the grid's own
     container query reflows it on tablet/narrow widths for free. -->
<div class="bo-widget-grid" style="--bo-widget-min: 9rem">
  <a href="/purchasing" class="bo-widget"
      style="text-align: center; padding-block: var(--bo-space-4)">
    <span class="bo-icon bo-icon--cart" aria-hidden="true"
        style="font-size: 2rem; color: var(--bo-color-accent); margin-inline: auto"></span>
    <span style="color: var(--bo-color-text-primary)">Purchasing</span>
  </a>
  …
</div>
<!-- Category row = the ordinary tabs pattern; each panel holds its own grid. -->`}</code></pre>
  </section>


  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>App shell</strong> — header + sidebar + main; the shell is the pattern.</li>
      <li><strong>Entry tiles</strong> — a <code>.bo-grid</code> of cards, each a task the user starts here.</li>
      <li><strong>Counts / badges</strong> — "12 awaiting approval" on a tile: the reason this screen exists rather than a static menu.</li>
      <li><strong>Recent items</strong> — a short list back into records the user touched last.</li>
    </ol>
    <p>
      <strong>One glyph per app, never reused in a launcher.</strong> A tile grid is
      scanned by shape before it is read, so two apps wearing the same mark cost the
      user the whole benefit of the grid. If no distinct glyph exists, use the
      initials chip rather than an approximate one — an approximate mark is worse
      than letters, because it is confidently wrong. This page practises that:
      Payables and Receivables are <span class="bo-badge">AP</span> and
      <span class="bo-badge">AR</span> rather than two near-identical document
      outlines, which is exactly the bug this section now rules out.
    </p>
    <p>
      <strong>The icon set is not the limit.</strong> A launcher is product content —
      your app list is yours, and no framework can ship the right twelve glyphs for
      it. Any inline <code>&lt;svg&gt;</code> drops into the same slot and inherits
      <code>currentColor</code>, so it themes with everything else for free.
      Currencies above is one: the international currency sign, hand-drawn in six
      lines of SVG, with nothing added to the framework.
    </p>
    <pre><code>{`<a href="/currencies" class="bo-widget">
  <svg viewBox="0 0 24 24" width="32" height="32" fill="none"
       stroke="currentColor" stroke-width="2" aria-hidden="true">
    …your mark…
  </svg>
  <span>Currencies</span>
</a>`}</code></pre>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns / on failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">GET /home</td><td>the tile grid; counts may be computed asynchronously</td></tr>
          <tr><td class="bo-data-table__col--code">GET /home/counts</td><td>a fragment swapped into the badges once available — tiles must render WITHOUT it</td></tr>
          <tr><td class="bo-data-table__col--code">GET /recent</td><td>the recent-items list; empty for a new user</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Loading</td><td>tiles render immediately — nothing here depends on data, only on which apps this user may open</td></tr>
          <tr><td>Per-tile counts (if your deployment adds them)</td><td>not part of <code>AppTile</code>'s three marks (icon / initials / svg) — a count badge is a fourth kind this component does not ship; add it as a sibling element inside the tile, and drop it silently rather than showing a stale or zero count</td></tr>
          <tr><td>Empty (new tenant)</td><td>a first-run state naming the one setup action, not an empty grid</td></tr>
          <tr><td>No permission</td><td>omit tiles the user cannot open — a disabled tile teaches nothing</td></tr>
          <tr><td>Error</td><td>inline alert above the grid with retry; keep whatever tiles did load</td></tr>
          <tr><td>No JS</td><td>the category tabs are plain <code>&lt;button role="tab"&gt;</code> elements with no native switching behavior — without <code>initTabs()</code>'s click handler, the second panel (marked <code>hidden</code> in the markup) never un-hides, so only the Finance tiles are ever reachable; the Logistics apps behind the second tab are effectively invisible</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 1 of 4</span></p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/base/primitives'}>App shell & grid</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/dashboard'}>Cards</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
    </ul>
  </section>

  <Related links={[
    ["/components/dashboard#card", "Card (.bo-widget)"],
    ["/components/tabs", "Tabs"],
    ["/concepts/container-queries", "Container queries"],
    ["/concepts/density", "Density & device coverage"],
  ]} />
</Gallery>
