---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SECTIONS = [
  ['general', 'General information'],
  ['items', 'Line items'],
  ['delivery', 'Delivery'],
  ['approvals', 'Approvals'],
];

const markup = `<div class="op-sticky">                        <!-- ONE sticky wrapper -->
  <header class="bo-widget">…object header: title, status, key facts…</header>
  <nav class="bo-pagination" data-anchor-nav tabindex="0" aria-label="Sections">
    <a class="bo-pagination__btn" href="#general" aria-current="page">General information</a>
    <a class="bo-pagination__btn" href="#items">Line items</a>
  </nav>
</div>

<section class="bo-widget" id="general">…</section>
<section class="bo-widget" id="items">…</section>

<div class="bo-form-actions">                     <!-- already sticky + print-hidden -->
  <button class="bo-btn bo-btn--secondary" type="button">Discard</button>
  <button class="bo-btn" type="submit">Submit for approval</button>
</div>`;
---
<Gallery title="Pattern: object page — a long record, in sections">
  <p class="demo-note">
    <strong>A long record, navigated in sections instead of scrolled as one
    feed.</strong> <strong>Who uses it</strong>: whoever owns one record end
    to end — a buyer opening a PO, an approver checking it before signing;
    many times a day, one object at a time. <strong>What "done" looks
    like</strong>: the reader can see the object's status without scrolling,
    reach any section in one click, and act on it from anywhere on the page.
    The long-record counterpart to
    <a href={base + '/patterns/record-detail'}>record detail</a>: same content,
    but too tall to take in at once, so it gains navigation of its own.
    <strong>Not for a record you can take in at one glance</strong> — the
    anchor rail and sticky action bar are overhead you only earn by being
    long. That one is
    <a href={base + '/patterns/record-detail'}>record detail</a>.
  </p>

  <section class="demo">
    <h2>The screen</h2>

    <div class="op-sticky">
      <header class="bo-widget">
        <div class="bo-widget__header">
          <span class="bo-widget__title">PO-88213 · Acme Supply Co.</span>
          <span class="bo-badge bo-badge--warning">Pending approval</span>
        </div>
        {/* The facts collapse as the reader scrolls into the record — the
            title and status stay. This is `.bo-widget__collapse`, the same
            element collapsible cards use, driven by scroll instead of a click:
            no new CSS, and its transition already runs on a motion token so
            prefers-reduced-motion zeroes it. */}
        <div class="bo-widget__collapse" data-anchor-collapse data-state="open">
          <div class="bo-widget__body">
            <dl class="bo-kv bo-kv--rows">
              <div><dt>Net value</dt><dd><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">18,940.50</span></span></dd></div>
              <div><dt>Cost center</dt><dd><span class="bo-u-tabular">CC-4021</span></dd></div>
              <div><dt>Requested delivery</dt><dd><span class="bo-u-tabular">15 Sep 2026</span></dd></div>
            </dl>
          </div>
        </div>
      </header>

      <nav class="bo-pagination op-anchors" data-anchor-nav tabindex="0" aria-label="Sections">
        {SECTIONS.map(([id, label], i) => (
          <a class="bo-pagination__btn" href={`#${id}`} aria-current={i === 0 ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>

    <div class="bo-stack bo-stack--loose">
      <section class="bo-widget op-section" id="general">
        <div class="bo-widget__header"><span class="bo-widget__title">General information</span></div>
        <div class="bo-widget__body">
          <dl class="bo-kv bo-kv--rows">
            <div><dt>Vendor</dt><dd>Acme Supply Co.</dd></div>
            <div><dt>Payment terms</dt><dd>Net 30</dd></div>
            <div><dt>Buyer</dt><dd>J. Kim</dd></div>
            <div><dt>Order date</dt><dd><span class="bo-u-tabular">10 Aug 2026</span></dd></div>
          </dl>
        </div>
      </section>

      <section class="bo-widget op-section" id="items">
        <div class="bo-widget__header"><span class="bo-widget__title">Line items</span></div>
        <div class="bo-data-table-container" tabindex="0">
          <table class="bo-data-table" data-density="compact">
            <caption class="bo-visually-hidden">Line items on PO-88213</caption>
            <thead>
              <tr>
                <th scope="col">Material</th>
                <th scope="col">Description</th>
                <th scope="col" class="bo-data-table__col--numeric">Qty</th>
                <th scope="col" class="bo-data-table__col--numeric">Net value</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="bo-data-table__col--code">MAT-4471</td>
                <td>Hydraulic pump, 24V</td>
                <td class="bo-data-table__col--numeric"><span class="bo-u-tabular">12</span></td>
                <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">9,240.00</span></span></td>
              </tr>
              <tr>
                <td class="bo-data-table__col--code">MAT-1180</td>
                <td>Seal kit, 60 mm</td>
                <td class="bo-data-table__col--numeric"><span class="bo-u-tabular">40</span></td>
                <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">1,480.50</span></span></td>
              </tr>
              <tr>
                <td class="bo-data-table__col--code">MAT-9002</td>
                <td>Filter cartridge</td>
                <td class="bo-data-table__col--numeric"><span class="bo-u-tabular">150</span></td>
                <td class="bo-data-table__col--numeric"><span class="bo-amount"><span class="bo-amount__currency">$</span><span class="bo-amount__value">8,220.00</span></span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="bo-widget op-section" id="delivery">
        <div class="bo-widget__header">
          <span class="bo-widget__title">Delivery</span>
          <span class="bo-badge">Partial</span>
        </div>
        <div class="bo-widget__body">
          <dl class="bo-kv bo-kv--rows">
            <div><dt>Ship-to</dt><dd>Dock 4, 123 Warehouse Rd</dd></div>
            <div><dt>Incoterms</dt><dd>DAP</dd></div>
            <div><dt>Requested</dt><dd><span class="bo-u-tabular">15 Sep 2026</span></dd></div>
            <div><dt>Confirmed</dt><dd><span class="bo-u-tabular">17 Sep 2026</span> <span class="bo-badge bo-badge--warning">2 days late</span></dd></div>
          </dl>
        </div>
      </section>

      <section class="bo-widget op-section" id="approvals">
        <div class="bo-widget__header"><span class="bo-widget__title">Approvals</span></div>
        <div class="bo-widget__body">
          <ol class="bo-timeline" role="list">
            <li class="bo-timeline__step" data-state="done">
              <span class="bo-timeline__marker" aria-hidden="true"></span>
              <div class="bo-timeline__title">Submitted by J. Kim</div>
              <div class="bo-timeline__meta">10 Aug 2026 · 09:14</div>
            </li>
            <li class="bo-timeline__step" data-state="done">
              <span class="bo-timeline__marker" aria-hidden="true"></span>
              <div class="bo-timeline__title">Budget check passed</div>
              <div class="bo-timeline__meta">10 Aug 2026 · 09:15 · automatic</div>
            </li>
            <li class="bo-timeline__step" data-state="current">
              <span class="bo-timeline__marker" aria-hidden="true"></span>
              <div class="bo-timeline__title">Awaiting cost-centre owner</div>
              <div class="bo-timeline__meta">assigned to M. Okafor</div>
            </li>
          </ol>
        </div>
      </section>
    </div>

    <div class="bo-form-actions">
      <button class="bo-btn bo-btn--secondary" type="button">Discard</button>
      <button class="bo-btn" type="button">Submit for approval</button>
    </div>

    <p class="bo-u-text-muted">Scroll the sections: the anchor bar follows,
    marking the section you are in, and the header's facts collapse away so the
    record gets the screen back — the title and status never leave. Every part of this screen is a component
    that already ships — the only thing added is
    <code>initAnchorNav()</code>, and it writes no CSS.</p>
  </section>

  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Object header</strong> — a plain
      <a href={base + '/components/dashboard'}>widget</a> carrying the title,
      a <a href={base + '/components/badge'}>status badge</a>, and the key facts
      as a <a href={base + '/components/kv'}>kv</a> list. Status is visible
      before any scrolling, which is the whole reason the header sticks.</li>
      <li><strong>Anchor bar</strong> —
      <a href={base + '/components/pagination'}>pagination</a> markup used as
      section navigation, because it already styles
      <code>[aria-current="page"]</code>. Kept to one line and allowed to scroll
      sideways; it carries <code>tabindex="0"</code> because a scrollable region
      must be reachable by keyboard. <strong>Reads like tabs, is NOT
      <code>role="tab"</code></strong> — a real
      <a href={base + '/components/tabs'}>tabs</a> widget hides every panel but
      the active one and moves between them with the arrow keys; this bar is
      plain links, every section stays in the DOM and on screen, and Tab
      visits each link like any other link. Activating one scrolls (Enter or a
      click), same as clicking any anchor — Chrome/Firefox/Safari all then
      resume keyboard Tab from the section just jumped to, not from the top of
      the document, even though it never becomes <code>document.activeElement</code>
      itself (verified live, 2026-08-22).</li>
      <li><strong>One sticky wrapper</strong> — the header and the bar stick
      <em>together</em>, in a single sticky element. Two sticky children both at
      <code>inset-block-start: 0</code> pin to the same offset and overlap.</li>
      <li><strong>Sections</strong> — one widget per facet, each with the
      <code>id</code> the anchor bar targets.</li>
      <li><strong>Action bar</strong> —
      <code>.bo-form-actions</code>, which is already sticky, already hidden in
      print, and already sets <code>scroll-padding-block-end</code> so focus
      never lands under it.</li>
    </ol>
    <p class="bo-u-text-muted">Follows the <a href={base + '/concepts/review-anatomy'}>review-screen anatomy</a>
    contract — this is the long-record shape; see that page for when a shorter
    <a href={base + '/patterns/record-detail'}>record detail</a> is enough.</p>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <p>The screen is one <code>GET</code> of one object. Sections are regions of
    that response, not separate requests — anchor navigation is in-page, so
    there is no round trip when the reader moves between them.</p>
    <ul class="bo-stack bo-stack--tight docs-list">
      <li><strong><code>GET /purchase-orders/:id</code></strong> → the whole
      object. Every section id in the anchor bar must exist in the response, or
      the link scrolls nowhere.</li>
      <li><strong>Actions post the whole object</strong> —
      <code>POST /purchase-orders/:id/submit</code> returns the re-rendered
      page, or a 4xx with the object plus errors. Swap the whole
      <code>&lt;main&gt;</code>: a partial swap would drop the sticky wrapper and
      the reader's scroll position with it.</li>
      <li><strong>A 409</strong> (someone else edited it) returns the current
      object and a banner. Remember that htmx discards non-2xx by default —
      see <a href={base + '/patterns/editable-grid'}>editable grid</a>.</li>
    </ul>
  </section>

  <section class="demo">
    <h2>States</h2>
    <table class="bo-data-table">
      <thead><tr><th scope="col">State</th><th scope="col">What the screen shows</th></tr></thead>
      <tbody>
        <tr><td>Loading</td><td>The header skeletons first — status is the thing the reader came for. Sections fill in after.</td></tr>
        <tr><td>Empty section</td><td>The section stays in the anchor bar and says why it is empty. Removing it would make the bar change shape between records.</td></tr>
        <tr><td>Error in one section</td><td>That section shows the error; the rest of the object stays readable. A whole-page error for one failed facet loses the record.</td></tr>
        <tr><td>Read-only / no permission</td><td>The action bar is absent, not disabled — there is nothing to explain if the reader can never act.</td></tr>
        <tr><td>Conflict (409)</td><td>Banner above the sections, object re-rendered, anchor position preserved.</td></tr>
        <tr><td>Print</td><td>Sticky chrome and the action bar drop out; sections print in order as one continuous document.</td></tr>
      </tbody>
    </table>
  </section>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{markup}</code></pre>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 3 of 4</span> —
    overview &amp; shell tier.</p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/dashboard'}>Widget</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/kv'}>Kv</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/amount'}>Amount</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/pagination'}>Pagination</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/button'}>Button</a></li>
    </ul>
  </section>

  <Related links={[
    ["/patterns/record-detail", "Record detail (short records)"],
    ["/patterns/detail-form", "Detail form (editing)"],
    ["/patterns/output-form", "Issued document (printing or emailing this record)"],
    ["/components/pagination", "Pagination"],
    ["/concepts/js-behaviors", "JS behaviors"],
  ]} />
</Gallery>

<style>
  /* The floorplan's only page-level CSS, and all of it is layout.
     One sticky wrapper: two sticky children at inset-block-start: 0 pin to the
     SAME offset and overlap (measured 77px at 1440, 181px at 390).

     Two bugs found live while scrolling (roadmap 108, 2026-08-22), both
     from the SAME cause: .bo-app-shell__main is the scrolling ancestor,
     and it carries its own --bo-space-6 padding-block-start. A sticky
     child's `top: 0` pins BELOW that padding (measured: exactly a
     --bo-space-6 gap between the shell's visible top edge and where this
     bar actually sticks) — a scrolled-past table cell was fully visible in
     that gap, sitting behind nothing, because the sticky bar never claims
     the padding that belongs to its SCROLL CONTAINER. The usual fix for
     this shape (negative margin + matching padding, so the box extends
     into the gap and its own background covers it) measured as A NO-OP
     here — `.op-sticky` is a direct flex item of `.demo`, and Chrome does
     not fold a flex item's margin into its sticky offset the way block
     flow does; the gap stayed exactly --bo-space-6 with the trick applied.
     `inset-block-start: calc(-1 * var(--bo-space-6))` is what actually
     closes it — measured 0px gap, both the moment stickiness first
     engages and deep into the scroll, both themes. Second: an embedded
     table with no height of its own resolves ITS sticky thead against the
     SAME scrolling ancestor, so at the collision point the table header
     (--bo-z-sticky-header, 1100) painted over this page-level bar
     (z-index: 2, an arbitrary number with no relation to the framework's
     stacking scale) instead of losing to it. --bo-z-sticky-page exists now
     specifically so page-level chrome always wins that collision — see
     its definition in tokens/z-index.css. */
  .op-sticky {
    position: sticky;
    inset-block-start: calc(-1 * var(--bo-space-6));
    z-index: var(--bo-z-sticky-page);
    background: var(--bo-color-bg-canvas);
  }

  /* One line, scrollable. Allowing the labels to wrap spills them out of the
     button: .bo-pagination__btn takes --bo-density-control-height, a fixed
     box, so a two-line label renders taller than the control that holds it
     (measured 38px of text in a 36px button at 390). */
  .op-anchors {
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
  }

  .op-anchors > .bo-pagination__btn {
    white-space: nowrap;
  }

  /* Land below the sticky chrome — sized for the COLLAPSED header, because
     that is the state that exists after any jump: scrolling into a section is
     exactly what collapses the facts. Sized for the expanded header (12rem) the
     jump overshot by ~110px and the reader landed on the section ABOVE the one
     they clicked — caught by the existing "anchor bar follows the reader" claim
     the moment the collapse landed. */
  .op-section {
    /* `--bo-anchor-landing-offset` is set by anchor-nav.ts to the ACTUAL
       collapsed-header height, measured live (roadmap 102.8) — the collapsed
       height is not a constant: 87px at 1440, 105px at 390, because the
       header's title + badge wrap to two lines under width pressure even
       collapsed. A fixed `calc(7rem - var(--bo-space-6))` = 88px matched
       neither and left a 2.25px gap at 390 only (invisible in a screenshot).
       `+ var(--bo-space-2)` is a small landing buffer against sub-pixel
       rounding at the boundary, same purpose as anchor-nav.ts's own
       SPY_TOLERANCE. The `7rem` fallback keeps the no-JS case working
       (measured: fields stay reachable, just without this precision). */
    scroll-margin-block-start: calc(var(--bo-anchor-landing-offset, 7rem) + var(--bo-space-2));
  }
</style>

<script>
  import { initAnchorNav } from '@busy-office/ui/js';
  initAnchorNav();
</script>
