---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import patternsIndex from '../../data/patterns-index.json';
import PatternPreview from '../../components/PatternPreview.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Gallery title="Patterns">
  <p class="demo-note">
    <strong>Not a component reference</strong> — for one control's API, use
    the <a href={base + '/components/data-table'}>component docs</a> instead.
    This is every full ERP screen this framework documents, grouped the way a
    working day actually runs: find something, work one record, correct
    data, clear a queue, monitor what ran. Every tile's text is generated
    from its pattern page's own opener, complexity badge and Components-used
    list, so it cannot drift from the page it describes. Tiles whose screens
    read at this size also carry a <strong>live miniature</strong> — a small,
    inert composition of the same shipped CSS, not an image — while dense
    screens stay text-only on purpose: a list-report shrunk to a tile is
    grey noise. Within each group, tiles order simplest first.
  </p>

  {patternsIndex.groups.map((group) => (
    <section class="demo">
      <h2>{group.label.replace(/^Patterns:\s*/, '')}</h2>
      <div class="bo-widget-grid" style="--bo-widget-min: 16rem">
        {group.tiles.map((tile) => (
          <a href={base + tile.href} class="bo-widget">
            <PatternPreview slug={tile.href.replace('/patterns/', '')} />
            <div class="bo-widget__header">
              <span class="bo-widget__title">{tile.title}</span>
              <span class="bo-badge">complexity {tile.complexity} of 4</span>
            </div>
            <div class="bo-widget__body">
              <p class="bo-u-text-muted">{tile.openerShort}</p>
              {tile.components.length > 0 && (
                <p class="bo-cluster" style="--bo-cluster-gap: var(--bo-space-1); margin-block-start: var(--bo-space-2)">
                  {tile.components.map((c) => <span class="bo-badge bo-badge--type">{c.label}</span>)}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <Related links={[
    ["/getting-started/first-screen", "Build your first screen"],
    ["/components/data-table", "Component reference"],
    ["/concepts/design-language", "The design language"],
  ]} />
</Gallery>
