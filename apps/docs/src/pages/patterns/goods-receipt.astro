---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Gallery title="Pattern: goods receipt (RF scanner)">
  <p class="demo-note">
    A GR (goods receipt) screen driven by a handheld RF scanner, not a mouse — the
    scanner types the barcode fast and sends Enter, so the field needs to stay
    focused and clear itself between scans. Composed from <code>data-scan-input</code>
    (new opt-in behavior, no new CSS — a plain <code>.bo-input</code>), the existing
    <code>.bo-quantity</code> at <code>data-density="spacious"</code> for a
    warehouse-floor large target, and the data table for the receiving log. A
    visually-hidden <code>aria-live="polite"</code> region (linked via the field's
    own <code>aria-describedby</code>) announces each successful scan — a
    screen-reader/low-vision RF user gets non-visual confirmation without it
    being read for every sighted user.
  </p>

  <section class="demo" data-density="spacious">
    <h2>Scan to receive</h2>
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="gr-scan">Scan barcode</label>
      <input class="bo-input bo-input--code" id="gr-scan" data-scan-input autofocus
          placeholder="Waiting for scan…" aria-describedby="gr-scan-status" />
      <p id="gr-scan-status" data-scan-status aria-live="polite" class="bo-visually-hidden"></p>
    </div>
    <div class="bo-form-field">
      <label class="bo-form-field__label" for="gr-qty">Quantity</label>
      <div class="bo-quantity">
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="-1" aria-label="Decrease quantity">&minus;</button>
        <input class="bo-quantity__input" type="number" id="gr-qty" value="1" min="1" max="9999" step="1" inputmode="numeric" aria-label="Quantity" />
        <button class="bo-btn bo-btn--secondary bo-quantity__step" type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
        <span class="bo-quantity__unit">ea</span>
      </div>
    </div>

    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table">
        <thead><tr><th scope="col">Barcode</th><th scope="col" class="bo-data-table__col--numeric">Qty</th><th scope="col">Received</th></tr></thead>
        <tbody id="gr-log">
          <tr><td colspan="3" class="bo-u-text-muted">No scans yet — try the live demo above.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <script>
    import { initScanInput, initQuantity } from '@busy-office/ui/js';
    initScanInput();
    initQuantity();

    const scanInput = document.getElementById('gr-scan');
    const qtyInput = document.getElementById('gr-qty') as HTMLInputElement | null;
    const log = document.getElementById('gr-log');
    let placeholderCleared = false;

    scanInput?.addEventListener('bo:scan', (e) => {
      if (!log) return;
      if (!placeholderCleared) { log.innerHTML = ''; placeholderCleared = true; }
      const value = (e as CustomEvent).detail.value;
      const qty = qtyInput?.value || '1';
      // textContent, never innerHTML: barcode content is untrusted
      // physical-world input (adversary-printed labels exist).
      const row = document.createElement('tr');
      const codeCell = document.createElement('td');
      codeCell.className = 'bo-data-table__col--code';
      codeCell.textContent = value;
      const qtyCell = document.createElement('td');
      qtyCell.className = 'bo-data-table__col--numeric';
      qtyCell.textContent = qty;
      const timeCell = document.createElement('td');
      timeCell.textContent = new Date().toLocaleTimeString();
      row.append(codeCell, qtyCell, timeCell);
      log.prepend(row);
    });
  </script>

  <section class="demo">
    <h2>Markup</h2>
    <pre><code>{`<input class="bo-input bo-input--code" data-scan-input autofocus
    aria-describedby="scan-status" />
<p id="scan-status" data-scan-status aria-live="polite" class="bo-visually-hidden"></p>

<script type="module">
  import { initScanInput } from "@busy-office/ui/js";
  initScanInput(); // once — clears + refocuses on Enter, fires bo:scan,
                    // announces "Scanned <value>" in data-scan-status if linked
  document.querySelector('[data-scan-input]')
    .addEventListener('bo:scan', (e) => console.log(e.detail.value));
</script>`}</code></pre>
  </section>


  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight" style="padding-inline-start: 1.25rem">
      <li><strong>Scan field</strong> — always focused; a hardware scanner types then presses Enter, which <code>initScanInput()</code> treats as a submit.</li>
      <li><strong>Expected vs received list</strong> — every line with its ordered quantity and a running received count.</li>
      <li><strong>Quantity control</strong> — spacious density and big steppers: this screen is used one-handed, often gloved.</li>
      <li><strong>Confirm bar</strong> — post the receipt; disabled until at least one line has a quantity.</li>
    </ol>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns / on failure</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">POST /receipts/:id/scan</td><td>the matched line fragment with its updated count; 404 → an unknown-barcode alert that does NOT steal focus from the scan field</td></tr>
          <tr><td class="bo-data-table__col--code">POST /receipts/:id</td><td>the posted receipt; 422 for over-receipt beyond tolerance</td></tr>
          <tr><td class="bo-data-table__col--code">GET /receipts/:id</td><td>resume a partially entered receipt — warehouse sessions get interrupted</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>Waiting for scan</td><td>the field holds focus permanently; every state change must return focus to it</td></tr>
          <tr><td>Unknown barcode</td><td>an alert plus an audible or visible cue — the user is looking at the goods, not the screen</td></tr>
          <tr><td>Over-receipt</td><td>a warning with the tolerance stated; block only past the policy limit</td></tr>
          <tr><td>Partial receipt</td><td>the line shows received/ordered; posting a partial is normal and must not warn</td></tr>
          <tr><td>Complete</td><td>a clear terminal state — the next scan starts a NEW receipt rather than silently appending</td></tr>
          <tr><td>Offline / flaky wifi</td><td>queue scans locally and replay; a dropped scan in a warehouse is a stock discrepancy later</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 3 of 4</span></p>
    <ul class="bo-cluster" style="list-style: none; padding: 0">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/quantity'}>Quantity</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/data-table'}>Data table</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/alerts'}>Alerts</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/concepts/density'}>Density (spacious)</a></li>
    </ul>
  </section>

  <Related links={[
    ["/concepts/js-behaviors", "JS behaviors"],
    ["/components/quantity", "Quantity"],
    ["/components/data-table", "Data table"],
  ]} />
</Gallery>
