---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = [
  { no: 'INV-10234', vendor: 'Acme Supply Co.', amount: '$4,208.00', status: 'Approved', tone: 'success', error: null },
  { no: 'INV-10235', vendor: 'Globex Industrial', amount: '$56,000.00', status: 'Pending', tone: 'warning', error: 'Needs a second approver over $20,000.00' },
  { no: 'INV-10236', vendor: 'Initech GmbH', amount: '$730.25', status: 'Approved', tone: 'success', error: null },
  { no: 'INV-10237', vendor: 'Umbrella Logistics', amount: '$2,110.00', status: 'Rejected', tone: 'danger', error: 'Already rejected' },
];

const markup = `<!-- The response to a bulk POST does TWO things: swap the rows, and
     deliver the summary out of band. One request, both truths. -->
<tbody id="rows">
  <tr id="row-INV-10235" data-row-state="error">
    …cells…
    <td>
      <span class="bo-badge bo-badge--warning">Pending</span>
      <!-- the reason in WORDS — the row tint is never the only signal -->
      <span class="bo-badge bo-badge--danger">Needs a second approver over $20,000.00</span>
    </td>
  </tr>
</tbody>

<div id="bulk-result" hx-swap-oob="innerHTML">
  <div class="bo-alert bo-alert--warning" role="alert">
    <p><strong>18 approved, 2 could not be.</strong> The rows below carry the reason.</p>
  </div>
</div>`;

const massChange = `<!-- ONE form, ONE selection, two endpoints. formaction re-points the same
     checked ids at the mass-change handler, so there is no second selection
     to keep in sync. The safe action stays the form's submit button, so the
     keyboard path (Enter from any row) still cannot reach a destructive one. -->
<form id="po-bulk" hx-post="/pos/bulk-approve" hx-target="#rows" hx-swap="outerHTML">
  <div class="bo-data-table__bulk-actions" role="group" aria-label="Bulk actions">
    <button class="bo-btn" type="submit">Approve selected</button>
    <button class="bo-btn bo-btn--secondary" type="button"
            data-dialog-trigger="mass-cc">Change cost centre…</button>
  </div>
  …table with name="id" row checkboxes…
</form>

<!-- The dialog's field JOINS the form above via form="po-bulk"; its submit
     button re-targets with formaction. -->
<input class="bo-input bo-input--code" name="cc" form="po-bulk" placeholder="CC-4021">
<button class="bo-btn" type="submit" form="po-bulk"
        formaction="/pos/mass-change">Change selected</button>`;

const serverMarkup = `// Partial-failure state is TRANSIENT. Clear last round's reasons before
// computing this one, or a row keeps advertising an error that is no
// longer true — the list starts lying about the record.
records.forEach((r) => { delete r.bulkError; });

const failed = [];
let ok = 0;
for (const r of selected) {
  if (r.status !== "Pending")   { failed.push([r, "Already " + r.status.toLowerCase()]); continue; }
  if (r.amount > LIMIT)         { failed.push([r, "Needs a second approver"]); continue; }
  r.status = "Approved"; ok += 1;
}
for (const [r, reason] of failed) r.bulkError = reason;   // rendered per row`;
---
<Gallery title="Pattern: bulk actions">
  <p class="demo-note">
    <strong>Who uses it</strong>: an AP clerk clearing a queue — select
    many, act once. <strong>What "done" looks like</strong>: every
    selected record either changed or explained why it didn't. The
    failure mode this pattern exists to prevent is the silent one: an
    action that reports success while quietly skipping rows.
    <strong>Not for changing one record</strong> — a single row's fields belong on
    <a href={base + '/patterns/object-page'}>the object page</a> or
    <a href={base + '/patterns/record-detail'}>record-detail</a>; this pattern's
    whole cost (out-of-band summary, per-row reasons, the transient-state rule)
    only pays for itself once more than one record is changing at once.
  </p>

  <section class="demo">
    <h2>The state after a partial failure</h2>
    {/* KEEPS role="alert", deliberately. In a real screen this banner is the
        RESULT of the user's action and arrives by swap — the hx-swap-oob
        sample above is exactly this banner — so the role is what a consumer should copy. The
        docs can only render the post-action state statically; that is a
        limitation of the page, not of the markup. */}
    <div class="bo-alert bo-alert--warning" role="alert">
      <p><strong>2 approved, 2 could not be.</strong> The rows below carry the reason.</p>
    </div>
    <div class="bo-data-table-container" tabindex="0" style="margin-block-start: var(--bo-space-3)">
      <table class="bo-data-table" data-density="compact">
        <thead><tr>
          <th scope="col">Invoice #</th><th scope="col">Vendor</th>
          <th scope="col" class="bo-data-table__col--numeric">Amount</th><th scope="col">Status</th>
        </tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-row-state={r.error ? 'error' : undefined}>
              <td class="bo-data-table__col--code">{r.no}</td>
              <td>{r.vendor}</td>
              <td class="bo-data-table__col--numeric">{r.amount}</td>
              <td>
                <span class={`bo-badge bo-badge--${r.tone}`}>{r.status}</span>
                {r.error && <span class="bo-badge bo-badge--danger"> {r.error}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bo-u-text-muted">Zero new components: the summary is an
    <a href={base + '/components/alerts'}>alert</a>, the failed rows use
    <code>data-row-state="error"</code>, and each reason is a
    <a href={base + '/components/badge'}>badge</a> — in words, beside the
    status, so the tint is never the only signal. A clerk can see which
    two rows need them and why without opening anything.</p>
  </section>

  <section class="demo">
    <h2>Anatomy</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><strong>Selection</strong> <span class="bo-u-text-muted">(not in the demo above — see <a href={base + '/patterns/list-report'}>the list report</a> for the live checkboxes)</span> — row checkboxes carrying <code>name</code>/<code>value</code>, so the selection POSTs natively; <code>initDataTables()</code> keeps the count O(1) at scale.</li>
      <li><strong>Toolbar action</strong> <span class="bo-u-text-muted">(same — see the list report)</span> — bulk buttons appear only when something is selected (<a href={base + '/components/table-toolbar'}>toolbar</a>).</li>
      <li><strong>Summary region</strong> — an empty container above the table that the response fills out of band.</li>
      <li><strong>Per-row result</strong> — the error state plus the reason, rendered by the same row template as everything else.</li>
    </ol>
  </section>

  <section class="demo">
    <h2>Data contract</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Request</th><th scope="col">Returns</th></tr></thead>
        <tbody>
          <tr><td class="bo-data-table__col--code">POST /invoices/bulk-approve<br />(ids as repeated form fields)</td><td>the affected <code>&lt;tbody&gt;</code> <strong>plus</strong> an out-of-band summary block — one request, both truths</td></tr>
          <tr><td class="bo-data-table__col--code">…all succeeded</td><td>same shape, a success alert; do not special-case the happy path into a different mechanism</td></tr>
          <tr><td class="bo-data-table__col--code">…nothing selected</td><td>the button should not have been reachable; if it was, return the list unchanged and say so</td></tr>
        </tbody>
      </table>
    </div>
    <pre><code>{markup}</code></pre>
    <p class="bo-u-text-muted">Selection is client state: a swap that
    replaces rows clears it, which is the honest behaviour after a bulk
    action — the user's next decision should start from the new truth.</p>
  </section>

  <section class="demo">
    <h2>The rule that makes it honest</h2>
    <pre><code>{serverMarkup}</code></pre>
    <p class="bo-u-text-muted">Found by building this against the
    reference app: without the clear, a row kept showing "needs a second
    approver" after a colleague had approved it. A stale failure reason
    is worse than none — it sends someone to fix a problem that no
    longer exists.</p>
  </section>

  <section class="demo">
    <h2>Mass change — the honest answer to "update 200 records"</h2>
    <p>Select N rows, set <strong>one</strong> field, in <strong>one</strong>
    validated operation. This is the request that usually arrives as "we need
    editable cells", and it is worth pushing back on: 200 hand-edits is 200
    chances to fumble a value, and it leaves no record of what was intended.
    One operation is simpler <em>and</em> safer, and it produces a single audit
    entry.</p>
    <pre><code>{massChange}</code></pre>
    <p class="bo-u-text-muted">Same contract as the action above — rows plus an
    out-of-band summary, per-row reasons in words, the TRANSIENT-state rule.
    <strong>No new component and no second selection:</strong>
    <code>formaction</code> re-points the same checked ids at a different
    endpoint, and the dialog's field joins the table's form with
    <code>form="po-bulk"</code>.</p>

    <h3>Validate the operation before you touch a row</h3>
    <ul class="bo-stack bo-stack--tight docs-list">
      <li><strong>A bad target value is not a per-row failure.</strong>
      "CC-nonsense" is the whole request being wrong, so it returns
      <code>422</code> with a document-level message and changes
      <em>nothing</em> — not 200 identical row errors the user has to read
      past.</li>
      <li><strong>Per-row rules still apply per row.</strong> A purchase order
      that is already approved needs a reversal, not a re-cost, so it is
      reported in its own row with that reason while the others go through.</li>
      <li><strong>Say the count and the value.</strong> "1 moved to CC-9002, 1
      could not be" — a bare "done" hides which half happened.</li>
      <li><strong>No-op rows are failures worth naming.</strong> A row already
      on the target cost centre is reported ("Already on CC-9002") rather than
      counted as changed, because a count that includes no-ops is a lie about
      what the operation did.</li>
    </ul>
    <p class="bo-u-text-muted">This is <strong>M3</strong> of the four data
    maintenance patterns in <code>DESIGN.md</code>; the working implementation
    is in
    <a href="https://github.com/Busy-Office/busy-office-ui/tree/main/examples/po-app">examples/po-app</a>.</p>
  </section>

  <section class="demo">
    <h2>States</h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">State</th><th scope="col">What ships</th></tr></thead>
        <tbody>
          <tr><td>All succeeded</td><td>a success alert with the count; rows re-render in their new status</td></tr>
          <tr><td>Partial failure</td><td>counts BOTH ways in one sentence, and every failed row carries its own reason</td></tr>
          <tr><td>All failed</td><td>same shape — never a bare "action failed" with no per-row detail</td></tr>
          <tr><td>Nothing selected</td><td>bulk actions are hidden until a selection exists, so this should be unreachable</td></tr>
          <tr><td>No permission</td><td>the bulk buttons are absent, not disabled (<a href={base + '/concepts/permissions'}>permissions</a>)</td></tr>
          <tr><td>Stale selection</td><td>a record decided by someone else since the page loaded fails with "already approved" — that is the partial-failure path doing its job, not an error</td></tr>
          <tr><td>Long-running</td><td>past a few seconds, return a job id and poll; a frozen button is not a progress indicator</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="demo">
    <h2>Keyboard walkthrough</h2>
    <ol class="bo-stack bo-stack--tight docs-list">
      <li><kbd class="bo-kbd">Tab</kbd> to the select-all checkbox, <kbd class="bo-kbd">Space</kbd> to take the page; the live region announces the count.</li>
      <li><kbd class="bo-kbd">Tab</kbd> through rows, <kbd class="bo-kbd">Space</kbd> to deselect the ones you are not ready for.</li>
      <li>Back to the toolbar, where the first selection has revealed the bulk
      <kbd class="bo-kbd">Enter</kbd>, from wherever you are in the list — the
      rows and the bulk buttons are one <code>&lt;form&gt;</code>, so native
      implicit submission runs the action without any journey back to the
      toolbar. Only the safe action is <code>type="submit"</code>; a
      destructive bulk action stays <code>type="button"</code> and needs a
      deliberate click.</li>
      <li>Focus stays on the checkbox you pressed — but only because each one
      carries an <code>id</code>. The swap replaces those very rows, and htmx
      restores focus solely to a matching id; without it the clerk is dropped
      on <code>&lt;body&gt;</code> at the top of the document.</li>
      <li>The summary is <code>role="alert"</code>, so the outcome is announced without moving focus; the failed rows are still in document order below it.</li>
    </ol>
  </section>

  <section class="demo">
    <h2>Components used</h2>
    <p class="bo-u-text-muted"><span class="bo-badge">complexity 3 of 4</span></p>
    <ul class="bo-cluster docs-list-bare">
      <li><a class="bo-badge bo-badge--type" href={base + '/components/data-table'}>Data table</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/table-toolbar'}>Toolbar</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/alerts'}>Alerts</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/components/badge'}>Badge</a></li>
      <li><a class="bo-badge bo-badge--type" href={base + '/concepts/permissions'}>Permissions</a></li>
    </ul>
  </section>

  <Related links={[
    ['/patterns/list-report', 'List report'],
    ['/components/table-toolbar', 'Toolbar & grid navigation'],
    ['/concepts/concurrency', 'Concurrency & conflicts'],
    ['/getting-started/htmx', 'Using with HTMX'],
  ]} />
</Gallery>
