---
import Gallery from '../layouts/Gallery.astro';
const shellMarkup = `<div class="bo-app-shell">          <!-- container: bo-shell -->
  <header class="bo-navbar bo-app-shell__header">…</header>
  <nav class="bo-sidebar-nav bo-app-shell__sidebar">…</nav>
  <main class="bo-app-shell__main">…</main>
</div>`;
---
<Gallery title="Layout primitives">
  <p class="demo-note">
    Every screen is composed from four primitives plus the app shell. Knobs are
    custom properties set inline or in your own CSS:
    <code>--bo-stack-gap</code>, <code>--bo-cluster-gap</code>,
    <code>--bo-grid-min</code>, <code>--bo-grid-gap</code>.
  </p>
  <section class="demo">
    <h2><code>.bo-stack</code> — vertical flow (<code>--tight</code>/<code>--loose</code>)</h2>
    <div class="bo-stack bo-stack--tight" style="max-inline-size: 20rem">
      <button class="bo-btn bo-btn--secondary">One</button>
      <button class="bo-btn bo-btn--secondary">Two</button>
    </div>
  </section>
  <section class="demo">
    <h2><code>.bo-cluster</code> — wrapping toolbar row (<code>--split</code>/<code>--end</code>)</h2>
    <div class="bo-cluster">
      <button class="bo-btn">Save</button>
      <button class="bo-btn bo-btn--secondary">Cancel</button>
      <span class="bo-badge bo-badge--warning">Draft</span>
    </div>
  </section>
  <section class="demo">
    <h2><code>.bo-grid</code> — auto-fill card grid (<code>--bo-grid-min</code>)</h2>
    <div class="bo-grid" style="--bo-grid-min: 10rem">
      {[1, 2, 3, 4].map((n) => (
        <div style="border:1px solid var(--bo-color-border-default);border-radius:var(--bo-radius-md);padding:var(--bo-space-4)">Card {n}</div>
      ))}
    </div>
  </section>
  <section class="demo">
    <h2><code>.bo-app-shell</code> — header/sidebar/main + container queries</h2>
    <pre><code>{shellMarkup}</code></pre>
    <p class="bo-u-text-muted">The shell is a named container (<code>bo-shell</code>);
    the sidebar collapses to icon-only below 900px of <em>shell</em> width. Labels stay
    in the accessibility tree when collapsed. <code>.bo-visually-hidden</code> is also
    available for your own screen-reader-only text.</p>
  </section>
</Gallery>
