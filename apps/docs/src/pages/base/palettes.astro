---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// GENERATED from the shipped brand CSS — swatches, tokens, and hex are
// parsed from packages/core/src/css/brand/*.css at build, never
// hand-painted; the same files check-contrast.mjs gates (32 pairs × 2
// themes per palette).
const files = import.meta.glob('../../../../../packages/core/src/css/brand/*.css', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const TOKENS = [
  'accent', 'accent-strong', 'accent-solid', 'accent-subtle',
  'accent-text', 'focus-ring', 'bg-selected',
];
function parseBlock(block) {
  const out = {};
  for (const t of TOKENS) {
    // matchAll + overwrite: LAST declaration wins, matching CSS custom
    // property resolution (grill 2026-08-16 — first-match documented the
    // value the browser discards on a duplicate declaration).
    for (const m of block.matchAll(new RegExp(`--bo-color-${t}:\\s*([^;]+);`, 'g'))) out[t] = m[1].trim();
  }
  return out;
}
const palettes = Object.entries(files).map(([path, css]) => {
  const name = path.match(/brand-([a-z-]+)\.css$/)[1];
  // Parse assertions (Slice 21 grill E1-class hardening): the split and
  // value shapes are load-bearing — fail the BUILD, never render wrong.
  const stripped = css.replace(/\/\*[\s\S]*?\*\//g, ''); // comments may legally mention the selector
  const parts = stripped.split('[data-theme="dark"]');
  if (parts.length !== 2)
    throw new Error(`palettes: brand-${name}.css must contain exactly one [data-theme="dark"] block outside comments (found ${parts.length - 1})`);
  // ALIGNMENT ENFORCED (Slice 22): every token must be an ALIAS to a
  // scale step, resolved through the preset's own local step definitions
  // — a raw hex or an unresolvable alias fails the build.
  const localSteps = {};
  for (const m of stripped.matchAll(/--bo-palette-([a-z]+)-(\d+):\s*(#[0-9a-fA-F]+)/g))
    localSteps[`${m[1]}-${m[2]}`] = { hex: m[3], step: m[2] };
  function resolveBlock(block, theme) {
    const out = {};
    for (const t of TOKENS) {
      const v = block[t];
      if (v === undefined)
        throw new Error(`palettes: brand-${name}.css ${theme} block is missing --bo-color-${t}`);
      const alias = v.match(/^var\(--bo-palette-([a-z]+-\d+)\)$/);
      if (!alias)
        throw new Error(`palettes: brand-${name}.css ${theme} --bo-color-${t} is "${v}" — must be a scale-step alias (alignment is the contract)`);
      const step = localSteps[alias[1]];
      if (!step)
        throw new Error(`palettes: brand-${name}.css ${theme} --bo-color-${t} aliases ${alias[1]} but the preset doesn't define that step locally`);
      out[t] = step.hex;
      out[t + '-step'] = alias[1];
    }
    return out;
  }
  const light = resolveBlock(parseBlock(parts[0]), 'light');
  const dark = resolveBlock(parseBlock(parts[1]), 'dark');
  return { name, light, dark };
}).sort((a, b) => a.name.localeCompare(b.name));
// ERP buyer profile per preset — the words a builder picks WITH, shown
// on the card (owner lineup decision 2026-08-16).
const PROFILES: Record<string, string> = {
  graphite: 'monochrome premium — modern back-office',
  cobalt: 'the enterprise blue',
  navy: 'deep, conservative — banking & government',
  forest: 'operations green — finance & logistics',
  indigo: 'modern SaaS',
  violet: 'analytics & BI',
};
---
<Gallery title="Palettes">
  <p class="demo-note">
    Pick a brand in one look: every card is a live preview of a shipped
    preset (<code>@busy-office/ui/css/brand-&lt;name&gt;</code>), each gated
    through the full 32-pair AA contrast check in both themes — swatches,
    tokens, and hex generated from the CSS that actually ships. One import
    re-skins the whole framework; teal is the built-in default (no
    import). The <a href={base + '/concepts/theming'}>theming guide</a>
    has the recipe for defining your own.
  </p>

  <section class="demo">
    <h2>The presets — the default and six alternatives</h2>
    <div class="pal-cards">
      <div class="pal-card">
        <h3>default (teal)</h3>
        <div class="pal-preview">
          <button class="bo-btn" type="button">Approve</button>
          <div class="pal-preview-row">
            <span class="bo-badge bo-badge--accent">badge</span>
            <a href={base + '/concepts/theming'}>a link</a>
          </div>
        </div>
        <p class="pal-profile">the framework itself — what you're comparing against</p>
        <div class="pal-import">
          <code>no import</code>
        </div>
      </div>
      {palettes.map((p) => (
        <div class="pal-card">
          <h3>{p.name}</h3>
          <style set:html={
            `.pal-${p.name}{${TOKENS.map((t) => `--bo-color-${t}:${p.light[t]}`).join(';')}}` +
            `[data-theme="dark"] .pal-${p.name}{${TOKENS.map((t) => `--bo-color-${t}:${p.dark[t]}`).join(';')}}`
          }></style>
          <div class={'pal-preview pal-' + p.name}>
            <button class="bo-btn" type="button">Approve</button>
            <div class="pal-preview-row">
              <span class="bo-badge bo-badge--accent">badge</span>
              <a href={base + '/concepts/theming'}>a link</a>
            </div>
          </div>
          <p class="pal-profile">{PROFILES[p.name] ?? ''}</p>
          <div class="pal-import">
            <code>{`brand-${p.name}`}</code>
            <button type="button" class="pal-copy bo-btn bo-btn--ghost"
              data-copy={`@import "@busy-office/ui/css/brand-${p.name}";`}>copy @import</button>
          </div>
        </div>
      ))}
    </div>
    <div class="copy-toast" role="status" aria-live="polite"></div>
    <p class="bo-u-text-muted">Previews follow your theme toggle — light
    values in light, the palette's dark values in dark, exactly what an
    app importing it gets. Every accent in every card is an alias to a
    <a href={base + '/base/colors'}>scale step</a>; the build fails if one
    drifts to a raw hex.</p>
    <p><strong>Placement matters</strong>: import the preset
    <em>after</em> <code>@busy-office/ui/css</code>, outside any
    <code>@layer</code> — that ordering is what lets it win under the
    <a href={base + '/concepts/cascade'}>cascade contract</a>. The
    <a href={base + '/getting-started/installation'}>installation page</a>
    shows the full stylesheet order.</p>
  </section>

  <section class="demo">
    <h2>Full token values</h2>
    {palettes.map((p) => (
      <details class="pal-details">
        <summary><span style="text-transform: capitalize">{p.name}</span> — all seven tokens, both themes</summary>
        <div class="bo-data-table-container" tabindex="0">
          <table class="bo-data-table" data-density="compact">
            <thead><tr>
              <th scope="col">Token</th>
              <th scope="col">Light</th>
              <th scope="col" class="bo-data-table__col--code">Hex</th>
              <th scope="col">Dark</th>
              <th scope="col" class="bo-data-table__col--code">Hex</th>
            </tr></thead>
            <tbody>
              {TOKENS.map((t) => (
                <tr>
                  <td class="bo-data-table__col--code">--bo-color-{t}</td>
                  <td><span class="doc-swatch" aria-hidden="true" style={`background:${p.light[t]}`}></span></td>
                  <td class="bo-data-table__col--code">{p.light[t]} <span class="bo-u-text-muted">({p.light[t + '-step']})</span></td>
                  <td><span class="doc-swatch" aria-hidden="true" style={`background:${p.dark[t]}`}></span></td>
                  <td class="bo-data-table__col--code">{p.dark[t]} <span class="bo-u-text-muted">({p.dark[t + '-step']})</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ))}
  </section>

  <section class="demo">
    <h2>Your own palette</h2>
    <p>Same recipe, no framework changes: define the accent family
    (accent / strong / solid / subtle / text) plus <code>focus-ring</code>
    and <code>bg-selected</code>, in <em>both</em> light and dark blocks,
    unlayered, imported after the framework CSS. Copy any file above as a
    starting point, and add your file to the contrast gate's brand scan
    if you vendor the repo — the gate discovers
    <code>src/css/brand/*.css</code> automatically. <strong>Why palettes
    never touch status colors</strong>: success/warning/danger carry
    MEANING (approved, on hold, overdue) that must read identically
    across every brand — a re-skin that made "danger" olive would be a
    correctness bug, not a theme. Palettes re-skin identity (the accent
    family); semantics stay framework-owned.</p>
  </section>

  <style>
    .pal-details .doc-swatch { --doc-swatch-w: 2.5em; vertical-align: middle; }
    .pal-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
      gap: var(--bo-space-3);
    }
    .pal-card {
      border: var(--bo-border-width) solid var(--bo-color-border-default);
      border-radius: var(--bo-radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .pal-card h3 {
      margin: 0;
      padding: var(--bo-space-2) var(--bo-space-3);
      font-size: var(--bo-font-size-sm);
      text-transform: capitalize;
      border-block-end: var(--bo-border-width) solid var(--bo-color-border-default);
    }
    .pal-preview {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--bo-space-2);
      padding: var(--bo-space-3);
      background: var(--bo-color-bg-surface);
      flex: 1;
    }
    .pal-preview-row {
      display: flex;
      gap: var(--bo-space-2);
      align-items: center;
      font-size: var(--bo-font-size-sm);
    }
    .pal-profile {
      margin: 0;
      padding: 0 var(--bo-space-3) var(--bo-space-2);
      color: var(--bo-color-text-muted);
      font-size: var(--bo-font-size-xs);
    }
    .pal-import {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--bo-space-2);
      padding: var(--bo-space-1) var(--bo-space-2) var(--bo-space-1) var(--bo-space-3);
      border-block-start: var(--bo-border-width) solid var(--bo-color-border-default);
      font-size: var(--bo-font-size-xs);
    }
    .pal-details { margin-block-end: var(--bo-space-2); }
    .pal-details summary { cursor: pointer; }
  </style>

  <script>
    // Copy-the-import — shared copy-toast (two channels, failure reported).
    import { copyWithToast } from '../../lib/copy-toast';
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.pal-copy');
      if (!btn) return;
      copyWithToast(btn.dataset.copy!, 'clipboard unavailable here — copy the line from the card');
    });
  </script>

  <Related links={[["/concepts/theming", "Theming guide"], ["/getting-started/installation", "Installation"], ["/base/colors", "Color scales"], ["/base/tokens", "Design tokens"]]} />
</Gallery>
