---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import api from '@busy-office/ui/api';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const classes = api.motion.classes;
const DESC: Record<string, string> = {
  'bo-motion-fade-in': 'opacity 0 → 1 on mount',
  'bo-motion-fade-out': 'opacity 1 → 0, then gone',
  'bo-motion-scale-in': 'fade + a subtle 0.96 → 1 scale — menu/popover entrance',
  'bo-motion-slide-in-inline-start': 'fade + slide from the start edge',
  'bo-motion-slide-in-block-start': 'fade + slide from the top — toast entrance',
  'bo-motion-collapse': 'expand/collapse via grid-template-rows; toggle data-state="open"',
  'bo-motion-pulse-once': 'a single background flash — "this row just changed"',
  'bo-motion-spin': 'continuous rotation for loading indicators',
};
// Roadmap 115.1: which of the eight intent categories below each shipped
// class serves. A vocabulary for the CONVERSATION ("this is an Entrance,
// not Attention, so fade — not pulse") — not a new mechanism; every class
// still animates exactly one way, tagged here rather than re-implemented
// per intent.
const INTENT: Record<string, string> = {
  'bo-motion-fade-in': 'Entrance / Exit',
  'bo-motion-fade-out': 'Entrance / Exit',
  'bo-motion-scale-in': 'Entrance / Exit',
  'bo-motion-slide-in-inline-start': 'Entrance / Exit',
  'bo-motion-slide-in-block-start': 'Entrance / Exit',
  'bo-motion-collapse': 'State Transition',
  'bo-motion-pulse-once': 'Attention',
  'bo-motion-spin': 'Progress',
};
const entranceMarkup = `<div class="bo-motion-fade-in">fade-in</div>
<div class="bo-motion-scale-in">scale-in</div>
<div class="bo-motion-slide-in-inline-start">slide-in-inline-start</div>
<div class="bo-motion-slide-in-block-start">slide-in-block-start</div>`;
const collapseMarkup = `<button class="bo-btn bo-btn--secondary" id="collapse-toggle" aria-expanded="false" aria-controls="collapse-demo">Toggle</button>
<div class="bo-motion-collapse" id="collapse-demo" data-state="closed">
  <div>Collapsible content — height animates via grid-template-rows, no JS measurement.</div>
</div>`;
const pulseMarkup = `<button class="bo-btn bo-btn--secondary" id="pulse-trigger">Simulate update</button>
<div class="bo-motion-pulse-once" id="pulse-demo">Row total: $12,400.00</div>`;
const spinMarkup = `<span class="bo-motion-spin" aria-hidden="true">⟳</span> <span aria-live="polite">Loading…</span>`;
/* Showcases (137.18). Every demo above animates an abstract box, which shows
   WHAT each class does but not WHEN to reach for it — and the page's own
   framing is that you pick by intent. These are the same eight classes in the
   place an ERP actually uses them. `fade-out` appears here because it is the
   one documented class that had no demo at all. */
const toastMarkup = `<!-- Entrance: a toast arrives from the top edge -->
<div class="bo-alert bo-alert--success bo-motion-slide-in-block-start" role="status">
  <p class="bo-alert__title">Purchase order PO-88213 approved</p>
</div>`;
const menuMarkup = `<!-- Entrance: a menu grows from its trigger, 0.96 -> 1 -->
<div class="bo-motion-scale-in">
  <div class="bo-card">Duplicate · Export · Cancel line</div>
</div>`;
const rowMarkup = `<!-- Attention: a row the server just repriced -->
<tr class="bo-motion-pulse-once">
  <td>MRN-2255</td><td class="bo-data-table__col--numeric">1,284.00</td>
</tr>`;
const savingMarkup = `<!-- Progress: the spinner lives INSIDE the button that is busy -->
<button class="bo-btn" type="button" aria-busy="true">
  <span class="bo-motion-spin bo-icon bo-icon--settings" aria-hidden="true"></span>
  Saving…
</button>`;
const removeMarkup = `<!-- Exit: the line leaves before the DOM node does -->
<tr class="bo-motion-fade-out">…</tr>`;
---
<Gallery title="Motion" description="Opt-in functional animation, imported separately from the default bundle. Every duration comes from a token and is zeroed under prefers-reduced-motion.">
  <p class="demo-note">
    Opt-in, functional animations — not a decorative Animate.css clone. Import
    separately: <code>@busy-office/ui/css/motion</code>. Never in the default
    bundle. Every duration comes from the <code>--bo-motion-duration-*</code> tokens,
    already zeroed under <code>prefers-reduced-motion</code>, so every class here is
    reduced-motion-safe with no extra markup.
    <strong>Not for structural layout — reach for it once a state is already
    changing.</strong> These classes decorate a transition that's happening
    anyway (a row appearing, a panel opening); they never decide layout or
    timing on their own. If nothing is changing yet, motion has nothing to
    attach to.
  </p>
  <section class="demo">
    <h2>Motion intent</h2>
    <p class="bo-u-text-muted">Eight intents cover what a transition on this
    page communicates. Naming the intent first — "this is an Entrance, not
    Attention" — is what keeps a reach for motion deliberate instead of
    decorative; not every intent has a shipped utility class below, because
    some are already served by a component's own behavior, not this module.</p>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Intent</th><th scope="col">Communicates</th><th scope="col">Where it lives</th></tr></thead>
        <tbody>
          <tr><td>Feedback</td><td>a direct interaction was received (press, hover, focus, selection)</td><td>component-level transitions — button, form fields; not this module</td></tr>
          <tr><td>State Transition</td><td>a control changed state</td><td><code>.bo-motion-collapse</code>; also tabs/switch/checkbox in their own CSS</td></tr>
          <tr><td>Entrance / Exit</td><td>an element joined or left the interface</td><td><code>.bo-motion-fade-in</code>, <code>-fade-out</code>, <code>-scale-in</code>, the two <code>-slide-in-*</code> classes</td></tr>
          <tr><td>Spatial Transition</td><td>where an element exists relative to the rest of the screen</td><td>drawer/offcanvas, dialog — their own directional transitions, not this module</td></tr>
          <tr><td>Progress</td><td>a process is still running</td><td><code>.bo-motion-spin</code>; also skeleton, native <code>&lt;progress&gt;</code></td></tr>
          <tr><td>Confirmation</td><td>an action completed</td><td>toast/alert success states — text + icon, no dedicated motion class here</td></tr>
          <tr><td>Attention</td><td>something changed and is worth noticing, without stealing focus</td><td><code>.bo-motion-pulse-once</code> — the HTMX settle flash, generalized</td></tr>
          <tr><td>Delight</td><td>personality, when the context calls for it</td><td>not shipped — this framework targets transactional ERP screens first, where delight is rarely the job; build it in your own app when the context genuinely calls for it</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <section class="demo">
    <h2>Quick reference <span class="bo-badge">generated</span></h2>
    <div class="bo-data-table-container" tabindex="0">
      <table class="bo-data-table" data-density="compact">
        <thead><tr><th scope="col">Class</th><th scope="col">Intent</th><th scope="col">Does</th></tr></thead>
        <tbody>
          {classes.map((c: string) => (
            <tr>
              <td class="bo-data-table__col--code">.{c}</td>
              <td>{INTENT[c] ?? '—'}</td>
              <td class="bo-u-text-muted">{DESC[c] ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="demo">
    <h2>Entrance</h2>
    <p class="bo-u-text-muted">Play once on mount. Click Replay to see them again.</p>
    <div class="bo-cluster" id="entrance-demo" style="--bo-cluster-gap: var(--bo-space-4)">
      <div class="bo-motion-fade-in">fade-in</div>
      <div class="bo-motion-scale-in">scale-in</div>
      <div class="bo-motion-slide-in-inline-start">slide-in-inline-start</div>
      <div class="bo-motion-slide-in-block-start">slide-in-block-start</div>
    </div>
    <button class="bo-btn bo-btn--sm bo-btn--secondary" id="entrance-replay" type="button">Replay</button>
    <pre><code>{entranceMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2><code>--collapse</code> — expand/collapse</h2>
    <p class="bo-u-text-muted">
      Toggle <code>data-state="open"</code>/<code>"closed"</code> — the same
      convention dialog/offcanvas already use. Pure CSS: no JS height measurement.
    </p>
    <button class="bo-btn bo-btn--secondary" id="collapse-toggle" aria-expanded="false" aria-controls="collapse-demo" type="button">Toggle</button>
    <div class="bo-motion-collapse" id="collapse-demo" data-state="closed">
      <div>Collapsible content — height animates via grid-template-rows, no JS measurement.</div>
    </div>
    <pre><code>{collapseMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Pulse-once — "this just changed"</h2>
    <p class="bo-u-text-muted">
      Generalizes the HTMX settle flash (<a href={base + '/getting-started/htmx'}>Using with
      HTMX</a>) for any element, not just HTMX swaps.
    </p>
    <button class="bo-btn bo-btn--secondary" id="pulse-trigger" type="button">Simulate update</button>
    <div id="pulse-demo" style="padding: var(--bo-space-2) 0">Row total: $12,400.00</div>
    <pre><code>{pulseMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>Spin — loading indicator</h2>
    <p class="bo-u-text-muted">
      Continuous, so it isn't token-duration-driven — guarded by an explicit
      <code>prefers-reduced-motion</code> override instead (stops rotating;
      <code>aria-live</code> on the label is the programmatic channel either way).
    </p>
    <span class="bo-motion-spin" aria-hidden="true" style="display: inline-block; font-size: var(--bo-font-size-xl)">⟳</span>
    <span aria-live="polite">Loading…</span>
    <pre><code>{spinMarkup}</code></pre>
  </section>
  <section class="demo">
    <h2>In context — the same classes on real screens</h2>
    <p class="bo-u-text-muted">The demos above animate a plain box, which
    shows what each class does but not when to reach for it. These are the
    same classes doing the job they exist for. <strong>Pick by intent</strong>
    — Entrance for something arriving, Attention for something that changed
    under the user, Progress for something still running.</p>

    <div class="bo-stack">
      <div>
        <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-motion-play="sc-toast">Show toast</button>
        <div id="sc-toast" style="margin-block-start: var(--bo-space-2)">
          <div class="bo-alert bo-alert--success bo-motion-slide-in-block-start" role="status">
            <p class="bo-alert__title">Purchase order PO-88213 approved</p>
          </div>
        </div>
        <p class="bo-u-text-muted"><strong>Entrance · toast</strong> —
        <code>slide-in-block-start</code>. It arrives from the edge it is
        anchored to, so the motion says where it came from.</p>
      </div>

      <div>
        <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-motion-play="sc-menu">Open menu</button>
        <div id="sc-menu" style="margin-block-start: var(--bo-space-2)">
          <div class="bo-motion-scale-in bo-alert" role="group" aria-label="Row actions">
            <p>Duplicate · Export · Cancel line</p>
          </div>
        </div>
        <p class="bo-u-text-muted"><strong>Entrance · menu</strong> —
        <code>scale-in</code>. A subtle 0.96 → 1 reads as "this grew out of
        the thing you clicked", which a plain fade does not.</p>
      </div>

      <div>
        <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-motion-play="sc-row" data-motion-class="bo-motion-pulse-once">Reprice line</button>
        <div class="bo-data-table-container" tabindex="0" style="margin-block-start: var(--bo-space-2)">
          <table class="bo-data-table">
            <caption class="bo-visually-hidden">A line the server just repriced</caption>
            <thead><tr><th scope="col">Item</th><th scope="col" class="bo-data-table__col--numeric">Unit price</th></tr></thead>
            <tbody>
              <tr><td class="bo-data-table__col--code">MRN-2210</td><td class="bo-data-table__col--numeric">640.00</td></tr>
              <tr id="sc-row"><td class="bo-data-table__col--code">MRN-2255</td><td class="bo-data-table__col--numeric">1,284.00</td></tr>
            </tbody>
          </table>
        </div>
        <p class="bo-u-text-muted"><strong>Attention · a value changed under
        you</strong> — <code>pulse-once</code> on the row the server
        repriced. This is the one intent that exists because the user did
        <em>not</em> cause the change, so nothing else on screen points at
        it.</p>
      </div>

      <div>
        <button class="bo-btn" type="button" id="sc-save" data-motion-play="sc-save-icon">Save</button>
        <p class="bo-u-text-muted" style="margin-block-start: var(--bo-space-2)"><strong>Progress · saving</strong> —
        <code>spin</code> inside the button that is busy, paired with
        <code>aria-busy</code>. Keeping it in the button is what ties the
        wait to the thing being waited on.</p>
      </div>

      <div>
        <button class="bo-btn bo-btn--sm bo-btn--secondary" type="button" data-motion-play="sc-remove">Remove line</button>
        <div id="sc-remove" style="margin-block-start: var(--bo-space-2)">
          <div class="bo-alert bo-motion-fade-out">Line 30 — Anode kit</div>
        </div>
        <p class="bo-u-text-muted"><strong>Exit · removal</strong> —
        <code>fade-out</code>, the one class on this page that had no demo
        until now. It buys the half-second a user needs to see WHICH row
        left; remove the node when the animation ends, not before.</p>
      </div>
    </div>
  </section>

  <Related links={[
    ["/concepts/accessibility", "Accessibility model"],
    ["/concepts/js-behaviors", "JS behaviors (state attributes, the Save sequence)"],
    ["/getting-started/htmx", "Using with HTMX"],
    ["/base/utilities", "Utilities"],
  ]} />
</Gallery>
<script>
  // Replay: forcing a reflow between removing and re-adding the class
  // restarts the CSS animation (the standard no-JS-animation-lib trick).
  const replayBtn = document.getElementById('entrance-replay');
  const entranceItems = document.querySelectorAll('#entrance-demo > *');
  replayBtn?.addEventListener('click', () => {
    for (const el of entranceItems) {
      const cls = [...el.classList].filter((c) => c.startsWith('bo-motion-'));
      el.classList.remove(...cls);
      void (el as HTMLElement).offsetWidth;
      el.classList.add(...cls);
    }
  });

  const collapseToggle = document.getElementById('collapse-toggle');
  const collapseDemo = document.getElementById('collapse-demo');
  collapseToggle?.addEventListener('click', () => {
    const open = collapseDemo?.dataset.state === 'open';
    if (collapseDemo) collapseDemo.dataset.state = open ? 'closed' : 'open';
    collapseToggle.setAttribute('aria-expanded', String(!open));
  });

  /* Showcase replay (137.18). One delegated handler for every sample: strip
     the bo-motion-* classes, force a reflow, put them back — the same
     restart trick the entrance replay uses. Without a replay these are
     invisible, because an entrance animation plays once on mount, long
     before anyone has scrolled to it. */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-motion-play]');
    if (!btn) return;
    const target = document.getElementById(btn.dataset.motionPlay!);
    if (!target) return;
    const el = (target.querySelector('[class*="bo-motion-"]') as HTMLElement) ?? target;
    /* Attention effects are ADDED when something changes, so their element
       carries no bo-motion-* class at rest — which made this handler bail and
       left the "Reprice line" button dead. data-motion-class names the class
       to apply for that case; entrance effects, which sit in the markup, keep
       replaying the classes they already have. */
    const cls = [...el.classList].filter((c) => c.startsWith('bo-motion-'));
    if (!cls.length && btn.dataset.motionClass) cls.push(btn.dataset.motionClass);
    if (!cls.length) return;
    el.classList.remove(...cls);
    void el.offsetWidth;
    el.dataset.userPlayed = '1';   // see the fade-out handler below
    el.classList.add(...cls);
  });

  /* The Save showcase swaps the button into its busy state for real, rather
     than animating a decoration next to it — aria-busy is the half a screen
     reader gets, so it moves with the spinner. */
  const save = document.getElementById('sc-save');
  save?.addEventListener('click', () => {
    if (save.getAttribute('aria-busy') === 'true') return;
    const label = save.textContent;
    save.setAttribute('aria-busy', 'true');
    save.innerHTML =
      '<span class="bo-motion-spin bo-icon bo-icon--settings" aria-hidden="true"></span> Saving…';
    setTimeout(() => {
      save.removeAttribute('aria-busy');
      save.textContent = label;
    }, 1600);
  });

  /* fade-out has no `forwards` fill on purpose, so the element springs back
     to opacity 1 when the animation ends — the class animates the exit, it
     does not perform it. Removing the node is the consumer's job, and doing
     it here is what makes this a demo of the real pattern rather than of a
     flicker. Restored after a beat so the sample can be replayed. */
  /* pulse-once is a one-shot: leave the class on and the animation cannot be
     replayed, because re-adding a class the element already has does nothing. */
  document.addEventListener('animationend', (e) => {
    const el = e.target as HTMLElement;
    if (el.classList?.contains('bo-motion-pulse-once') && el.closest('#sc-row')) {
      el.classList.remove('bo-motion-pulse-once');
    }
  });

  const scRemove = document.getElementById('sc-remove');
  scRemove?.addEventListener('animationend', (e) => {
    const row = e.target as HTMLElement;
    if (!row.classList.contains('bo-motion-fade-out')) return;
    // Only a USER-triggered play removes the row. The class also runs once on
    // mount like every other entrance demo here, and hiding on that made the
    // sample show an empty gap to anyone who had just arrived — the demo
    // looked broken at exactly the moment it was first seen.
    if (row.dataset.userPlayed !== '1') return;
    delete row.dataset.userPlayed;
    row.style.visibility = 'hidden';
    setTimeout(() => { row.style.visibility = ''; }, 1200);
  });

  const pulseTrigger = document.getElementById('pulse-trigger');
  const pulseDemo = document.getElementById('pulse-demo');
  pulseTrigger?.addEventListener('click', () => {
    pulseDemo?.classList.remove('bo-motion-pulse-once');
    void (pulseDemo as HTMLElement)?.offsetWidth;
    pulseDemo?.classList.add('bo-motion-pulse-once');
  });
</script>
