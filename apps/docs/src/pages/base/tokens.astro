---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import contrast from '@busy-office/ui/contrast';
import scales from '@busy-office/ui/scales';
import { readFileSync } from 'node:fs';
import { lightVars, darkVars } from '../../lib/semantic-css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// GENERATED from the shipped semantic tier (tokens/color.css, via the
// shared reader in lib/semantic-css) — each token row shows its resolved
// value per theme, cross-linked to the raw scale step it aliases
// (research choice 5: close the palette↔token page-hop gap). Parsed at
// build; an unresolvable alias fails the build.
function resolve(value: string, vars: Record<string, string>): { hex: string; step?: string } {
  const pal = value.match(/^var\(--bo-palette-([a-z]+)-(\d+)\)$/);
  if (pal) {
    const hex = scales.ranges[pal[1]]?.steps[pal[2]];
    if (!hex) throw new Error(`tokens: ${value} does not resolve to a scale step`);
    return { hex, step: `${pal[1]}-${pal[2]}` };
  }
  const sem = value.match(/^var\((--bo-color-[a-z-]+)\)$/);
  if (sem) return resolve(vars[sem[1]], vars);
  return { hex: value };
}

// Role text keyed by token; grouped for the table. Only documented
// (component-consumed) tokens are listed — the CSS stays the source of
// the VALUES, this page adds the role words.
const GROUPS: [string, [string, string][]][] = [
  ['Backgrounds', [
    ['bg-canvas', 'the page itself, behind everything'],
    ['bg-surface', 'cards, panels, table bodies'],
    ['bg-surface-raised', 'popovers, dropdowns, dialogs'],
    ['bg-muted', 'subdued fills: table stripes, wells, disabled fields'],
    ['bg-hover', 'opaque hover fill (sticky cells that must cover content)'],
    ['bg-selected', 'the selected row/item fill'],
  ]],
  ['Borders', [
    ['border-default', 'hairlines: table rules, card edges'],
    ['border-strong', 'emphasized dividers'],
    ['border-control', 'input/select boundaries (≥3:1 against surface)'],
  ]],
  ['Text', [
    ['text-primary', 'body text'],
    ['text-secondary', 'supporting text'],
    ['text-muted', 'captions, hints (still AA on muted fills)'],
    ['text-disabled', 'disabled labels — decorative only'],
    ['text-inverse', 'text on solid accent/status fills'],
  ]],
  ['Accent (brand)', [
    ['accent', 'the brand color — links, active nav'],
    ['accent-strong', 'hover/active accent'],
    ['accent-solid', 'solid fills carrying text-inverse'],
    ['accent-subtle', 'tinted accent backgrounds'],
    ['accent-text', 'accent-colored text on surfaces'],
    ['focus-ring', 'the keyboard focus indicator'],
  ]],
  ['Status', [
    ['danger', 'errors, destructive actions'],
    ['danger-solid', 'solid danger fills — destructive buttons'],
    ['danger-strong', 'hover/active on solid danger'],
    ['danger-subtle', 'danger-tinted backgrounds'],
    ['danger-text', 'danger text on surfaces'],
    ['warning', 'warning accents — alert stripe, table markers'],
    ['warning-strong', 'warning fills and emphasis'],
    ['warning-subtle', 'warning-tinted backgrounds'],
    ['warning-text', 'warning text on surfaces'],
    ['success', 'confirmations, positive states'],
    ['success-subtle', 'success-tinted backgrounds'],
    ['success-text', 'success text on surfaces'],
  ]],
];
for (const [group, rows] of GROUPS)
  for (const [t] of rows)
    if (!(('--bo-color-' + t) in lightVars)) throw new Error(`tokens: documented token --bo-color-${t} (${group}) not found in color.css`);

// Spacing values, parsed from the shipped space.css (never hand-typed).
const spaceCss = readFileSync(new URL('../../../../../packages/core/src/css/tokens/space.css', import.meta.url), 'utf8');
const spaces = [...spaceCss.matchAll(/--bo-space-(\d+):\s*([^;]+);/g)].map((m) => [m[1], m[2].trim()]);
if (spaces.length < 8) throw new Error('tokens: space.css parse came up short');
const DENSITY_ALIASES = ['control-height', 'row-height', 'cell-padding-y', 'cell-padding-x', 'field-gap', 'font-size'];
const densityCss = readFileSync(new URL('../../../../../packages/core/src/css/tokens/density.css', import.meta.url), 'utf8');
for (const a of DENSITY_ALIASES)
  if (!densityCss.includes(`--bo-density-${a}:`)) throw new Error(`tokens: density alias --bo-density-${a} not found in density.css`);
const cell = (t: string, vars: Record<string, string>) => resolve(vars['--bo-color-' + t], vars);
---
<Gallery title="Design tokens">
  <p class="demo-note">
    The semantic tier — what components actually consume, and the tier
    that is <strong>stable API</strong>: renaming or removing any token
    below is a major version (see
    <a href={base + '/getting-started/versioning'}>versioning</a>). Each
    token resolves per theme to a
    <a href={base + '/base/colors'}>scale step</a> (or a deliberate
    literal); status colors carry meaning and are never re-skinned by
    <a href={base + '/base/palettes'}>palettes</a>.
  </p>

  <section class="demo">
    <h2>Color tokens</h2>
    {GROUPS.map(([group, rows]) => (
      <>
        <h3>{group}</h3>
        <div class="bo-data-table-container" tabindex="0">
          <table class="bo-data-table tok-table" data-density="compact">
            <caption class="bo-visually-hidden">{group} tokens</caption>
            <thead><tr>
              <th scope="col">Token</th>
              <th scope="col">Role</th>
              <th scope="col">Light</th>
              <th scope="col">Dark</th>
            </tr></thead>
            <tbody>
              {rows.map(([t, role]) => {
                const l = cell(t, lightVars); const d = cell(t, darkVars);
                return (
                  <tr>
                    <td class="bo-data-table__col--code">--bo-color-{t}</td>
                    <td>{role}</td>
                    <td class="bo-data-table__col--code">
                      <span class="doc-swatch" aria-hidden="true" style={`background:${l.hex}`}></span>
                      {l.hex}{l.step && <><br /><span class="bo-u-text-muted">(<a href={`${base}/base/colors#${l.step}`}>{l.step}</a>)</span></>}
                    </td>
                    <td class="bo-data-table__col--code">
                      <span class="doc-swatch" aria-hidden="true" style={`background:${d.hex}`}></span>
                      {d.hex}{d.step && <><br /><span class="bo-u-text-muted">(<a href={`${base}/base/colors#${d.step}`}>{d.step}</a>)</span></>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    ))}
    <p class="bo-u-text-muted">Dark literals (the <code>#1a1d23</code>-family
    surfaces) are deliberate: dark surfaces are tuned as a set rather than
    aliased to gray steps, so elevation reads as a ladder. That tuning is
    inside the semantic contract — apps never need to reproduce it.</p>
  </section>

  <section class="demo">
    <h2>Spacing scale</h2>
    {spaces.map(([n, v]) => (
      <div style="display:flex;align-items:center;gap:1rem">
        <code style="inline-size:8rem;font-size:var(--bo-font-size-xs)">--bo-space-{n}</code>
        <code style="inline-size:5rem;font-size:var(--bo-font-size-xs)" class="bo-u-text-muted">{v}</code>
        <span style={`display:inline-block;block-size:0.75rem;background:var(--bo-color-accent);inline-size:var(--bo-space-${n})`}></span>
      </div>
    ))}
  </section>

  <section class="demo">
    <h2>Contrast ratios <span class="bo-badge">generated & CI-gated</span></h2>
    <p class="bo-u-text-muted">Computed from the shipped token values by
    <code>check-contrast.mjs</code> on every build — the build fails if any pair
    drops below its threshold, so these numbers cannot drift.</p>
    {Object.entries(contrast.themes).map(([theme, pairs]) => {
      const rows = (pairs as any[]).filter((p) => !p.skipped);
      // Highest level actually met — the pass/fail column was 35 identical
      // badges (owner review): dead information. AAA is 7:1 (4.5 for large
      // text); everything here is normal-size UI text or a non-text pair.
      const level = (p: any) => (p.threshold >= 4.5
        ? (p.ratio >= 7 ? 'AAA' : 'AA')
        : (p.ratio >= 4.5 ? 'AA' : 'AA Large'));
      const aaa = rows.filter((p) => level(p) === 'AAA').length;
      return (
      <>
        <p class="bo-u-text-muted"><strong>{rows.length}/{rows.length}</strong> {theme}-theme
        pairs pass their required minimum — {aaa} with AAA headroom.</p>
        <div class="bo-data-table-container" tabindex="0">
        <table class="bo-data-table" data-density="compact">
          <caption class="bo-visually-hidden">{theme} theme contrast ratios</caption>
          <thead><tr><th scope="col">{theme}</th><th scope="col">on</th><th scope="col">sample</th><th scope="col" class="bo-data-table__col--numeric">ratio</th><th scope="col" class="bo-data-table__col--numeric">min</th><th scope="col">level</th></tr></thead>
          <tbody>
            {rows.map((p: any) => (
              <tr>
                <td class="bo-data-table__col--code">{p.fg.replace('--bo-color-', '')} <span class="bo-u-text-muted">{p.fgValue}</span></td>
                <td class="bo-data-table__col--code">{p.bg.replace('--bo-color-', '')} <span class="bo-u-text-muted">{p.bgValue}</span></td>
                {/* Live specimen: the certified pair rendered as itself, so a
                    mis-wired token LOOKS wrong instead of quietly reporting a
                    ratio for colors nobody can see. Decorative — the token
                    names above carry the meaning. */}
                <td class="doc-specimen" style={`background:${p.bgValue};color:${p.fgValue}`} aria-hidden="true">Aa</td>
                <td class="bo-data-table__col--numeric">{p.ratio}</td>
                <td class="bo-data-table__col--numeric">{p.threshold}</td>
                <td><span class={`bo-badge bo-badge--${p.pass ? (level(p) === 'AAA' ? 'success' : 'type') : 'danger'}`}>{p.pass ? level(p) : 'FAIL'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </>
      );
    })}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  <section class="demo">
    <h2>Density aliases</h2>
    <p class="demo-note">Components never hard-code sizes — they read six
    aliases ({DENSITY_ALIASES.map((a, i) => <>{i > 0 && ', '}<code>--bo-density-{a}</code></>)})
    that remap when <code>data-density</code> changes. Try it: the Density
    picker in this page's header re-sizes the control below.</p>
    <button class="bo-btn">Density-aware control</button>
  </section>

  <style>
    h3 { margin-block: var(--bo-space-4) var(--bo-space-2); }
    /* One column grid across ALL five group tables — sized independently
       they staggered down the page (owner, 2026-08-16). Fixed layout, so
       a long token name wraps instead of pushing the rails apart. */
    .tok-table {
      table-layout: fixed;
      /* PROPORTIONAL, not fixed rem: with rem widths the ROLE column
         collapsed to zero and its text overlapped the LIGHT column
         once the table got narrower than their sum (owner screenshot,
         zoomed view). Percentages keep the rails aligned across all
         five tables AND adapt; the min-inline-size makes the container
         scroll instead of crushing at phone widths. */
      min-inline-size: 34rem;
    }
    .tok-table :is(th, td):nth-child(1) { inline-size: 24%; }
    .tok-table :is(th, td):nth-child(2) { inline-size: 32%; }
    .tok-table :is(th, td):nth-child(3),
    .tok-table :is(th, td):nth-child(4) { inline-size: 22%; }

    .doc-specimen {
      font-weight: var(--bo-font-weight-semibold);
      text-align: center;
      border-radius: var(--bo-radius-sm);
    }
  </style>

  <Related links={[["/base/colors", "Color scales"], ["/getting-started/versioning", "Versioning & upgrades"], ["/concepts/tokens", "Design tokens (concept)"], ["/concepts/accessibility", "Accessibility model"]]} />
</Gallery>
