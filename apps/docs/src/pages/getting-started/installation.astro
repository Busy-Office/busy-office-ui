---
import Gallery from '../../layouts/Gallery.astro';
import Related from '../../components/Related.astro';
import pkg from '@busy-office/ui/package.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const aLaCarte = `# ORDER MATTERS: tokens, then reset, then components
import "@busy-office/ui/css/tokens";
import "@busy-office/ui/css/reset";
import "@busy-office/ui/css/components/data-table";
# a .min variant exists for every file (…/data-table.min)`;
const jsInit = `import { initDialogs, initDataTables, initTabs, initDropdowns, initAlerts }
  from "@busy-office/ui/js";

// Call each ONCE, ever — document-level delegation survives all DOM swaps.
initDialogs(); initDataTables(); initTabs(); initDropdowns(); initAlerts();`;
const skeleton = `<!doctype html>
<html lang="en" data-density="comfortable"> <!-- or "compact" for back-office -->
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- NEVER add user-scalable=no — zoom is the WCAG 1.4.4 mechanism -->
  <!-- CSS-only pages are LIGHT, coherently — native scrollbars and form
       chrome included. Offering dark mode = setting data-theme, blocking,
       before first paint (localStorage, a cookie, or server-rendered): -->
  <script>
    document.documentElement.dataset.theme =
      localStorage.getItem("theme") ?? "light";
  </script>
  <link rel="stylesheet" href="/vendor/busy-office-ui@${pkg.version}/index.min.css">
  <!-- Works in ANY server stack (Rails, Django, PHP, Go): copy dist/ into
       your static/asset pipeline — no bundler, no Node at runtime. Put the
       VERSION in the vendored path: upgrades become an explicit new copy +
       one href change, and you can always tell which version is deployed. -->
</head>
<body>
  <div class="bo-app-shell">
    <header class="bo-navbar bo-app-shell__header">…</header>
    <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Main">…</nav>
    <main class="bo-app-shell__main">…your screen…</main>
  </div>
  <script type="module">
    import { initDialogs, initDataTables } from "/vendor/busy-office-ui/js/index.js";
    initDialogs(); initDataTables();
  </script>
</body>
</html>`;
---
<Gallery title="Installation">
  <p class="demo-note">Install the package and import one stylesheet — that's it. No
  build step: the output is plain CSS and standard ES modules.</p>

  <section class="demo">
    <h2>Install</h2>
    <pre><code>npm i @busy-office/ui</code></pre>
    <pre><code>import "@busy-office/ui/css";   /* everything, one line */</code></pre>
    <p class="bo-u-text-muted"><strong>No npm?</strong> Copy
    <code>dist/css/index.min.css</code> and <code>dist/js/</code> from the
    <a href="https://github.com/Busy-Office/busy-office-ui">repo</a> (or
    <code>npm pack @busy-office/ui</code>) into your assets and link them as plain
    files — see the skeleton below.</p>
  </section>

  <section class="demo">
    <h2>Import only what you use <span class="bo-u-text-muted">(optional)</span></h2>
    <pre><code>{aLaCarte}</code></pre>
  </section>

  <section class="demo">
    <h2>Turn on interactive components</h2>
    <pre><code>{jsInit}</code></pre>
    <p class="bo-u-text-muted">Components whose page says "JS required" are inert until
    you call their init. What each does →
    <a href={base + '/concepts/js-behaviors'}>JS behaviors</a>.</p>
  </section>

  <section class="demo">
    <h2>Copy-paste page skeleton</h2>
    <pre><code>{skeleton}</code></pre>
  </section>

  <section class="demo">
    <h2>Browser floor</h2>
    <p><strong>Chrome/Edge 119 · Firefox 128 · Safari 17.4.</strong> The framework uses
    <code>@layer</code>, <code>:has()</code>, named container queries, and
    <code>popover</code>. Server-set <code>aria-invalid</code> error messages degrade
    gracefully below the floor; interactive <code>:has()</code> reveals do not.</p>
    <p class="bo-u-text-muted">One caveat: it assumes an unmodified root font-size. A
    host page that rescales <code>html</code> (legacy <code>62.5%</code> hacks) rescales
    every rem — embed via iframe instead.</p>
  </section>
  <Related links={[["/getting-started/first-screen", "Your first screen"], ["/concepts/cascade", "The cascade contract"], ["/getting-started/troubleshooting", "Troubleshooting"]]} />
</Gallery>
