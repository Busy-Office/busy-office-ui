---
import '@busy-office/ui/css';
import '../styles/code-hl.css';
import '../styles/copy-toast.css';
import '../styles/doc-swatch.css';
import Logo from '../components/Logo.astro';
import PrefBootstrap from '../components/PrefBootstrap.astro';
import SidebarNav from '../components/SidebarNav.astro';
import pkg from '@busy-office/ui/package.json';
import versions from '../../versions.json';
import { PATTERN_GROUPS } from '../data/pattern-groups.mjs';
const { title } = Astro.props;
const sections = [
  {
    label: 'Getting started',
    items: [
      { href: '/getting-started/installation', label: 'Installation' },
      { href: '/getting-started/first-screen', label: 'Your first screen' },
      { href: '/getting-started/htmx', label: 'Using with HTMX' },
      { href: '/getting-started/ai-assistants', label: 'Working with AI assistants' },
      { href: '/getting-started/troubleshooting', label: 'Troubleshooting' },
      { href: '/getting-started/versioning', label: 'Versioning & upgrades' },
      { href: '/getting-started/scope', label: "What's in scope" },
    ],
  },
  {
    label: 'Core concepts',
    items: [
      { href: '/concepts/design-language', label: 'The design language' },
      { href: '/concepts/tokens', label: 'Design tokens' },
      { href: '/concepts/density', label: 'Density' },
      { href: '/concepts/cascade', label: 'The cascade contract' },
      { href: '/concepts/js-behaviors', label: 'JS behaviors' },
      { href: '/concepts/review-anatomy', label: 'Review anatomy' },
      { href: '/concepts/accessibility', label: 'Accessibility model' },
      { href: '/concepts/container-queries', label: 'Container queries' },
      { href: '/concepts/theming', label: 'Theming & dark mode' },
      { href: '/concepts/permissions', label: 'Permissions & read-only' },
      { href: '/concepts/concurrency', label: 'Concurrency & conflicts' },
      { href: '/concepts/i18n', label: 'Internationalization' },
      { href: '/concepts/scale', label: 'Performance at scale' },
    ],
  },
  {
    label: 'Base styles',
    items: [
      { href: '/base/colors', label: 'Color scales' },
      { href: '/base/palettes', label: 'Palettes' },
      { href: '/base/primitives', label: 'Layout primitives' },
      { href: '/base/utilities', label: 'Utilities' },
      { href: '/base/motion', label: 'Motion' },
      { href: '/base/print', label: 'Print & reports' },
    ],
  },
  // Components grouped by TASK (2026-08-16 docs-IA pass, after DaisyUI/
  // Tailwind comparison) — "what am I trying to do" beats one flat 22-item
  // list or internal file layout. Kept to 2 nesting levels, 3-10 items/group.
  {
    label: 'Actions',
    items: [
      { href: '/components/button', label: 'Button' },
      { href: '/components/dropdown', label: 'Dropdown' },
      { href: '/components/segmented', label: 'Segmented control' },
    ],
  },
  {
    label: 'Data input',
    items: [
      { href: '/components/form', label: 'Forms' },
      { href: '/components/combobox', label: 'Combobox' },
      { href: '/components/filters', label: 'Filters' },
      { href: '/components/money', label: 'Money' },
      { href: '/components/quantity', label: 'Quantity' },
      { href: '/components/tag-input', label: 'Tag input' },
      { href: '/components/file-upload', label: 'File upload' },
      { href: '/components/richtext', label: 'Rich text' },
    ],
  },
  {
    label: 'Tables & lists',
    items: [
      { href: '/components/data-table', label: 'Data table' },
      { href: '/components/inline-editing', label: 'Inline editing' },
      { href: '/components/table-toolbar', label: 'Toolbar & grid nav' },
      { href: '/components/pagination', label: 'Pagination' },
      { href: '/components/tree', label: 'Tree' },
      { href: '/components/tree-table', label: 'Tree table' },
      { href: '/components/ordered-list', label: 'Ordered list' },
    ],
  },
  {
    label: 'Values',
    items: [
      { href: '/components/amount', label: 'Amount' },
      { href: '/components/kv', label: 'Key-value facts' },
      { href: '/components/date', label: 'Date (deprecated)' },
    ],
  },
  {
    label: 'Display',
    items: [
      { href: '/components/dashboard', label: 'Dashboard' },
      { href: '/components/dashboard#card', label: 'Card' },
      { href: '/components/byline', label: 'Byline' },
      { href: '/components/badge', label: 'Badge' },
      { href: '/components/kbd', label: 'Keyboard key' },
      { href: '/components/avatar', label: 'Avatar' },
      { href: '/components/prose', label: 'Prose' },
      { href: '/components/calendar', label: 'Calendar' },
    ],
  },
  {
    label: 'Feedback',
    items: [
      { href: '/components/alerts', label: 'Alerts & toasts' },
      { href: '/components/state-patterns', label: 'Loading, empty & error' },
      { href: '/components/progress', label: 'Progress' },
      { href: '/components/stepper', label: 'Stepper' },
      { href: '/components/approval-workflow', label: 'Timeline & audit' },
    ],
  },
  {
    label: 'Navigation & layout',
    items: [
      { href: '/components/navbar', label: 'Navbar' },
      { href: '/components/sidebar-nav', label: 'Sidebar navigation' },
      { href: '/components/breadcrumb', label: 'Breadcrumb' },
      { href: '/components/offcanvas', label: 'Drawers' },
      { href: '/components/tabs', label: 'Tabs' },
      { href: '/components/dialog', label: 'Dialog' },
      { href: '/components/icon', label: 'Icon' },
    ],
  },
  // Patterns grouped by JOB FAMILY in a real ERP working day — the shared
  // source is pattern-groups.mjs (roadmap 104.1), so this sidebar and the
  // generated /patterns/ tile index cannot disagree about which patterns
  // exist or how they're grouped. A clerk's day runs find → work → decide →
  // monitor, and "review & approve" holding the detail family was the tell
  // (Slice 109 catalogue: .roundtable/erp-pattern-catalogue-2026-08-22.md).
  // RF is a TRACK, not a group: own browser floor (rf-essentials, Chrome/
  // WebView 108), own screen size, own usage.
  ...PATTERN_GROUPS,
  {
    label: 'Reference',
    items: [
      { href: '/reference/tokens', label: 'Token reference' },
      { href: '/reference/keyboard', label: 'Keyboard map' },
      { href: '/reference/events', label: 'Intent-event index' },
      { href: '/reference/classes', label: 'Class index' },
      { href: '/reference/acr', label: 'Accessibility Conformance Report' },
    ],
  },
];
// Base-aware links so the site works at / (dev) and /busy-office-ui (Pages).
const projectLinks = [
  { href: 'https://github.com/Busy-Office/busy-office-ui', label: 'GitHub' },
  { href: 'https://github.com/Busy-Office/busy-office-ui/issues/new/choose', label: 'Report an issue' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Version switcher (Slice 20 item 3): snapshot builds carry a
// /v/<ver> base suffix — strip it to get the SITE root so "latest"
// from inside a snapshot escapes the snapshot instead of looping.
const siteRoot = base.replace(/\/v\/[^/]+$/, '');
const currentSnapshot = base.match(/\/v\/([^/]+)$/)?.[1] ?? null;
const current =
  (Astro.url.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
---
<html lang="en" data-density="comfortable">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Belt-and-suspenders with the color-scheme CSS property (tokens/color.css):
         hints the browser's OWN default rendering — before any stylesheet or
         script runs — to follow the OS light/dark preference during the
         unpainted gap every cross-document navigation has, instead of
         defaulting to a light/white canvas regardless of the user's theme. -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <title>{title} · busy-office-ui</title>
    <PrefBootstrap />
  </head>
  <!-- hx-select selects the incoming main's CHILDREN, not the main
       itself: selecting "#main-content" with innerHTML nested a second
       <main id="main-content"> inside the first on every boosted swap —
       duplicate id, doubled landmark, and doubled 24px padding (owner
       tokens review, 2026-08-16). -->
  <body hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML"
        hx-ext="head-support">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <style>
      /* First focusable element in the DOM, visually hidden until focused —
         the standard skip-link pattern; not a framework component (it's a
         one-off for this specific docs shell, not a reusable API). */
      .skip-link {
        position: absolute;
        inset-block-start: -3rem;
        inset-inline-start: var(--bo-space-2);
        z-index: 1000;
        padding: var(--bo-space-2) var(--bo-space-3);
        background: var(--bo-color-bg-surface);
        color: var(--bo-color-text-primary);
        border: 1px solid var(--bo-color-border-default);
        border-radius: var(--bo-radius-md);
        text-decoration: none;
      }
      .skip-link:focus-visible {
        inset-block-start: var(--bo-space-2);
      }
    </style>
    <div class="bo-app-shell">
      <header class="bo-navbar bo-app-shell__header" data-pagefind-ignore>
        <button class="bo-btn bo-btn--secondary bo-btn--icon docs-menu-btn" data-dialog-trigger="nav-drawer" aria-label="Open navigation">☰</button>
        {/* Search was completely unreachable below the sidebar breakpoint
            (roadmap 27.1): both instances measured 0x0 at 420px and Cmd-K is
            not a phone gesture. Same dialog, second entry point. */}
        <button class="bo-btn bo-btn--secondary bo-btn--icon docs-search-btn" type="button"
            data-cmdk-open aria-label="Search the docs">
          <span class="bo-icon bo-icon--doc" aria-hidden="true"></span>
        </button>
        {/* hx-boost="false": this points at the landing page, which does NOT
            use this layout — no #main-content, no sidebar, its own navbar.
            Boosted, htmx's hx-select="#main-content > *" finds nothing in
            the response to swap, so the URL/title update but the docs shell
            stays on screen with stale content — reproduced live, 2026-08-22.
            Same precedent as #toc-nav below: opt OUT of boost for a link
            that leaves this shell entirely, don't rely on the destination
            page adopting our target id. */}
        <a class="bo-navbar__brand" href={base + '/'} hx-boost="false"><Logo />busy-office-ui</a>
        <label class="bo-choice" for="version"><span class="bo-visually-hidden">Docs version</span>
          <select class="bo-select" id="version" aria-label="Docs version">
            <option value={siteRoot + '/'} selected={currentSnapshot === null}>v{pkg.version} · latest</option>
            {versions.snapshots.map((v) => (
              <option value={siteRoot + '/v/' + v + '/'} selected={currentSnapshot === v}>v{v}</option>
            ))}
          </select>
        </label>
        <span class="bo-navbar__spacer"></span>
        {currentSnapshot && (
          <p class="version-banner" role="note">
            You're reading the <strong>v{currentSnapshot}</strong> snapshot —
            it does not update. <a href={siteRoot + '/'} hx-boost="false">Switch to the latest docs</a>.
          </p>
        )}
        <label class="bo-choice" for="density">Density
          <select class="bo-select" id="density">
            <option value="compact">Compact</option>
            <option value="comfortable" selected>Comfortable</option>
            <option value="spacious">Spacious</option>
          </select>
        </label>
        <label class="bo-choice" for="theme">Theme
          <select class="bo-select" id="theme">
            <option value="light" selected>Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </header>
      <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Docs" data-pagefind-ignore>
        {/* ONE search instance site-wide (roadmap 27.1). This used to be a
            second PagefindUI mounted here, which inherited Pagefind's stock
            #393939 text because the token mapping is scoped to .docs-cmdk —
            measured at 1.46:1 in dark, a WCAG 1.4.3 failure. A button that
            opens the already-themed dialog fixes that, reaches mobile, keeps
            the shortcut hint as a REAL element, and stays short enough to pin.
            The `hint` is filled in by script from the actual platform. */}
        {!currentSnapshot && (
          <div class="bo-sidebar-nav__section docs-searchbtn-wrap">
            <button class="bo-btn bo-btn--secondary docs-searchbtn" type="button"
                data-cmdk-open aria-label="Search the docs">
              <span class="bo-icon bo-icon--doc" aria-hidden="true"></span>
              <span class="docs-searchbtn__label">Search docs…</span>
              <kbd class="bo-kbd docs-searchbtn__hint" data-cmdk-hint aria-hidden="true">⌘K</kbd>
            </button>
          </div>
        )}
        <SidebarNav sections={sections} current={current} base={base} idPrefix="side" />
        <div class="bo-sidebar-nav__section">
          <div class="bo-sidebar-nav__heading">Project</div>
          <ul>
            {projectLinks.map((p) => (
              <li><a class="bo-sidebar-nav__link" href={p.href} rel="external"><span class="bo-sidebar-nav__label">{p.label} ↗</span></a></li>
            ))}
          </ul>
        </div>
      </nav>
      <dialog class="bo-offcanvas docs-drawer" id="nav-drawer" data-state="closed" aria-label="Navigation">
        <div class="bo-offcanvas__header">
          <span class="bo-navbar__brand">Menu</span>
          <form method="dialog"><button class="bo-btn bo-btn--ghost bo-btn--icon" aria-label="Close">✕</button></form>
        </div>
        <nav class="bo-sidebar-nav" aria-label="Docs">
          <SidebarNav sections={sections} current={current} base={base} idPrefix="drawer" />
          <div class="bo-sidebar-nav__section">
            <div class="bo-sidebar-nav__heading">Project</div>
            <ul>
              {projectLinks.map((p) => (
                <li><a class="bo-sidebar-nav__link" href={p.href} rel="external"><span class="bo-sidebar-nav__label">{p.label} ↗</span></a></li>
              ))}
            </ul>
          </div>
        </nav>
      </dialog>
      <main class="bo-app-shell__main" id="main-content" data-pagefind-body>
        <div class="docs-main">
          <div class="bo-stack bo-stack--loose docs-content">
            <h1>{title}</h1>
            <slot />
          </div>
          <aside class="toc" aria-label="On this page" hidden data-pagefind-ignore>
            <div class="toc__heading">On this page</div>
            <nav id="toc-nav" hx-boost="false"></nav>
          </aside>
        </div>
      </main>
    </div>
    {!currentSnapshot && (
    <dialog id="cmdk" class="bo-dialog bo-dialog--wide docs-cmdk" aria-label="Search the docs">
      <div class="docs-cmdk__panel">
        <div id="cmdk-search"></div>
        <div class="docs-cmdk__hint">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </dialog>
    )}
    <script is:inline>
      // Keep the left index in place across navigations. The docs are a static
      // MPA, so each page load re-renders the sidebar at scrollTop 0 — restore
      // the last position, and if the current page's item isn't visible (deep
      // link, or a far jump), center it. Runs synchronously to avoid a flash.
      (() => {
        const sb = document.querySelector('.bo-app-shell__sidebar');
        if (!sb) return;
        const KEY = 'bo-sidebar-scroll';
        const saved = sessionStorage.getItem(KEY);
        if (saved !== null) sb.scrollTop = parseInt(saved, 10) || 0;
        const active = sb.querySelector('[aria-current="page"]');
        if (active) {
          const a = active.getBoundingClientRect(), s = sb.getBoundingClientRect();
          if (s.height && (a.top < s.top || a.bottom > s.bottom)) active.scrollIntoView({ block: 'center' });
        }
        sb.addEventListener('scroll', () => sessionStorage.setItem(KEY, String(sb.scrollTop)), { passive: true });
      })();
    </script>
    <script is:inline define:vars={{ base }}>
      // Pagefind exists only in the built site; degrade silently in dev.
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}/pagefind/pagefind-ui.css`;
      document.head.append(css);
      const s = document.createElement('script');
      s.src = `${base}/pagefind/pagefind-ui.js`;
      // Pagefind re-renders its result links on every keystroke. htmx.process()
      // re-scans a subtree for hx-* attributes but does NOT retroactively
      // re-derive an ANCESTOR's hx-boost for newly-added descendants (that
      // inheritance is only computed at the initial page-load scan, confirmed
      // empirically) — so each fresh link needs hx-boost set explicitly, or
      // clicking a search result falls through to a full page reload.
      function keepBoosted(container) {
        if (!window.htmx) return;
        new MutationObserver(() => {
          container.querySelectorAll('a[href]:not([hx-boost])').forEach((a) => a.setAttribute('hx-boost', 'true'));
          htmx.process(container);
        }).observe(container, { childList: true, subtree: true });
      }
      s.onload = () => {
        // ONE instance, constructed below inside the dialog. Pagefind's input
        // ships title/placeholder only — no accessible name (axe
        // label-title-only) — so it is labelled after mount.
        setTimeout(() => {
          document.querySelectorAll('.pagefind-ui__search-input').forEach((i) => {
            i.setAttribute('aria-label', 'Search the docs');
          });
        }, 0);
        // Cmd/Ctrl+K command palette — a second Pagefind instance in a dialog.
        const dlg = document.getElementById('cmdk');
        if (dlg) {
          new PagefindUI({ element: '#cmdk-search', showSubResults: true, showImages: false });
          keepBoosted(document.getElementById('cmdk-search'));
          const input = () => dlg.querySelector('.pagefind-ui__search-input');
          const links = () => [...dlg.querySelectorAll('.pagefind-ui__result-link')];
          const open = () => {
            if (dlg.open) return;
            dlg.showModal();
            const i = input(); if (i) { i.focus(); i.select?.(); }
          };
          document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); }
          });
          // The sidebar and mobile-header triggers are the pointer/touch entry
          // points to this same dialog — one instance, three ways in.
          /* Persist which nav groups the reader left open, alongside bo-theme and
         bo-density. Open/close itself is native — this only remembers. The
         group holding the current page is force-opened server-side, so a
         stored "closed" never hides where you are. */
      try {
        const KEY = 'bo-navgroups';
        const closed = new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]'));
        document.querySelectorAll('[data-navgroup]').forEach((d) => {
          const key = d.dataset.navgroup;
          if (closed.has(key) && !d.querySelector('[aria-current="page"]')) d.open = false;
          d.addEventListener('toggle', () => {
            const set = new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]'));
            d.open ? set.delete(key) : set.add(key);
            localStorage.setItem(KEY, JSON.stringify([...set]));
          });
        });
      } catch (e) { /* storage disabled: groups just don't persist */ }

      document.querySelectorAll('[data-cmdk-open]').forEach((btn) => {
            btn.addEventListener('click', open);
          });
          // Arrow keys move focus through results; Enter follows the focused link.
          dlg.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
            const l = links(); if (!l.length) return;
            e.preventDefault();
            const i = l.indexOf(document.activeElement);
            const next = e.key === 'ArrowDown' ? (i + 1) % l.length : (i <= 0 ? l.length - 1 : i - 1);
            l[next].focus();
          });
          // Backdrop click closes (native dialog doesn't by default).
          dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        }
      };
      s.onerror = () => {
        // No search at all beats a button that opens an empty dialog.
        document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.remove());
        document.getElementById('cmdk')?.remove();
      };
      document.head.append(s);
      // A visible affordance: the sidebar search shows the shortcut hint.
      /* A real element, so the hint can be platform-correct — the old CSS
         ::after hardcoded "⌘K" for Windows and Linux users too, who are the
         majority for a back-office framework. */
      {
        const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
        document.querySelectorAll('[data-cmdk-hint]').forEach((k) => {
          k.textContent = mac ? '\u2318K' : 'Ctrl K';
        });
      }
    </script>
    <script>
      // SIDE-EFFECT import, deliberately: a bound-but-unused default import
      // (import htmx from …) gets TREE-SHAKEN by the bundler and htmx silently
      // never loads — caught by the boost gate's "navigation was NOT boosted"
      // assertion while building it.
      //
      // head-support now comes from htmx-ext-head-support, NOT from
      // htmx.org/dist/ext/. htmx.org 2.0.10 still ships an htmx-1-era dist/ext/
      // directory, so the old import made every page log "You are using an
      // htmx 1 extension with htmx 2.0.10"; htmx 2 moved extensions into their
      // own packages (2026-08-18).
      //
      // It is NOT optional, which I established by deleting it: the boost gate
      // immediately failed with .scale-grid and .pal-cards rendering
      // display:block on /base/colors/ and /base/palettes/. The static check
      // only guarantees no page ships layout in an INLINE head <style>;
      // page-scoped CSS still arrives as its own <link>, and without the head
      // merge a boosted swap never adds it.
      //
      // Order matters and is enforced by module dependency, not statement
      // position: htmx-setup sets window.htmx during ITS evaluation, then
      // head-support evaluates against that global — synchronous, no race
      // window for a fast boosted click (owner root-cause doc, 2026-08-16).
      //
      // SIDE-EFFECT imports, both of them: a bound-but-unused default import
      // (import htmx from …) gets TREE-SHAKEN by the bundler and htmx silently
      // never loads — caught by the boost gate while building it.
      import '../lib/htmx-setup';
      import 'htmx-ext-head-support';
      import { initDialogs } from '@busy-office/ui/js';
      initDialogs(); // the mobile nav drawer (off-canvas dialog) — document
                      // delegation, so it keeps working across boosted swaps
                      // with no re-init needed.

      // Demo code folds (roadmap 118): a closed <details> prints EMPTY and
      // CSS cannot force one open, so print opens every fold and restores
      // after. Both signals wired on purpose: beforeprint/afterprint cover a
      // real print, and the matchMedia listener covers emulated print media
      // (which never fires beforeprint) — that second path is what the
      // check-claims case actually exercises.
      const setPrintFolds = (on) => {
        document.querySelectorAll('details.demo-pair__code').forEach((d) => {
          if (on) {
            if (!d.open) { d.dataset.printOpened = ''; d.open = true; }
          } else if ('printOpened' in d.dataset) {
            delete d.dataset.printOpened;
            d.open = false;
          }
        });
      };
      window.addEventListener('beforeprint', () => setPrintFolds(true));
      window.addEventListener('afterprint', () => setPrintFolds(false));
      const printMq = matchMedia('print');
      printMq.addEventListener('change', (e) => setPrintFolds(e.matches));
      // A page can LOAD already under print media (emulation sets media
      // before navigation) — then there is no change event to catch.
      if (printMq.matches) setPrintFolds(true);
    </script>
    <script is:inline define:vars={{ base }}>
      // hx-boost (2026-08-14): only #main-content swaps on an internal link
      // click — header/sidebar/scripts persist, closing the "whole screen
      // refresh instead of just the main area" gap the color-scheme fix
      // (also 2026-08-14) didn't touch. Everything below re-derives the
      // per-page state that used to come free from a full document reload.
      function onPageReady() {
        // Sidebar aria-current: server-rendered per page on a full load;
        // after a boosted swap the sidebar itself never re-renders, so it
        // has to be corrected by hand from the URL that's now current.
        const path = (location.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
        document.querySelectorAll('.bo-sidebar-nav__link').forEach((a) => {
          const href = (a.getAttribute('href') || '').slice(base.length).replace(/\/$/, '') || '/';
          if (href === path) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });

        // On-this-page: slugify every content h2, make it an anchor target,
        // and build the right-rail TOC. Hidden when a page has fewer than 2
        // sections. Re-run every time #main-content is replaced — the toc
        // nav itself is INSIDE the swapped region, so it's already empty.
        const content = document.querySelector('.docs-content');
        const headings = content ? [...content.querySelectorAll('h2')] : [];
        const toc = document.querySelector('.toc');
        const nav = document.getElementById('toc-nav');
        if (toc && nav && headings.length >= 2) {
          for (const h of headings) {
            if (!h.id) {
              h.id = (h.textContent || '')
                .toLowerCase()
                .replace(/[^\w]+/g, '-')
                .replace(/^-+|-+$/g, '');
            }
            const a = document.createElement('a');
            a.href = '#' + h.id;
            a.textContent = h.textContent;
            nav.append(a);
          }
          toc.hidden = false;
        }

        // Copy button on every code block — zero per-page work.
        for (const pre of content ? content.querySelectorAll('pre') : []) {
          const code = pre.querySelector('code');
          if (!code) continue;
          pre.classList.add('has-copy');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn bo-btn bo-btn--sm bo-btn--secondary';
          btn.textContent = 'Copy';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code.textContent || '');
              btn.textContent = 'Copied';
              setTimeout(() => (btn.textContent = 'Copy'), 1200);
            } catch {
              btn.textContent = 'Press ⌘C';
            }
          });
          pre.append(btn);
        }
      }
      onPageReady();
      document.body.addEventListener('htmx:afterSwap', (e) => {
        if (e.target && e.target.id === 'main-content') {
          onPageReady();
          document.querySelector('.bo-app-shell__main')?.scrollTo(0, 0);
          // The mobile drawer and cmd-k palette live OUTSIDE #main-content,
          // so unlike everything else they now persist across a swap where
          // a full reload used to reset them for free — close both so
          // navigating from inside either doesn't leave it hanging open.
          const drawer = document.getElementById('nav-drawer');
          if (drawer && drawer.open) { drawer.close(); drawer.dataset.state = 'closed'; }
          const cmdk = document.getElementById('cmdk');
          if (cmdk && cmdk.open) cmdk.close();
        }
      });
    </script>
    <script>
      // The documented 3-line density-toggle recipe.
      const sel = document.getElementById('density') as HTMLSelectElement;
      sel.value = localStorage.getItem('bo-density') ?? 'comfortable';
      document.documentElement.dataset.density = sel.value;
      sel.addEventListener('change', () => {
        document.documentElement.dataset.density = sel.value;
        localStorage.setItem('bo-density', sel.value);
      });
      // Theme toggle: same shape — one attribute, one storage key. The
      // data-bo-theming guard freezes transitions for the frame of the flip so
      // text doesn't flash on a mismatched (still-animating) background.
      // The INITIAL value is already applied — a blocking inline script in
      // <head> set it before first paint (site bug fix, 2026-08-14) — this
      // only syncs the <select> to match and wires the change handler.
      const html = document.documentElement;
      const setTheme = (v: string) => {
        html.setAttribute('data-bo-theming', '');
        html.dataset.theme = v;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => html.removeAttribute('data-bo-theming')));
      };
      const version = document.getElementById('version') as HTMLSelectElement;
      version?.addEventListener('change', () => {
        window.location.href = version.value;
      });
      const theme = document.getElementById('theme') as HTMLSelectElement;
      theme.value = html.dataset.theme ?? 'light';
      theme.addEventListener('change', () => {
        setTheme(theme.value);
        localStorage.setItem('bo-theme', theme.value);
      });
    </script>
  </body>
</html>
<style is:global>
  /* Docs-only chrome, written unlayered on purpose to demo the override rule. */
  .demo-note {
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--bo-color-accent);
    background: var(--bo-color-accent-subtle);
    border-radius: var(--bo-radius-sm);
    font-size: var(--bo-font-size-sm);
  }
  section.demo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    container-type: inline-size;
    container-name: bo-demo;
  }
  .demo h2 { font-size: var(--bo-font-size-lg); }

  /* Content + on-this-page rail. Rail drops out below its breakpoint and in
     print; content always keeps full width when the rail is gone. */
  .docs-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--bo-space-8);
    align-items: start;
  }
  .docs-content { min-inline-size: 0; }
  /* Marker indent for prose lists on docs pages. Was an identical inline
     style="padding-inline-start: 1.25rem" repeated 37 times across 27 pages
     (Standardize sweep, 2026-08-17). Docs-local on purpose: this is page
     styling, not framework API, and the Standardize rule is to consolidate
     WITHOUT widening the public surface. */
  .docs-list { padding-inline-start: 1.25rem; }
  /* A <ul> used purely as a cluster of badges/links — the list semantics are
     wanted, the markers are not. Was style="list-style: none; padding: 0"
     repeated 14 times (same Standardize sweep). */
  .docs-list-bare { list-style: none; padding: 0; }
  /* Cap the reading MEASURE, not the column (owner review: prose ran
     ~175ch on a 1920px display). Capping the grid column instead would
     squeeze the wide demos — full app screens, data tables, the scale
     grid — which are the point of the component and pattern pages. */
