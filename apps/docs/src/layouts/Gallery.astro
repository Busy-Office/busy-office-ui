    display: flex;
    flex-direction: column;
    min-block-size: 0;
    flex: 1 1 auto;
  }
  /* Default flex-shrink is 1 on any flex item — without this, the input
     shrank ~10px shorter once the (taller) drawer content made the column
     overflow, since it was shrinking right along with the drawer instead of
     staying fixed while only the drawer scrolled. Measured live: input
     height dropped from 51px (empty query, drawer hidden) to 41px (query
     typed, drawer visible) before this rule. */
  #cmdk-search .pagefind-ui__search-input,
  #cmdk-search .pagefind-ui__search-clear {
    flex-shrink: 0;
  }
  #cmdk-search .pagefind-ui__drawer {
    min-block-size: 0;
    flex: 1 1 auto;
    overflow-y: auto;
  }
  /* Clear is `position: absolute` relative to <form>, which coincides with
     the input's own top-left (input is the form's first child) but is NOT
     the input's height — the form also wraps the whole results drawer.
     --cmdk-input-h (set by syncClearSize() above, from the input's real
     measured height) sizes Clear to exactly the input's box instead of
     Pagefind's own calc(58px * scale), which came out taller than this
     site's actual (reset-shrunk) input and stuck out below it. */
  #cmdk-search .pagefind-ui__search-clear {
