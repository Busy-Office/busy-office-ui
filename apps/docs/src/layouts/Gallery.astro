---
import '@busy-office/ui/css';
const { title } = Astro.props;
const sections = [
  {
    label: 'Getting started',
    items: [
      { href: '/', label: 'Overview' },
      { href: '/getting-started/installation', label: 'Installation' },
      { href: '/getting-started/first-screen', label: 'Your first screen' },
      { href: '/getting-started/htmx', label: 'Using with HTMX' },
      { href: '/getting-started/troubleshooting', label: 'Troubleshooting' },
      { href: '/getting-started/versioning', label: 'Versioning & upgrades' },
    ],
  },
  {
    label: 'Core concepts',
    items: [
      { href: '/concepts/tokens', label: 'Design tokens' },
      { href: '/concepts/density', label: 'Density' },
      { href: '/concepts/cascade', label: 'The cascade contract' },
      { href: '/concepts/js-behaviors', label: 'JS behaviors' },
      { href: '/concepts/accessibility', label: 'Accessibility model' },
      { href: '/concepts/container-queries', label: 'Container queries' },
      { href: '/concepts/theming', label: 'Theming & dark mode' },
    ],
  },
  {
    label: 'Base styles',
    items: [
      { href: '/base/colors', label: 'Colors & tokens' },
      { href: '/base/primitives', label: 'Layout primitives' },
      { href: '/base/utilities', label: 'Utilities' },
      { href: '/base/print', label: 'Print & reports' },
    ],
  },
  {
    label: 'Components',
    items: [
      { href: '/components/button', label: 'Button' },
      { href: '/components/badge', label: 'Badge' },
      { href: '/components/form', label: 'Forms' },
      { href: '/components/data-table', label: 'Data table' },
      { href: '/components/pagination', label: 'Pagination' },
      { href: '/components/filters', label: 'Filters' },
      { href: '/components/tabs', label: 'Tabs' },
      { href: '/components/dropdown', label: 'Dropdown' },
      { href: '/components/alerts', label: 'Alerts & toasts' },
      { href: '/components/nav', label: 'Navigation' },
      { href: '/components/dialog', label: 'Dialog' },
      { href: '/components/dashboard', label: 'Dashboard' },
      { href: '/components/stepper', label: 'Stepper' },
      { href: '/components/approval-workflow', label: 'Timeline & audit' },
      { href: '/components/byline', label: 'Byline' },
      { href: '/components/ordered-list', label: 'Ordered list' },
    ],
  },
  {
    label: 'Patterns',
    items: [
      { href: '/patterns/invoice-list', label: 'Invoice list' },
      { href: '/patterns/approval', label: 'Approval workflow' },
      { href: '/patterns/record-detail', label: 'Record detail' },
    ],
  },
  {
    label: 'Reference',
    items: [{ href: '/reference/classes', label: 'Class index' }],
  },
];
// Base-aware links so the site works at / (dev) and /busy-office-ui (Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current =
  (Astro.url.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
---
<html lang="en" data-density="comfortable">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · busy-office-ui</title>
  </head>
  <body>
    <div class="bo-app-shell">
      <header class="bo-navbar bo-app-shell__header">
        <a class="bo-navbar__brand" href={base + '/'}>busy-office-ui</a>
        <span class="bo-badge bo-badge--accent">v0.1.0</span>
        <span class="bo-navbar__spacer"></span>
        <label class="bo-choice" for="density">Density
          <select class="bo-select" id="density" style="inline-size: auto">
            <option value="compact">Compact</option>
            <option value="comfortable" selected>Comfortable</option>
            <option value="spacious">Spacious</option>
          </select>
        </label>
        <label class="bo-choice" for="theme">Theme
          <select class="bo-select" id="theme" style="inline-size: auto">
            <option value="light" selected>Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </header>
      <nav class="bo-sidebar-nav bo-app-shell__sidebar" aria-label="Docs">
        <div class="bo-sidebar-nav__section" id="docsearch"></div>
        {sections.map((s) => (
          <div class="bo-sidebar-nav__section">
            <div class="bo-sidebar-nav__heading">{s.label}</div>
            <ul>
              {s.items.map((p) => (
                <li>
                  <a
                    class="bo-sidebar-nav__link"
                    href={base + p.href}
                    aria-current={current === p.href ? 'page' : undefined}
                  >
                    <span class="bo-sidebar-nav__label">{p.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <main class="bo-app-shell__main">
        <div class="docs-main">
          <div class="bo-stack bo-stack--loose docs-content">
            <h1>{title}</h1>
            <slot />
          </div>
          <aside class="toc" aria-label="On this page" hidden>
            <div class="toc__heading">On this page</div>
            <nav id="toc-nav"></nav>
          </aside>
        </div>
      </main>
    </div>
    <script is:inline define:vars={{ base }}>
      // Pagefind exists only in the built site; degrade silently in dev.
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}/pagefind/pagefind-ui.css`;
      document.head.append(css);
      const s = document.createElement('script');
      s.src = `${base}/pagefind/pagefind-ui.js`;
      s.onload = () => new PagefindUI({ element: '#docsearch', showSubResults: true, showImages: false });
      s.onerror = () => document.getElementById('docsearch')?.remove();
      document.head.append(s);
    </script>
    <script>
      // On-this-page: slugify every content h2, make it an anchor target, and
      // build the right-rail TOC. Deep-links (#slug) then work for every
      // section. Hidden when a page has fewer than 2 sections.
      const content = document.querySelector('.docs-content');
      const headings = content ? [...content.querySelectorAll('h2')] : [];
      const toc = document.querySelector('.toc') as HTMLElement | null;
      const nav = document.getElementById('toc-nav');
      if (toc && nav && headings.length >= 2) {
        for (const h of headings) {
          if (!h.id) {
            h.id = (h.textContent || '')
              .toLowerCase()
              .replace(/[^\w]+/g, '-')
              .replace(/^-+|-+$/g, '');
          }
          const a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          nav.append(a);
        }
        toc.hidden = false;
      }
    </script>
    <script>
      // The documented 3-line density-toggle recipe.
      const sel = document.getElementById('density') as HTMLSelectElement;
      sel.value = localStorage.getItem('bo-density') ?? 'comfortable';
      document.documentElement.dataset.density = sel.value;
      sel.addEventListener('change', () => {
        document.documentElement.dataset.density = sel.value;
        localStorage.setItem('bo-density', sel.value);
      });
      // Theme toggle: same shape — one attribute, one storage key.
      const theme = document.getElementById('theme') as HTMLSelectElement;
      theme.value = localStorage.getItem('bo-theme') ?? 'light';
      document.documentElement.dataset.theme = theme.value;
      theme.addEventListener('change', () => {
        document.documentElement.dataset.theme = theme.value;
        localStorage.setItem('bo-theme', theme.value);
      });
    </script>
  </body>
</html>
<style is:global>
  /* Docs-only chrome, written unlayered on purpose to demo the override rule. */
  .demo-note {
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--bo-color-accent);
    background: var(--bo-color-accent-subtle);
    border-radius: var(--bo-radius-sm);
    font-size: var(--bo-font-size-sm);
  }
  section.demo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .demo h2 { font-size: var(--bo-font-size-lg); }

  /* Content + on-this-page rail. Rail drops out below its breakpoint and in
     print; content always keeps full width when the rail is gone. */
  .docs-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--bo-space-8);
    align-items: start;
  }
  .docs-content { min-inline-size: 0; }
  .toc {
    position: sticky;
    inset-block-start: var(--bo-space-4);
    font-size: var(--bo-font-size-sm);
  }
  .toc__heading {
    font-size: var(--bo-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bo-color-text-muted);
    margin-block-end: var(--bo-space-2);
  }
  #toc-nav { display: flex; flex-direction: column; gap: var(--bo-space-1); }
  #toc-nav a {
    color: var(--bo-color-text-secondary);
    text-decoration: none;
    border-inline-start: 2px solid var(--bo-color-border-default);
    padding-inline-start: var(--bo-space-3);
    padding-block: 0.1rem;
  }
  #toc-nav a:hover { color: var(--bo-color-text-primary); border-color: var(--bo-color-accent); }
  html { scroll-behavior: smooth; scroll-padding-block-start: var(--bo-space-4); }
  @media (max-width: 60rem) { .docs-main { grid-template-columns: 1fr; } .toc { display: none; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print { .toc { display: none; } }
</style>
