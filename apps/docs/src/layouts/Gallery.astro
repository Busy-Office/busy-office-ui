  html { scroll-behavior: smooth; scroll-padding-block-start: var(--bo-space-4); }
  @media (max-width: 60rem) { .docs-main { grid-template-columns: 1fr; } .toc { display: none; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print { .toc { display: none; } }

  /* Responsive nav: persistent sidebar on wide; a Menu button opening an
     off-canvas drawer on narrow. Overrides the app-shell's icon-rail collapse,
     which doesn't suit a labels-only docs nav. */
  .docs-menu-btn { display: none; }
  @media (max-width: 56rem) {
    .docs-menu-btn { display: inline-flex; }
    /* Scoped to the DOCS shell (body > direct child) — an unscoped selector
