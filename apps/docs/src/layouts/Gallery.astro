     results together — which does nothing. Chain flex/min-block-size:0 down
     through Pagefind's own wrapper elements instead: #cmdk-search fills the
     remaining space in the (max 70vh) panel, and only the drawer — which
     holds the message, result list and "Load more" button, not the input —
     scrolls inside it. */
  #cmdk-search {
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    flex: 1 1 auto;
    overflow: hidden;
    padding: var(--bo-space-3);
  }
