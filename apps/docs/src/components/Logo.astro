---
// busy-office-ui mark: a ledger record — a rounded frame with rows, the last
// one short (a record in progress). currentColor + the accent token, so it's
// theme-aware and carries the Ledger teal. Decorative: the brand text already
// names the product, so the SVG is aria-hidden. Sized in em to track the text.
const { size = '1.15em' } = Astro.props;
---
<svg
  class="docs-logo"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="4.5" stroke="currentColor" stroke-width="2" />
  <path
    d="M7 8.5h10M7 12h10M7 15.5h6"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  />
</svg>

<style>
  .docs-logo {
    color: var(--bo-color-accent);
    flex: none;
    vertical-align: -0.15em;
  }
</style>
