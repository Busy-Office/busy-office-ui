---
/**
 * Live tile miniatures for the /patterns/ index (roadmap 104.2, owner
 * decision 2026-08-23: option c-scoped). Each preview is a SMALL, REAL
 * composition of the shipped CSS — the same classes the pattern page
 * itself demonstrates — rendered inert inside the tile. Zero drift by
 * construction: no images to go stale, and check-markup verifies every
 * class against the built CSS like any other docs markup.
 *
 * SCOPED deliberately (the research's own caveat, and namethatui's own
 * practice): only patterns whose screens read at tile size get one — a
 * dense list-report shrunk to 16rem is grey noise, and a preview that
 * cannot be read is worse than text. Patterns not in this map render
 * text-only tiles, unchanged.
 *
 * Rules for a fragment, so previews can never regress the gates:
 *  - real shipped classes and documented data-* values ONLY
 *    (check-markup enforces this against dist);
 *  - NO ids, NO popovers, NO aria-controls/expanded — nothing that can
 *    collide or claim interactivity; the whole stage is `inert` +
 *    aria-hidden, so it is invisible to AT and untabbable (the tile's
 *    own text carries all information);
 *  - decorative text only; never a value the tile's copy contradicts.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const day = (n: number, attrs = '') => `<span class="bo-calendar__day"${attrs}>${n}</span>`;
const PREVIEWS: Record<string, { scale: number; html: string }> = {
  'login': { scale: 0.8, html: `
