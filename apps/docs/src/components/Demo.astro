---
/**
 * Paired example: a rendered preview on top, its EXACT markup below (with the
 * site-wide copy button). Both come from the same `code` string — the live
 * preview via set:html, the shown code escaped — so the demo and its code can
 * never drift apart. Use for static markup examples; keep hand-built <section>
 * demos for anything needing Astro expressions (.map over data).
 *
 * layout="row" — SPIKE (Slice 7 item 4): opt-in side-by-side (preview left,
 * code right) once the enclosing section.demo container is wide enough
 * (@container bo-demo, not a media query — consistent with the rest of the
 * framework). Default (omitted) stays the original stacked layout untouched.
 * Scoped per-Demo instance on purpose — a live, reversible trial on a
 * couple of pages before deciding whether to roll it out further.
 */
const { code, layout } = Astro.props;
---
{/* Code sits behind a native <details> fold (roadmap 118, owner-picked
    "Option A" from the wireframe review): the preview is the page, the
    markup is on demand. Native disclosure = keyboard, AT and no-JS for
    free; print folds are forced open by the shell's print listener and
    verified by a check-claims case. Still ONE string for both halves. */}
<div class:list={['demo-pair', layout === 'row' && 'demo-pair--row']}>
  <div class="demo-pair__preview" set:html={code} />
  <details class="demo-pair__code">
    <summary>View code</summary>
    <pre><code>{code}</code></pre>
  </details>
</div>
