---
/**
 * "Related" footer for docs pages — closes the site-grill A-6 finding (pages
 * were navigable only by sidebar). `links` is [href, label] pairs; hrefs are
 * base-relative (e.g. "/concepts/density") and the dist link checker verifies
 * every one resolves, so a stale target fails the build.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { links = [] } = Astro.props;
---
{links.length > 0 && (
  <section class="demo related">
    <h2>Related</h2>
    <ul class="bo-cluster docs-list-bare">
      {links.map(([href, label]: [string, string]) => (
        <li><a class="bo-chip" href={base + href}>{label} →</a></li>
      ))}
    </ul>
  </section>
)}
