---
/**
 * The RF task queue ("what's next") markup, shared by /patterns/rf/rf-list
 * (full CSS bundle) and /patterns/rf/rf-list-rf (isolated document,
 * rf-essentials only) — roadmap 109.7. Composed from `.bo-data-table`, the
 * SAME component ScanToReceive's own receiving log already ships inside the
 * RF profile at 360px (goods-receipt-rf, roadmap 59.4) — that page is the
 * existing proof this shape survives the RF floor and width, not a new
 * claim. Two narrow columns only: a task queue is scanned top-to-bottom for
 * "what's next", not cross-referenced column-to-column, so it never needs
 * the auto-compaction @container rule (data-table.css) to kick in.
 *
 * KNOWN DEFECT, roadmap 135.3: this page's opener promises the worker "taps
 * the top row and starts working it", and these rows are plain text with
 * nothing tappable in them. The obvious fix — a ghost-button link in the
 * first cell — was tried and REVERTED, because it was measured: the button's
 * horizontal padding pushes the Status column 44px past the container at
 * 320px and 4px at 360px, where plain text overflows by zero. Trading an
 * untappable queue for a clipped status column is not a fix.
 *
 * The real gap is that a data-table row which OPENS something has no shipped
 * idiom that survives a narrow two-column table: inbox and job-monitor put a
 * `bo-btn--sm` in a third column, which is desktop-width thinking. Queued for
 * a grill rather than guessed at here.
 */
const tasks = [
  { label: 'PO-88213 · Dock 4', status: 'Next' },
  { label: 'PO-88190 · Dock 2', status: 'Queued' },
  { label: 'SO-51204 · Pick', status: 'Queued' },
  { label: 'CC-3092 · Count', status: 'Queued' },
];
---
<div class="bo-data-table-container" tabindex="0" data-density="spacious">
  <table class="bo-data-table">
    <thead><tr><th scope="col">Task</th><th scope="col">Status</th></tr></thead>
    <tbody>
      {tasks.map((t) => (
        <tr>
          <td>{t.label}</td>
          <td><span class={`bo-badge ${t.status === 'Next' ? 'bo-badge--accent' : ''}`}>{t.status}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
