---
/**
 * Quick-reference cheat sheet — generated from api.json. A flat class → role
 * table at the TOP of a component page for the "look it up at screen #40"
 * developer (the Tailwind reference-table-first pattern), but generated from
 * the shipped CSS so it cannot drift.
 */
import api from '@busy-office/ui/api';
const { component } = Astro.props;
const c = api.components[component];
if (!c) throw new Error(`ClassRef: unknown component "${component}"`);

// Role inferred from the BEM shape the extractor already classified.
function role(cls: string): string {
  if (cls.includes('--')) {
    const mod = cls.split('--').pop();
    return `variant: ${mod}`;
  }
  if (cls.includes('__')) {
    const part = cls.split('__').pop();
    return `part: ${part}`;
  }
  return 'block (root)';
}
const rows = c.classes.map((cls: string) => [cls, role(cls)]);
---
<section class="demo">
  <h2>Quick reference <span class="bo-badge">generated</span></h2>
  <div class="bo-data-table-container">
    <table class="bo-data-table" data-density="compact" data-search-keep>
      <thead><tr><th scope="col">Class</th><th scope="col">Role</th></tr></thead>
      <tbody>
        {rows.map(([cls, r]: [string, string]) => (
          <tr>
            <td class="bo-data-table__col--code">.{cls}</td>
            <td class="bo-u-text-muted">{r}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {(c.dataAttrs.length > 0 || c.ariaAttrs.length > 0) && (
    <p class="bo-u-text-muted" style="font-size: var(--bo-font-size-sm)">
      State attributes: {[...c.dataAttrs, ...c.ariaAttrs].map((a: string) => <code style="margin-inline-end:.4rem">{a}</code>)}
    </p>
  )}
</section>
