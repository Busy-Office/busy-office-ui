# Build the docs site and serve it statically. Build context = repo root.
#   podman build -f apps/docs/Containerfile -t bo-docs .
#   podman run --rm -p 8081:80 bo-docs   ->  http://localhost:8081/
FROM node:22-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/docs ./apps/docs
# DESIGN.md is a BUILD INPUT, not just documentation: /getting-started/ai-assistants
# generates its paste-in instruction block from the two tables in it, and throws
# rather than shipping an incomplete one. Leaving it out of the context broke this
# image from 33.1 until 2026-08-18 — the second time a docs-build dependency rotted
# here unnoticed, which is why CI now builds this file.
COPY DESIGN.md ./
# The ERP suite is a BUILD INPUT too, since 147.1: gen-suite-index.mjs reads its
# screens to generate the kit index, and copy-suite.mjs builds and copies its 28
# pages into dist/suite. Leaving it out broke this image on 2026-08-26 with
# ERR_MODULE_NOT_FOUND — the THIRD time a docs-build dependency rotted here, and
# the second in one session: two gates added that morning had already broken it
# by reading ci.yml and ROADMAP.md, which are legitimately absent and now stand
# down. This one is different and must NOT stand down: the suite is not optional
# context, it is a quarter of what the docs now serve, and an image that quietly
# omitted the screen kit would look fine and be wrong.
COPY examples/erp-suite ./examples/erp-suite
RUN npm ci --ignore-scripts
# The docs build ends in check-boost, which drives a real browser. Without
# Chrome the image build fails — which it silently did from the moment that
# gate landed until 2026-08-17. resolve-chrome.mjs finds this path itself.
# Build stage only: the runtime image below carries none of it.
RUN apk add --no-cache chromium
RUN npm run build -w @busy-office/ui
# No base path: served at the container root, so links resolve at "/".
RUN npm run build -w docs

FROM docker.io/library/nginx:alpine
COPY apps/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/docs/dist /usr/share/nginx/html
EXPOSE 80
